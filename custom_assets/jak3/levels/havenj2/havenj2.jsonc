{
  // Jak 2's whole Haven City, rebuilt as a single Jak 3 custom level.
  // The long_name must be 10 characters or fewer, and match this folder's name.
  "long_name": "havenj2",
  "iso_name": "HAVENJ2",
  "nickname": "hj2",

  // Jak 2's static props (street lamps, yakows...) and the pool surfaces of the palace plaza and
  // the stadium, generated by gen_havenj2_mesh.py (run gen_havenj2_water.py first): lit like the
  // city's background, without collision but for the props' invisible boxes. The "water" region
  // tree (ocean everywhere in the city, plus one volume per pool) comes from gen_havenj2_water.py.
  "gltf_file": "custom_assets/jak3/levels/havenj2/havenj2-mesh.glb",
  // + Jak 2's load regions of the city (the target and camera trees), translated by
  // gen_havenj2_links.py: they load the place behind a door when Jak nears it, and unload it when
  // he walks away, like Jak 2 did
  "region_tree_files": [
    "custom_assets/jak3/levels/havenj2/havenj2-water-regions.json",
    "custom_assets/jak3/levels/havenj2/havenj2-regions.json"
  ],

  // The base actor id for this level. Must not overlap other custom levels.
  "base_id": 21000,
  "base_region_id": 21000,

  // Generated by gen_havenj2_links.py from Jak 2's extracted data (requires a prior Jak 2
  // `task extract`, coordinates kept as-is in Jak 2's world space):
  //  - import_fr3: the background, merged from Jak 2's .fr3 files,
  //  - cameras: Jak 2's fixed cameras,
  //  - custom_models: the models built by build-actor (goal_src/jak3/game.gp) for the actors,
  //  - art_groups: Jak 3 art groups extracted from the Jak 3 DGOs into this level's fr3 (needs
  //    the Jak 3 ISO data), their .go listed in havenj2.gd,
  //  - actors: doors and elevators placed like Jak 2's, and the props that are actors.
  // BEGIN GENERATED by gen_havenj2_links.py: doors and elevators, edit the script
  // the whole background (tfrag/tie/shrub render trees + collision with its original pat),
  // merged from Jak 2's extracted .fr3 files (out/jak2/fr3/<level>.fr3). The palace pillars
  // (palshaft) are a level of their own, hj2-pshaft, like in Jak 2.
  "import_fr3": {"game": "jak2", "levels": ["ctywide", "ctysluma", "ctyslumb", "ctyslumc", "ctyport", "ctymarka", "ctymarkb", "ctyinda", "ctyindb", "ctygena", "ctygenb", "ctygenc", "ctyfarma", "ctyfarmb", "ctypal", "stadium"], "tfrag": true, "tie": true, "shrub": true, "collision": true, "collision_bounds": [-700, -200, -1000, 1400, 470, 2150], "hide_prototypes": ["city-mark-roof-before-broken.mb", "ctyp-statue-wall-breakable.mb"]},
  // Jak 2's city navigation: its nav meshes and its districts' traffic data merged into one
  // city-level-info (gen_havenj2_nav.py)
  "nav_data": "custom_assets/jak3/levels/havenj2/havenj2-nav.json",
  // the sprite textures of Jak 2's city particles, as texture page 1566 (havenj2-part.gc)
  "sprite_textures": {"page": 1566, "game": "jak2", "textures": [["ctysluma", "ctysluma-sprite", "sign-crimson"], ["ctysluma", "ctysluma-sprite", "sign-m5"], ["ctysluma", "ctysluma-sprite", "sign-blank"], ["ctysluma", "ctysluma-sprite", "sign-doctors"], ["ctysluma", "ctysluma-sprite", "sign-hiphog"], ["ctywide", "ctywide-sprite", "race-sign-03"], ["ctywide", "ctywide-sprite", "race-sign-01"], ["ctywide", "ctywide-sprite", "race-sign-02"], ["ctywide", "ctywide-sprite", "race-sign-04"], ["ctysluma", "ctysluma-sprite", "sign-metalhead"], ["ctywide", "ctywide-sprite", "burning-bush-off"], ["ctyslumb", "ctyslumb-sprite", "sign-hiphog"], ["ctyslumb", "ctyslumb-sprite", "sign-happy-pirate"], ["ctyslumb", "ctyslumb-sprite", "sign-future"], ["ctyslumb", "ctyslumb-sprite", "sign-baron"], ["ctyslumb", "ctyslumb-sprite", "sign-blank"], ["ctyslumb", "ctyslumb-sprite", "sign-gt2"], ["ctyslumb", "ctyslumb-sprite", "sign-crimson"], ["ctyslumc", "ctyslumc-sprite", "sign-hiphog-slumc"], ["ctyslumc", "ctyslumc-sprite", "sign-future-slumc"], ["ctyslumc", "ctyslumc-sprite", "sign-erol"], ["ctyport", "ctyport-sprite", "ctyport-muddrop"], ["GAME", "effects", "water-ring"], ["ctyport", "ctyport-sprite", "sign-holding-right"], ["ctyport", "ctyport-sprite", "sign-hiphog"], ["ctyport", "ctyport-sprite", "sign-blank"], ["ctyport", "ctyport-sprite", "sign-no-unloading"], ["ctyport", "ctyport-sprite", "sign-hiphog-exterior-krew"], ["ctyport", "ctyport-sprite", "sign-krew-international"], ["ctyport", "ctyport-sprite", "sign-vert-right-arrow"], ["ctyport", "ctyport-sprite", "sign-loading-left"], ["ctyport", "ctyport-sprite", "sign-arrows"], ["ctyport", "ctyport-sprite", "sign-hiphog-exterior-chick"], ["ctymarka", "ctymarka-sprite", "rugs-off"], ["ctymarka", "ctymarka-sprite", "rugs-rug"], ["ctymarka", "ctymarka-sprite", "rugs-on"], ["ctymarka", "ctymarka-sprite", "fish-on"], ["ctymarka", "ctymarka-sprite", "fish-off"], ["ctymarka", "ctymarka-sprite", "fresh-fish-structure-top"], ["ctymarka", "ctym