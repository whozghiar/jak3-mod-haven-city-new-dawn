    ["gungame", "gungame-door-5"]
  ],
  // Jak 2 door classes Jak 3 has no class for (the others: convert/jak2_jak3.py DOOR_ETYPES):
  // Jak 2's palace gate and fortress gate rebuilt from their models (models), classes in
  // havenj2-obs.gc and GAME; Jak 3 has no com-elevator: hj2-elevator is Jak 3's elevator with
  // Jak 2's model, like hj2-cpad-elevator. The gun course's doors (gungame-door) are Jak 2's
  // fortress gate model: hj2-fort-gate
  // the height lump of the doors that have none (meters above and below the door): Jak 3's airlock
  // only acts on Jak in that slice (Jak 2 paused the doors it didn't see, through its visibility
  // data, which the levels here don't have: the palace pillars' top doors acted from the lobby)
  "door_height": [20.0, 20.0],
  // Jak 2's doors with Jak 2's own models (hj2-common-obs.gc, GAME: rebuilt by build-actor)
  "etypes": {"palace-door": "hj2-palace-door", "fort-entry-gate": "hj2-fort-gate", "gungame-door": "hj2-fort-gate", "com-elevator": "hj2-elevator", "cpad-elevator": "hj2-cpad-elevator", "com-airlock-outer": "hj2-airlock-outer", "cas-front-door": "hj2-airlock-outer", "com-airlock-inner": "hj2-airlock-inner", "hip-door-a": "hj2-hip-door", "hip-door-b": "hj2-hip-door", "hide-door-a": "hj2-hide-door-a", "hide-door-b": "hj2-hide-door-b", "oracle-door": "hj2-oracle-door", "vin-door": "hj2-vin-door", "vin-door-ctyinda": "hj2-vin-door-ctyinda"},
  // Jak 2's elevators among the doors: Jak 2's elevators ride from their first point to their last
  "elevator_etypes": ["com-elevator", "cpad-elevator"],
  // Elevators stopping at every point of their path. The palace pillar had two elevators in one
  // shaft: com-elevator-3 from the lobby to the palace entrance hall (346m), used by the sneak-in
  // mission, and com-elevator-2 between the lobby and the roof door (417m), used after the palace
  // boss. The inside of the palace isn't ported: only com-elevator-2 is, lobby <-> roof door, with
  // its ride cameras, called from both floors (thresholds in meters). What each ride loads is set
  // by Jak 2's scripts: region 528 loads the roof on the way up, the pillar top airlock (on-inside
  // of com-airlock-inner-25) reloads the city as soon as Jak is back in from the roof, before the
  // ride down.
  "elevators": [{"level": "palshaft", "name": "com-elevator-2", "xz_threshold": 20.0, "y_threshold": 10.0, "comment": "lobby <-> roof door"}],
  // scripts sending events to Jak 2's elevators by name: they now go to the one that's left (the
  // palace gate calls com-elevator-3 down to the lobby)
  "renames": {"com-elevator-3": "com-elevator-2", "com-elevator-2": "com-elevator-2"},
  // script changes, by Jak 2 level and name: script -> replacement (null removes it). The outer
  // doors of the roof and of the cable hide the pillar (want-display hj2-pshaft #f) when they close.
  // A door is born closed when its level loads, and runs that script if Jak is in front of it,
  // however far: riding the cable pillar's elevator up loads the roof, whose door (570m away) then
  // turned off hj2-pshaft, the elevator Jak stood on and the shaft around him. The pillar stays
  // shown (it's loaded with the roof and the cable anyway).
  "script_overrides": {"palroof": {"com-airlock-outer-18": {"on-deactivate": null}}, "palcab": {"com-airlock-outer-17": {"on-deactivate": null}}},
  // a door's pair (next-actor), when Jak 2's isn't placed: Jak 2 pairs the slums' fortress gate
  // with the dump's (fordumpa, not ported); the rescue's gate (forresca) is its other side at the
  // end of the game
  "next_actor_overrides": {"ctysluma": {"fort-entry-gate-17": "fort-entry-gate-7"}},
  // Jak 2 levels that are only a backdrop: a door waiting for them to be loaded doesn't need them
  "backdrop_levels": ["palout"],
  // the art group of the mod's classes that use one of Jak 3 (the others: convert/jak2_jak3.py
  // ART_GROUPS, and the classes with a model below, built by build-actor). A ported actor's art
  // group goes into its level's DGO: the force-field walls, the searchlights, the port's barges
  // Jak's pole animations (jak-pole+0-ag, the target's jakb-pole-cycle-ja): Jak 3 only lets him grab
  // a swingpole while a level of his has them, like its own levels with poles (halfpipe, precc,
  // tema); the levels placing swingpoles or the dig's trapezes carry them. Jak's slide animations
  // (jak-tube+0-ag, the target's jakb-tube-turn-ja...) the same way, with the slides
  "art_groups": {"swingpole": "jak-pole+0-ag", "slide-control": "jak-tube+0-ag", "hj2-dig-balloon-lurker": "jak-pole+0-ag", "hj2-air-train": "air-train-ag", "hj2-time-gate": "warp-gate-ag", "hj2-security-wall": "security-wall-ag", "searchlight": "searchlight-ag", "hj2-boat-manager": "barge-ag"},

  // Actors ported by Jak 2 level and name. The mountain's: the warp gates between its foot (the
  // gardens airlock) and its top, Jak 2's only way up; the trans-plat riding from the top down to
  // Haven Forest; the iris doors, open like at the end of the game (they lead to the canyon,
  // hj2-mincan); and the temple elevator, parked at the top (it only goes down to the far
  // iris door). Their classes are in hj2-mount-obs.gc, but Jak 3's warp-gate. The dig's warp gate,
  // to Vin's room. The temple's return platform (mtn-plat-return-5, in mtnext; its -6 is only
  // spawned while mtnext is a backdrop). The city's 9 guard turrets (hj2-cty-guard-turret,
  // havenj2-obs.gc), hidden under their lids until the alert rises near a vehicle Jak drives.
  "named_actors": [["mountain", "warp-gate-10"], ["mountain", "warp-gate-11"], ["mountain", "trans-plat-1"], ["mountain", "mtn-iris-door-2"], ["mountain", "mtn-iris-door-3"], ["mountain", "mtn-plat-elevator-1"], ["dig3a", "warp-gate-28"], ["vinroom", "warp-gate-21"], ["mtnext", "mtn-plat-return-5"], ["ctygena", "cty-guard-turret-6"], ["ctyinda", "cty-guard-turret-3"], ["ctyindb", "cty-guard-turret-4"], ["ctyindb", "cty-guard-turret-7"], ["ctysluma", "cty-guard-turret-8"], ["ctysluma", "cty-guard-turret-9"], ["ctysluma", "cty-guard-turret-10"], ["ctyslumb", "cty-guard-turret-1"], ["stadium", "cty-guard-turret-2"]],
  // their classes (warp gates are Jak 3's), and the lumps kept ("path": points rounded, w = 1): the
  // trans-plat's ride, Jak 2's curve knots and speed (the return platform has no speed lump)
  "named_etypes": {"trans-plat": {"etype": "hj2-trans-plat", "lumps": {"path": "path", "path-k": "float", "speed": "float"}}, "mtn-iris-door": {"etype": "hj2-iris-door"}, "mtn-plat-elevator": {"etype": "hj2-mtn-elevator"}, "mtn-plat-return": {"etype": "hj2-mtn-plat-return", "lumps": {"path": "path", "path-k": "float"}}, "cty-guard-turret": {"etype": "hj2-cty-guard-turret"}},
  // Jak 2's air trains between the port and the castle pad, as hj2-air-train (Jak 3's air train, in
  // GAME: jak2-haven-city-world.gc). Riding one is a teleport, a short fade to the continue next to
  // the other air train (dest, a Jak 2 continue). Jak 2 hides the port's once the game is over:
  // here both always run.
  "teleporters": [
    {"level": "ctyport", "name": "air-train-1", "etype": "hj2-air-train", "dest": "caspad-warp", "travel_name": "the Dig Site"},
    {"level": "caspad", "name": "air-train-3", "etype": "hj2-air-train", "dest": "ctyport-warp", "travel_name": "Haven City"}
  ],
  // The time gate in Jak 2's hideout to the Freedom HQ (hj2-time-gate, Jak 3's warp gate, in GAME),
  // in the free corner of its main room (pos in meters, facing a unit xz vector: the actor's local
  // z). Jak 3's warp gate's opening faces its local x (Jak 3's arrival points stand along it), so
  // facing is the room's direction (-0.722, 0.692), toward the arrival point (new_continues
  // hideout-gate), turned 90 degrees: the opening faces the room and Jak. Its destination is the
  // Freedom HQ's arrival point (continues.target_continues); the Freedom HQ's gate is spawned by
  // GAME and goes to the hideout's (continues.new_continues).
  "new_teleporters": [
    {"level": "hideout", "name": "hj2-time-gate-1", "etype": "hj2-time-gate", "pos": [1207.0, 3.1, 53.0], "facing": [-0.692, -0.722], "radius": 8.0, "dest": "hj2-freehq-gate", "travel_name": "Jak 3", "comment": "the time gate to hj2-freehq-gate (hj2-time-gate, Jak 3's warp gate)"}
  ],

  // Jak 2's platforms and props of the pumping station, the mountain, the dig, Dead Town, the
  // construction site, the prison and the way out of the fortress, ported with their models
  // (models), by Jak 2 class: our class and the lumps kept (name -> res type). Their classes are in
  // levels/havenj2/hj2-*-obs.gc. Not ported from the dig: its enemies and the spiky spheres its
  // doors roll (the doors stay, still). At the end of the game, Dead Town's slabs,
  // bridge, floating platforms and flag are gone with the tower (Jak 2 only spawns them before).
  // The way out of the fortress: its trap doors stand whole, for Jak to break with a dive attack
  // as in Jak 2's escape (it then marks them dead). Its lifts are Jak 3's plat (the user18 option raises the deck in
  // place). The log is raised and the buttons down, like once Jak 2's dig is done; the mtn-plat-gap
  // stands at the top of its path, raised over the gap ("trans": "path_start").
  "ported_levels": ["atoll", "caspad", "consite", "ctyfarmb", "ctyport", "dig3a", "forest", "forexita", "forexitb", "forresca", "forrescb", "garage", "hideout", "hiphog", "mountain", "mtnext", "oracle", "palcab", "palroof", "prison", "ruins", "vinroom"],
  "ported_etypes": {
    "piston": {"etype": "hj2-piston", "lumps": {"move-range": "float", "sync": "float"}},
