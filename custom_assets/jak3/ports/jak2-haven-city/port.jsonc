    "water-anim-fortress": {"etype": "hj2-fort-pool"},
    "fort-trap-door": {"etype": "hj2-fort-trap-door"},
    "consite-silo-doors": {"etype": "hj2-cons-silo-doors"},
    "consite-bomb-elevator": {"etype": "hj2-cons-bomb-elevator"},
    // the gardens' yakows, alive (havenj2-obs.gc)
    "yakow": {"etype": "hj2-yakow"},
    // the palace cable and roof (hj2-pcab-obs.gc, hj2-common-obs.gc)
    "pal-cable-nut": {"etype": "hj2-pal-cable-nut", "lumps": {"sync": "float"}},
    "pal-falling-plat": {"etype": "hj2-pal-falling-plat"},
    "pal-flip-step": {"etype": "hj2-pal-flip-step"},
    "pal-electric-fan": {"etype": "hj2-pal-electric-fan", "lumps": {"rotspeed": "float"}},
    "pal-rot-gun": {"etype": "hj2-pal-rot-gun"},
    "pal-gun-turret": {"etype": "hj2-pal-gun-turret", "lumps": {"distance": "float"}},
    "pal-lowrez-throne": {"etype": "hj2-pal-lowrez-throne"},
    "pal-prong": {"etype": "hj2-pal-prong"},
    // the end of the game: the mountain temple's pressed buttons, ejected steps, lens room, dice
    // and dark eco pool (hj2-mount-obs.gc), Dead Town's fallen pillars (hj2-ruins-obs.gc), the
    // fortress rescue's buttons and lights (hj2-common-obs.gc). Not ported: the buried rocks, step
    // rocks, rhino walls, breakable walls and gear device (no rip has their end pose)
    "mtn-button": {"etype": "hj2-mtn-button"},
    "mtn-dice-button": {"etype": "hj2-mtn-dice-button"},
    "mtn-plat-eject": {"etype": "hj2-mtn-plat-eject"},
    "mtn-lens": {"etype": "hj2-mtn-lens"},
    "mtn-lens-base": {"etype": "hj2-mtn-lens-base"},
    "mtn-lens-floor": {"etype": "hj2-mtn-lens-floor"},
    "mtn-dice": {"etype": "hj2-mtn-dice", "lumps": {"extra-id": "int32"}},
    "dark-eco-pool": {"etype": "hj2-dark-eco-pool", "lumps": {"vol": "vector"}},
    "ruins-pillar-collapse": {"etype": "hj2-ruins-pillar"},
    "fort-elec-button": {"etype": "hj2-fort-elec-button"},
    "fort-led": {"etype": "hj2-fort-led"},
    // the decor of the places: the Oracle's banners (hj2-oracle-obs.gc), the hideout's swinging
    // lamp (hj2-hide-obs.gc), the garage's curtain (hj2-garage-obs.gc), Vin's turbines and their
    // lightning (hj2-vin-obs.gc). Not ported: the race track's force field (stad-d-force-field:
    // its ring of walls needs Jak 2's own collide meshes, which the level port can't copy yet),
    // the atoll tank wreck (no rip has its wreck animation)
    "oracle-wall-banner": {"etype": "hj2-oracle-wall-banner"},
    "oracle-roof-banner": {"etype": "hj2-oracle-roof-banner"},
    "oracle-roof-banner-b": {"etype": "hj2-oracle-roof-banner-b"},
    "hide-light": {"etype": "hj2-hide-light"},
    "gar-curtain": {"etype": "hj2-gar-curtain"},
    "vin-turbine": {"etype": "hj2-vin-turbine", "lumps": {"extra-id": "int32"}},
    // Haven Forest's creatures (hj2-forest-obs.gc): the wrens, pecking or flying their curves
    // (both of Jak 2's path lumps come joined, hj2-wren splits them), and the fish schools (Jak
    // 2's 7 fish-managers of 12 minnows)
    "wren": {"etype": "hj2-wren", "lumps": {"idle": "path", "takeoff": "path", "takeoff-k": "float", "path": "path", "path-k": "float"}},
    "fish-manager": {"etype": "hj2-fish-manager"},
    // the avalanche of the mountain temple's gully (hj2-mtnx-obs.gc, simulated: Jak 2's streamed
    // fall animation isn't in the rips) and the dig's stomp blocks (hj2-dig-obs.gc, Jak 3's rigid
    // bodies)
    "mtn-aval-rocks": {"etype": "hj2-mtn-aval-rocks"},
    "dig-stomp-block-controller": {"etype": "hj2-dig-stomp-block-controller"},
    // the fortress's electric belt (hj2-fortb-obs.gc), the castle pad's electric gate (hj2-caspad-
    // obs.gc, Jak 3's elec-gate), the pumping station's gun buoy (hj2-atoll-obs.gc, a prop
    // surfacing in Jak 2's sea zone, no navigation). Not placed: the fortress's elec gates, off at
    // the end of the game
    "caspad-elec-gate": {"etype": "hj2-caspad-elec-gate", "lumps": {"pathl": "path", "pathr": "path"}},
    "fort-elec-belt": {"etype": "hj2-fort-elec-belt", "lumps": {"path": "path", "sync": "float"}},
    "gun-buoy": {"etype": "hj2-gun-buoy"},
    // the fortress's laser turrets (hj2-fortb-obs.gc), invincible like Jak 2's; the city's guard
    // turrets are named actors (hj2-cty-guard-turret, havenj2-obs.gc)
    "fort-turret": {"etype": "hj2-fort-turret", "lumps": {"sync": "float"}},
    // the city (havenj2-obs.gc): the parking spots (parked bikes and cars of the traffic), the
    // force-field walls (open: Jak owns every pass at the end of the game) and Jak 3's
    // searchlights
    "parking-spot": {"etype": "hj2-parking-spot", "lumps": {"rotoffset": "float"}},
    "security-wall": {"etype": "hj2-security-wall", "lumps": {"path": "vector", "pickup-type": "int32"}},
    "searchlight": {"etype": "searchlight"},
    // the main town's street lamps (ctygena, ctygenc: by the palace and by the stadium), which
    // Jak's attacks and the vehicles snap, as in Jak 2 (hj2-ctyn-lamp, havenj2-obs.gc)
    "ctyn-lamp": {"etype": "hj2-ctyn-lamp"},
    // the port and the garage: Daxter's mech (farthy) and the garage's parked cars (hj2-common-
    // obs.gc), the port's barges (hj2-port-obs.gc, Jak 3's boat-manager and barge)
    "farthy": {"etype": "hj2-farthy"},
    "dummy-vehicle": {"etype": "hj2-dummy-vehicle", "lumps": {"art-name": "string"}},
    "boat-manager": {"etype": "hj2-boat-manager", "lumps": {"nav-mesh-actor": "uint32"}},
    // the Hip Hog's whack-a-metal cabinet (hj2-hiphog-obs.gc), its game's fixed camera kept
    "hip-whack-a-metal": {"etype": "hj2-whack-cabinet", "lumps": {"camera-name": "string"}}
  },
  // the ported classes placed in every level, not only in ported_levels: the swinging bars (Jak 3's
  // swingpole, the bar itself is background) and the slides (Jak 3's slide-control, target-tube.gc).
  // Jak 2's crates are placed in every level too (as Jak 3's wood crates, with their pickups). The
  // city's parking spots, force-field walls and searchlights (the hub, its districts, the cable).
  "ported_everywhere": ["slide-control", "swingpole", "parking-spot", "security-wall", "searchlight", "ctyn-lamp"],

  // Models rebuilt from Jak 2's rips for build-actor (custom_assets/jak3/models/custom_levels/
  // <model>.glb, built by goal_src/jak3/game.gp), by the class that uses them:
  //   rip:     decompiler_out/jak2/levels/<rip>
  //   prims:   the primitives kept (null: all)
  //   collide: null for a box around the model; {"hull": y}: the convex hull of the vertices above
  //            y (null: all), below y_max if given; or a list of meshes, each a list of boxes
  //            [lo, hi] (the model's space), {"hull": y, "joint": name} (the hull of that joint's
  //            part, moved with it) or {"joint_box": name} (the box around that joint's part)
  //   anims:   the animations kept instead of the rip's first: [rip, animation, our name]
  //   extras:  models of their own drawn with it (no actor)
  // Jak 2's com-elevator: a 12 x 13m platform, floor at its origin's height, from 0.85m behind its
  // origin to 12m in front; its collision: the floor, and a fence along its edges that is only
  // solid during the ride (Jak 3's elevator fence, prim id #xfe000000), so Jak can walk on it without
  // falling between it and the shaft. The cpad-elevator (castle pad down to the dig): 24 x 24m, the
  // same way. The palace gate: a box around its sliding door, bound to the door joint.
  "models": {
    // Jak 2's doors (hj2-common-obs.gc)
    "hj2-airlock-outer": {"model": "hj2-airlock-outer", "rip": "ctyslumb/com-airlock-outer-lod0.glb", "prims": null, "collide": [{"hull": null, "joint": "Ldoor"}, {"hull": null, "joint": "Rdoor"}]},
    "hj2-airlock-inner": {"model": "hj2-airlock-inner", "rip": "ctyslumb/com-airlock-inner-lod0.glb", "prims": null, "collide": [{"hull": null, "joint": "Ldoormove"}, {"hull": null, "joint": "Rdoormove"}]},
    "hj2-hip-door": {"model": "hj2-hip-door", "rip": "hiphog/hip-door-a-lod0.glb", "prims": null, "collide": [{"hull": null, "joint": "Ldoor"}, {"hull": null, "joint": "Rdoor"}]},
    // the Hip Hog's whack-a-metal (hj2-hiphog-obs.gc): the cabinet (its box unused: the class
    // collides with Jak 2's spheres; rebuild_model gives back its prejoint's 0.64 scale), and the models its game
    // spawns: the metal heads (hip-mole's normal primitives 6 to 11) and their gold twin (0 to 5,
    // Jak 2's other mask), Daxter (daxter-highres, ripped from lwhack with his daxter-mole
    // animations: jak2_config.jsonc's extra_art_groups_by_dgo bakes his model there) and his hammer
    // (big-bopper, the same animations by name; Jak 2 clones Daxter's frame numbers onto it, so its
    // frames take his rate, 30 per second: anim_fps, its rip says 60)
