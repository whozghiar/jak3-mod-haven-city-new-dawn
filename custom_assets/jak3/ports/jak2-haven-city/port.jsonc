{
  // The jak2-haven-city port: Jak 2's Haven City and the places around it, as Jak 3 custom
  // levels. Every level file of the mod is generated from Jak 2's extracted data by
  //   python scripts/level_port custom_assets/jak3/ports/jak2-haven-city/port.jsonc
  // (from the repository root, after a Jak 2 and a Jak 3 extraction). A fix goes here, never in
  // a generated file. What each key means: scripts/level_port/README.md; the mod itself:
  // docs/modding/current_mod/haven_city_new_dawn_readme.md.
  "name": "jak2-haven-city",
  "source_game": "jak2",
  "target_game": "jak3",
  // Jak 2's texture pack (custom_assets/jak2/texture_replacements) also replaces the textures of
  // the same name in the Jak 3 art groups the levels hold (the Hellcat's wing01, dash01...),
  // after Jak 3's own folder: written into every level's .jsonc
  "texture_replacements": ["jak2"],
  // the mark of the mod's edits and generated files, and the prefix of what the port names
  // (continues, particle groups and callbacks; the GAME code defines <prefix>sprite-page-new and
  // <prefix>sprite-page-register, jak2-haven-city-world.gc)
  "tag": "og:jak2-haven-city",
  // the files the port generates (from the player's Jak 2 and Jak 3 extractions) are kept out of git:
  // a full run lists them in this .gitignore (scripts/level_port/__main__.py)
  "ignore_outputs": ".gitignore",
  "prefix": "hj2-",
  "paths": {
    "levels": "custom_assets/jak3/levels",
    "models": "custom_assets/jak3/models/custom_levels",
    // the levels' code (particles, ocean maps, height map are generated there)
    "code": "goal_src/jak3/levels/havenj2"
  },

  // The story state every level is in: the end of the game, but for these story nodes, taken as
  // still open (the palace stays reachable: Jak 2 closes its doors once this mission is over).
  // It decides which of Jak 2's actors are placed (their kill-mask), the background prototypes
  // shown and the branches of Jak 2's scripts. level_open_tasks: more story nodes taken as open
  // for one source level only. The palace plaza is as it is before Mar's tomb is found
  // (canyon-insert-items): the Baron's statue standing on its wall, no rubble, no broken statue, the
  // tomb's airlock behind the wall. The intact statue is ctywide's (baron-statue, in havenj2's mesh):
  // ctywide is taken before Mar's tomb too (no other ctywide actor or script depends on it).
  "story": {"state": "end", "open_tasks": ["palace-sneak-in-meeting"],
            "level_open_tasks": {"ctypal": ["canyon-insert-items-shard", "canyon-insert-items-resolution"],
                                 "ctywide": ["canyon-insert-items-shard", "canyon-insert-items-resolution"]}},

  // the goalc build steps of the levels (goal_src/jak3/game.gp loads this file): their models, their
  // level code and the levels. A level code object depends on the GAME code of the mod
  // (default_deps), or on what code_deps says: the city's signs, obs and farm code build on its
  // particles in turn, its height map on Jak 3's height-map-h, its traffic on Jak 3's city speech;
  // the dig's lava platforms are Jak 3's rigid-body-platform (rigid-body-plat.o, the volcano's)
  "build": {
    "file": "goal_src/jak3/levels/havenj2/jak2-haven-city.gp",
    "default_deps": ["jak2-haven-city-world"],
    "code_deps": {
      "havenj2-signs": ["havenj2-part"],
      "havenj2-obs": ["havenj2-signs"],
      "havenj2-farm": ["havenj2-obs"],
      "havenj2-height-map": ["height-map-h"],
      "havenj2-traffic": ["ctywide-speech", "jak2-haven-city-world"],
      "hj2-dig-obs": ["jak2-haven-city-world", "rigid-body-plat"],
      // the Oracle's banners and the hideout's lamp are hj2-anim-loop (GAME, hj2-common-obs.gc)
      "hj2-oracle-obs": ["jak2-haven-city-world", "hj2-common-obs"],
      "hj2-hide-obs": ["jak2-haven-city-world", "hj2-common-obs"],
      // the Hip Hog's whack-a-metal cabinet is a hj2-still-prop (GAME, hj2-common-obs.gc); its game
      // launches the particles of hj2-hiphog-part.gc by the ids it defines
      "hj2-hiphog-obs": ["jak2-haven-city-world", "hj2-common-obs", "hj2-hiphog-part"],
      // the castle pad's electric gate is Jak 3's elec-gate (elec-gate.o, linked before it in HJY)
      "hj2-caspad-obs": ["jak2-haven-city-world", "elec-gate"],
      // the port's barges are Jak 3's (ctyport-obs.o, linked before it in HPT)
      "hj2-port-obs": ["jak2-haven-city-world", "ctyport-obs"]
    }
  },

  // Jak 2's sound: the levels' sound banks (want-sound), looped ambiences (sound-play-loop) and
  // music (the MIDI music of Jak 2's .MUS files, played by game/overlord/jak3/srpc.cpp), renamed j2*
  // and copied from iso_data/jak2 by the build (scripts/level_port/steps/sound.py). Jak 3's traffic
  // sounds (its cars, citizens and Freedom League guards) load with the city's banks.
  "sound": {
    "prefix": "j2",
    "extra_banks": {"ctywide3": ["cityffh"], "ctywide1": ["citycarh"], "ctywide2": ["citypedh"]},
    // the sound check (scripts/level_port/steps/sound_check.py): the mod's GAME code, whose classes
    // the levels place, and the GOAL list of the Jak 2 banks each level's content needs besides
    // the wanted ones (hj2-update-extra-sound-bank, jak2-haven-city-world.gc, loads them)
    "game_code": ["goal_src/jak3/pc/features/jak2-haven-city-world.gc", "goal_src/jak3/levels/havenj2/hj2-common-obs.gc"],
    "level_banks_var": "*hj2-level-sound-banks*",
    // Jak 2's musics the mod's code plays itself: danger3, the whack-a-metal's (hj2-hiphog-obs.gc)
    "music": ["danger3"],
    // Jak 2's voice lines, packed for Jak 3 by the build (goalc's pack-vags), j + their name (Jak 3's
    // code plays some of Jak 2's names: its propa class). Each list is defined in the level-info file:
    // the speakers' speeches (havenj2-obs.gc), the citizens' and the guards' lines (Jak 2's
    // ctywide-speech.gc, given to Jak 3's civ-* and guard-* speech types in havenj2-traffic.gc).
    "voice_prefix": "j",
    "voices": {
      "*hj2-propa-sounds*": ["prop009", "prop010", "prop011", "prop012", "prop013", "prop014", "prop015", "prop016", "prop017", "prop018", "prop019", "prop020", "prop021", "prop022", "prop023", "prop024", "prop025", "prop026", "prop028", "prop027", "prop029", "prop030", "prop031", "prop032", "prop033", "prop034", "prop035", "prop036", "prop037", "prop038", "prop039", "prop040", "prop041", "prop042", "prop043", "prop008", "prop006", "prop005", "prop004", "prop002", "prop003", "bar001", "prop044", "prop045", "prop046", "prop047", "prop048", "prop049", "prop051", "prop052", "prop053", "prop054", "prop055", "prop056"],
      "*hj2-civ-m-alert-sounds*": ["cit099", "cit099a", "cit099b", "cit100", "cit100a", "cit101", "cit101a", "cit101b"],
      "*hj2-civ-f-alert-sounds*": ["cit099c", "cit099d", "cit100c", "cit101c", "cit103", "cit103a", "cit104", "cit104a", "cit105", "cit120", "cit120a"],
      "*hj2-civ-m-shot-sounds*": ["cit097", "cit097a", "cit097b", "cit098", "cit098a", "cit098b"],
      "*hj2-civ-f-shot-sounds*": ["cit097c", "cit097d", "cit098c", "cit098d", "cit099c", "cit098d"],
      "*hj2-civ-m-stealing-sounds*": ["cit001", "cit004", "cit008", "cit010", "cit016", "cit033", "cit034", "cit035", "cit046", "cit047", "cit051", "cit053", "cit055", "cit056", "cit057", "cit058"],
      "*hj2-civ-m-cower-sounds*": ["cit099", "cit099a", "cit099b", "cit100", "cit100a", "cit100b", "cit101", "cit101a", "cit101b"],
      "*hj2-civ-f-cower-sounds*": ["cit099c", "cit099d", "cit100c", "cit101c", "cit103", "cit103a", "cit104", "cit104a", "cit105", "cit120", "cit120a"],
      // Jak 2's Crimson Guards' lines, for Jak 3's guard-* speech types (havenj2-traffic.gc)
      "*hj2-guard-chatter-sounds*": ["kg007a", "kg010", "kg015", "kg030", "kg031", "kg032", "kg033", "kg007", "kg035a", "kg033a", "kg121a", "kg034", "kg030a", "kg031a", "kg034a", "kg128a", "kg035", "kg032a", "kg038", "kg129a", "kg041a", "kg042a", "kg043a", "kg121", "kg125", "kg124", "kg128", "kg125a", "kg129", "kg131", "kg124a", "kg131a"],
      "*hj2-guard-chatter-jak-sounds*": ["kg029a", "kg036", "kg037", "kg051a", "kg052a", "kg053a", "kg037a", "kg054a", "kg055a", "kg056a", "kg036a", "kg057a", "kg058a", "kg059a", "kg060a", "kg061a", "kg029", "kg062a", "kg063a", "kg064a", "kg113a"],
      "*hj2-guard-go-hostile-sounds*": ["kg070", "kg071a", "kg072a", "kg077", "kg073a", "kg074a", "kg070a", "kg075a", "kg076a", "kg077a"],
      "*hj2-guard-hit-sounds*": ["kg386a", "kg387a", "kg388a", "kg389a", "kg390a", "kg391a", "kg392a", "kg393a", "kg394a", "kg395a", "kg396a", "kg397a", "kg398a", "kg399a", "kg400a", "kg401a", "kg402a", "kg403a", "kg404a", "kg090a", "kg405a", "kg406a", "kg407a", "kg408a", "kg409a", "kg410a", "kg411a", "kg412a", "kg413a", "kg414a", "kg415a", "kg416a", "kg417a", "kg418a", "kg419a", "kg420a", "kg421a", "kg422a", "kg423a", "kg424a", "kg425a", "kg426a", "kg427a", "kg428a", "kg089a"],
      "*hj2-guard-victory-sounds*": ["kg009", "kg132", "kg132a", "kg133", "kg146", "kg147", "kg148", "kg149", "kg151", "kg152", "kg153", "kg154", "kg159", "kg165", "kg165a", "kg165b", "kg166", "kg166a", "kg166b", "kg167", "kg167a", "kg167b", "kg168", "kg168a", "kg168b", "kg169", "kg169a", "kg169b", "kg170", "kg170a", "kg170b", "kg171", "kg171a", "kg171b", "kg172", "kg172a", "kg172b", "kg173", "kg173a", "kg173b", "kg236a", "kg236b", "kg237a", "kg237b", "kg238a", "kg239a", "kg239b", "kg240a"],
      "*hj2-guard-change-targets-sounds*": ["kg044a", "kg045a", "kg046a", "kg047a", "kg048a", "kg049a", "kg050a"],
      "*hj2-guard-bumped-sounds*": ["kg387a", "kg396a", "kg399a"],
      "*hj2-guard-battle-sounds*": ["kg001", "kg002", "kg004", "kg006", "kg001a", "kg013", "kg016", "kg018", "kg019", "kg020", "kg023", "kg024", "kg002a", "kg004a", "kg078a", "kg079a", "kg080a", "kg081a", "kg082a", "kg083a", "kg084a", "kg085a", "kg086a", "kg087a", "kg088a", "kg091a", "kg023a", "kg006a", "kg092a", "kg020a", "kg093a", "kg094a", "kg005a", "kg095a", "kg103a", "kg104a", "kg112a", "kg024a", "kg134", "kg136", "kg137", "kg138", "kg139", "kg140", "kg141", "kg014", "kg153", "kg135", "kg142", "kg144", "kg145", "kg150"],
      // Tess at the Hip Hog's whack-a-metal (Jak 2's talker speeches 395 to 448, whack.gc there;
      // hj2-hiphog-obs.gc): cheering, near 1300 points, after a hit, after a red metal head, at the
      // end of a game won or lost
      "*hj2-whack-cheer-sounds*": ["tswm001", "tswm002", "tswm003", "tswm004", "tswm007", "tswm009", "tswm010", "tswm011", "tswm012", "tswm013", "tswm014", "tswm015", "tswm016", "tswm017", "tswm018", "tswm027", "tswm028", "tswm029", "tswm044", "tswm045"],
      "*hj2-whack-close-sounds*": ["tswm047", "tswm048", "tswm049"],
      "*hj2-whack-hit-sounds*": ["tswm005", "tswm006", "tswm008"],
      "*hj2-whack-wrong-sounds*": ["tswm019", "tswm020", "tswm021", "tswm039", "tswm040", "tswm041", "tswm042", "tswm043", "tswm046", "tswm051", "tswm052", "tswm053"],
      "*hj2-whack-win-sounds*": ["tswm050", "tswm054", "tswm055", "tswm056", "tswm023", "tswm024", "tswm025", "tswm026"],
      "*hj2-whack-lose-sounds*": ["tswm030", "tswm031", "tswm032", "tswm033", "tswm034", "tswm036", "tswm037", "tswm038"]
    }
  },

  // the level-load-infos and continue points of every level, in GAME (known at boot: warps, saves)
  "level_info": {
    "file": "goal_src/jak3/pc/features/jak2-haven-city-levels.gc",
    "comment": [
      "The level-load-info of havenj2 (Jak 2's Haven City) and of the places reached from it,",
      "with their continue points taken from Jak 2's. They're in GAME so the continues are known",
      "at boot (warps, saves). Moods and callbacks: jak2-haven-city-world.gc."
    ],
    "levels_var": "*havenj2-levels*",
    "levels_var_comment": "every level of this mod (the clock stays as set while one of them is active)",
    "hubs_var": "*havenj2-hubs*",
    // which district holds each 25m square of the city (the one whose collision ground covers most
    // of it, else Jak 2's traffic cells; the district loading guard,
    // hj2-district-guard in jak2-haven-city-world.gc), and the districts within "preload" meters of
    // each square, whose geometry the PC renderer loads before Jak gets there (hj2-renderer-prefetch)
    "district_map": {"var": "*havenj2-district", "cell": 25.0, "preload": 130.0},
    "hubs_var_comment": "the city's districts and their hub, (district . hub): a district is loaded after its hub"
  },
  // the level-load-info of a level, unless it says otherwise: its level callbacks (GAME,
  // jak2-haven-city-world.gc), draw priority; its mood is update-mood-<level>
  "level_defaults": {"level_info": {"callbacks": [[35, "hj2-place-activate"], [36, "hj2-place-deactivate"]], "draw_priority": "10.0"}},
  // the ocean map of the levels whose "ocean" is true (havenj2-ocean.gc, in GAME)
  "ocean_map": "*ocean-map-havenj2*",

  // The levels: each one merges its "sources" (Jak 2 levels: its own, then the ones merged into
  // it) and keeps Jak 2's world coordinates, so none can be loaded with Jak 3's city levels.
  //   nick, iso, index: the level's nickname (its DGO is <NICK>.DGO), ISO name and level index
  //   base_id:  its actor and region ids (1000 per level, past every other custom level's)
  //   memory:   a fixed level-memory-mode; else Jak 2's, made to fit Jak 3's level heap with
  //             the levels it's loaded with (the levels step prints the changes)
  //   sky:      Jak 2's :sky (the sky is only drawn when an active level has it); outdoor
  //   ocean:    true for the city's ocean map, or the name of the level's own (ocean_source)
  //   code:     objects of its DGO after the art groups: the level code (goal_src/jak3/levels/
  //             havenj2, built by game.gp)
  //   collision_bounds: [xmin, ymin, zmin, xmax, ymax, zmax] meters, the collision kept: the
  //             backdrops of some places spread over kilometers, collision included, and would
  //             blow the collide hash grid up
  // Level templates: a level with "template": <name> takes the keys below it doesn't set itself.
  // city-district: one of Jak 2's city districts (and the stadium grounds). Like Jak 2, a district
  // is a small level (small-edge) loaded with its city-wide hub (havenj2, small-center, holding the
  // city's code, traffic and navigation) and one neighbor district or interior: Jak 2's own scripts
  // load and show them (their doors, their regions, their continues). display-wait: Jak waits
  // (trips) at a district border while the next district is still loading, as in Jak 2.
  "level_templates": {
    "city-district": {
      "hub": "havenj2", "memory": "small-edge", "level_flags": ["display-wait"], "sky": true,
      // Jak 2's actors placed by class ("ported_etypes", in the levels of "ported_levels")
      "ported_actors": true,
      // the playable collision with a margin, up to the top of the palace pillars
      "collision_bounds": [-700, -200, -1000, 1400, 470, 2150],
      // the city's light (update-mood-havenj2, jak2-haven-city-world.gc)
      "level_info": {"mood": "update-mood-havenj2"},
      // its navigation, Jak 2's as it is: the traffic lives where the district is displayed
      "nav": {},
      // Jak 2's static props of the city that aren't actors here, and the pools' surfaces, as one
      // mesh (havenj2-mesh.glb, its gltf_file). Per Jak 2 class: its collision ("box", "post" for
      // poles with a head like street lamps, null: none) and its pat material (0 stone, 6 wood, 16
      // metal). The palace plaza at the end of the game (Mar's tomb found): the Baron's statue
      // broken on the plaza, the wall under it broken; Jak 2's broken statue has no collision, the
      // broken wall's collide mesh isn't in the rip, and a box would shut the tomb's way through it.
      // Not placed while the plaza is before Mar's tomb (story.level_open_tasks).
      // Not kept: the market props, farm crops and propaganda speakers, which are actors (props,
      // custom_props), the street lamps (hj2-ctyn-lamp, ported_everywhere), the force-field walls, the searchlights and the guard turrets (actors too:
      // ported_everywhere, named_actors), and the cutscene or mission actors, nor Jak 2's mission
      // terminals (burning-bush, the "?" holograms): the port has no Jak 2 missions to give.
      // The palettes: the city's background palettes have their ambient around 110/255 and their
      // sun palettes up to about 100.
      "mesh": {
        "props": {"lurker-pipe-lid": [null, null], "barons-ship-lores": [null, null], "ctypal-baron-statue-broken": [null, null], "ctypal-broke-wall": [null, null]},
        "post_width": 0.6,
        "palette": {"ambient": 110.0, "sun": 100.0}
      },
      // Jak 2's market props and farm crops as actors, with Jak 3's classes and models: Jak 3's own
      // Haven City reuses them (their art ships in Jak 3's DGOs, their code in Jak 3's level code).
      // The crops have Jak 3's art (it still has Jak 2's burst models) and Jak 2's behavior
      // (havenj2-farm.gc). Jak 2 turned its crops to a random angle when they spawned.
      "props": {
        // no max_vis_dist: each keeps Jak 2's vis-dist (140m for the market's), which is also how far
        // it is drawn (Jak 2's and Jak 3's setup-lods! take it for a 999999m last lod, as these
        // props' are). Phase 15b capped them at 80m: they vanished well before Jak 2's
        "etypes": {"market-crate": ["market-crate", "market-crate-ag"], "market-basket-a": ["market-basket-a", "market-basket-a-ag"], "market-basket-b": ["market-basket-b", "market-basket-b-ag"], "market-sack-a": ["market-sack-a", "market-sack-a-ag"], "market-sack-b": ["market-sack-b", "market-sack-b-ag"], "cty-fruit-stand": ["fruit-stand", "cty-fruit-stand-ag"], "farm-marrow": ["hj2-farm-marrow", "farm-marrow-ag"], "farm-beetree": ["hj2-farm-beetree", "farm-beetree-ag"], "farm-chilirots": ["hj2-farm-chilirots", "farm-chilirots-ag"], "farm-cabbage": ["hj2-farm-cabbage", "farm-cabbage-ag"], "farm-small-cabbage": ["hj2-farm-small-cabbage", "farm-small-cabbage-ag"], "farm-sprinkler-barrels": ["farm-sprinkler-barrels", "farm-sprinkler-barrels-ag"]},
        "random_yaw": ["farm-beetree", "farm-cabbage", "farm-chilirots", "farm-marrow", "farm-small-cabbage"]
      },
      // Jak 2's propaganda speaker: rebuilt from its model, placed with hj2-propa (havenj2-obs.gc).
      // Jak 2 switches its looks with setup-masks (intact: primitives 3 and 4, damaged: 1 and 2,
      // broken: 0, the stump); build-actor models have no mask table, so each look is a model of its
      // own, drawn by a child process.
      "custom_props": {
        "etypes": {"propa": {"etype": "hj2-propa", "rip": "ctywide/propa-lod0.glb", "prims": [3, 4], "looks": [["hj2-propa-damaged", [1, 2]], ["hj2-propa-broken", [0]]]}}
      }
    }
  },

  "levels": [
    {
      // Jak 2's ctywide: the city-wide level, the hub its districts load with (they come next).
      // It holds what the city shares: ctywide's background (the city walls, the palace, the
      // mountains), the traffic and its navigation, the ocean, the code of every district's
      // actors and particles. not-physical: Jak is never "in" it, the respawn points are the
      // districts' (Jak 3's ctywide does the same).
      "name": "havenj2", "nick": "hj2", "iso": "HAVENJ2", "index": "0x129", "base_id": 21000,
      "what": "Jak 2's Haven City, its city-wide level (the hub of its districts)",
      "sources": ["ctywide"],
      "memory": "small-center",
      "level_flags": ["not-physical"],
      "sky": true,
      "ocean": "*ocean-map-havenj2*",
      // Jak 2's actors placed by class ("ported_etypes", in the levels of "ported_levels")
      "ported_actors": true,
      // the playable collision with a margin, up to the top of the palace pillars. Drops ctywide's
      // backdrop mountains (x < -3000m, up to 1500m high), unreachable
      "collision_bounds": [-700, -200, -1000, 1400, 470, 2150],
      "continues": [],
      // the code of its districts' props, signs, palace gate, speakers and crops, after the traffic
      "code": ["ctymark-obs-h.o", "ctymark-obs.o", "ctyfarm-obs.o", "havenj2-part.o", "havenj2-signs.o", "havenj2-obs.o", "havenj2-farm.o"],
      // the traffic's guard bikes (hj2-guard-bike, havenj2-traffic.gc), rebuilt from Jak 2's model
      "models": ["hj2-guard-bike"],
      "level_info": {
        "callbacks": [[6, "*security-texture-anim-array*"], [33, "havenj2-login"], [34, "havenj2-logout"], [35, "havenj2-activate"], [36, "havenj2-deactivate"]],
        "draw_priority": "9.0",
        // the minimap's squares (bit 5 * row + column of Jak 3's 5x7 city grid, the same as Jak 2's)
        // that have a Jak 2 map: all of them, its maps are in its texture page (source_textures)
        "city_map_bits": "0x39d6f59cc",
        "comment": [
          "Jak 2's ctywide, the city-wide level of Jak 2's Haven City (custom_assets/jak3/levels/havenj2),",
          "loaded first with every district (hj2-slma...). Kept at Jak 2's world coordinates, so it",
          "must never be loaded together with Jak 3's own city levels.",
          "sky: the sky is only drawn when an active level has this flag.",
          "login/logout: the traffic engine, in havenj2's own code (havenj2-traffic.gc).",
          "6: the force-field walls' color texture animation (Jak 3's ctywide-texture.gc)."
        ]
      },
      // the city-wide ocean region (the pools are their districts', hj2-pal and hj2-stdm)
      "water": {
        "ocean_region": {"center": [350.0, 0.0, 575.0], "radius": 1950.0},
        "below": 3.0, "above": 2.0,
        "pools": []
      },
      // Jak 2's static props of the city that aren't actors here, and the pools' surfaces, as one
      // mesh (havenj2-mesh.glb, its gltf_file). Per Jak 2 class: its collision ("box", "post" for
      // poles with a head like street lamps, null: none) and its pat material (0 stone, 6 wood, 16
      // metal). The palace plaza at the end of the game (Mar's tomb found): the Baron's statue
      // broken on the plaza, the wall under it broken; Jak 2's broken statue has no collision, the
      // broken wall's collide mesh isn't in the rip, and a box would shut the tomb's way through it.
      // Not placed while the plaza is before Mar's tomb (story.level_open_tasks). The Baron's intact
      // statue on the plaza's wall (ctywide's baron-statue, 250m high, no collision in Jak 2): placed
      // only then.
      // Not kept: the market props, farm crops and propaganda speakers, which are actors (props,
      // custom_props), the street lamps (hj2-ctyn-lamp, ported_everywhere), the force-field walls, the searchlights and the guard turrets (actors too:
      // ported_everywhere, named_actors), and the cutscene or mission actors, nor Jak 2's mission
      // terminals (burning-bush, the "?" holograms): the port has no Jak 2 missions to give.
      // The palettes: the city's background palettes have their ambient around 110/255 and their
      // sun palettes up to about 100.
      "mesh": {
        "props": {"lurker-pipe-lid": [null, null], "barons-ship-lores": [null, null], "ctypal-baron-statue-broken": [null, null], "ctypal-broke-wall": [null, null], "baron-statue": [null, null]},
        "post_width": 0.6,
        "palette": {"ambient": 110.0, "sun": 100.0}
      },
      // Jak 2's traffic height map only (how high the city's vehicles fly: havenj2-height-map.gc, in
      // place of Jak 3's): like Jak 2's ctywide, it has no navigation, its districts hold their own
      // (the traffic engine links the city data of at most 2 levels, the 2 districts loaded with it)
      "nav": {
        "height_map": {"source": "goal_src/jak2/levels/city/traffic/traffic-height-map.gc"},
        "sources": []
      },
      // the traffic (levels/havenj2/havenj2-traffic.gc): Jak 3's traffic code, the objects of
      // ctywide's DGO but those of Jak 3's city itself (its props, particles, missions, scenes, trail
      // graph and height map; its searchlights and force-field wall colors, ctywide-texture, are
      // kept), which havenj2's DGO links in the same order; and the art of the
      // traffic types havenj2 spawns: Jak 3's citizens, Freedom League guards and their shields, the
      // city's hover cars and bikes, their pilots, the vehicles' explosion and Jak's animations in a
      // vehicle, and Jak 2's Freedom League Hellcats (their guard pilots are crimson-guard-ag)
      "traffic": {
        "code_from": "goal_src/jak3/dgos/cwi.gd",
        "skip": ["ctyport-obs", "ctywide-obs", "ctywide-part", "ctywide-scenes", "ctywide-tasks", "krimson-wall", "mhcity-obs", "mhcity-obs2", "mhcity-part", "traffic-height-map", "trail", "trail-graph"],
        "replace": {"traffic-height-map": "havenj2-height-map"},
        "code": ["havenj2-traffic.o"],
        "art": ["citizen-norm-ag", "citizen-fat-ag", "citizen-chick-ag", "crimson-guard-ag", "shield-sphere-ag", "shield-sphere-distort-ag", "shield-sphere-explode-ag", "cara-ag", "carb-ag", "carc-ag", "bikea-ag", "bikeb-ag", "bikec-ag", "citizen-norm-rider-ag", "vehicle-explosion-ag", "jak-pilot+0-ag", "jak-pilot-hcar+0-ag", "jak-pilot-gun+0-ag", "hellcat-ag"]
      },
      // Jak 2's particle effects of the city: signs and posters, neon signs, street lights and
      // glows, chimney smoke, steam, fountains, drips, fires, the Baron's propaganda holograms...
      // (havenj2-part.gc). Its texture page (1566): a texture-page-dir entry Jak 3 never uses,
      // under 2048 so that its texture ids stay positive in the int32 and binteger arrays of the
      // particle data. Its ids: Jak 3's GAME takes parts up to 899 and groups up to 221, the Jak 3
      // level code in havenj2 more (ctymark-obs: parts 1117-1162, groups 248-253; ctyfarm-obs:
      // parts 4001-4047, groups 1134-1145; the traffic's vehicle-part: parts 916-952, groups
      // 224-225; cty-guard-projectile: parts 1163-1164, group 254). The rest is free while
      // havenj2 is loaded: no Jak 3 level can be. Past these ranges are the places' ranges.
      // target_textures: the sprite pieces of Jak 3's market and farm props (breaking crates,
      // pots, crops, the fruit stands' fruit), which Jak 3 takes from its own city levels' sprite
      // pages (hj2-prop-textures-on in jak2-haven-city-world.gc finds them by name), and the health
      // bar of the vehicle Jak drives (vehicle-hud.gc finds it by name).
      // source_textures: Jak 2's minimap squares (its *-minimap pages), for havenj2's minimap page
      // (hj2-minimap-page-on in jak2-haven-city-world.gc finds them by name).
      // The neon signs (neon-baron...) are hj2- types of havenj2-signs.gc, with their data arrays;
      // extra_groups: the Baron's hologram over his speakers (hj2-propa), the farm crops bursting
      // and the sprinklers' water, the guard turrets' hits (ctywide-obs.gc). Jak 2's mission
      // terminals (burning-bush) and their "?" hologram aren't placed (no "kiosks" entry): the
      // port has no Jak 2 missions to give.
      // The race posters (birth-func-race-poster, ported in particle-callbacks.gc) show
      // race-sign-04, Jak 2's poster once its class 1 race is won (the end of its story).
      "particles": {
        // the part spawners of every district, each placed in its district's level
        // no max_vis_dist: every spawner keeps Jak 2's vis-dist (the city's signs 384m, the port's
        // 600m). Phase 15b capped the districts' at 150m (Jak 2's levels culled them with their
        // visibility data, the port's have none): the signs vanished well before Jak 2's
        "levels": ["ctywide", "ctysluma", "ctyslumb", "ctyslumc", "ctyport", "ctymarka", "ctymarkb", "ctyinda", "ctyindb", "ctygena", "ctygenb", "ctygenc", "ctyfarma", "ctyfarmb", "ctypal", "stadium", "garage"],
        "files": [
          "goal_src/jak2/levels/city/ctywide-part.gc",
          "goal_src/jak2/levels/city/slums/ctysluma-part.gc",
          "goal_src/jak2/levels/city/slums/ctyslumb-part.gc",
          "goal_src/jak2/levels/city/slums/ctyslumc-part.gc",
          "goal_src/jak2/levels/city/slums/neon-baron-part.gc",
          "goal_src/jak2/levels/city/port/ctyport-part.gc",
          "goal_src/jak2/levels/city/market/ctymarka-part.gc",
          "goal_src/jak2/levels/city/market/ctymarkb-part.gc",
          "goal_src/jak2/levels/city/industrial/ctyinda-part.gc",
          "goal_src/jak2/levels/city/industrial/ctyindb-part.gc",
          "goal_src/jak2/levels/city/generic/ctygena-part.gc",
          "goal_src/jak2/levels/city/generic/ctygenb-part.gc",
          "goal_src/jak2/levels/city/generic/ctygenc-part.gc",
          "goal_src/jak2/levels/city/generic/neon-praxis-part.gc",
          "goal_src/jak2/levels/city/farm/ctyfarma-part.gc",
          "goal_src/jak2/levels/city/farm/ctyfarmb-part.gc",
          "goal_src/jak2/levels/city/farm/ctyfarm-obs.gc",
          "goal_src/jak2/levels/city/palace/ctypal-part.gc",
          "goal_src/jak2/levels/stadium/stadium-part.gc",
          "goal_src/jak2/levels/city/ctywide-obs.gc"
        ],
        "textures_from": ["GAME", "ctywide", "ctysluma", "ctyslumb", "ctyslumc", "ctyport", "ctymarka", "ctymarkb", "ctyinda", "ctyindb", "ctygena", "ctygenb", "ctygenc", "ctyfarma", "ctyfarmb", "ctypal", "stadium"],
        "target_textures": [["waswide", "waswide-sprite", ["wood-plain-debris", "clay-pot-debris-01", "rope-mesh-debris-01", "basket-debris-01", "straw-bit", "straw-ground", "cotton-wrap-debris", "cherry", "fruit1"]], ["ctyfarma", "ctyfarma-sprite", ["ctyfarm-cab-body", "ctyfarm-chili-leaf", "ctyfarm-chili-stem", "ctyfarm-eggplant-body", "ctyfarm-eggplant-leaf-1", "ctyfarm-eggplant-leaf-2"]], ["wasall", "wasall-minimap", ["hud-small-vehicle-health-bar-01"]]],
        "source_textures": [["ctypal-minimap", ["map-ctypala", "map-ctypalb"]], ["ctygena-minimap", ["map-ctygena"]], ["ctygenb-minimap", ["map-ctygenb"]], ["ctygenc-minimap", ["map-ctygenc", "map-ctyfarma"]], ["ctyinda-minimap", ["map-ctyinda"]], ["ctyindb-minimap", ["map-ctyindb"]], ["stadium-minimap", ["map-stadium"]], ["ctymarka-minimap", ["map-ctymarka", "map-ctyfarmb"]], ["ctymarkb-minimap", ["map-ctymarkb"]], ["ctyport-minimap", ["map-ctyporta", "map-ctyportb", "map-ctyportc", "map-ctyportd", "map-ctyporte", "map-ctyportf"]], ["ctysluma-minimap", ["map-ctysluma"]], ["ctyslumb-minimap", ["map-ctyslumb"]], ["ctyslumc-minimap", ["map-ctyslumc"]]],
        "page": 1566,
        "parts": [1200, 2600], "groups": [300, 800],
        "base_aid": 45000,
        "ported_callbacks": {"birth-func-ctywide-baron-propoganda-ticker-rotate": "hj2-birth-func-baron-ticker-rotate", "birth-func-race-poster": "hj2-birth-func-race-poster"},
        "callbacks_file": "particle-callbacks.gc",
        "data": {"*baron-neon-skull*": "*hj2-baron-neon-skull*", "*praxis*": "*hj2-praxis*", "*praxis-backing*": "*hj2-praxis-backing*", "*hiphog-exterior-marquee*": "*hj2-hiphog-exterior-marquee*"},
        // part_specs: init-specs replaced in Jak 2's parts (by its part id). The halo around the
        // Baron's hologram over his speakers (819, a 10m glow) and the projector's flare (822),
        // red and orange in Jak 2, are blue; so is the Baron's logo (818 and its flicker 821): its
        // texture is grey, Jak 2's red came from these colors, here Jak 2's with red and blue swapped
        "part_specs": {"819": {":r": ["32.0", "64.0"], ":g": [":copy", "r"], ":b": ["255.0"]}, "822": {":r": ["0.0", "64.0"], ":g": ["64.0", "64.0"], ":b": ["255.0"]}, "818": {":r": ["0.0", "64.0"], ":g": [":copy", "r"], ":b": ["192.0"]}, "821": {":r": ["16.0"], ":g": ["32.0"], ":b": ["255.0"]}},
        "group_arrays": {"*city-baron-group-ids*": "*hj2-baron-group-ids*", "*city-neon-praxis-group-ids*": "*hj2-neon-praxis-group-ids*", "*hiphog-exterior-marquee-group-ids*": "*hj2-hiphog-marquee-group-ids*"},
        "extra_groups": {"group-ctywide-baron-propoganda-holo": "*hj2-propa-holo-group-ids*", "group-farm-marrow-explode": "*hj2-farm-marrow-explode-group-ids*", "group-farm-beetree-explode": "*hj2-farm-beetree-explode-group-ids*", "group-farm-cabbage-explode": "*hj2-farm-cabbage-explode-group-ids*", "group-farm-small-cabbage-explode": "*hj2-farm-small-cabbage-explode-group-ids*", "group-farm-chilirots-explode": "*hj2-farm-chilirots-explode-group-ids*", "group-farm-sprinkler-barrels-water": "*hj2-farm-sprinkler-water-group-ids*", "group-cty-guard-turret-hit": "*hj2-cty-guard-turret-hit-group-ids*"},
        "sign_actors": {"neon-baron": "hj2-neon-baron", "city-neon-praxis": "hj2-neon-praxis", "hiphog-exterior-marquee": "hj2-hiphog-marquee"}
      }
