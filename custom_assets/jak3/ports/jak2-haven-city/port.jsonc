  },

  // Regions: Jak 2 region ids are unique over the whole game; ours are offset past the water
  // regions. Per region, tasks taken as not done yet, to pick another of Jak 2's branches: 528, the
  // palace pillar elevator goes to the roof first (elevators), so passing this plane on the way up
  // loads the roof, like before the sneak-in mission. Region script changes: Keira's garage has no
  // doors (their on-enter showed it), the region that loads it shows it.
  "region_id_offset": 1000,
  "region_open_tasks": {"528": ["palace-sneak-in-introduction"]},
  "region_script_overrides": {"319": {"on-enter": "(begin (want-load 'havenj2 'hj2-garage) (want-display 'hj2-garage 'display))"}},

  // Continue points. Our names: hj2-<Jak 2 name>, but havenj2-start (ctysluma-start). The places
  // get all of Jak 2's continues of their levels (the respawn points, see havenj2-update-continue in
  // GAME), but the title, intro, new game, demo and cutscene ones:
  //   kept:  kept anyway: the destinations of the warp gates (the mountain's, the dig's to Vin's
  //          room) and of the port's air train
  //   wants: a continue's level list, when Jak 2's doesn't suit: palshaft-lobby's is for the
  //          sneak-in mission, with the city unloaded; here the lobby gate opens on it
  //   door_continues: continues Jak 2 doesn't have, for the Mods menu's key places: in front of a
  //          door, facing it (distance in meters): the airlock of the palace's cable pillar
  //   new_continues: the time gate's arrival point in the hideout, in front of its gate, facing
  //          away from it (Jak jumps out of the gate: warp-gate)
  //   target_continues: continues of Jak 3 levels, defined in the level-info file for GAME: the
  //          Freedom HQ's arrival point from the hideout's time gate, with Jak 3's freehq-start
  //          level list and sounds
  "continues": {
    "prefix": "hj2-",
    "names": {"ctysluma-start": "havenj2-start"},
    "kept": ["caspad-warp", "mountain-warp-bottom", "mountain-warp-top", "vinroom-warp"],
    "wants": {"palshaft-lobby": [["palshaft", "'display"], ["ctypal", "#f"]]},
    "door_continues": {"cable-pillar": {"level": "ctygenb", "door": "com-airlock-outer-15", "distance": 8.0, "wants": [["ctywide", "'display"], ["ctygenb", "'display"]]}},
    "new_continues": {"hideout-gate": {"level": "hideout", "pos": [1207.0, 3.1, 53.0], "facing": [-0.722, 0.692], "distance": 6.0, "flags": ["warp-gate"], "wants": [["hideout", "'display"], ["ctywide", "'display"], ["ctysluma", "'display"]]}},
    "target_continues": [
      {"name": "hj2-freehq-gate", "var": "*hj2-freehq-gate-continue*", "level": "freehq", "pos": [710.0, 80.338, -565.0], "facing": [-0.908, 0.418], "distance": 6.0, "flags": ["no-auto"], "wants": [["freehq", "'display"], ["ctyslumc", "#f"], ["freecast", "'special"]], "want_sound": ["cityhq1", "cityhq2", "ctyslmch"], "comment": ["the Freedom HQ's arrival point from Jak 2's hideout (its time gate), in front of the HQ's", "gate (GAME adds it to freehq's continues)"]}
    ]
  }
}
