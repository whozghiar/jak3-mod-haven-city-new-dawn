    "hj2-farthy": {"model": "hj2-farthy", "rip": "ctyport/mecha-daxter-lod0.glb", "prims": null, "collide": null},
    // Jak 2's Crimson Guard bike in the city's traffic (hj2-guard-bike, havenj2-traffic.gc; in
    // havenj2's "models"). Jak 3 has no crimson-bike art: rebuilt from a Jak 2 rip, joints kept
    // (the turret turns joint 4). Primitives 5-10: the intact rear and front, 18-21: the body and
    // seat (0-1 and 2-4: the broken rear and front, 11-13 and 14-17: the damaged ones; Jak 2 swaps
    // them with setup-masks, build-actor models have no mask table). Its collision is the class's
    // spheres
    "hj2-guard-bike": {"model": "hj2-guard-bike", "rip": "lwideb/crimson-bike-lod0.glb", "prims": [5, 6, 7, 8, 9, 10, 18, 19, 20, 21], "collide": null}
  },

  // Regions: Jak 2 region ids are unique over the whole game; ours are offset past the water
  // regions. Per region, tasks taken as not done yet, to pick another of Jak 2's branches: 528, the
  // palace pillar elevator goes to the roof first (elevators), so passing this plane on the way up
  // loads the roof, like before the sneak-in mission. Region script changes: Keira's garage has no
  // doors (their on-enter showed it), the region that loads it shows it, and 776 (the camera volume
  // around the garage, which makes it Jak's level) shows it too as the camera enters (the doors'
  // on-enter: swapped in if a script dropped it) and makes the stadium grounds Jak's level again
  // as the camera leaves (else the garage stayed Jak's level outside, the district guard off).
  // 894 (the top of the mountain temple's gully): starts and stops the avalanche (the translator drops its 'draw events).
  // 436 (Haven Forest, the way to its far end): loads hj2-forstb (the mother tree and the
  // Precursor stone head) and shows it at once; Jak 2 only shows it when the camera crosses the
  // small face 434, which the camera can miss. 489 (the port's corridor to the farm, a camera face
  // every way there crosses): also loads hj2-farmb (Jak 2's loading face 487 can be walked around,
  // the farm then loaded too late). 317 (the stadium's race track, the camera face at its entrance):
  // also makes the track Jak's level (want-vis, like Jak 2's garage region 776) and back: Jak 2
  // never names it, and the track's tunnels run under the main town, on its street squares, so the
  // district guard took Jak for being there and loaded the main town over the track.
  "region_id_offset": 1000,
  "region_open_tasks": {"528": ["palace-sneak-in-introduction"]},
  "region_script_overrides": {"489": {"on-enter": "(begin (want-load 'havenj2 'hj2-port 'hj2-farmb) (want-display 'hj2-farmb 'display))"}, "436": {"on-enter": "(begin (want-load 'hj2-forest 'hj2-forstb) (want-display 'hj2-forstb 'display))"}, "429": {"on-enter": "(send-event \"pal-rot-gun-1\" 'trigger)", "on-exit": "(send-event \"pal-rot-gun-1\" 'untrigger)"}, "319": {"on-enter": "(begin (want-load 'havenj2 'hj2-stdm 'hj2-garage) (want-display 'hj2-garage 'display))"}, "776": {"on-enter": "(want-display 'hj2-garage 'display)", "on-exit": "(want-vis 'hj2-stdm)"},"317": {"on-enter": "(begin (want-display 'hj2-stadd 'display) (want-vis 'hj2-stadd))", "on-exit": "(begin (want-display 'hj2-stadd #f) (want-vis 'hj2-stdm))"}, "894": {"on-enter": "(send-event \"mtn-aval-rocks-4\" 'draw #t)", "on-exit": "(begin (send-event \"mtn-aval-rocks-4\" 'draw #f) (want-continue \"hj2-mountain-top\"))"}, "177": {"on-enter": "(send-event \"gun-buoy-1\" 'kill-player)"}, "353": {"on-enter": "(send-event \"gun-buoy-1\" 'kill-player)"}, "873": {"on-enter": "(send-event \"gun-buoy-1\" 'kill-player)"}},

  // Continue points. Our names: hj2-<Jak 2 name>, but havenj2-start (ctysluma-start). The places
  // get all of Jak 2's continues of their levels (the respawn points, see havenj2-update-continue in
  // GAME), but the title, intro, new game, demo and cutscene ones:
  //   kept:  kept anyway: the destinations of the warp gates (the mountain's, the dig's to Vin's
  //          room) and of the port's air train
  //   wants: a continue's level list, when Jak 2's doesn't suit: palshaft-lobby's is for the
  //          sneak-in mission, with the city unloaded; here the lobby gate opens on it
  //   door_continues: continues Jak 2 doesn't have, for the Mods menu's key places: in front of a
  //          door, facing it (distance in meters): the airlock of the palace's cable pillar
  //   new_continues: the time gate's arrival point in the hideout, in front of its gate, facing
  //          away from it (Jak jumps out of the gate: warp-gate)
  //   target_continues: continues of Jak 3 levels, defined in the level-info file for GAME: the
  //          Freedom HQ's arrival point from the hideout's time gate, with Jak 3's freehq-start
  //          level list and sounds
  "continues": {
    "prefix": "hj2-",
    "names": {"ctysluma-start": "havenj2-start"},
    "kept": ["caspad-warp", "mountain-warp-bottom", "mountain-warp-top", "vinroom-warp"],
    "wants": {"palshaft-lobby": [["palshaft", "'display"], ["ctypal", "#f"]]},
    "door_continues": {"cable-pillar": {"level": "ctygenb", "door": "com-airlock-outer-15", "distance": 8.0, "wants": [["ctywide", "'display"], ["ctygenb", "'display"]]}},
    "new_continues": {"hideout-gate": {"level": "hideout", "pos": [1207.0, 3.1, 53.0], "facing": [-0.722, 0.692], "distance": 6.0, "flags": ["warp-gate"], "wants": [["hideout", "'display"], ["ctywide", "'display"], ["ctysluma", "'display"]]}},
    "target_continues": [
      {"name": "hj2-freehq-gate", "var": "*hj2-freehq-gate-continue*", "level": "freehq", "pos": [710.0, 80.338, -565.0], "facing": [-0.908, 0.418], "distance": 6.0, "flags": ["no-auto"], "wants": [["freehq", "'display"], ["ctyslumc", "#f"], ["freecast", "'special"]], "want_sound": ["cityhq1", "cityhq2", "ctyslmch"], "comment": ["the Freedom HQ's arrival point from Jak 2's hideout (its time gate), in front of the HQ's", "gate (GAME adds it to freehq's continues)"]}
    ]
  }
}
