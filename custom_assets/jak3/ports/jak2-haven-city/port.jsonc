  // the ported classes placed in every level, not only in ported_levels: the swinging bars (Jak 3's
  // swingpole, the bar itself is background) and the slides (Jak 3's slide-control, target-tube.gc).
  // Jak 2's crates are placed in every level too (as Jak 3's wood crates, with their pickups).
  "ported_everywhere": ["slide-control", "swingpole"],

  // Models rebuilt from Jak 2's rips for build-actor (custom_assets/jak3/models/custom_levels/
  // <model>.glb, built by goal_src/jak3/game.gp), by the class that uses them:
  //   rip:     decompiler_out/jak2/levels/<rip>
  //   prims:   the primitives kept (null: all)
  //   collide: null for a box around the model; {"hull": y}: the convex hull of the vertices above
  //            y (null: all), below y_max if given; or a list of meshes, each a list of boxes
  //            [lo, hi] (the model's space), {"hull": y, "joint": name} (the hull of that joint's
  //            part, moved with it) or {"joint_box": name} (the box around that joint's part)
  //   anims:   the animations kept instead of the rip's first: [rip, animation, our name]
  //   extras:  models of their own drawn with it (no actor)
  // Jak 2's com-elevator: a 12 x 13m platform, floor at its origin's height, from 0.85m behind its
  // origin to 12m in front; its collision: the floor, and a fence along its edges that is only
  // solid during the ride (Jak 3's elevator fence, prim id #xfe000000), so Jak can walk on it without
  // falling between it and the shaft. The cpad-elevator (castle pad down to the dig): 24 x 24m, the
  // same way. The palace gate: a box around its sliding door, bound to the door joint.
  "models": {
    "hj2-palace-door": {"model": "hj2-palace-door", "rip": "ctypal/palace-door-lod0.glb", "prims": null, "collide": [{"joint_box": "door"}]},
    "hj2-elevator": {"model": "hj2-com-elevator", "rip": "palshaft/com-elevator-lod0.glb", "prims": [0, 1, 2, 3, 4], "collide": [[[[-6.0, -1.0, -0.85], [6.0, 0.0, 12.0]]], [[[-6.0, 0.0, -0.85], [-5.7, 3.0, 12.0]], [[5.7, 0.0, -0.85], [6.0, 3.0, 12.0]], [[-6.0, 0.0, -0.85], [6.0, 3.0, -0.55]], [[-6.0, 0.0, 11.7], [6.0, 3.0, 12.0]]]]},
