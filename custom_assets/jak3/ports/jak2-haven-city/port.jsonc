{
  // The jak2-haven-city port: Jak 2's Haven City and the places around it, as Jak 3 custom
  // levels. Every level file of the mod is generated from Jak 2's extracted data by
  //   python scripts/level_port custom_assets/jak3/ports/jak2-haven-city/port.jsonc
  // (from the repository root, after a Jak 2 and a Jak 3 extraction). A fix goes here, never in
  // a generated file. What each key means: scripts/level_port/README.md; the mod itself:
  // docs/modding/current_mod/jak2_haven_city_readme.md.
  "name": "jak2-haven-city",
  "source_game": "jak2",
  "target_game": "jak3",
  // the mark of the mod's edits and generated files, and the prefix of what the port names
  // (continues, particle groups and callbacks; the GAME code defines <prefix>sprite-page-new and
  // <prefix>sprite-page-register, jak2-haven-city-world.gc)
  "tag": "og:jak2-haven-city",
  "prefix": "hj2-",
  "paths": {
    "levels": "custom_assets/jak3/levels",
    "models": "custom_assets/jak3/models/custom_levels",
    // the levels' code (particles, ocean maps, height map are generated there)
    "code": "goal_src/jak3/levels/havenj2"
  },

  // The story state every level is in: the end of the game, but for these story nodes, taken as
  // still open (the palace stays reachable: Jak 2 closes its doors once this mission is over).
  // It decides which of Jak 2's actors are placed (their kill-mask), the background prototypes
  // shown and the branches of Jak 2's scripts.
  "story": {"state": "end", "open_tasks": ["palace-sneak-in-meeting"]},

  // the goalc build steps of the levels (goal_src/jak3/game.gp loads this file): their models, their
  // level code and the levels. A level code object depends on the GAME code of the mod
  // (default_deps), or on what code_deps says: the city's signs, obs and farm code build on its
  // particles in turn, its height map on Jak 3's height-map-h, its traffic on Jak 3's city speech;
  // the dig's lava platforms are Jak 3's rigid-body-platform (rigid-body-plat.o, the volcano's)
  "build": {
    "file": "goal_src/jak3/levels/havenj2/jak2-haven-city.gp",
    "default_deps": ["jak2-haven-city-world"],
    "code_deps": {
      "havenj2-signs": ["havenj2-part"],
      "havenj2-obs": ["havenj2-signs"],
      "havenj2-farm": ["havenj2-obs"],
      "havenj2-height-map": ["height-map-h"],
      "havenj2-traffic": ["ctywide-speech", "jak2-haven-city-world"],
      "hj2-dig-obs": ["jak2-haven-city-world", "rigid-body-plat"]
    }
  },

  // the level-load-infos and continue points of every level, in GAME (known at boot: warps, saves)
  "level_info": {
    "file": "goal_src/jak3/pc/features/jak2-haven-city-levels.gc",
    "comment": [
      "The level-load-info of havenj2 (Jak 2's Haven City) and of the places reached from it,",
      "with their continue points taken from Jak 2's. They're in GAME so the continues are known",
      "at boot (warps, saves). Moods and callbacks: jak2-haven-city-world.gc."
    ],
    "levels_var": "*havenj2-levels*",
    "levels_var_comment": "every level of this mod (the clock stays as set while one of them is active)"
  },
  // the level-load-info of a level, unless it says otherwise: its level callbacks (GAME,
  // jak2-haven-city-world.gc), draw priority; its mood is update-mood-<level>
  "level_defaults": {"level_info": {"callbacks": [[35, "hj2-place-activate"], [36, "hj2-place-deactivate"]], "draw_priority": "10.0"}},
  // the ocean map of the levels whose "ocean" is true (havenj2-ocean.gc, in GAME)
  "ocean_map": "*ocean-map-havenj2*",

  // The levels: each one merges its "sources" (Jak 2 levels: its own, then the ones merged into
  // it) and keeps Jak 2's world coordinates, so none can be loaded with Jak 3's city levels.
  //   nick, iso, index: the level's nickname (its DGO is <NICK>.DGO), ISO name and level index
  //   base_id:  its actor and region ids (1000 per level, past every other custom level's)
  //   memory:   a fixed level-memory-mode; else Jak 2's, made to fit Jak 3's level heap with
  //             the levels it's loaded with (the levels step prints the changes)
  //   sky:      Jak 2's :sky (the sky is only drawn when an active level has it); outdoor
  //   ocean:    true for the city's ocean map, or the name of the level's own (ocean_source)
  //   code:     objects of its DGO after the art groups: the level code (goal_src/jak3/levels/
  //             havenj2, built by game.gp)
  //   collision_bounds: [xmin, ymin, zmin, xmax, ymax, zmax] meters, the collision kept: the
  //             backdrops of some places spread over kilometers, collision included, and would
  //             blow the collide hash grid up
  "levels": [
    {
      // Jak 2's whole city: its 14 districts, ctywide and the stadium grounds (Jak 2 loaded them
      // next to its streets like the others). Its .jsonc is written by hand but for its GENERATED
      // section. The palace pillars (palshaft) are a level of their own, hj2-pshaft, like in Jak 2.
      "name": "havenj2", "nick": "hj2", "index": "0x129",
      "what": "Jak 2's Haven City",
      "jsonc": "section",
      // always shown while Jak is in it: Jak 2's scripts showing or hiding its districts are dropped
      "shown": true,
      "sources": ["ctywide", "ctysluma", "ctyslumb", "ctyslumc", "ctyport", "ctymarka", "ctymarkb", "ctyinda", "ctyindb", "ctygena", "ctygenb", "ctygenc", "ctyfarma", "ctyfarmb", "ctypal", "stadium"],
      "memory": "large",
      "sky": true,
      "ocean": "*ocean-map-havenj2*",
      // Jak 2's crates of the city aren't placed
      "ported_actors": false,
      // the playable collision with a margin, up to the top of the palace pillars. Drops ctywide's
      // backdrop mountains (x < -3000m, up to 1500m high), unreachable
      "collision_bounds": [-700, -200, -1000, 1400, 470, 2150],
      // its continues (Jak 2 names): every district's own, the mission starts (burning bushes, well
      // spread over the streets), the stadium's and ours (continues.door_continues).
      // ctysluma-start (havenj2-start) stays first: the Mods menu warp uses it.
      "continues": ["ctysluma-start", "ctysluma-alley", "ctyslumb-start", "ctyslumb-fort", "ctyslumc-start", "ctyslumc-slums", "ctyport-start", "ctyport-hiphog", "ctyport-gungame", "ctyport-warp", "ctyport-under", "ctyfarma-start", "ctyfarmb-start", "ctyinda-start", "ctyinda-vinroom", "ctyinda-consite", "ctyindb-start", "ctymarka-brutter", "ctymarkb-tanker", "ctypal-shaft", "ctypal-tomb", "ctygena-start", "ctygenb-start", "ctygenc-start", "ctysluma-burning-bush", "ctyslumb-burning-bush", "ctyslumb-burning-bush-2", "ctyslumc-burning-bush", "ctyport-burning-bush", "ctyport-burning-bush-3", "ctyfarma-burning-bush", "ctyfarmb-burning-bush", "ctyinda-burning-bush", "ctyindb-burning-bush", "ctymarka-burning-bush", "ctymarkb-burning-bush", "ctymarkb-burning-bush-2", "ctypal-burning-bush", "ctypal-burning-bush-2", "ctygena-burning-bush", "ctygena-burning-bush-2", "ctygenb-burning-bush", "ctygenb-burning-bush-2", "ctygenc-burning-bush", "ctygenc-burning-bush-2", "stadium-start", "stadium-burning-bush", "cable-pillar"],
      // the code of its signs, palace gate, speakers and crops, after its traffic and props
      "code": ["havenj2-part.o", "havenj2-signs.o", "havenj2-obs.o", "havenj2-farm.o"],
      // built for it first (the palace gate, havenj2-obs.gc)
      "models": ["hj2-palace-door"],
      "level_info": {
        "callbacks": [[33, "havenj2-login"], [34, "havenj2-logout"], [35, "havenj2-activate"], [36, "havenj2-deactivate"]],
        "draw_priority": "9.0",
        "part_engine_max": 255,
        "comment": [
          "Jak 2's whole Haven City as one custom level (custom_assets/jak3/levels/havenj2). Kept at",
          "Jak 2's world coordinates, so it must never be loaded together with Jak 3's own city levels.",
          "sky: the sky is only drawn when an active level has this flag.",
          "part-engine-max: the static particles of Jak 2's lights (x16, see part-spawner).",
          "login/logout: the traffic engine, in havenj2's own code (havenj2-traffic.gc)."
        ]
      },
      // the pools of the palace plaza and the stadium (Jak 2's water-anim actors): their water
      // regions (havenj2-water-regions.json), their surfaces in havenj2-mesh.glb. Region 1 is the
      // city-wide ocean region; per *water-anim-look* index, the pool's mesh and the water flags of
      // its region (null: a surface only, e.g. a fountain's top basin Jak 2 gave no water). The
      // three fountains of the stadium grounds: Jak 2 only had water (wading, no swimming) in the
      // middle and floor ones. Pools are at most 2m deep.
      "water": {
        "ocean_region": {"center": [350.0, 0.0, 575.0], "radius": 1950.0},
        "below": 3.0, "above": 2.0,
        "pools": [
          {"level": "ctypal", "etype": "water-anim-ctypal", "looks": {"29": ["water-anim-ctypal-lrgsqr-pool", "(swim wade)"], "30": ["water-anim-ctypal-smlsqr-pool", "(swim wade)"], "31": ["water-anim-ctypal-lrgfloor-pool", "(swim wade)"], "32": ["water-anim-ctypal-smlground-pool", "(swim wade)"], "33": ["water-anim-ctypal-middle-fountain", "(swim wade)"], "34": ["water-anim-ctypal-long-grnd-pool", "(swim wade)"]}},
          {"level": "stadium", "etype": "water-anim-stadium", "looks": {"16": ["water-anim-stadium-middle-pool", "(wade)"], "17": ["water-anim-stadium-top-fountain", null], "18": ["water-anim-stadium-floor-pool", "(wade)"]}}
        ]
      },
      // Jak 2's static props of the city that aren't actors here, and the pools' surfaces, as one
      // mesh (havenj2-mesh.glb, its gltf_file). Per Jak 2 class: its collision ("box", "post" for
      // poles with a head like street lamps, null: none) and its pat material (0 stone, 6 wood, 16
      // metal). The palace plaza at the end of the game (Mar's tomb found): the Baron's statue
      // broken on the plaza, the wall under it broken; Jak 2's broken statue has no collision, the
      // broken wall's collide mesh isn't in the rip, and a box would shut the tomb's way through it.
      // Not kept: the market props, farm crops and propaganda speakers, which are actors (props,
      // custom_props), the force-field walls (open or shut with the story), the searchlights and
      // guard turrets (they move, the turrets hide underground), and the cutscene or mission actors.
      // The palettes: the city's background palettes have their ambient around 110/255 and their
      // sun palettes up to about 100.
      "mesh": {
        "props": {"yakow": ["box", 0], "ctyn-lamp": ["post", 16], "burning-bush": [null, null], "lurker-pipe-lid": [null, null], "barons-ship-lores": [null, null], "ctypal-baron-statue-broken": [null, null], "ctypal-broke-wall": [null, null]},
        "post_width": 0.6,
        "palette": {"ambient": 110.0, "sun": 100.0}
      },
      // Jak 2's city navigation: the districts' traffic data merged over one grid of 50m cells,
      // their nav meshes (havenj2-nav.json, its nav_data), and Jak 2's traffic height map (how
      // high the city's vehicles fly: havenj2-height-map.gc, in place of Jak 3's)
      "nav": {
        "cell": 50.0,
        "outside_depth": 10000.0,
        "height_map": {"source": "goal_src/jak2/levels/city/traffic/traffic-height-map.gc"}
      },
      // the traffic (levels/havenj2/havenj2-traffic.gc): Jak 3's traffic code, the objects of
      // ctywide's DGO but those of Jak 3's city itself (its props, particles, missions, scenes, trail
      // graph and height map), which havenj2's DGO links in the same order; and the art of the
      // traffic types havenj2 spawns: Jak 3's citizens, Freedom League guards and their shields, the
      // city's hover cars and bikes, their pilots, the vehicles' explosion and Jak's animations in a
      // vehicle
      "traffic": {
        "code_from": "goal_src/jak3/dgos/cwi.gd",
        "skip": ["ctyport-obs", "ctywide-obs", "ctywide-part", "ctywide-scenes", "ctywide-tasks", "ctywide-texture", "krimson-wall", "mhcity-obs", "mhcity-obs2", "mhcity-part", "searchlight", "traffic-height-map", "trail", "trail-graph"],
        "replace": {"traffic-height-map": "havenj2-height-map"},
        "code": ["havenj2-traffic.o"],
        "art": ["citizen-norm-ag", "citizen-fat-ag", "citizen-chick-ag", "crimson-guard-ag", "shield-sphere-ag", "shield-sphere-distort-ag", "shield-sphere-explode-ag", "cara-ag", "carb-ag", "carc-ag", "bikea-ag", "bikeb-ag", "bikec-ag", "citizen-norm-rider-ag", "vehicle-explosion-ag", "jak-pilot+0-ag", "jak-pilot-hcar+0-ag", "jak-pilot-gun+0-ag"]
      },
      // Jak 2's market props and farm crops as actors, with Jak 3's classes and models: Jak 3's own
      // Haven City reuses them (their art ships in Jak 3's DGOs, their code in Jak 3's level code).
      // The crops have Jak 3's art (it still has Jak 2's burst models) and Jak 2's behavior
      // (havenj2-farm.gc). Jak 2 turned its crops to a random angle when they spawned.
      "props": {
        "etypes": {"market-crate": ["market-crate", "market-crate-ag"], "market-basket-a": ["market-basket-a", "market-basket-a-ag"], "market-basket-b": ["market-basket-b", "market-basket-b-ag"], "market-sack-a": ["market-sack-a", "market-sack-a-ag"], "market-sack-b": ["market-sack-b", "market-sack-b-ag"], "cty-fruit-stand": ["fruit-stand", "cty-fruit-stand-ag"], "farm-marrow": ["hj2-farm-marrow", "farm-marrow-ag"], "farm-beetree": ["hj2-farm-beetree", "farm-beetree-ag"], "farm-chilirots": ["hj2-farm-chilirots", "farm-chilirots-ag"], "farm-cabbage": ["hj2-farm-cabbage", "farm-cabbage-ag"], "farm-small-cabbage": ["hj2-farm-small-cabbage", "farm-small-cabbage-ag"], "farm-sprinkler-barrels": ["farm-sprinkler-barrels", "farm-sprinkler-barrels-ag"]},
        "code": ["ctymark-obs-h.o", "ctymark-obs.o", "ctyfarm-obs.o"],
        "random_yaw": ["farm-beetree", "farm-cabbage", "farm-chilirots", "farm-marrow", "farm-small-cabbage"],
        "base_aid": 40000
      },
      // Jak 2's propaganda speaker: rebuilt from its model, placed with hj2-propa (havenj2-obs.gc).
      // Jak 2 switches its looks with setup-masks (intact: primitives 3 and 4, damaged: 1 and 2,
      // broken: 0, the stump); build-actor models have no mask table, so each look is a model of its
      // own, drawn by a child process.
      "custom_props": {
        "etypes": {"propa": {"etype": "hj2-propa", "rip": "ctywide/propa-lod0.glb", "prims": [3, 4], "looks": [["hj2-propa-damaged", [1, 2]], ["hj2-propa-broken", [0]]]}},
        "base_aid": 44000
      },
      // Jak 2's particle effects of the city: signs and posters, neon signs, street lights and
      // glows, chimney smoke, steam, fountains, drips, fires, the Baron's propaganda holograms...
      // (havenj2-part.gc). Its texture page (1566): a texture-page-dir entry Jak 3 never uses,
      // under 2048 so that its texture ids stay positive in the int32 and binteger arrays of the
      // particle data. Its ids: Jak 3's GAME takes parts up to 899 and groups up to 221, the Jak 3
      // level code in havenj2 more (ctymark-obs: parts 1117-1162, groups 248-253; ctyfarm-obs:
      // parts 4001-4047, groups 1134-1145; the traffic's vehicle-part: parts 916-952, groups
      // 224-225; cty-guard-projectile: parts 1163-1164, group 254). The rest is free while
      // havenj2 is loaded: no Jak 3 level can be. Past these ranges are the places' ranges.
      // target_textures: the sprite pieces of Jak 3's market and farm props (breaking crates,
      // pots, crops, the fruit stands' fruit), which Jak 3 takes from its own city levels' sprite
      // pages (hj2-prop-textures-on in jak2-haven-city-world.gc finds them by name), and the health
      // bar of the vehicle Jak drives (vehicle-hud.gc finds it by name).
      // The neon signs (neon-baron...) are hj2- types of havenj2-signs.gc, with their data arrays;
      // extra_groups: the Baron's hologram over his speakers (hj2-propa), the mission kiosks'
      // hologram (burning-bush, shown off), the farm crops bursting and the sprinklers' water.
      "particles": {
        "files": [
          "goal_src/jak2/levels/city/ctywide-part.gc",
          "goal_src/jak2/levels/city/slums/ctysluma-part.gc",
          "goal_src/jak2/levels/city/slums/ctyslumb-part.gc",
          "goal_src/jak2/levels/city/slums/ctyslumc-part.gc",
          "goal_src/jak2/levels/city/slums/neon-baron-part.gc",
          "goal_src/jak2/levels/city/port/ctyport-part.gc",
          "goal_src/jak2/levels/city/market/ctymarka-part.gc",
          "goal_src/jak2/levels/city/market/ctymarkb-part.gc",
          "goal_src/jak2/levels/city/industrial/ctyinda-part.gc",
          "goal_src/jak2/levels/city/industrial/ctyindb-part.gc",
          "goal_src/jak2/levels/city/generic/ctygena-part.gc",
          "goal_src/jak2/levels/city/generic/ctygenb-part.gc",
          "goal_src/jak2/levels/city/generic/ctygenc-part.gc",
          "goal_src/jak2/levels/city/generic/neon-praxis-part.gc",
          "goal_src/jak2/levels/city/farm/ctyfarma-part.gc",
          "goal_src/jak2/levels/city/farm/ctyfarmb-part.gc",
          "goal_src/jak2/levels/city/farm/ctyfarm-obs.gc",
          "goal_src/jak2/levels/city/palace/ctypal-part.gc",
          "goal_src/jak2/levels/stadium/stadium-part.gc"
        ],
        "textures_from": ["GAME", "ctywide", "ctysluma", "ctyslumb", "ctyslumc", "ctyport", "ctymarka", "ctymarkb", "ctyinda", "ctyindb", "ctygena", "ctygenb", "ctygenc", "ctyfarma", "ctyfarmb", "ctypal", "stadium"],
        "target_textures": [["waswide", "waswide-sprite", ["wood-plain-debris", "clay-pot-debris-01", "rope-mesh-debris-01", "basket-debris-01", "straw-bit", "straw-ground", "cotton-wrap-debris", "cherry", "fruit1"]], ["ctyfarma", "ctyfarma-sprite", ["ctyfarm-cab-body", "ctyfarm-chili-leaf", "ctyfarm-chili-stem", "ctyfarm-eggplant-body", "ctyfarm-eggplant-leaf-1", "ctyfarm-eggplant-leaf-2"]], ["wasall", "wasall-minimap", ["hud-small-vehicle-health-bar-01"]]],
        "page": 1566,
        "parts": [1200, 2600], "groups": [300, 800],
        "base_aid": 45000,
        "ported_callbacks": {"birth-func-ctywide-baron-propoganda-ticker-rotate": "hj2-birth-func-baron-ticker-rotate", "birth-func-race-poster": "hj2-birth-func-race-poster"},
        "callbacks_file": "particle-callbacks.gc",
        "data": {"*baron-neon-skull*": "*hj2-baron-neon-skull*", "*praxis*": "*hj2-praxis*", "*praxis-backing*": "*hj2-praxis-backing*", "*hiphog-exterior-marquee*": "*hj2-hiphog-exterior-marquee*"},
        "group_arrays": {"*city-baron-group-ids*": "*hj2-baron-group-ids*", "*city-neon-praxis-group-ids*": "*hj2-neon-praxis-group-ids*", "*hiphog-exterior-marquee-group-ids*": "*hj2-hiphog-marquee-group-ids*"},
        "extra_groups": {"group-ctywide-baron-propoganda-holo": "*hj2-propa-holo-group-ids*", "group-ctywide-burning-bush-holo-off": "*hj2-burning-bush-holo-group-ids*", "group-farm-marrow-explode": "*hj2-farm-marrow-explode-group-ids*", "group-farm-beetree-explode": "*hj2-farm-beetree-explode-group-ids*", "group-farm-cabbage-explode": "*hj2-farm-cabbage-explode-group-ids*", "group-farm-small-cabbage-explode": "*hj2-farm-small-cabbage-explode-group-ids*", "group-farm-chilirots-explode": "*hj2-farm-chilirots-explode-group-ids*", "group-farm-sprinkler-barrels-water": "*hj2-farm-sprinkler-water-group-ids*"},
        "sign_actors": {"neon-baron": "hj2-neon-baron", "city-neon-praxis": "hj2-neon-praxis", "hiphog-exterior-marquee": "hj2-hiphog-marquee"},
        "kiosks": {"burning-bush": {"group": "group-ctywide-burning-bush-holo-off", "suffix": "-holo", "vis_dist": 819200.0}}
      }
    },
    {
      "name": "hj2-hiphog", "nick": "hjh", "iso": "HJ2HIPHG", "index": "0x12A", "base_id": 21500,
      "what": "the Hip Hog saloon",
      "sources": ["hiphog"],
      "sky": false
    },
    {
      "name": "hj2-gun", "nick": "hjg", "iso": "HJ2GUN", "index": "0x12B", "base_id": 21600,
      "what": "the gun course",
      "sources": ["gungame"],
      "sky": false
    },
    {
      "name": "hj2-vin", "nick": "hjv", "iso": "HJ2VIN", "index": "0x12C", "base_id": 21700,
      "what": "Vin's power station room",
      "sources": ["vinroom"],
      "sky": false
    },
    {
      "name": "hj2-hide", "nick": "hjd", "iso": "HJ2HIDE", "index": "0x12D", "base_id": 21800,
      "what": "the Underground's hideout",
      "sources": ["hideout"],
      "sky": false
    },
    {
      "name": "hj2-oracle", "nick": "hjo", "iso": "HJ2ORACL", "index": "0x12E", "base_id": 21900,
      "what": "the Oracle",
      "sources": ["oracle"],
      "sky": false
    },
    {
      "name": "hj2-garage", "nick": "hjk", "iso": "HJ2GARAG", "index": "0x12F", "base_id": 22000,
      "what": "Keira's garage, behind the stadium grounds",
      "sources": ["garage"],
      "sky": false
    },
    {
      // Dead Town, with the Sage's hut at its far end: Jak 2's continues load the hut with Dead Town
      // (shown 'special: drawn, not a level Jak is in), so they're one level here. Its sea is
      // Jak 2's own ocean map (hj2-ruins-ocean.gc), its beams Jak 2's (hj2-ruins-obs.gc)
      "name": "hj2-ruins", "nick": "hjr", "iso": "HJ2RUINS", "index": "0x131", "base_id": 22200,
      "what": "Dead Town and the Sage's hut, through the slums airlock",
      "sources": ["ruins", "sagehut"],
      "sky": true, "ocean": "*ocean-map-hj2-ruins*",
      "ocean_source": {"file": "goal_src/jak2/levels/ruins/ruins-ocean.gc", "name": "ruins"},
      "code": ["hj2-ruins-ocean.o", "hj2-ruins-obs.o"],
      "particles": {"levels": ["ruins"], "files": ["goal_src/jak2/levels/ruins/ruins-part.gc"], "textures_from": ["GAME", "ruins"], "page": 1627, "parts": [2800, 3000], "groups": [840, 880]}
    },
    {
      "name": "hj2-consb", "nick": "hjb", "iso": "HJ2CONSB", "index": "0x133", "base_id": 22300,
