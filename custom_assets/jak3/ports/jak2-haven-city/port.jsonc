  // Particles of every level (steps/particles.py): the Jak 2 callbacks copied into the level code
  // (renamed hj2-<name>, their part ids moved, Jak 2's matrix argument read as Jak 3's
  // sprite-vec-data-2d), the callbacks of Jak 3's level code the levels include (ctyfarm-obs, in
  // havenj2), and ids never taken (Jak 3's level code in havenj2)
  "particles": {
    "copied_callbacks": ["check-drop-level-ruins-rubble", "check-drop-level-ruins-tower-userdata", "ruins-bird-bob-func", "sparticle-ruins-bird-moon", "palcab-bird-bob-func", "sparticle-palcab-bird-moon", "check-drop-level-atoll-drop", "check-drop-level-dig-lava-bloops", "check-drop-level-forexitb-drop-water-userdata", "check-drop-level-hide-fireplace-sparks", "birth-func-rotate-hour", "birth-func-rotate-minute", "hiphog-mirror-sheen-func", "birth-func-vinroom-sphere", "check-drop-level-kiosk-fire-sparks", "check-bubble-surface-onintent", "check-onintent-bugs", "birth-func-whack-score"],
    "level_callbacks": ["birth-func-ctyfarma-drip", "birth-func-ctyfarmb-drip", "check-farm-piece-ground"],
    // ids of the target game's level code linked with the levels: ctymark-obs (parts 1117-1162,
    // groups 248-253), ctyfarm-obs (parts 4001-4047, groups 1134-1145); "auto" ids start past the
    // fixed ranges of the city and its places
    "reserved": {"parts": [[1117, 1162], [4001, 4047]], "groups": [[248, 253], [1134, 1145]]},
    "auto_start": {"parts": 3000, "groups": 880}
  },

