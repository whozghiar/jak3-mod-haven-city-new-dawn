{
  "mcpServers": {
    "blender-mcp": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ]
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[mcp]",
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    }
  }
}