(set! (-> *hj2-kg-soldier-nav-enemy-info* fact-defaults) *fact-info-enemy-defaults*)

(defmethod init-enemy-collision! ((this hj2-kg-soldier))
  "The soldier's collision (marauder's, with the guard's two body spheres): an enemy that Jak's blows
and shots hit (usually-hit-by-player: the hit-by-others list), solid, 1.5m wide. Sets root."
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> cshape penetrated-by) (penetrate
                                      generic-attack
                                      lunge
                                      flop
                                      punch
                                      spin
                                      roll
                                      uppercut
                                      bonk
                                      tube
                                      flut-attack
                                      board
                                      mech-punch
                                      dark-punch
                                      dark-smack
                                      flut
                                      )
          )
    (let ((group (new 'process 'collide-shape-prim-group cshape (the-as uint 2) 0)))
      (set! (-> cshape total-prims) (the-as uint 3))
      (set! (-> group prim-core collide-as) (collide-spec enemy))
      (set! (-> group prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> group prim-core action) (collide-action solid no-standon))
      (set-vector! (-> group local-sphere) 0.0 8192.0 0.0 10240.0)
      (set! (-> cshape root-prim) group)
      )
    ;; legs, then chest
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-spec enemy))
      (set! (-> prim prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> prim prim-core action) (collide-action solid))
      (set-vector! (-> prim local-sphere) 0.0 6144.0 0.0 6144.0)
      )
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-spec enemy))
      (set! (-> prim prim-core collide-with)
            (collide-spec backgnd jak crate civilian enemy obstacle vehicle-sphere hit-by-others-list player-list pusher)
            )
      (set! (-> prim prim-core action) (collide-action solid no-standon))
      (set-vector! (-> prim local-sphere) 0.0 9830.4 0.0 6144.0)
      )
    (set! (-> cshape nav-radius) 6144.0)
    (let ((root-prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> root-prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> root-prim prim-core collide-with))
      )
    (set! (-> cshape max-iteration-count) (the-as uint 3))
    (set! (-> this root) cshape)
    )
  0
  (none)
  )

(defmethod init-enemy! ((this hj2-kg-soldier))
  "The soldier's model (red, or yellow: 1.1 times bigger and twice the hit points), its enemy settings
on its spawner's nav mesh, and its line of sight to Jak. Called by enemy-init-by-other, after
init-enemy-collision!. Side effect: sets the shared settings' nav-mesh (read by setup-enemy! now)."
  (initialize-skeleton
    this
    (the-as skeleton-group (art-group-get-by-name
                             *level*
                             (if (-> this yellow?)
                                 "skel-hj2-kg-yellow"
                                 "skel-hj2-kg-red"
                                 )
                             (the-as (pointer level) #f)
                             )
            )
    (the-as pair 0)
    )
  (set! (-> *hj2-kg-soldier-nav-enemy-info* nav-mesh) (-> this kg-mesh))
  (setup-enemy! this *hj2-kg-soldier-nav-enemy-info*)
  (when (-> this yellow?)
    (set! (-> this hit-points) (* 2.0 (-> this hit-points)))
    (set-vector! (-> this root scale) 1.1 1.1 1.1 1.0)
    )
  (init-los! (-> this los) this (seconds 0.2) (meters 80) (collide-spec backgnd hit-by-others-list los-blocker))
  (set! (-> this next-burst) 0)
  (none)
  )

(defmethod deactivate ((this hj2-kg-soldier))
  "Counts the soldier out of *hj2-kg-soldier-count* (once: a dead process is deactivated no more),
then the stock clean-up. Returns nothing."
  (if (!= (-> this status) 'dead)
      (+! *hj2-kg-soldier-count* -1)
      )
  ((method-of-type nav-enemy deactivate) this)
  (none)
  )

(defbehavior hj2-kg-soldier-init-by-other hj2-kg-soldier ((spawner process) (params hj2-kg-soldier-init-params))
  "Init of a soldier spawned by its spawner (process-spawn): its nav mesh and look from params, then
Jak 3's enemy init (the place, the model, the settings), and its first state (idle). Side effect:
counts it in *hj2-kg-soldier-count*."
  ;; the suspend stack of a nav-enemy spawned by another process (marauder.gc does the same)
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self kg-mesh) (-> params mesh))
  (set! (-> self yellow?) (-> params yellow?))
  (+! *hj2-kg-soldier-count* 1)
  (enemy-init-by-other (the-as process-drawable spawner) params)
  )

(defun hj2-kg-soldier-fire ((this hj2-kg-soldier))
  "One guard shot from the rifle's muzzle at Jak's body (its focus), up to *hj2-kg-spread* off in x
and y. Side effect: spawns the shot (guard-projectile.gc), which plays its own sound. Returns nothing."
  (let ((foe (as-type (handle->process (-> this focus handle)) process-focusable)))
    (when foe
      (let ((muzzle (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data HJ2_KG_MUZZLE)))
            (back (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data HJ2_KG_GUN_BACK)))
            (aim (new 'stack-no-clear 'vector))
            )
        (vector-copy! aim (get-trans foe 3))
        (+! (-> aim x) (rand-vu-float-range (- *hj2-kg-spread*) *hj2-kg-spread*))
        (+! (-> aim y) (rand-vu-float-range (- *hj2-kg-spread*) *hj2-kg-spread*))
        (spawn-guard-projectile this back aim (meters 200) muzzle)
        )
      )
    )
  (none)
  )

(defbehavior hj2-kg-soldier-try-shoot hj2-kg-soldier ()
  "From the trans of hostile and stare: updates the line of sight to Jak (its focus), and goes to shoot
when he is alive, in range, in sight and the last burst is over. Returns nothing (or doesn't return)."
  (let ((foe (as-type (handle->process (-> self focus handle)) process-focusable)))
    (when (and foe (not (logtest? (-> foe focus-status) (focus-status disable dead ignore grabbed))))
      (los-control-method-9 (-> self los) foe (get-trans foe 3) 819.2 4096.0)
      (if (and (>= (current-time) (-> self next-burst))
               (< (vector-vector-distance (get-trans foe 0) (-> self root trans))
                  *hj2-kg-fire-range*
                  )
               (should-check-los? (-> self los) 0)
               )
          (go-virtual shoot)
          )
      )
    )
  (none)
  )

;; Running after Jak (nav-enemy's hostile: the run clip, chasing on the nav mesh), shooting when it can.
(defstate hostile (hj2-kg-soldier)
  :virtual #t
  :trans (behavior ()
    (hj2-kg-soldier-try-shoot)
    (let ((t9-0 (-> (method-of-type nav-enemy hostile) trans)))
      (if t9-0
          (t9-0)
          )
      )
    )
  )

;; Standing, facing Jak where it can't reach him (nav-enemy's stare: blocked, or Jak off its mesh),
;; shooting when it can.
(defstate stare (hj2-kg-soldier)
  :virtual #t
  :trans (behavior ()
    (hj2-kg-soldier-try-shoot)
    (let ((t9-0 (-> (method-of-type nav-enemy stare) trans)))
      (if t9-0
          (t9-0)
          )
      )
    )
  )

;; A burst: stops, turns to Jak, raises the rifle, fires 2 to 4 shots (one per gun-attack clip),
;; lowers it, then chases again; the next burst comes 1.5 to 3s later. Hits still knock it out of here.
(defstate shoot (hj2-kg-soldier)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self enemy-flags) (enemy-flag lock-focus))
    ;; stand still (no speed, no nav callbacks), turning to Jak (nav-enemy-face-focus-post)
    (nav-enemy-method-178 self)
    (nav-enemy-method-182 self)
    (nav-enemy-method-183 self)
    )
  :exit (behavior ()
    (logclear! (-> self enemy-flags) (enemy-flag lock-focus))
    (set! (-> self next-burst) (+ (current-time) (rnd-time-frame self (seconds 1.5) (seconds 3))))
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.1))
    (ja-no-eval :group! (-> self draw art-group data HJ2_KG_AIM) :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (dotimes (i (+ 2 (rnd-int self 3)))
      (ja-no-eval :group! (-> self draw art-group data HJ2_KG_FIRE) :num! (seek!) :frame-num 0.0)
      (hj2-kg-soldier-fire self)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    (ja-no-eval :group! (-> self draw art-group data HJ2_KG_LOWER) :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (go-hostile self)
    )
  :post nav-enemy-face-focus-post
  )

;; Spawner ///////////////////////////////////////////////////////////////////////////////////////

;; soldier: its soldier (#f: none); pos, quat: the Jak 2 enemy's place and rotation; yellow?: its
;; soldier's look (lump look: 1); done?: its soldier was killed, no other until its level loads again;
;; next-try: no spawn before this time (there was no nav mesh to put it on).
(deftype hj2-kg-spawner (process)
  ((soldier   handle)
   (pos       vector      :inline)
   (quat      quaternion  :inline)
   (yellow?   symbol)
   (done?     symbol)
   (next-try  time-frame)
   )
  (:state-methods
    idle
    )
  )


(defun hj2-kg-ground! ((pos vector))
  "Puts pos on the background ground below it: a 0.1m sphere dropped from 2m above pos, 60m down (a
Jak 2 enemy that flew: a jetpack guard, a pegasus). Returns #t and sets pos's y when there is
ground, #f (pos unchanged) when there is none. Needs the collision loaded around pos."
  (let ((cq (new 'stack-no-clear 'collide-query)))
    (vector-copy! (-> cq start-pos) pos)
    (+! (-> cq start-pos y) (meters 2))
    (set-vector! (-> cq move-dist) 0.0 (meters -60) 0.0 1.0)
    (set! (-> cq radius) 409.6)
    (set! (-> cq collide-with) (collide-spec backgnd))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat)
          (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1)
          )
    (set! (-> cq action-mask) (collide-action solid))
    (let ((u (fill-and-probe-using-line-sphere *collide-cache* cq)))
      (when (>= u 0.0)
        (set! (-> pos y) (- (+ (-> cq start-pos y) (* u (-> cq move-dist y))) 409.6))
        #t
        )
      )
    )
  )

(defun hj2-kg-spawn-soldier ((this hj2-kg-spawner))
  "Spawns the spawner's soldier, as its child, on the ground below its place, on a nav mesh of the
loaded levels: the Jak 2 enemy's (its nav-mesh-actor lump), else the nearest one within 10m (the
place then moved onto it). Without a nav mesh, spawns none and tries again in 1s. Side effects:
soldier, next-try. Returns nothing."
  (let ((pos (new 'stack-no-clear 'vector)))
    (vector-copy! pos (-> this pos))
    (hj2-kg-ground! pos)
    (let ((mesh (nav-mesh-from-res-tag (-> this entity) 'nav-mesh-actor 0)))
      (when (not mesh)
        (set! mesh (find-nearest-nav-mesh pos (meters 10)))
        ;; the closest point of that mesh (pos in, pos out)
        (if mesh
            (nav-mesh-method-10 mesh pos pos (the-as nav-poly #f))
            )
        )
      (cond
        (mesh
          (let ((params (new 'stack-no-clear 'hj2-kg-soldier-init-params)))
            (vector-copy! (-> params trans) pos)
            (quaternion-copy! (-> params quat) (-> this quat))
            (set! (-> params entity) (-> this entity))
            (set! (-> params directed?) #f)
            (set! (-> params no-initial-move-to-ground?) #f)
            (set! (-> params art-level) #f)
            (set! (-> params mesh) mesh)
            (set! (-> params yellow?) (-> this yellow?))
            (let ((proc (process-spawn hj2-kg-soldier this params :name "hj2-kg-soldier" :to this)))
              (if proc
                  (set! (-> this soldier) (ppointer->handle proc))
                  )
              )
            )
          )
        (else
          (set! (-> this next-try) (+ (current-time) (seconds 1)))
          )
        )
      )
    )
  (none)
  )

(defun hj2-kg-spawner-update ((this hj2-kg-spawner))
  "Once a frame: with the war on, spawns the soldier when Jak comes within *hj2-kg-spawn-distance*
(and fewer than *hj2-kg-max-soldiers* are alive), notes a soldier killed (done?), removes one Jak
left *hj2-kg-forget-distance* behind; with the war off, removes the soldier. Returns nothing."
  (let ((soldier (the-as hj2-kg-soldier (handle->process (-> this soldier)))))
    (cond
      ((not (hj2-war-on?))
       (when soldier
         (deactivate soldier)
         (set! (-> this soldier) (the-as handle #f))
         )
       )
      ((not *target*)
       )
      (soldier
        (when (< *hj2-kg-forget-distance* (vector-vector-distance (target-pos 0) (-> soldier root trans)))
          (deactivate soldier)
          (set! (-> this soldier) (the-as handle #f))
          )
        )
      ((-> this soldier)
       ;; a soldier was spawned and is gone without us: killed
       (set! (-> this done?) #t)
       (set! (-> this soldier) (the-as handle #f))
       )
      ((and (not (-> this done?))
            (>= (current-time) (-> this next-try))
            (< *hj2-kg-soldier-count* *hj2-kg-max-soldiers*)
            (< (vector-vector-distance (target-pos 0) (-> this pos)) *hj2-kg-spawn-distance*)
            )
       (hj2-kg-spawn-soldier this)
       )
      )
    )
  (none)
  )

;; Watching for Jak and the war switch, every frame.
(defstate idle (hj2-kg-spawner)
  :virtual #t
  :code (behavior ()
    (until #f
      (hj2-kg-spawner-update self)
      (suspend)
      )
    #f
    )
  )

(defmethod init-from-entity! ((this hj2-kg-spawner) (arg0 entity-actor))
  "Setup from the entity the level port placed: the Jak 2 enemy's place and rotation, the look (lump
look: 1 yellow, else red), no soldier yet."
  (vector-copy! (-> this pos) (-> arg0 extra trans))
  (quaternion-copy! (-> this quat) (-> arg0 quat))
  (set! (-> this yellow?) (= (res-lump-value arg0 'look int :time -1000000000.0) 1))
  (set! (-> this done?) #f)
  (set! (-> this next-try) 0)
  (set! (-> this soldier) (the-as handle #f))
  (go (method-of-object this idle))
  )
