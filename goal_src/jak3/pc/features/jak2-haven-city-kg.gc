;;-*-Lisp-*-
(in-package goal)

;; name: jak2-haven-city-kg.gc
;; name in dgo: jak2-haven-city-kg
;; dgos: GAME

#|

  jak2-haven-city-kg.gc -- the war mode's Krimzon Guards in the places around Jak 2's city (GAME).

  While the war is on (hj2-war-on?, jak2-haven-city-war.gc), red and yellow Krimzon Guards stand
  where Jak 2 put its enemies in Dead Town, the pumping station, the mountain temple, Haven Forest,
  the dig, the fortress and its way out. With the war off, nothing of this file runs.

  - hj2-kg-spawner: an actor the level port places at each of those Jak 2 enemies (the manifest's
    "spawns", lumps: nav-mesh-actor, the Jak 2 enemy's nav mesh; look, 0 red, 1 yellow). Once Jak
    comes near it spawns one hj2-kg-soldier, as its child, on a nav mesh of the loaded levels (its
    own, else the nearest one); none where there is no nav mesh. A soldier killed isn't replaced
    until its level loads again; a soldier Jak left far behind, or one of a war switched off, is
    removed (and the war, on again, brings it back).
  - hj2-kg-soldier: a Jak 3 nav-enemy drawn with Jak 2's Krimzon Guard (skel-hj2-kg-red or
    skel-hj2-kg-yellow, jak2-haven-city-war.gc; their clips are in crimson-guard-ag's order, so the
    clip numbers below are Jak 3's guard's). It stands or patrols by its spawner, notices Jak, runs
    after him on the nav mesh, and fires bursts of Jak 3's guard shots (guard-shot) when he is in
    range and in sight. Hit, it is knocked back; killed, it plays its death and is gone. Yellow (Jak
    2's dark guard): 1.1 times bigger, twice the hit points. Its art groups are in its spawner's level
    (the place's DGO), which is the level a child process looks its art up in.

  Modeled on Jak 3's marauder (levels/desert/chase/marauder.gc: a nav-enemy that shoots guard shots)
  and on the Krimzon Guard's enemy settings (levels/city/traffic/citizen/guard.gc, CWI: copied here,
  GAME can't use them).

|#

;; DECOMP BEGINS

;; the war switch (jak2-haven-city-war.gc)
(define-extern hj2-war-on? (function symbol))

;; Tuning ////////////////////////////////////////////////////////////////////////////////////////

;; a spawner spawns its soldier when Jak comes this close to it
(define *hj2-kg-spawn-distance* (meters 60))

;; a soldier this far from Jak is removed (its spawner may spawn it again when Jak comes back)
(define *hj2-kg-forget-distance* (meters 150))

;; at most this many soldiers at once (the process pool and the frame rate: the dig has 70 spawners)
(define *hj2-kg-max-soldiers* 12)

;; the soldiers alive now (hj2-kg-soldier-init-by-other adds one, its deactivate removes it)
(define *hj2-kg-soldier-count* 0)

;; a soldier fires at Jak from this close
(define *hj2-kg-fire-range* (meters 40))

;; how far from Jak's body a shot may aim (not every shot hits)
(define *hj2-kg-spread* (meters 1.2))

;; Clips of the soldier's art group (crimson-guard-ag's order, art-elts.gc), and its gun's joints
;; (node-list indices, as guard-rifle.gc fires from them: the muzzle, and the point behind it the shot
;; flies away from).
(defconstant HJ2_KG_AIM 19)     ;; idle-to-stab-idle: raises the rifle
(defconstant HJ2_KG_FIRE 26)    ;; gun-attack: one shot
(defconstant HJ2_KG_LOWER 24)   ;; stab-idle-to-idle: lowers it
(defconstant HJ2_KG_MUZZLE 14)
(defconstant HJ2_KG_GUN_BACK 15)

;; Soldier ///////////////////////////////////////////////////////////////////////////////////////

;; los: Jak in sight; kg-mesh: the nav mesh given by its spawner; yellow?: Jak 2's dark guard;
;; next-burst: no burst before this time.
(deftype hj2-kg-soldier (nav-enemy)
  ((los         los-control  :inline)
   (kg-mesh     nav-mesh)
   (yellow?     symbol)
   (next-burst  time-frame)
   )
  (:state-methods
    shoot
    )
  )


;; What its spawner gives it: the enemy's (place, rotation, entity: the spawner's), and its nav mesh
;; and look.
(deftype hj2-kg-soldier-init-params (enemy-init-by-other-params)
  ((mesh     nav-mesh)
   (yellow?  symbol)
   )
  )


;; Jak 3's Krimzon Guard's enemy settings (guard.gc *crimson-guard-nav-enemy-info*), with Jak 2's
;; guard's pace: it notices Jak from 60m (not 100m), runs at 9m/s (not 12m/s), has a run clip
;; (hostile-anim 6) and a notice clip (7), and isn't knocked by a mere touch. nav-mesh is set by
;; init-enemy! for each soldier, before setup-enemy! reads it.
(define *hj2-kg-soldier-nav-enemy-info*
  (new 'static 'nav-enemy-info
    :use-die-falling #f
    :use-victory #f
    :use-jump-blocked #f
    :debug-draw-neck #f
    :jump-debug-draw #f
    :move-to-ground #t
    :hover-if-no-ground #f
    :idle-anim-script (new 'static 'inline-array idle-control-frame 2
      (new 'static 'idle-control-frame
        :command (idle-control-cmd play)
        :anim #x4
        :param0 1
        :param1 1
        :param2 '((new 'static 'bfloat :data 1.0) (new 'static 'bfloat :data 1.0))
        )
      (new 'static 'idle-control-frame)
      )
    :idle-anim 4
    :notice-anim 7
    :hostile-anim 6
    :hit-anim 4
    :knocked-anim 8
    :knocked-land-anim 9
    :die-anim 17
    :die-falling-anim 39
    :victory-anim 4
    :jump-wind-up-anim 4
    :jump-in-air-anim 38
    :jump-land-anim 4
    :neck-joint 30
    :look-at-joint 6
    :bullseye-joint 5
    :sound-hit (static-sound-name "guard-hit")
    :sound-die (static-sound-name "guard-die")
    :notice-distance (meters 60)
    :notice-distance-delta (meters 10)
