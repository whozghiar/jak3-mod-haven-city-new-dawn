;;-*-Lisp-*-
(in-package goal)

#|

  jak2-haven-city-menu.gc -- Mods menu entry for jak3/features/jak2-haven-city.

  Jak 2's Haven City is rebuilt as custom levels like Jak 2's: the city-wide hub
  `havenj2` (custom_assets/jak3/levels/havenj2) and one level per district
  (hj2-slma...). This file lives in GAME.CGO, not in a level's DGO, so the warp
  is reachable from anywhere in the game.

  The warps (to the city, one of its districts or key places, the places
  reached from it, or back to Jak 3's Freedom HQ) go through a continue point,
  never through `bg`: the hub and its districts need the level heap Jak 3's own
  city takes. A continue point makes the level system unload every level it
  doesn't want first, then load the hub and the districts it lists.

  The time of day: the clock stays at the chosen hour while Jak is in Jak 2's
  city or one of its places, or runs like in Jak 2 (see
  *mod-jak2-haven-city-hour* in jak2-haven-city-world.gc).

  The weather, in the whole game: Jak 3's changing weather (clear, cloudy, foggy,
  rain and thunderstorms), or a fixed one (sunny, cloudy, foggy, light rain, rain,
  thunderstorm, snow), see *mod-jak2-haven-city-weather*.

  The menu (the user's layout, phase 20): the mod's switch (*mod-jak2-haven-city-enabled*, off by
  default), then four entries, greyed out while the mod is off: the warp to Jak 2's city (its
  underground hideout), the warps by district, the warps outside the city, and the weather (with
  the time of day). The traffic, its Hellcats and guard bikes, and Jak 2's alert are always on in
  Jak 2's levels (jak2-haven-city-world.gc).

|#

;; defined in jak2-haven-city-world.gc, which GAME loads after this file
(define-extern *mod-jak2-haven-city-enabled* symbol)
(define-extern mod-jak2-haven-city-set-enabled (function symbol none))
(define-extern *mod-jak2-haven-city-hour* int)
(define-extern hj2-world-level-active? (function level symbol))
(define-extern hj2-apply-time-of-day (function none))
(define-extern *mod-jak2-haven-city-weather* int)
(define-extern hj2-apply-weather (function none))

(defun mod-jak2-haven-city-warp ((name string))
  "Close the Mods menu and restart the player at one of this mod's continue points (havenj2-start:
the city, hj2-atoll-start: the pumping station, hj2-forest-start: Haven Forest)."
  (let ((cont (get-continue-by-name *game-info* name)))
    (when cont
      (mods-menu-close!)
      (start 'play cont)
      )
    )
  (none)
  )

(defun mod-jak2-haven-city-set-hour ((hour int))
  "Set the hour the clock stays at in this mod's levels (-1: the clock runs), and apply it now if
Jak is in one of them."
  (set! *mod-jak2-haven-city-hour* hour)
  (if (hj2-world-level-active? (the-as level #f))
      (hj2-apply-time-of-day)
      )
  (none)
  )

(defun mod-jak2-haven-city-set-weather ((weather int))
  "Set the weather of the whole game (0: Jak 3's changing weather, else a fixed one, see
*mod-jak2-haven-city-weather*), from now on."
  (set! *mod-jak2-haven-city-weather* weather)
  (hj2-apply-weather)
  (none)
  )

(defmacro mod-jak2-haven-city-warp-button (label continue)
  "A Mods menu button warping to a continue point."
  `(new 'static 'popup-menu-button :label ,label
        :on-confirm (lambda () (mod-jak2-haven-city-warp ,continue) (none))
        )
  )

(defmacro mod-jak2-haven-city-weather-flag (label weather)
  "A Mods menu choice of weather."
  `(new 'static 'popup-menu-flag :label ,label
        :is-toggled? (lambda () (= *mod-jak2-haven-city-weather* ,weather))
        :on-confirm (lambda () (mod-jak2-haven-city-set-weather ,weather) (none))
        )
  )

(defmacro mod-jak2-haven-city-hour-flag (label hour)
  "A Mods menu choice of the hour the clock stays at in this mod's levels (-1: Jak 2's day and night
cycle, any negative hour)."
  `(new 'static 'popup-menu-flag :label ,label
        :is-toggled? (lambda () (if (< ,hour 0) (< *mod-jak2-haven-city-hour* 0) (= *mod-jak2-haven-city-hour* ,hour)))
        :on-confirm (lambda () (mod-jak2-haven-city-set-hour ,hour) (none))
        )
  )

(define *mod-jak2-haven-city-menu*
  (new 'static 'popup-menu-submenu :label "jak2-haven-city"
    :entries (new 'static 'boxed-array :type popup-menu-entry
      ;; the mod's switch: the Freedom HQ's time gate, the weather, the entries below (each greyed out
      ;; while the mod is off, an entry-disabled? lambda: a static field can't name a function)
      (new 'static 'popup-menu-flag :label "Mod enabled"
           :is-toggled? (lambda () *mod-jak2-haven-city-enabled*)
           :on-confirm (lambda () (mod-jak2-haven-city-set-enabled (not *mod-jak2-haven-city-enabled*)) (none))
           )
      ;; to Jak 2's city: its underground hideout
      (new 'static 'popup-menu-button :label "Warp to Haven City (Jak 2)"
           :entry-disabled? (lambda () (not *mod-jak2-haven-city-enabled*))
           :on-confirm (lambda () (mod-jak2-haven-city-warp "hj2-hideout-start") (none))
           )
      ;; the districts (Jak 2's city levels) and the places in them, by Jak 2's continue points
      (new 'static 'popup-menu-submenu :label "Warp to a district"
        :entry-disabled? (lambda () (not *mod-jak2-haven-city-enabled*))
        :entries (new 'static 'boxed-array :type popup-menu-entry
          (mod-jak2-haven-city-warp-button "Slums: the hideout's street" "havenj2-start")
          (mod-jak2-haven-city-warp-button "Slums: the fortress gate" "hj2-ctyslumb-fort")
          (mod-jak2-haven-city-warp-button "Slums: the Oracle" "hj2-ctyslumc-start")
          (mod-jak2-haven-city-warp-button "Slums: inside the Oracle" "hj2-oracle-start")
          (mod-jak2-haven-city-warp-button "Port" "hj2-ctyport-start")
          (mod-jak2-haven-city-warp-button "Port: Hip Hog saloon" "hj2-ctyport-hiphog")
          (mod-jak2-haven-city-warp-button "Port: gun course" "hj2-ctyport-gungame")
          (mod-jak2-haven-city-warp-button "Port: air train" "hj2-ctyport-warp")
          (mod-jak2-haven-city-warp-button "Bazaar: Brutter's stall" "hj2-ctymarka-brutter")
          (mod-jak2-haven-city-warp-button "Bazaar: the east side" "hj2-ctymarkb-tanker")
          (mod-jak2-haven-city-warp-button "Industrial Section: Vin's side" "hj2-ctyinda-start")
          (mod-jak2-haven-city-warp-button "Industrial Section: Vin's power station" "hj2-ctyinda-vinroom")
          (mod-jak2-haven-city-warp-button "Industrial Section: construction site gate" "hj2-ctyinda-consite")
          (mod-jak2-haven-city-warp-button "Industrial Section: the south side" "hj2-ctyindb-start")
          (mod-jak2-haven-city-warp-button "Main Town: the west side" "hj2-ctygena-start")
          (mod-jak2-haven-city-warp-button "Main Town: the cable pillar" "hj2-ctygenb-start")
          (mod-jak2-haven-city-warp-button "Main Town: the east side" "hj2-ctygenc-start")
          (mod-jak2-haven-city-warp-button "Main Town: pillar to the palace" "hj2-cable-pillar")
          (mod-jak2-haven-city-warp-button "Gardens: the mountain airlock" "hj2-ctyfarma-start")
          (mod-jak2-haven-city-warp-button "Gardens: the north side" "hj2-ctyfarmb-start")
          (mod-jak2-haven-city-warp-button "Palace plaza" "hj2-ctypal-shaft")
          (mod-jak2-haven-city-warp-button "Palace roof" "hj2-palroof-throne")
          (mod-jak2-haven-city-warp-button "Stadium grounds" "hj2-stadium-start")
          (mod-jak2-haven-city-warp-button "Keira's garage" "hj2-garage-start-skate")
          )
        )
      (new 'static 'popup-menu-submenu :label "Warp outside the city"
        :entry-disabled? (lambda () (not *mod-jak2-haven-city-enabled*))
        :entries (new 'static 'boxed-array :type popup-menu-entry
          (mod-jak2-haven-city-warp-button "Dead Town" "hj2-ruins-start")
          (mod-jak2-haven-city-warp-button "Dead Town: the Sage's hut" "hj2-ruins-hut")
          (mod-jak2-haven-city-warp-button "Inside the fortress" "hj2-forresca-start")
          (mod-jak2-haven-city-warp-button "Fortress: the prison" "hj2-prison-start")
          (mod-jak2-haven-city-warp-button "Stadium race track" "hj2-stadiumd-start")
          (mod-jak2-haven-city-warp-button "Construction site" "hj2-consite-start")
          (mod-jak2-haven-city-warp-button "Pumping station" "hj2-atoll-start")
          (mod-jak2-haven-city-warp-button "Mountain top" "hj2-mountain-top")
          (mod-jak2-haven-city-warp-button "Haven Forest" "hj2-forest-start")
          (mod-jak2-haven-city-warp-button "Castle pad (air train)" "hj2-caspad-start")
          (mod-jak2-haven-city-warp-button "Dig site" "hj2-dig3-start")
          ;; back to Jak 3's world: its Freedom HQ, where the time gate to Jak 2's city stands
          (mod-jak2-haven-city-warp-button "Freedom HQ (Jak 3)" "freehq-start")
          )
        )
      ;; the weather of the whole game and the hour of Jak 2's levels (jak2-haven-city-world.gc)
      (new 'static 'popup-menu-submenu :label "Weather"
        :entry-disabled? (lambda () (not *mod-jak2-haven-city-enabled*))
        :entries (new 'static 'boxed-array :type popup-menu-entry
          (mod-jak2-haven-city-weather-flag "Changing (Jak 3's weather)" 0)
          (mod-jak2-haven-city-weather-flag "Sunny" 1)
          (mod-jak2-haven-city-weather-flag "Cloudy" 2)
          (mod-jak2-haven-city-weather-flag "Foggy" 3)
          (mod-jak2-haven-city-weather-flag "Light rain" 4)
          (mod-jak2-haven-city-weather-flag "Rain" 5)
          (mod-jak2-haven-city-weather-flag "Thunderstorm" 6)
          (mod-jak2-haven-city-weather-flag "Snow" 7)
          (new 'static 'popup-menu-submenu :label "Time of day (Jak 2's levels)"
            :entries (new 'static 'boxed-array :type popup-menu-entry
              (mod-jak2-haven-city-hour-flag "Morning (9:00)" 9)
              (mod-jak2-haven-city-hour-flag "Noon (12:00)" 12)
              (mod-jak2-haven-city-hour-flag "Afternoon (16:00)" 16)
              (mod-jak2-haven-city-hour-flag "Evening (19:00)" 19)
              (mod-jak2-haven-city-hour-flag "Night (23:00)" 23)
              (mod-jak2-haven-city-hour-flag "Day and night cycle (Jak 2)" -1)
              )
            )
          )
        )
      )
    )
  )

(defun mod-jak2-haven-city-build-menu ()
  "Return this mod's entry for the Mods menu. Called on every rebuild."
  (the-as popup-menu-entry *mod-jak2-haven-city-menu*)
  )

(mods-menu-register "jak2-haven-city" mod-jak2-haven-city-build-menu)
