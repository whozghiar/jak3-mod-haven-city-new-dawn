;; Time gate ///////////////////////////////////////////////////////////////////////////////////////

;; A time gate in Jak 3's Freedom HQ (freehq), to Jak 2's Haven City: a swirl of light Jak jumps
;; into, like Jak 3's warp gates. freehq is one of Jak 3's own levels: its level-load-info
;; (level-info.gc) gets two callbacks here, which spawn the gate while freehq is active. The gate
;; stands on the free floor at the back of the main room (the floor is at 80.34m).
(define *hj2-time-gate-trans* (static-vectorm 710 80.338 -565))

;; the gate's light: a glow and sparkles rising from a ring (part ids 5400-5402 and group id 1650:
;; no Jak 3 level uses them; a new group's name isn't defined, see part-groups.gc)
(defpartgroup group-hj2-time-gate
  :id 1650
  :bounds (static-bspherem 0 2 0 4)
  :parts ((sp-item 5400) (sp-item 5401) (sp-item 5402))
  )

(defpart 5400
  :init-specs ((:texture (glow-soft level-default-sprite))
    (:num 0.5)
    (:y (meters 1.6))
    (:scale-x (meters 4) (meters 1))
    (:rot-z (degrees 0) (degrees 360))
    (:scale-y (meters 5) (meters 1))
    (:r 32.0 32.0)
    (:g 96.0 64.0)
    (:b 255.0)
    (:a 16.0 16.0)
    (:fade-a -0.16)
    (:timer (seconds 0.5))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    )
  )

(defpart 5401
  :init-specs ((:texture (hotdot level-default-sprite))
    (:num 1.0 1.0)
    (:x (meters 1.2) (meters 0.3))
    (:scale-x (meters 0.15) (meters 0.1))
    (:scale-y :copy scale-x)
    (:r 96.0 64.0)
    (:g 192.0 63.0)
    (:b 255.0)
    (:a 128.0 64.0)
    (:vel-y (meters 0.02) (meters 0.02))
    (:fade-a -1.0 -0.5)
    (:timer (seconds 1.2))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    (:rotate-y (degrees 0) (degrees 360))
    )
  )

(defpart 5402
  :init-specs ((:texture (middot level-default-sprite))
    (:num 0.3)
    (:y (meters 1.6))
    (:scale-x (meters 2.5) (meters 0.5))
    (:rot-z (degrees 0) (degrees 360))
    (:scale-y :copy scale-x)
    (:r 128.0)
    (:g 192.0)
    (:b 255.0)
    (:a 32.0 16.0)
    (:rotvel-z (degrees -1) (degrees 2))
    (:fade-a -0.2)
    (:timer (seconds 0.8))
    (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-3))
    )
  )

;; The time gate: continue is where it leads (havenj2-start), center the point Jak jumps to (1.5m
;; above its base).
(deftype hj2-time-gate (process-drawable)
  ((continue  continue-point)
   (center    vector  :inline)
   )
  (:state-methods
    idle
    (use continue-point)
    )
  )


;; the gate's light, and its prompt while Jak stands within 3m of it (triangle: use)
(defstate idle (hj2-time-gate)
  :virtual #t
  :code (behavior ()
    (set-time! (-> self state-time))
    (until #f
      (spawn (-> self part) (-> self root trans))
      (when (and (-> self continue) (hj2-can-travel? (meters 3)))
        (talker-surpress!)
        (when (and (can-display-query? self "warp-gate" -99.0) (time-elapsed? (-> self state-time) (seconds 0.1)))
          (if (and (cpad-pressed? 0 triangle) (process-grab? *target* #f))
              (go-virtual use (-> self continue))
              )
          (hj2-print-travel-prompt "Press <PAD_TRIANGLE> to travel through the time (Jak 2)")
          )
        )
      (suspend)
      )
    #f
    )
  )

;; the warp gate's use (warp-gate.gc): Jak jumps into the gate and vanishes, the continue loads
(defstate use (hj2-time-gate)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('effect)
       (vector-copy! (-> *launch-matrix* trans) (-> self center))
       (part-tracker-spawn part-tracker :to *entity-pool* :group group-warpgate)
       )
      )
    )
  :exit (behavior ()
    (remove-setting! 'mode-name)
    (remove-setting! 'interp-time)
    )
  :trans (behavior ()
    (send-event *camera* 'joystick 0.0 0.0)
    )
  :code (behavior ((arg0 continue-point))
    (kill-current-talker '() '() 'exit)
    (set-setting! 'mode-name 'cam-fixed 0.0 0)
    (set-setting! 'interp-time 'abs 0.0 0)
    (set-time! (-> self state-time))
    (set-setting! 'allow-progress #f 0.0 0)
    (set! (-> *setting-control* user-default border-mode) #t)
    (set! (-> *level* play?) #t)
    (apply-settings *setting-control*)
    (let ((s5-0 (new 'stack-no-clear 'event-message-block)))
      (set! (-> s5-0 from) (process->ppointer self))
      (set! (-> s5-0 num-params) 4)
      (set! (-> s5-0 message) 'change-state)
      (set! (-> s5-0 param 0) (the-as uint target-warp-out))
      (let ((v1-22 (new 'static 'vector)))
        (vector-copy! v1-22 (-> self center))
        (set! (-> s5-0 param 1) (the-as uint v1-22))
        )
      (set! (-> s5-0 param 2) (the-as uint (target-pos 0)))
      (set! (-> s5-0 param 3) (the-as uint (process->handle self)))
      (send-event-function *target* s5-0)
      )
    (suspend-for (seconds 2)
      (spawn (-> self part) (-> self root trans))
      )
    (set-blackout-frames (seconds 0.05))
    (start 'play arg0)
    (suspend-for (seconds 1)
      )
    (go-virtual idle)
    )
  )

(defbehavior hj2-time-gate-init hj2-time-gate ((pos vector))
  "Init of the time gate (process-spawn :init), standing at pos: its light and its continue point."
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (quaternion-identity! (-> self root quat))
  (vector-identity! (-> self root scale))
  (vector-copy! (-> self center) pos)
  (+! (-> self center y) (meters 1.5))
  (set! (-> self continue) (get-continue-by-name *game-info* "havenj2-start"))
  (set! (-> self part) (create-launch-control (-> *part-group-id-table* 1650) self))
  (go-virtual idle)
  )

(define *hj2-time-gate* (the-as handle #f))

(defun hj2-freehq-activate ((lev level) (mode symbol))
  "freehq's activation callback (slot 35, added below): the time gate."
  (when (not (handle->process *hj2-time-gate*))
    (let ((proc (process-spawn hj2-time-gate :init hj2-time-gate-init *hj2-time-gate-trans* :name "hj2-time-gate" :to *entity-pool*)))
      (set! *hj2-time-gate* (if proc
                                (ppointer->handle proc)
                                (the-as handle #f)
                                )
            )
      )
    )
  (none)
  )

(defun hj2-freehq-deactivate ((lev level))
  "freehq's deactivation callback (slot 36, added below): the time gate goes."
  (let ((proc (handle->process *hj2-time-gate*)))
    (if proc
        (deactivate proc)
        )
    )
  (set! *hj2-time-gate* (the-as handle #f))
  (none)
  )

;; freehq has no callbacks of its own
(when (not (get-callback-by-slot! freehq 35))
  (let ((callbacks '((35 . hj2-freehq-activate) (36 . hj2-freehq-deactivate))))
    (set! (-> freehq callback-list)
          (cons (car callbacks) (cons (car (cdr callbacks)) (-> freehq callback-list)))
          )
    )
  )

;; Respawn points /////////////////////////////////////////////////////////////////////////////////

;; Jak 3 picks the closest continue of a level when the player enters it (level-group update), which
;; is how Jak 2's city districts, each its own level, got a respawn point next to the player. havenj2
;; is one level: once one of its continues is set, that choice never runs again. This process does
;; it by distance while havenj2 is active, so dying or saving respawns Jak near where he was. The
;; places reached through the doors keep Jak 3's own choice (the doors set the vis level).

(define *havenj2-continues* (the-as handle #f))

(defun havenj2-closest-continue ((pos vector))
  "The havenj2 continue point closest to pos, skipping the ones Jak 3 doesn't pick by itself."
  (let ((best (the-as continue-point #f))
        (best-dist 0.0)
        (info (lookup-level-info 'havenj2))
        )
    (when info
      (let ((conts (-> info continues)))
        (while (not (null? conts))
          (let ((cont (the-as continue-point (car conts))))
            (when (not (logtest? (-> cont flags) (continue-flags change-continue no-auto)))
              (let ((dist (vector-vector-distance pos (-> cont trans))))
                (when (or (not best) (< dist best-dist))
                  (set! best cont)
                  (set! best-dist dist)
                  )
                )
              )
            )
          (set! conts (cdr conts))
          )
        )
      )
    best
    )
  )

(defun havenj2-update-continue ()
  "Move the current continue to the havenj2 one closest to Jak, while it is a havenj2 one."
  (let ((cont (-> *game-info* current-continue)))
    (when (and *target*
               cont
               (= (-> cont level) 'havenj2)
               (not (logtest? (-> cont flags) (continue-flags change-continue)))
               (-> *setting-control* user-current allow-continue)
               )
      (let ((best (havenj2-closest-continue (target-pos 0))))
        (if (and best (!= best cont))
            (set-continue! *game-info* (the-as basic best) #f)
            )
        )
      )
    )
  (none)
  )

(defbehavior havenj2-continues-code process ()
  "The respawn point process's code: moves the current continue every frame
(havenj2-update-continue)."
  (loop
    (havenj2-update-continue)
    (suspend)
    )
  )

;; Traffic ////////////////////////////////////////////////////////////////////////////////////////

;; Jak 3's citizens, guards and vehicles in havenj2 (Mods menu: City traffic)
(define *mod-jak2-haven-city-traffic* #t)

;; in havenj2's own code (levels/havenj2/havenj2-traffic.gc): only called while havenj2 is active
(define-extern havenj2-traffic-start (function level symbol none))
(define-extern havenj2-traffic-stop (function level none))

(defun hj2-traffic-refresh ((lev level) (mode symbol))
  "Start or stop the traffic of havenj2 (lev, active), as *mod-jak2-haven-city-traffic* says."
  (if *mod-jak2-haven-city-traffic*
      (havenj2-traffic-start lev mode)
      (havenj2-traffic-stop lev)
      )
  (none)
  )

;; Level callbacks (level-info callback-list) /////////////////////////////////////////////////////

(defun havenj2-activate ((lev level) (mode symbol))
  "havenj2's activation callback (slot 35): the clock (see *mod-jak2-haven-city-hour*), the
weather, its sprite textures (and its props' particles), the traffic, and the respawn point follows
Jak."
  (hj2-apply-time-of-day)
  (hj2-apply-weather)
  (hj2-sprite-page-on lev)
  (hj2-prop-textures-on)
  (hj2-traffic-refresh lev mode)
  (when (not (handle->process *havenj2-continues*))
    (let ((proc (process-spawn-function process havenj2-continues-code :name "havenj2-continues")))
      (set! *havenj2-continues* (if proc
                                    (ppointer->handle proc)
                                    (the-as handle #f)
                                    )
            )
      )
    )
  (none)
  )

(defun havenj2-deactivate ((lev level))
  "havenj2's deactivation callback (slot 36): the traffic stops, the respawn point stops following,
the clock runs again if Jak left this mod's levels."
  (havenj2-traffic-stop lev)
  (hj2-release-time-of-day lev)
  (hj2-sprite-page-off lev)
  (let ((proc (handle->process *havenj2-continues*)))
    (if proc
        (deactivate proc)
        )
    )
  (set! *havenj2-continues* (the-as handle #f))
  (none)
  )

(defun hj2-place-activate ((lev level) (mode symbol))
  "Activation callback (slot 35) of the places reached from the city: the same clock as the city
(Jak 2 unloads the city while Jak is in some of them)."
  (hj2-apply-time-of-day)
  (hj2-apply-weather)
  (hj2-sprite-page-on lev)
  (none)
  )

(defun hj2-place-deactivate ((lev level))
  "Deactivation callback (slot 36) of the places: the clock runs again if Jak left this mod's
levels."
  (hj2-release-time-of-day lev)
  (hj2-sprite-page-off lev)
  (none)
  )
