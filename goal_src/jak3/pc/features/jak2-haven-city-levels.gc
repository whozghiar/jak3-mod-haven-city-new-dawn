;;-*-Lisp-*-
(in-package goal)

;; name: jak2-haven-city-levels.gc
;; name in dgo: jak2-haven-city-levels
;; dgos: GAME

;; og:jak2-haven-city GENERATED by scripts/level_port from
;; custom_assets/jak3/ports/jak2-haven-city/port.jsonc, edit the port.
;; The level-load-info of havenj2 (Jak 2's Haven City) and of the places reached from it,
;; with their continue points taken from Jak 2's. They're in GAME so the continues are known
;; at boot (warps, saves). Moods and callbacks: jak2-haven-city-world.gc.

;; every level of this mod (the clock stays as set while one of them is active)
(define *havenj2-levels* '(havenj2 hj2-slma hj2-slmb hj2-slmc hj2-port hj2-marka hj2-markb hj2-inda hj2-indb hj2-gena hj2-genb hj2-genc hj2-farma hj2-farmb hj2-pal hj2-stdm hj2-hiphog hj2-gun hj2-vin hj2-hide hj2-oracle hj2-garage hj2-ruins hj2-consb hj2-cons hj2-pshaft hj2-proof hj2-pcab hj2-atollx hj2-atoll hj2-mount hj2-mtnx hj2-forest hj2-forstb hj2-caspad hj2-dig hj2-digb hj2-forta hj2-fortb hj2-prison hj2-fexa hj2-fexb hj2-stadd hj2-kiosk hj2-onin hj2-mincan))

;; the city's districts and their hub, (district . hub): a district is loaded after its hub
(define *havenj2-hubs* '((hj2-slma . havenj2) (hj2-slmb . havenj2) (hj2-slmc . havenj2) (hj2-port . havenj2) (hj2-marka . havenj2) (hj2-markb . havenj2) (hj2-inda . havenj2) (hj2-indb . havenj2) (hj2-gena . havenj2) (hj2-genb . havenj2) (hj2-genc . havenj2) (hj2-farma . havenj2) (hj2-farmb . havenj2) (hj2-pal . havenj2) (hj2-stdm . havenj2)))

;; the city's districts, and which of them holds each 25.0m square of the city's streets (1 + its
;; index in *havenj2-district-names*, 0: none), from Jak 2's traffic cells. The grid: x and z of its first
;; square (game units), square size, squares per row.
(define *havenj2-district-names* (new 'static 'boxed-array :type symbol 'hj2-slma 'hj2-slmb 'hj2-slmc 'hj2-port 'hj2-marka 'hj2-markb 'hj2-inda 'hj2-indb 'hj2-gena 'hj2-genb 'hj2-genc 'hj2-farma 'hj2-farmb 'hj2-pal 'hj2-stdm))

(define *havenj2-district-grid* (new 'static 'vector :x -1638400.0 :y -3174400.0 :z 102400.0 :w 64.0))

(define *havenj2-district-cells* (new 'static 'boxed-array :type uint8
