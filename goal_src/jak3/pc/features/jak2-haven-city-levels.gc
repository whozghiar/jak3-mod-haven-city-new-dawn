;; Jak 2's ctywide, the city-wide level of Jak 2's Haven City (custom_assets/jak3/levels/havenj2),
;; loaded first with every district (hj2-slma...). Kept at Jak 2's world coordinates, so it
;; must never be loaded together with Jak 3's own city levels.
;; sky: the sky is only drawn when an active level has this flag.
;; login/logout: the traffic engine, in havenj2's own code (havenj2-traffic.gc).
;; 6: the force-field walls' color texture animation (Jak 3's ctywide-texture.gc).
(define havenj2
  (new 'static 'level-load-info
    :name 'havenj2
    :visname 'havenj2-vis
    :nickname 'hj2
    :dbname 'havenj2
    :taskname 'default
    :index #x129
    :master-level #f
    :level-flags (level-flags sky ocean-near-translucent not-physical)
    :packages '()
    :run-packages '("common")
    :memory-mode (level-memory-mode small-center)
    :music-bank #f
    :extra-sound-bank #f
    :mood-func 'update-mood-havenj2
    :special-mood #f
    :ocean '*ocean-map-havenj2*
    :ocean-alpha 1.0
    :priority 100
    :draw-priority 9.0
    :part-engine-max 4
    :base-task-mask (task-mask task0)
    :bigmap-id (bigmap-id none)
    :continues '(

      )
    :callback-list '((6 . *security-texture-anim-array*) (33 . havenj2-login) (34 . havenj2-logout) (35 . havenj2-activate) (36 . havenj2-deactivate))
    :borrow #f
    :bottom-height (meters -100)
    :fog-height (meters 80)
    :max-rain 1.0
    :mood-range (new 'static 'mood-range :max-cloud 1.0 :max-fog 1.0)
    :fog-mult 1.0
    )
  )

(cons! *level-load-list* 'havenj2)

