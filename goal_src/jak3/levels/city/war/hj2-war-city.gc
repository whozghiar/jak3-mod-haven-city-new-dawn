;;-*-Lisp-*-
(in-package goal)

;; name: hj2-war-city.gc
;; name in dgo: hj2-war-city
;; dgos: CWI, HJ2

#|

  The city's part of the war mode of Haven City: New Dawn (pc/features/jak2-haven-city-war.gc,
  GAME): "KG-Guard vs Freedom Fighters" in Jak 2's city, and Praxis KG invasion in Jak 3's. Linked
  after the traffic code in Jak 3's city (goal_src/jak3/dgos/cwi.gd, an added line) and in Jak 2's
  city hub (havenj2's DGO takes CWI's objects in their order), so it only exists while one of the
  two cities is loaded.

  While either mode is on, a director process, child of the traffic manager (it dies with the
  traffic), every frame:
  - counts the live looks of the guards and jetpack guards (the shares of jak2-haven-city-war.gc);
  - frightens the citizens: every citizen on foot keeps fleeing from the nearest guard (or Jak), and a
    danger sphere on a Krimzon Guard near Jak keeps new ones from walking in (the traffic engine's
    'panic);
  - adds the war's hatreds to the attack controller: the two sides seek each other out from further
    away, and the Krimzon Guards attack citizens too;
  - in Jak 2's city only: plays Jak 3's city fight music (fight1), and sends a troop transport now
    and then, landing near Jak, the two sides in turn (a red Krimzon Guard ship with red and yellow
    guards, a blue Freedom Fighters one with blue guards; hj2-transport.gc). Jak 3's city has no war
    ship: its conflict zones are held by the faction manager's hooks (jak2-haven-city-war.gc
    hj2-invasion-permission, hj2-invasion-spawn-ok?, hj2-war-wake-ok?), and its fight music is Jak
    3's own, in a territory at war.

  Switching a mode on or off rebuilds the city's traffic (a guard's look is chosen when its process
  is made): in Jak 3's city by running ctywide's activation again, as a death does
  (*hj2-war-city-hook*); havenj2 restarts its own (jak2-haven-city-war.gc hj2-war-changed!).

|#

;; in hj2-transport.gc, linked before this file
(define-extern hj2-transport-spawn (function process int level process))
;; the switches alone, mission or not, and the war of Jak 2's world (jak2-haven-city-war.gc, GAME)
(define-extern hj2-war-switched-on? (function symbol))
(define-extern hj2-invasion-switched-on? (function symbol))
(define-extern hj2-war-jak2-on? (function symbol))

;; DECOMP BEGINS

(deftype hj2-war-city-state (structure)
  "The war director's handle, in a structure: a handle kept in a global symbol loses its pid (GOAL
wiki common 1.4.17)."
  ((director  handle)
   )
  )

(define *hj2-war-city* (new 'static 'hj2-war-city-state))

(set! (-> *hj2-war-city* director) (the-as handle #f))

;; how often a transport comes: the first one this long after the war starts, then one every 45 to
;; 90 s while none flies
(defconstant HJ2_WAR_FIRST_TRANSPORT (seconds 20))
(defconstant HJ2_WAR_TRANSPORT_MIN (seconds 45))
(defconstant HJ2_WAR_TRANSPORT_MAX (seconds 90))

;; the citizens' panic: around a Krimzon Guard this close to Jak, a danger sphere of this radius whose
;; alarm reaches this far
(defconstant HJ2_WAR_PANIC_RANGE (meters 80))
(defconstant HJ2_WAR_PANIC_RADIUS (meters 15))
(defconstant HJ2_WAR_PANIC_NOTIFY (meters 40))

;; Hatred ////////////////////////////////////////////////////////////////////////////////////////
;; Jak 3's attack controller gives each fighter its target from a table of hatreds between types
;; (city-target-type: Jak 0, civilian 1, guards 3 to 5 by weapon, KG robots 9; the faction
;; praxis-kguard 13, HJ2_TARGET_PRAXIS, which the war's Krimzon Guards and red jetpack guards
;; register as, hj2-war-attacker-type). An entry weighs a pair by its hatred, full up to
;; hatred-dist, dist-scale times at that distance, none past max-consider-dist (mission-squad-control-
;; method-13). Jak 3's table (init-attack-controller, cty-attack-controller.gc) has nothing for type
;; 13. At war, three entries: the Freedom League's guards and praxis-kguard hate each other most
;; (0.9, full up to 100 m, up to 160 m); praxis-kguard hates the citizens 0.7, full up to 10 m, a
;; quarter at 60 m, up to 100 m (a citizen near a Krimzon Guard is shot before a guard further
;; away); and Jak 0.6, as Jak 3's KG robots do. The KG robots and the Metal Heads have no entry
;; towards it, nor it towards them.

;; the table's length with the war's 3 entries (Jak 3's 11 and the empty entry 0, then 3)
(defconstant HJ2_WAR_HATRED_COUNT 15)

(defun hj2-war-hatred-set! ((on symbol))
  "Jak 3's hatred table again (reset-hatred, init-attack-controller), and with on the war's entries
on top (see above). Returns nothing. Side effect: *cty-attack-controller*'s table."
  (let ((ctrl *cty-attack-controller*))
    (when (and ctrl (nonzero? ctrl))
      (reset-hatred ctrl)
      (init-attack-controller ctrl)
      (when on
        (let ((fight (push-back-hatred ctrl)))
          (set! (-> fight hatred) 0.9)
          (set! (-> fight hatred-dist) (meters 100))
          (set! (-> fight dist-scale) 0.5)
          (set! (-> fight attacker-scale) 0.01)
          (set! (-> fight max-consider-dist) (meters 160))
          (dotimes (guard 3)
            (set-hatred-indices ctrl fight (+ guard 3) HJ2_TARGET_PRAXIS)
            (set-hatred-indices ctrl fight HJ2_TARGET_PRAXIS (+ guard 3))
            )
          )
        (let ((civ (push-back-hatred ctrl)))
          (set! (-> civ hatred) 0.7)
          (set! (-> civ hatred-dist) (meters 60))
          (set! (-> civ dist-scale) 0.25)
          (set! (-> civ attacker-scale) 0.01)
          (set! (-> civ max-consider-dist) (meters 100))
          (set-hatred-indices ctrl civ HJ2_TARGET_PRAXIS 1)
          )
        ;; Jak, as Jak 3's KG robots (its own entry 0.6: 60 m full, up to 100 m)
        (let ((jak (push-back-hatred ctrl)))
          (set! (-> jak hatred) 0.6)
          (set! (-> jak hatred-dist) (meters 60))
          (set! (-> jak dist-scale) 0.5)
          (set! (-> jak attacker-scale) 0.01)
          (set! (-> jak max-consider-dist) (meters 100))
          (set-hatred-indices ctrl jak HJ2_TARGET_PRAXIS 0)
          )
        )
      )
    )
  (none)
  )

;; The director //////////////////////////////////////////////////////////////////////////////////
;;   count-time, mission-time, panic-time: the last looks count, mission check, danger sphere.
;;   transport-time: when the next transport may come. transport: the transport flying now.
;;   transport-side: the side of the next one (HJ2_SIDE_FF or HJ2_SIDE_KG, in turn).
;;   music?: its fight music setting is on. hatred?: the war's hatred entries are in the table.
(deftype hj2-war-director (process)
  ((count-time      time-frame)
   (mission-time    time-frame)
   (panic-time      time-frame)
   (transport-time  time-frame)
   (transport       handle)
   (transport-side  int32)
   (music?          symbol)
   (hatred?         symbol)
   )
  (:state-methods
    active
    )
  )


(defun hj2-war-city-level ()
  "The level the transport's art is in: havenj2, Jak 2's city hub, #f while it isn't active (the
transports fly in Jak 2's city only). No side effects."
  (let ((hub (level-get *level* 'havenj2)))
    (if (and hub (= (-> hub status) 'active))
        hub
        (the-as level #f)
        )
    )
  )

(defun hj2-war-panic ()
  "Frighten the citizens near the fighting: a danger sphere (Jak 3's traffic engine add-danger,
level 1: 'panic, they flee) on one Krimzon Guard picked at random among those within
HJ2_WAR_PANIC_RANGE of Jak. The traffic engine also keeps citizens from spawning in it for a few
seconds. Guards ignore this danger type. Returns nothing."
  (let ((te *traffic-engine*)
        (picked (the-as process-drawable #f))
        (n 0)
        )
    (when (and te *target*)
      (let ((trk (-> te tracker1)))
        (dotimes (i (the-as int (-> trk active-object-count)))
          (when (= (-> trk active-object-type-list i) (traffic-type guard-a))
            (let ((g (the-as process-drawable (handle->process (-> trk active-object-list i)))))
              (when (and g
                         (hj2-war-kg? g)
                         (< (vector-vector-distance (-> g root trans) (target-pos 0)) HJ2_WAR_PANIC_RANGE)
                         )
                ;; one at random: the n-th candidate replaces the pick with a chance of 1 in n
                (+! n 1)
                (if (zero? (rand-vu-int-count n))
                    (set! picked g)
                    )
                )
              )
            )
          )
        )
      (when picked
        (let ((d (new 'stack-no-clear 'traffic-danger-info)))
          (set! (-> d sphere quad) (-> picked root trans quad))
          (set! (-> d sphere r) HJ2_WAR_PANIC_RADIUS)
          (vector-reset! (-> d velocity))
          (set! (-> d handle) (the-as handle #f))
          (set! (-> d notify-radius) HJ2_WAR_PANIC_NOTIFY)
          (set! (-> d danger-level) 1.0)
          (set! (-> d decay-rate) 0.0)
          (set! (-> d flags) (the-as uint 1))
          (set! (-> d danger-type) (the-as uint 0))
          (add-danger te d)
          )
        )
      )
    )
  (none)
  )

(defun hj2-war-scare-civilians ()
  "Keep every citizen on foot fleeing (the city is at war): each one active in the traffic gets the
traffic engine's 'panic (civilian.gc: it flees from the danger's place, when walking, waiting or
stepping aside), the danger centered on the nearest guard of the war within HJ2_WAR_PANIC_RANGE,
else on Jak. Returns nothing."
  (let ((te *traffic-engine*))
    (when (and te *target*)
      (let ((trk (-> te tracker1))
            (d (new 'stack-no-clear 'traffic-danger-info))
            )
        (vector-reset! (-> d velocity))
        (set! (-> d handle) (the-as handle #f))
        (set! (-> d notify-radius) HJ2_WAR_PANIC_NOTIFY)
        (set! (-> d danger-level) 1.0)
        (set! (-> d decay-rate) 0.0)
        (set! (-> d flags) (the-as uint 1))
        (set! (-> d danger-type) (the-as uint 0))
        (dotimes (i (the-as int (-> trk active-object-count)))
          ;; civilian-male, civilian-female, civilian-fat
          (when (< (the-as int (-> trk active-object-type-list i)) (the-as int (traffic-type civilian-pilot)))
            (let ((civ (the-as process-drawable (handle->process (-> trk active-object-list i)))))
              (when civ
                ;; the nearest guard of the war, else Jak
                (let ((best (the-as process-drawable #f))
                      (best-d HJ2_WAR_PANIC_RANGE)
                      )
                  (dotimes (j (the-as int (-> trk active-object-count)))
                    (when (= (-> trk active-object-type-list j) (traffic-type guard-a))
                      (let ((g (the-as process-drawable (handle->process (-> trk active-object-list j)))))
                        (when g
                          (let ((dist (vector-vector-distance (-> g root trans) (-> civ root trans))))
                            (when (< dist best-d)
                              (set! best-d dist)
                              (set! best g)
                              )
                            )
                          )
                        )
                      )
                    )
                  (set! (-> d sphere quad) (-> (if best (-> best root trans) (target-pos 0)) quad))
                  )
                (set! (-> d sphere r) HJ2_WAR_PANIC_RADIUS)
                (send-event civ 'panic d)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun hj2-war-rearm-guards ()
  "At war no guard uses the tazer (hj2-war-guard-type, at each weapon change). A Freedom League guard
woken with its tazer before the war's rule applied to it (a guard of the pool kept from before the
war was switched on) is given its weapon again: the weapon change goes through the rule, which
trades the tazer for a rifle or a launcher. Returns nothing."
  (let ((te *traffic-engine*))
    (when te
      (let ((trk (-> te tracker1)))
        (dotimes (i (the-as int (-> trk active-object-count)))
          (when (= (-> trk active-object-type-list i) (traffic-type guard-a))
            (let ((g (the-as crimson-guard (handle->process (-> trk active-object-list i)))))
              (when (and g
                         (= (-> g type) crimson-guard)
                         (= (-> g guard-type) (guard-type tazer))
                         (= (hj2-war-guard-side g) 0)
                         )
                (crimson-guard-method-267 g (guard-type tazer) #f)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun hj2-war-kg-icons-off ()
  "The Krimzon Guards on the street lose the blue minimap icon Jak 3 gives every guard as it goes
out (citizen-method-194): the minimap has no red guard class, and a blue dot would say Freedom
League. The icon fades out (Jak 2's way of dropping one). Returns nothing."
  (let ((te *traffic-engine*))
    (when te
      (let ((trk (-> te tracker1)))
        (dotimes (i (the-as int (-> trk active-object-count)))
          (when (= (-> trk active-object-type-list i) (traffic-type guard-a))
            (let ((g (the-as crimson-guard (handle->process (-> trk active-object-list i)))))
              (when (and g (-> g minimap) (hj2-war-kg? g))
                (logior! (-> g minimap flags) (minimap-flag fade-out))
                (set! (-> g minimap) #f)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior hj2-war-transports hj2-war-director ()
  "Send a troop transport when it's time and none flies, landing near Jak (hj2-transport-spawn):
the two sides in turn, a Krimzon Guard ship (red and yellow guards) then a Freedom Fighters one (blue
guards); the next one 45 to 90 s later. A failed spawn (no landing spot, no process) is tried again
5 s later. Returns nothing. Side effects: transport, transport-time, transport-side."
  (when (and *target*
             (not (handle->process (-> self transport)))
             (>= (current-time) (-> self transport-time))
             )
    (let* ((lev (hj2-war-city-level))
           (proc (if lev
                     (hj2-transport-spawn self (-> self transport-side) lev)
                     (the-as process #f)
                     )
                 )
           )
      (cond
        (proc
          (set! (-> self transport) (process->handle proc))
          (set! (-> self transport-side) (- 1 (-> self transport-side)))
          (set! (-> self transport-time)
                (+ (current-time) (rand-vu-int-range HJ2_WAR_TRANSPORT_MIN HJ2_WAR_TRANSPORT_MAX))
                )
          )
        (else
          (set! (-> self transport-time) (+ (current-time) (seconds 5)))
          )
        )
      )
    )
  (none)
  )

(defbehavior hj2-war-director-update hj2-war-director ()
  "One frame of the war in the city: every 0.5 s whether a Jak 3 mission runs (the invasion then
steps aside, hj2-war-on?), and while a mode is on its counts, panic and hatreds, and in Jak 2's city
its music and transports. Returns nothing. Side effect: the director's music setting."
  (when (time-elapsed? (-> self mission-time) (seconds 0.5))
    (set-time! (-> self mission-time))
    (hj2-war-update-mission!)
    )
  ;; Jak 3's city fight music (cty-faction.gc plays it during a fight near Jak) for the whole war of
  ;; Jak 2's city: a setting of this process, above the city's own music and gone with the process
  (cond
    ((hj2-war-jak2-on?)
     (when (not (-> self music?))
       (set-setting! 'music 'fight1 0.0 0)
       (set! (-> self music?) #t)
       )
     )
    ((-> self music?)
     (remove-setting! 'music)
     (set! (-> self music?) #f)
     )
    )
  ;; the war's hatreds: put in while the war is on (again after a traffic restart reset the table),
  ;; taken out when the war is switched off; left to Jak 3's mission when the war steps aside for one
  ;; (the mission sets its own table)
  (let ((ctrl *cty-attack-controller*))
    (cond
      ((hj2-war-on?)
       (when (and ctrl
                  (nonzero? ctrl)
                  (or (not (-> self hatred?)) (< (-> ctrl hatred-vals length) HJ2_WAR_HATRED_COUNT))
                  )
         (hj2-war-hatred-set! #t)
         (set! (-> self hatred?) #t)
         )
       )
      ((-> self hatred?)
       (if (not (or (hj2-war-switched-on?) (hj2-invasion-switched-on?)))
           (hj2-war-hatred-set! #f)
           )
       (set! (-> self hatred?) #f)
       )
      )
    )
  (when (hj2-war-on?)
    (when (time-elapsed? (-> self count-time) (seconds 0.5))
      (set-time! (-> self count-time))
      (hj2-war-count-looks!)
      (hj2-war-kg-icons-off)
      (hj2-war-rearm-guards)
      (hj2-war-scare-civilians)
      )
    ;; every 2 s: each danger also holds one of the traffic engine's 16 suppression boxes for 5 s
    (when (time-elapsed? (-> self panic-time) (seconds 2))
      (set-time! (-> self panic-time))
      (hj2-war-panic)
      )
    (if (hj2-war-jak2-on?)
        (hj2-war-transports)
        )
    )
  (none)
  )

(defstate active (hj2-war-director)
  :virtual #t
  :code (behavior ()
    (loop
      (hj2-war-director-update)
      (suspend)
      )
    )
  )

(defbehavior hj2-war-director-init-by-other hj2-war-director ()
  "Start the director: counts at once, the first transport HJ2_WAR_FIRST_TRANSPORT later. Returns
nothing (goes active)."
  (set! (-> self count-time) 0)
  (set! (-> self mission-time) 0)
  (set! (-> self panic-time) 0)
  (set! (-> self transport) (the-as handle #f))
  (set! (-> self transport-time) (+ (current-time) HJ2_WAR_FIRST_TRANSPORT))
  (set! (-> self transport-side) HJ2_SIDE_KG)
  (set! (-> self music?) #f)
  (set! (-> self hatred?) #f)
  (go-virtual active)
  )

;; The traffic manager's frame (traffic-manager-method-16, its active state's post), as linked before
;; this file in this DGO, wrapped: while the war is on, it keeps a director among its children.
(define *hj2-war-stock-traffic-update* (method-of-type traffic-manager traffic-manager-method-16))

(defmethod traffic-manager-method-16 ((this traffic-manager))
  "Jak 3's traffic frame, then the war's director started if the war is on and none runs (it is a
child of the traffic manager: it dies with the traffic). Returns nothing."
  (*hj2-war-stock-traffic-update* this)
  ;; switched on, not hj2-war-on?: the director also tells when a Jak 3 mission ends
  (when (and (or (hj2-war-switched-on?) (hj2-invasion-switched-on?)) (not (handle->process (-> *hj2-war-city* director))))
    (let ((proc (process-spawn hj2-war-director :name "hj2-war-director" :to this)))
      (set! (-> *hj2-war-city* director) (if proc
                                             (ppointer->handle proc)
                                             (the-as handle #f)
                                             )
            )
      )
    )
  (none)
  )

(defun hj2-war-city-command ((cmd int))
  "*hj2-war-city-hook* (jak2-haven-city-war.gc), in Jak 3's city: HJ2_WAR_CITY_CHANGED (the war was
switched) runs ctywide's activation again, as a death does: the faction state back to Jak 3's, the
traffic rebuilt (its guards take their looks again), the squads and the attack controller reset.
Returns nothing."
  (when (= cmd HJ2_WAR_CITY_CHANGED)
    (let ((city (level-get *level* 'ctywide)))
      (if (and city (= (-> city status) 'active))
          (ctywide-activate city 'life)
          )
      )
    )
  (none)
  )

;; at every link of this file (Jak 3's city, or havenj2): the previous value pointed into the
;; previous link
(set! *hj2-war-city-hook* hj2-war-city-command)

