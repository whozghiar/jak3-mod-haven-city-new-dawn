;;-*-Lisp-*-
(in-package goal)

;; name: hj2-transport.gc
;; name in dgo: hj2-transport
;; dgos: CWI, HJ2

;; og:jak2-haven-city The war mode's troop transport: Jak 2's Krimzon Guard drop-ship (transport.gc
;; there, levels/city/traffic/vehicle) in Jak 3's traffic, in Jak 2's city (havenj2) and in Jak 3's
;; own city. The war director (hj2-war-city.gc) calls hj2-transport-spawn at the moments it picks:
;; the ship comes down 10 to 18 m from Jak to the height the hover vehicles fly at there (the traffic
;; height map's flight level, as hvehicle's), opens its hatch at the back, drops up to
;; HJ2_TRANSPORT_MAX_GUARDS guards of its side one by one (Jak 2's transport-method-33), closes and
;; flies away, and dies once out of sight. The war sends both sides' ships in turn: a Krimzon Guard
;; ship (red, Jak 2's) drops red and yellow guards, a Freedom Fighters ship (blue) drops blue
;; guards. Jak 2's chin turret (vehicle-turret) is left out: the ship carries no gun.
;;
;; The guards are the traffic's own: Jak 3's crimson-guard kept Jak 2's transport behavior (traffic
;; behavior 6: the exit-transport state, which walks the guard out of the hatch of the process in
;; its spawn params' handle and jumps it to the ground). Each guard process has a side for life
;; (hj2-war-guard-side, GAME: the integrator draws it blue or red when the traffic creates it), so
;; the ship picks a pooled guard of its side (hj2-transport-pick-guard) and wakes it the stock way
;; ('activate-object). No guard of its side free: it drops nothing, retries, and leaves after 8 s
;; without a drop.
;;
;; Invulnerable, as Jak 2's: shots and blows bounce off its hull (penetrated-by none, no 'attack).
;;
;; Models (build-actor, the level port's "models"): hj2-transport (Jak 2's transport rip) and
;; hj2-transport-blue (the same, its red turned blue), the second for side 0. A process
;; looks its art up in its own level: the spawn names the level holding its art group. Sounds: Jak
;; 2's (CTYWIDE3, loaded as 'j2ctywi3 in havenj2; silent where it isn't loaded).

(define-extern hj2-war-on? (function symbol))
(define-extern hj2-war-guard-side (function process int))

;; Guards one ship drops at most (the transport-ag alert mod's number)
(defconstant HJ2_TRANSPORT_MAX_GUARDS 8)

;; How high over the ground the ship hovers to drop its guards: the hover vehicles' upper lane there
;; (*traffic-height-map*'s flight level plus 1.5 m, where hvehicle-physics holds a flying vehicle),
;; at least HJ2_TRANSPORT_HOVER_MIN and at most HJ2_TRANSPORT_HOVER_MAX above the ground (a guard
;; jumping from the hatch looks for the ground up to 20 m below it: crimson-guard exit-transport,
;; enemy-above-ground?)
(defconstant HJ2_TRANSPORT_HOVER_MIN (meters 4))
(defconstant HJ2_TRANSPORT_HOVER_MAX (meters 14))

;; ---------------------------------------------------------------------------------------------
;; The ship (Jak 2's transport)
;; ---------------------------------------------------------------------------------------------

;; Joints (Jak 2's, kept by build-actor): 3 main, 4 hatch. Animations (the rip's order): 2 idle,
;; 3 hatch-open, 4 hatch-close.
(def-actor hj2-transport
  :art (idle-ja hatch-open-ja hatch-close-ja)
  :bounds (0 5 0 17)
  )

;; the Freedom Fighters' ship: the same skeleton and clips, blue
(def-actor hj2-transport-blue
  :art (idle-ja hatch-open-ja hatch-close-ja)
  :bounds (0 5 0 17)
  )

;;   y-dest: the height it hovers at to drop its guards; y-ground: the ground under it. next-drop-time:
;;   when it may try the next guard.
;;   last-drop-time: its last guard dropped (or its landing). spawn-side: the side of the hatch the
;;   next guard walks out of (0 left, 1 right). spawn?: still dropping. leave-time: when it takes
;;   off (0: not decided). max-guard / count-guard: guards to drop / dropped. side: its war side
;;   (0 Freedom League, 1 Krimzon Guard, hj2-war-guard-side's). ambient-sound-id: its engine loop.
(deftype hj2-transport (process-focusable)
  ((y-dest              float)
   (y-ground            float)
   (next-drop-time      time-frame)
   (last-drop-time      time-frame)
   (spawn-side          uint32)
   (spawn?              symbol)
   (leave-time          time-frame)
   (max-guard           uint32)
   (count-guard         uint32)
   (side                int32)
   (ambient-sound-id    sound-id)
   )
  (:state-methods
    come-down
    idle
    leave
    die-fast
    )
  (:methods
    (setup-collision (_type_) none)
    (drop-guard (_type_) none)
    (play-engine-sound (_type_) none)
    )
  )


(defun hj2-transport-pick-guard ((side int))
  "Find, in the traffic's pool of sleeping guards (traffic type guard-a, Jak 3's crimson-guard), one
of side `side` (hj2-war-guard-side) and move it to the head of the pool, the one the traffic's
activate-from-params wakes next. Returns #t when one is there, else #f. Side effects: the order of
the pool's handles."
  (when *traffic-engine*
    (let* ((info (-> *traffic-engine* object-type-info-array (traffic-type guard-a)))
           (arr (-> info array))
           )
      (dotimes (i (-> info inactive-count))
        (let ((proc (handle->process (-> arr i))))
          (when (and proc (= (hj2-war-guard-side proc) side))
            (let ((head (-> arr 0)))
              (set! (-> arr 0) (-> arr i))
              (set! (-> arr i) head)
              )
            (return #t)
            )
          )
        )
      )
    )
  #f
  )

(defun hj2-transport-ground-point ((this hj2-transport) (out vector))
  "Set out to the ground under the ship: its place at y-ground. Returns out."
  (set-vector! out (-> this root trans x) (-> this y-ground) (-> this root trans z) 1.0)
  out
  )

(defmethod drop-guard ((this hj2-transport))
  "Jak 2's transport-method-33, once the delay is over: wake a guard of the ship's side
(hj2-transport-pick-guard) with the traffic's 'activate-object, as Jak 2's: behavior 6 (Jak 3's
crimson-guard exit-transport: it walks out of the hatch of the ship in the params' handle, on
spawn-side, and jumps down), on the nav mesh of the ground under the ship, at the hatch (2 m above
the ship's origin), facing the hatch; guard
type 11 keeps the type the squad gave it. Next try 1 s later (2 s off screen) after a guard, 0.1 s
(1 s) after none. Returns nothing. Side effects: a guard on the street, the pool's order,
spawn-side, count-guard, next-drop-time, last-drop-time."
  (when (>= (current-time) (-> this next-drop-time))
    (let ((params (new 'stack 'traffic-object-spawn-params))
          (on-screen (logtest? (-> this draw status) (draw-control-status on-screen)))
          )
      (set! (-> params proc) #f)
      ;; the nav mesh is on the ground, under the hovering ship
      (let ((nav (find-nearest-nav-mesh (hj2-transport-ground-point this (new 'stack-no-clear 'vector)) 8192.0)))
        (when (and nav *traffic-manager* (hj2-transport-pick-guard (-> this side)))
          (set! (-> params object-type) (traffic-type guard-a))
          (set! (-> params behavior) (the-as uint 6))
          (set! (-> params id) (the-as uint 0))
          (set! (-> params nav-mesh) nav)
          (set! (-> params nav-branch) #f)
          (set! (-> params handle) (process->handle this))
          (set! (-> params handle-parent) (the-as handle #f))
          (set! (-> params user-data) (-> this spawn-side))
          (set! (-> params flags) (traffic-spawn-flags))
          (set! (-> params guard-type) (the-as uint 11))
          (set! (-> params entity) #f)
          (vector-reset! (-> params velocity))
          (vector-copy! (-> params position) (-> this root trans))
          (+! (-> params position y) 8192.0)
          (quaternion-rotate-local-y! (-> params rotation) (-> this root quat) 32768.0)
          (send-event *traffic-manager* 'activate-object params)
          )
        )
      (cond
        ((-> params proc)
         (set! (-> this spawn-side) (- 1 (the-as int (-> this spawn-side))))
         (+! (-> this count-guard) 1)
         (set-time! (-> this last-drop-time))
         (set! (-> this next-drop-time) (+ (current-time) (if on-screen (seconds 1) (seconds 2))))
         )
        (else
          (set! (-> this next-drop-time) (+ (current-time) (if on-screen (seconds 0.1) (seconds 1))))
          )
        )
      )
    )
  (none)
  )

(defmethod play-engine-sound ((this hj2-transport))
  "Jak 2's transport-method-35: the engine loop (Jak 2's \"transport\"), louder the closer the
ship is to the ground (silent 35 m up), higher the faster it climbs or sinks. Returns nothing. Side
effects: the loop's sound, the shared static spec's volume and pitch."
  (let ((speed-k (lerp-scale 0.0 2.0 (fabs (-> this root transv y)) 0.0 122880.0))
        (height-k (lerp-scale 0.0 1.0 (- (-> this root trans y) (-> this y-dest)) 143360.0 20480.0))
        (spec (static-sound-spec "transport" :volume 0.0 :mask (pitch reg0)))
        )
    (set! (-> spec volume) (the int (* 1024.0 height-k)))
    (set! (-> spec pitch-mod) (the int (* 1524.0 speed-k)))
    (sound-play-by-spec spec (-> this ambient-sound-id) (-> this root trans))
    )
  (none)
  )

(defmethod setup-collision ((this hj2-transport))
  "The ship's collision: a solid obstacle Jak bumps into and shots stop on, that nothing hurts
(Jak 2's: penetrated-by none). Jak 2's two collide meshes (the hull and the hatch) are replaced by
one 8 m sphere on joint 3, centered at the landing ground (a sphere centered higher is a ceiling
for Jak beside it), as build-actor models may carry no collide mesh. Returns nothing. Side
effects: root."
  (let ((cs (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> cs dynam) (copy *standard-dynamics* 'process))
    (set! (-> cs reaction) cshape-reaction-default)
    (set! (-> cs no-reaction) (the-as (function collide-shape-moving collide-query vector vector object) nothing))
    (set! (-> cs penetrated-by) (penetrate))
    (let ((grp (new 'process 'collide-shape-prim-group cs (the-as uint 1) 0)))
      (set! (-> cs total-prims) (the-as uint 2))
      (set! (-> grp prim-core collide-as) (collide-spec obstacle))
      (set! (-> grp prim-core collide-with) (collide-spec jak player-list))
      (set! (-> grp prim-core action) (collide-action solid))
      (set-vector! (-> grp local-sphere) 0.0 20480.0 0.0 69632.0)
      (set! (-> cs root-prim) grp)
      )
    (let ((hull (new 'process 'collide-shape-prim-sphere cs (the-as uint 0))))
      (set! (-> hull prim-core collide-as) (collide-spec obstacle))
      (set! (-> hull prim-core collide-with) (collide-spec jak player-list))
      (set! (-> hull prim-core action) (collide-action solid))
      (set! (-> hull transform-index) 3)
      (set-vector! (-> hull local-sphere) 0.0 0.0 0.0 32768.0)
      )
    (set! (-> cs nav-radius) (* 0.75 (-> cs root-prim local-sphere w)))
    (let ((rp (-> cs root-prim)))
      (set! (-> cs backup-collide-as) (-> rp prim-core collide-as))
      (set! (-> cs backup-collide-with) (-> rp prim-core collide-with))
      )
    (set! (-> this root) cs)
    )
  (none)
  )

(defmethod run-logic? ((this hj2-transport))
  "Always run (Jak 2's): the ship flies and drops guards far from the camera too."
  #t
  )

(defmethod deactivate ((this hj2-transport))
  "Stop the engine loop with the process (Jak 2's). Returns nothing."
  (sound-stop (-> this ambient-sound-id))
  (call-parent-method this)
  (none)
  )

(defbehavior hj2-transport-event-handler hj2-transport ((proc process) (argc int) (message symbol) (block event-message-block))
  "Jak 2's events: 'die-fast (gone at once), 'leave (take off now, the war director's recall),
'guards-left (answers how many guards it has still to drop), 'stop-spawning (drop no more); no
'attack (it can't be destroyed). proc: the sender, argc: the parameter count, message: the event,
block: its parameters. Returns the event's answer. Side effects: state, spawn?."
  (case message
    (('die-fast)
     (go-virtual die-fast)
     )
    (('leave)
     (if (not (and (-> self next-state)
                   (let ((name (-> self next-state name)))
                     (or (= name 'leave) (= name 'die-fast))
                     )
                   )
              )
         (go-virtual leave)
         )
     )
    (('guards-left)
     (- (-> self max-guard) (-> self count-guard))
     )
    (('stop-spawning)
     (set! (-> self spawn?) #f)
     #f
     )
    )
  )

;; Jak 2's: sinks from 40 m up to its hover height (twice the height left per second, 30 m/s at
;; most), then idle. The war switched off: it turns back.
(defstate come-down (hj2-transport)
  :virtual #t
  :event hj2-transport-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    )
  :code (behavior ()
    (ja-channel-push! 1 0)
    (ja-no-eval :group! hj2-transport-idle-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (sleep-code)
    )
  :post (behavior ()
    (set! (-> self root transv y) (* 2.0 (- (-> self y-dest) (-> self root trans y))))
    (set! (-> self root transv y) (fmax -122880.0 (fmin 122880.0 (-> self root transv y))))
    (+! (-> self root trans y) (* (-> self root transv y) (seconds-per-frame)))
    (cond
      ((not (hj2-war-on?))
       (go-virtual leave)
       )
      ((< (fabs (- (-> self root trans y) (-> self y-dest))) 409.6)
       (go-virtual idle)
       )
      )
    (play-engine-sound self)
    (transform-post)
    )
  )

;; Jak 2's: landed, opens its hatch and drops its guards; takes off 3 s after its last one (or
;; after 8 s without one: no guard of its side free, or the war switched off).
(defstate idle (hj2-transport)
  :virtual #t
  :event hj2-transport-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set-time! (-> self last-drop-time))
    (set! (-> self root transv y) 0.0)
    (set! (-> self next-drop-time) 0)
    )
  :code (behavior ()
    (ja-channel-push! 1 0)
    (sound-play "tran-door-open")
    (ja-no-eval :group! hj2-transport-hatch-open-ja :num! (seek! max 0.5) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! max 0.5))
      )
    (sleep-code)
    )
  :post (behavior ()
    (if (-> self spawn?)
        (drop-guard self)
        )
    (when (and (zero? (-> self leave-time))
               (or (>= (-> self count-guard) (-> self max-guard))
                   (time-elapsed? (-> self last-drop-time) (seconds 8))
                   (not (hj2-war-on?))
                   )
               )
      (set! (-> self leave-time) (+ (current-time) (seconds 3)))
      (set! (-> self spawn?) #f)
      )
    (if (and (nonzero? (-> self leave-time)) (< (-> self leave-time) (current-time)))
        (go-virtual leave)
        )
    (play-engine-sound self)
    (transform-post)
    )
  )

;; Jak 2's: gone at once, its engine loop stopped
(defstate die-fast (hj2-transport)
  :virtual #t
  :code (behavior ()
    (sound-stop (-> self ambient-sound-id))
    (cleanup-for-death self)
    )
  )

;; Jak 2's: closes its hatch and climbs (10 m/s^2, 30 m/s at most); gone once off screen 40 m above
;; its hover height
;; (or after 15 s: a camera looking up kept Jak 2's on screen)
(defstate leave (hj2-transport)
  :virtual #t
  :event hj2-transport-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self root transv y) 0.0)
    (set! (-> self spawn?) #f)
    )
  :code (behavior ()
    (ja-channel-push! 1 0)
    (sound-play "tran-thrust")
    (sound-play "tran-door-close")
    (ja-no-eval :group! hj2-transport-hatch-close-ja :num! (seek! max 0.2) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek! max 0.2))
      )
    (sleep-code)
    )
  :post (behavior ()
    (play-engine-sound self)
    (+! (-> self root transv y) (* 40960.0 (seconds-per-frame)))
    (set! (-> self root transv y) (fmax -122880.0 (fmin 122880.0 (-> self root transv y))))
    (+! (-> self root trans y) (* (-> self root transv y) (seconds-per-frame)))
    (if (or (and (not (logtest? (-> self draw status) (draw-control-status on-screen)))
                 (< 163840.0 (- (-> self root trans y) (-> self y-dest)))
                 )
            (time-elapsed? (-> self state-time) (seconds 15))
            )
        (go-virtual die-fast)
        )
    (transform-post)
    )
  )

(defbehavior hj2-transport-init-by-other hj2-transport ((pos vector) (side int) (lev level))
  "Set the ship up over pos (the ground under it), its hatch (its back) towards Jak, for side `side`
(0 Freedom League, 1 Krimzon Guard), its art looked up in `lev` (a process looks its art up in its
own level), 40 m above the height it hovers at to drop its guards (the hover vehicles' flight level
there, *traffic-height-map*, kept HJ2_TRANSPORT_HOVER_MIN to HJ2_TRANSPORT_HOVER_MAX above the
ground), then come-down. Returns nothing (goes to come-down; process-drawable-art-error without its
art). Side effects: all of the ship's fields."
  (setup-collision self)
  (vector-copy! (-> self root trans) pos)
  (let ((away (vector-! (new 'stack-no-clear 'vector) pos (target-pos 0))))
    (set! (-> away y) 0.0)
    (vector-normalize! away 1.0)
    (forward-up-nopitch->quaternion (-> self root quat) away *up-vector*)
    )
  (vector-identity! (-> self root scale))
  (set! (-> self side) side)
  (set! (-> self max-guard) (the-as uint HJ2_TRANSPORT_MAX_GUARDS))
  (set! (-> self count-guard) (the-as uint 0))
  (set! (-> self spawn-side) (the-as uint 0))
  (set! (-> self level) lev)
  (initialize-skeleton self (if (zero? side) *hj2-transport-blue-sg* *hj2-transport-sg*) (the-as pair 0))
  (set! (-> self y-ground) (-> self root trans y))
  (set! (-> self y-dest)
        (fmax (+ (-> self y-ground) HJ2_TRANSPORT_HOVER_MIN)
              (fmin (+ (-> self y-ground) HJ2_TRANSPORT_HOVER_MAX)
                    (if *traffic-height-map*
                        (+ 6144.0 (get-height-at-point *traffic-height-map* (-> self root trans)))
                        (-> self y-ground)
                        )
                    )
              )
        )
  (set! (-> self root trans y) (+ (-> self y-dest) 163840.0))
  (set! (-> self spawn?) #t)
  (set! (-> self leave-time) 0)
  (set! (-> self ambient-sound-id) (new-sound-id))
  (go-virtual come-down)
  (none)
  )

;; ---------------------------------------------------------------------------------------------
;; The war director's entry point
;; ---------------------------------------------------------------------------------------------

(defun hj2-transport-ground ((pos vector))
  "Drop pos onto the ground (backgnd) below it: a 1 m sphere cast from 5 m above to 25 m below.
Returns #t with pos's y on the ground, #f (pos unchanged) when nothing is there."
  (let ((cq (new 'stack-no-clear 'collide-query)))
    (vector-copy! (-> cq start-pos) pos)
    (+! (-> cq start-pos y) 20480.0)
    (vector-reset! (-> cq move-dist))
    (set! (-> cq move-dist y) -122880.0)
    (set! (-> cq radius) 4096.0)
    (set! (-> cq collide-with) (collide-spec backgnd))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> cq action-mask) (collide-action solid))
    (when (>= (fill-and-probe-using-line-sphere *collide-cache* cq) 0.0)
      (set! (-> pos y) (-> cq best-other-tri intersect y))
      #t
      )
    )
  )

(defun hj2-transport-spawn ((parent process) (side int) (lev level))
  "Send a troop transport of side `side` (0 Freedom League, blue guards; 1 Krimzon Guard, red
guards) next to Jak, like the transport-ag alert mod: up to 8 random spots 10 to 18 m around him,
the first on his far side from the camera (a hull landing between them hid Jak behind it), with
ground under it (hj2-transport-ground) and a nav mesh within 2 m of that ground.
parent: the process it becomes a child of (it dies with it), lev: the level holding the
hj2-transport art group ('havenj2 in Jak 2's city, 'ctypesa in Jak 3's).
Returns the ship, or #f: no Jak, no level, no traffic, no spot found, no free process, or its art
missing (that process is killed). Keep its handle in a process field or a structure (a global
symbol drops a handle's pid); the ship is gone once handle->process gives #f."
  (when (and *target* lev *traffic-manager*)
    (let ((jak (target-pos 0))
          (cam (camera-pos))
          (pos (new 'stack-no-clear 'vector))
          )
      (dotimes (i 8)
        (let ((angle (rand-vu-float-range 0.0 65536.0))
              (dist (rand-vu-float-range 40960.0 73728.0))
              )
          (set-vector! pos (+ (-> jak x) (* dist (cos angle))) (-> jak y) (+ (-> jak z) (* dist (sin angle))) 1.0)
          (when (and (< (+ (* (- (-> pos x) (-> jak x)) (- (-> cam x) (-> jak x)))
                           (* (- (-> pos z) (-> jak z)) (- (-> cam z) (-> jak z)))
                           )
                        0.0
                        )
                     (hj2-transport-ground pos)
                     (find-nearest-nav-mesh pos 8192.0)
                     )
            (let ((ptr (process-spawn hj2-transport pos side lev :to parent)))
              (when ptr
                (let ((proc (ppointer->process ptr)))
                  ;; `go` sets next-state at once: come-down, or process-drawable-art-error when its
                  ;; art is not in lev (drawn nowhere, never leaves)
                  (if (and (-> proc next-state) (= (-> proc next-state name) 'come-down))
                      (return proc)
                      )
                  (deactivate proc)
                  )
                )
              (return (the-as process #f))
              )
            )
          )
        )
      )
    )
  (the-as process #f)
  )
