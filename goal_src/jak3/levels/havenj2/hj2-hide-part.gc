;; hj2-hide's texture page 1530: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-hide.jsonc), as names and sizes (w | h << 16)
(define *hj2-hide-sprite-names* (new 'static 'boxed-array :type string "butterfly-wing"))

(define *hj2-hide-sprite-sizes* (new 'static 'boxed-array :type uint32 #x200020))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-hide (hj2-sprite-page-new 1530 *hj2-hide-sprite-names* *hj2-hide-sprite-sizes*))

