;;-*-Lisp-*-
(in-package goal)

;; name: hj2-vin-obs.gc
;; name in dgo: hj2-vin-obs
;; dgos: HJV

;; og:jak2-haven-city Level code for hj2-vin, Vin's power station room (Jak 2's vin-turbine,
;; levels/city/vinroom/vinroom-obs.gc there): the 7 turbines, throwing lightning at the walls. Their
;; model is Jak 2's, rebuilt by build-actor (hj2-vin-turbine.glb, made by the level port,
;; scripts/level_port); it doesn't move (its idle is one frame). Not ported: the glow where a bolt
;; lands (Jak 2's part 1245, defined in vinroom-obs.gc, not in the ported vinroom-part.gc).

;; Jak 2's vin-turbine.
;;   dont-draw-outside?: the entity's extra-id lump is set: hidden while the camera is on the far
;;     side of outside-plane (outside the room)
;;   lightning-timer:    when the next bolt may be thrown
;;   outside-plane:      the room's wall plane (game units, inside: positive)
;;   lightning-plane:    the same plane moved 10m in: no bolts while the camera is beyond it
(deftype hj2-vin-turbine (process-drawable)
  ((dont-draw-outside?  symbol)
   (lightning-timer     time-frame)
   (outside-plane       plane  :inline)
   (lightning-plane     plane  :inline)
   )
  (:state-methods
    idle
    dormant
    )
  )


(def-actor hj2-vin-turbine
  :bounds (0 0 0 6)
  )

;; Jak 2's lightning-turbine (its lightning-spec 17), with the texture of Jak 3's lightning (Jak 2's
;; default lightning texture, page #xc index #x83, is page #x4 index #x3f in Jak 3: lightning.gc,
;; as in hj2-pcab-obs.gc). A bolt lasts 1 s.
(define *hj2-vin-turbine-lightning* (new 'static 'lightning-spec
                                      :name #f
                                      :flags (lightning-spec-flags lsf2)
                                      :start-color (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                                      :end-color (new 'static 'rgba :a #x80)
                                      :fade-to-color (new 'static 'rgba :r #xbf :b #x8f :a #x5)
                                      :fade-start-factor 0.2
                                      :fade-time 120.0
                                      :texture (new 'static 'texture-id :index #x3f :page #x4)
                                      :reduction 0.42
                                      :num-points 16
                                      :box-size 12288.0
                                      :merge-factor 0.5
                                      :merge-count 4
                                      :radius 2048.0
                                      :duration 300.0
                                      :sound #f
                                      )
        )

(defbehavior hj2-vin-turbine-spark hj2-vin-turbine ()
  "Jak 2's vin-turbine post: unless the camera is beyond lightning-plane (turbines with
dont-draw-outside? only), once lightning-timer is past: picks a random direction 10 to 40 degrees
off vertical (up or down, any heading), probes the background along it from 3.8m + 1.5m out to 20m,
and if it hits a wall farther than 2m, spawns a lightning-tracker (1 s bolt) from 3.8m out to the
hit point. The next try waits 0.1 to 0.4 s after a hit, or the next frame after a miss. Returns
nothing."
  (when (and (or (not (-> self dont-draw-outside?))
                 (>= (vector4-dot (the-as vector (-> self lightning-plane)) (math-camera-pos)) 0.0)
                 )
             (< (-> self lightning-timer) (current-time))
             )
    (let ((rot (new 'stack-no-clear 'matrix))
          (dir (vector-rotate-x! (new 'stack-no-clear 'vector) *y-vector* (* 182.04445 (rand-vu-float-range 10.0 40.0))))
          (start (new 'stack-no-clear 'vector))
          (cq (new 'stack-no-clear 'collide-query))
          )
      (if (rand-vu-percent? 0.5)
          (vector-negate! dir dir)
          )
      (vector-rotate-y! dir dir (* 182.04445 (rand-vu-float-range 0.0 360.0)))
      (vector+float*! start (-> self root trans) dir 15564.8)
      (vector-copy! (-> cq start-pos) start)
      ;; a random tilt (up to 25 degrees around x, 5 around z), as Jak 2's
      (set-vector!
        (-> cq move-dist)
        (rand-vu-float-range -4551.1113 4551.1113)
        0.0
        (rand-vu-float-range -910.2222 910.2222)
        1.0
        )
      (matrix-rotate-zyx! rot (-> cq move-dist))
      (let ((v (vector-rotate*! (new 'stack-no-clear 'vector) dir rot)))
        (vector-normalize! v 6144.0)
        (vector+! (-> cq start-pos) (-> cq start-pos) v)
        (vector-normalize-copy! (-> cq move-dist) v 81920.0)
        )
      (set! (-> cq radius) 409.6)
      (set! (-> cq collide-with) (collide-spec backgnd))
      (set! (-> cq ignore-process0) self)
      (set! (-> cq ignore-process1) #f)
      (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
      (set! (-> cq action-mask) (collide-action solid))
      (when (>= (fill-and-probe-using-line-sphere *collide-cache* cq) 0.0)
        (set! (-> self lightning-timer) (+ (current-time) (the int (* 300.0 (rand-vu-float-range 0.1 0.4)))))
        (let ((hit (vector-copy! (new 'stack-no-clear 'vector) (-> cq best-other-tri intersect))))
          (if (< 8192.0 (vector-vector-distance start hit))
              (process-spawn
                lightning-tracker
                :init lightning-tracker-init
                *hj2-vin-turbine-lightning*
                0
                (the-as symbol #f)
                self
                start
                hit
                :name "lightning-tracker"
                :to self
                )
              )
          )
        )
      )
    )
  (none)
  )

;; hidden (camera outside the room): back to idle once the camera is inside again
(defstate dormant (hj2-vin-turbine)
  :virtual #t
  :enter (behavior ()
    (logior! (-> self draw status) (draw-control-status no-draw))
    )
  :exit (behavior ()
    (logclear! (-> self draw status) (draw-control-status no-draw))
    )
  :trans (behavior ()
    (if (>= (vector4-dot (the-as vector (-> self outside-plane)) (math-camera-pos)) 0.0)
        (go-virtual idle)
        )
    )
  :code sleep-code
  )

;; still (its pose is one frame), throwing lightning; hides when the camera leaves the room
(defstate idle (hj2-vin-turbine)
  :virtual #t
  :trans (behavior ()
    (if (and (-> self dont-draw-outside?)
             (< (vector4-dot (the-as vector (-> self outside-plane)) (math-camera-pos)) 0.0)
             )
        (go-virtual dormant)
        )
    )
  :code sleep-code
  :post (behavior ()
    (hj2-vin-turbine-spark)
    (ja-post)
    )
  )

(defmethod init-from-entity! ((this hj2-vin-turbine) (arg0 entity-actor))
  "Jak 2's vin-turbine setup: placement, skeleton, the room's planes, dont-draw-outside? from the
extra-id lump (the level port writes it as an int32), then idle, or dormant if it must hide now.
arg0: the entity. Returns nothing."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-vin-turbine-sg* (the-as pair 0))
  (set-vector! (-> this outside-plane) 0.707 0.0 0.707 -6377922.5)
  (set! (-> this lightning-plane quad) (-> this outside-plane quad))
  (set! (-> this lightning-plane w) -6419865.5)
  (set! (-> this dont-draw-outside?)
        (nonzero? (res-lump-value (-> this entity) 'extra-id uint128 :time -1000000000.0))
        )
  (set! (-> this lightning-timer) 0)
  (ja-post)
  (if (and (-> this dont-draw-outside?)
           (< (vector4-dot (the-as vector (-> this outside-plane)) (math-camera-pos)) 0.0)
           )
      (go (method-of-object this dormant))
      (go (method-of-object this idle))
      )
  (none)
  )
