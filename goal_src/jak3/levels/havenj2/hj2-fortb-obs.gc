(set! (-> *hj2-fort-turret-enemy-info* fact-defaults) *fact-info-enemy-defaults*)

(defun hj2-fort-turret-draw-laser ((start vector) (end vector))
  "Draw the turret's laser from start to end (Jak 2's fort-turret-draw-laser) with Jak 3's laser
sight beam (GAME part 207, the red laser of Jak's gun, Jak 2's 3064 there), one frame long and
thinner near the camera (full width 16m away). Changes the part's width and timer specs for the
launch and restores them. Returns none."
  (let* ((s4-0 (-> *part-id-table* 207))
         (s3-0 (get-field-spec-by-id s4-0 (sp-field-id spt-scale-x)))
         (s2-0 (get-field-spec-by-id s4-0 (sp-field-id spt-timer)))
         (f30-0 (-> s3-0 initial-valuef))
         (f28-0 (-> s3-0 random-rangef))
         (f26-0 (-> s2-0 initial-valuef))
         )
    (let ((f0-4 (fmin 1.0 (fmax 0.0 (* 0.000015287453 (+ -122.88 (vector-vector-distance (camera-pos) start)))))))
      (set! (-> s3-0 initial-valuef) (* f30-0 f0-4))
      (set! (-> s3-0 random-rangef) (* f28-0 f0-4))
      )
    ;; the timer spec holds ticks as int bits: 5 ticks, one frame
    (set! (-> s2-0 initial-valuef) (the-as float #x5))
    (draw-beam s4-0 start (vector-! (new 'stack-no-clear 'vector) end start) #t)
    (set! (-> s3-0 initial-valuef) f30-0)
    (set! (-> s3-0 random-rangef) f28-0)
    (set! (-> s2-0 initial-valuef) f26-0)
    )
  (none)
  )

(defmethod enemy-common-post ((this hj2-fort-turret))
  "The enemy's post, then carry and push Jak (the turret is a rideable pusher), and draw the laser
from the lasersight joint to where it ends, with a glow there: Jak 3's laser sight spot on an
enemy (parts 211 and 210, GAME) when it touches Jak, its spot on a wall (212) else. Side effects:
the collision, particles."
  ((method-of-type enemy enemy-common-post) this)
  (let ((s5-0 (-> this root)))
    (update-transforms s5-0)
    (pull-riders! s5-0)
    (do-push-aways s5-0)
    )
  ;; no laser before its first probe (beam-intersect #f)
  (when (and (-> this beam-intersect) (not (and (-> this next-state) (= (-> this next-state name) 'die))))
    (hj2-fort-turret-draw-laser
      (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 12))
      (-> this target-bullseye)
      )
    (case (-> this beam-intersect)
      (('target)
       (launch-particles (-> *part-id-table* 211) (-> this target-bullseye))
       (launch-particles (-> *part-id-table* 210) (-> this target-bullseye))
       )
      (('wall)
       (launch-particles (-> *part-id-table* 212) (-> this target-bullseye))
       )
      )
    )
  (none)
  )

(defmethod aim-at-target ((this hj2-fort-turret))
  "Turn and tilt the gun one frame towards Jak (Jak 2's fort-turret-method-139): the turn clamped
to 50 degrees each side of the placement's facing (behind it: the clamp on his side), the tilt to
45 degrees up or down, aimed a little above him (2m at the gun's distance); aim-pos becomes where
the barrel points now, at Jak's distance, from gunfire1. Side effects: aim-pos, desired/current
twist and tilt, the root's rotation, the head's joint-mod."
  (let ((a0-2 (the-as process-focusable (handle->process (-> this focus handle)))))
    (if a0-2
        (vector-copy! (-> this aim-pos) (get-trans a0-2 3))
        )
    )
  (let ((s4-0 (new 'stack-no-clear 'vector))
        (s5-2 (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 4)))
        )
    (let ((s3-0 (new 'stack-no-clear 'vector)))
      (vector-! s4-0 (-> this aim-pos) (-> this root trans))
      (vector-flatten! s4-0 s4-0 (-> this init-mat uvec))
      (vector-normalize! s4-0 1.0)
      (set! (-> this desired-twist) (asin (vector-dot (-> this init-mat rvec) s4-0)))
      (set! (-> this desired-twist) (fmin 9102.223 (fmax -9102.223 (-> this desired-twist))))
      (cond
        ((< 0.0 (vector-dot (-> this init-mat fvec) s4-0))
         )
        ((< (-> this desired-twist) 0.0)
         (set! (-> this desired-twist) -9102.223)
         )
        (else
          (set! (-> this desired-twist) 9102.223)
          )
        )
      (set! (-> this desired-tilt) 0.0)
      (when (< (fabs (-> this desired-twist)) 9102.223)
        (vector-normalize-copy! s3-0 (-> this node-list data 3 bone transform uvec) 1.0)
        (vector-! s4-0 (-> this aim-pos) s5-2)
        (set! (-> this desired-tilt)
              (- (atan 8192.0 (vector-normalize-ret-len! s4-0 1.0)) (asin (vector-dot s3-0 s4-0)))
              )
        (set! (-> this desired-tilt) (fmin 8192.0 (fmax -8192.0 (-> this desired-tilt))))
        )
      )
    (vector-normalize-copy!
      (-> this aim-pos)
      (-> this node-list data 4 bone transform fvec)
      (vector-vector-distance s5-2 (-> this aim-pos))
      )
    )
  (vector+! (-> this aim-pos) (-> this aim-pos) (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 7)))
  (turn-gun this 0.3 364.0889)
  (none)
  )

(defmethod turn-gun ((this hj2-fort-turret) (rate float) (max-step float))
  "Move the gun's turn and tilt towards desired-twist and desired-tilt by rate of the way, at most
max-step a frame (Jak 2's fort-turret-method-140), after finding Jak and his bots riding it.
rate: the fraction of the way (0 to 1). max-step: an angle. Side effects: gun-twist, gun-tilt, the
root's rotation, the head's joint-mod, the riders."
  (rider-trans)
  (let ((s3-0 (new 'stack-no-clear 'matrix)))
    (+! (-> this gun-twist) (fmax (- max-step) (fmin max-step (* rate (- (-> this desired-twist) (-> this gun-twist))))))
    (matrix-rotate-y! s3-0 (-> this gun-twist))
    (matrix*! s3-0 s3-0 (-> this init-mat))
    (matrix->quaternion (-> this root quat) s3-0)
    )
  (+! (-> this gun-tilt) (fmax (- max-step) (fmin max-step (* rate (- (-> this desired-tilt) (-> this gun-tilt))))))
  (quaternion-axis-angle! (-> this gun-tilt-jm quat) 1.0 0.0 0.0 (-> this gun-tilt))
  (none)
  )

(defmethod update-laser ((this hj2-fort-turret))
  "Probe the laser (Jak 2's fort-turret-method-141): a 40m line from the lasersight joint along its
z. It ends on Jak ('target: target-timeout is now), on something else ('wall), or nowhere
('nothing, full length). Side effects: target-bullseye, beam-intersect, target-timeout."
  (let* ((s5-0 (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 12)))
         (v1-3 (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> this node-list data 12 bone transform fvec) 1.0))
         (s4-1 (vector-float*! (new 'stack-no-clear 'vector) v1-3 163840.0))
         )
    (let ((s3-0 (new 'stack-no-clear 'collide-query)))
      (vector-copy! (-> s3-0 start-pos) s5-0)
      (vector-copy! (-> s3-0 move-dist) s4-1)
      (let ((v1-6 s3-0))
        (set! (-> v1-6 radius) 409.6)
        (set! (-> v1-6 collide-with)
              (collide-spec backgnd jak crate obstacle hit-by-player-list hit-by-others-list player-list pusher)
              )
        (set! (-> v1-6 ignore-process0) this)
        (set! (-> v1-6 ignore-process1) #f)
        (set! (-> v1-6 ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
        (set! (-> v1-6 action-mask) (collide-action solid))
        )
      (let ((f30-0 (fill-and-probe-using-line-sphere *collide-cache* s3-0)))
        (cond
          ((>= f30-0 0.0)
           (set! (-> this beam-intersect) 'wall)
           (when (-> s3-0 best-other-tri collide-ptr)
             (let ((a0-14 (as-type (-> s3-0 best-other-tri collide-ptr) collide-shape-prim)))
               (when (and a0-14 (= (-> a0-14 cshape process type) target))
                 (set-time! (-> this target-timeout))
                 (set! (-> this beam-intersect) 'target)
                 )
               )
             )
           (vector-float*! s4-1 s4-1 f30-0)
           )
          (else
            (set! (-> this beam-intersect) 'nothing)
            )
          )
        )
      )
    (vector+! (-> this target-bullseye) s5-0 s4-1)
    )
  (none)
  )

(defmethod fire-shot ((this hj2-fort-turret) (joint int))
  "Fire one guard shot (Jak 3's guard-shot, GAME) from the barrel at joint (7 to 9) towards aim-pos
at 120 m/s, spread at random (less the farther the aim), Jak 3's default damage (Jak 2's
fort-turret-method-142, silent: its turret-shot sounds aren't in Jak 3). Side effects: spawns the
projectile (child of the turret, notifies it when it hits), flash-state #t."
  (let ((v1-2 (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data joint)))
        (s4-0 (new 'stack-no-clear 'projectile-init-by-other-params))
        )
    (let* ((s2-1 (vector-! (new 'stack-no-clear 'vector) (-> this aim-pos) v1-2))
           (f30-1 (fmin 16384.0 (/ 2013265900.0 (vector-length s2-1))))
           (s3-0 (new 'stack-no-clear 'vector))
           )
      (set! (-> s4-0 ent) (-> this entity))
      (set! (-> s4-0 charge) 1.0)
      (set! (-> s4-0 options) (projectile-options))
      (vector-copy! (-> s4-0 pos) v1-2)
      (set! (-> s4-0 notify-handle) (process->handle this))
      (set! (-> s4-0 owner-handle) (the-as handle #f))
      (set! (-> s4-0 target-handle) (the-as handle #f))
      (set! (-> s4-0 target-pos quad) (the-as uint128 0))
      (set! (-> s4-0 ignore-handle) (process->handle this))
      (let* ((v1-10 *game-info*)
             (a0-18 (+ (-> v1-10 attack-id) 1))
             )
        (set! (-> v1-10 attack-id) a0-18)
        (set! (-> s4-0 attack-id) a0-18)
        )
      (set! (-> s4-0 timeout) (seconds 4))
      (vector-normalize-copy! (-> s4-0 vel) s2-1 491520.0)
      ;; the spread: two random pushes across the shot's direction
      (set-vector! s3-0 (-> s2-1 z) (-> s2-1 y) (- (-> s2-1 x)) 1.0)
      (vector-normalize! s3-0 (rand-vu-float-range (- f30-1) f30-1))
      (vector+! (-> s4-0 vel) (-> s4-0 vel) s3-0)
      (vector-cross! s3-0 s3-0 (-> s4-0 vel))
      (vector-normalize! s3-0 (rand-vu-float-range (- f30-1) f30-1))
      (vector+! (-> s4-0 vel) (-> s4-0 vel) s3-0)
      )
    (spawn-projectile guard-shot s4-0 this *default-dead-pool*)
    )
  (set! (-> this flash-state) #t)
  (none)
  )

;; Jak in its laser: rises, then fires 3 shots (barrels 7, 8, 9) with the shoot animation, 0.33 s
;; apart, waits 1.5 s, again, following him. Back to hostile (then sweep) once the laser has missed
;; him for 0.5 s or a shot hit him less than 2 s ago.
(defstate attack (hj2-fort-turret)
  :virtual #t
  :event enemy-event-handler
  :exit (behavior ()
    (set! (-> self flash-state) #f)
    )
  :trans (behavior ()
    (if (and (logtest? (-> self enemy-flags) (enemy-flag victory)) (-> self enemy-info use-victory))
        (go-virtual victory)
        )
    (when (time-elapsed? (-> self state-time) (-> self reaction-time))
      (if (>= 2 (the-as int (-> self focus aware)))
          (go-stare self)
          )
      )
    (set! (-> self root penetrated-by) (get-penetrated-by self))
    (update-laser self)
    (if (or (time-elapsed? (-> self target-timeout) (seconds 0.5))
            (not (time-elapsed? (-> self last-hit-time) (seconds 2)))
            )
        (go-virtual hostile)
        )
    (aim-at-target self)
    )
  :code (behavior ()
    (ja-no-eval :group! hj2-fort-turret-rise-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (suspend-for (seconds 0.5)
      )
    (until #f
      (let ((gp-2 7))
        (dotimes (s5-2 3)
          (if (-> self can-shoot)
              (fire-shot self gp-2)
              )
          (ja-no-eval :group! hj2-fort-turret-shoot-ja :num! (seek!) :frame-num 0.0)
          (until (ja-done? 0)
            (suspend)
            (ja :num! (seek!))
            )
          (suspend-for (seconds 0.33)
            )
          (+! gp-2 1)
          )
        )
      (set! (-> self flash-state) #f)
      (suspend-for (seconds 1.5)
        )
      )
    #f
    )
  :post enemy-simple-post
  )

;; sweeping its laser 45 degrees each side of where it faces, on its sync; attacks once the laser
;; touches Jak (and no shot hit him in the last 2 s)
(defstate sweep (hj2-fort-turret)
  :virtual #t
  :event enemy-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (if (and (logtest? (-> self enemy-flags) (enemy-flag victory)) (-> self enemy-info use-victory))
        (go-virtual victory)
        )
    (when (time-elapsed? (-> self state-time) (-> self reaction-time))
      (if (>= 2 (the-as int (-> self focus aware)))
          (go-stare self)
          )
      )
    (set! (-> self root penetrated-by) (get-penetrated-by self))
    (set! (-> self desired-twist) (* 8192.0 (cos (get-scaled-val! (-> self sync) 32768.0 0))))
    (turn-gun self 0.1 91.022224)
    (update-laser self)
    (if (and (not (time-elapsed? (-> self target-timeout) (seconds 0.5)))
             (time-elapsed? (-> self last-hit-time) (seconds 2))
             )
        (go-virtual attack)
        )
    )
  :code sleep-code
  :post enemy-simple-post
  )

;; hostile (Jak 2's): the gun goes back to the sweep's line (then sweep), or attacks as soon as the
;; laser touches Jak
(defstate hostile (hj2-fort-turret)
  :virtual #t
  :enter (behavior ()
    (let ((t9-0 (-> (method-of-type enemy hostile) enter)))
      (if t9-0
          (t9-0)
          )
      )
    (set! (-> self desired-tilt) 0.0)
    (set! (-> self desired-twist) 0.0)
    (ja-channel-push! 1 (seconds 0.5))
    (ja :group! hj2-fort-turret-idle-ja)
    )
  :trans (behavior ()
    (if (and (logtest? (-> self enemy-flags) (enemy-flag victory)) (-> self enemy-info use-victory))
        (go-virtual victory)
        )
    (when (time-elapsed? (-> self state-time) (-> self reaction-time))
      (if (>= 2 (the-as int (-> self focus aware)))
          (go-stare self)
          )
      )
    (set! (-> self root penetrated-by) (get-penetrated-by self))
    (update-laser self)
    (if (and (not (time-elapsed? (-> self target-timeout) (seconds 0.5)))
             (time-elapsed? (-> self last-hit-time) (seconds 2))
             )
        (go-virtual attack)
        )
    (set! (-> self desired-twist) (* 8192.0 (cos (get-scaled-val! (-> self sync) 32768.0 0))))
    (turn-gun self 0.1 91.022224)
    (if (and (< (fabs (-> self gun-twist)) 364.0889) (< (fabs (-> self gun-tilt)) 364.0889))
        (go-virtual sweep)
        )
    )
  :code sleep-code
  )

(defmethod event-handler ((this hj2-fort-turret) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  "Jak 2's events: a shot's 'notify of a hit on Jak (last-hit-time: no attack for 2 s), 'start /
'stop (can-shoot), 'attack ignored (invincible), 'flash-state (returns it); the others are the
enemy's. arg0: the sender, arg1: the parameter count, arg2: the message, arg3: the parameters.
Returns the event's answer. Side effects: last-hit-time, can-shoot."
  (if (and (= arg2 'notify) (< 1 arg1) (= (-> arg3 param 0) 'attack) (= (-> arg3 param 1) *target*))
      (set-time! (-> this last-hit-time))
      )
  (case arg2
    (('start)
     (set! (-> this can-shoot) #t)
     #t
     )
    (('stop)
     (set! (-> this can-shoot) #f)
     #f
     )
    (('attack)
     #f
     )
    (('flash-state)
     (-> this flash-state)
     )
    (else
      ((method-of-type enemy event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

(defmethod coin-flip? ((this hj2-fort-turret))
  "Never drawn mirrored (Jak 2's): returns #f."
  #f
  )

;; WARN: Return type mismatch int vs penetrate.
(defmethod get-penetrated-by ((this hj2-fort-turret))
  "Nothing hurts it (Jak 2's): returns no penetrate flag."
  (the-as penetrate 0)
  )

(defmethod init-enemy-collision! ((this hj2-fort-turret))
  "Jak 2's collision: a pusher group on the head holding the gun (its model's collide mesh 0, on
recoiltrans), the head (mesh 1, on secrotate) and the pillar (mesh 2, on main), solid and rideable;
nothing hurts it. Side effects: the main thread's stack (512 bytes), the root."
  (stack-size-set! (-> this main-thread) 512)
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 3) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 4))
      (set! (-> s4-0 prim-core collide-as) (collide-spec enemy pusher))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (set! (-> s4-0 transform-index) 4)
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 0.0 36864.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    (let ((v1-17 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-17 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-17 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-17 prim-core action) (collide-action solid rideable))
      (set! (-> v1-17 transform-index) 6)
      (set-vector! (-> v1-17 local-sphere) 0.0 0.0 5120.0 14336.0)
      )
    (let ((v1-19 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 1) (the-as uint 0))))
      (set! (-> v1-19 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-19 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-19 prim-core action) (collide-action solid rideable))
      (set! (-> v1-19 transform-index) 5)
      (set-vector! (-> v1-19 local-sphere) 0.0 6144.0 0.0 12288.0)
      )
    (let ((v1-21 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 2) (the-as uint 0))))
      (set! (-> v1-21 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-21 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-21 prim-core action) (collide-action solid rideable))
      (set! (-> v1-21 transform-index) 3)
      (set-vector! (-> v1-21 local-sphere) 0.0 24576.0 0.0 24576.0)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-24 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-24 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-24 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

;; WARN: Return type mismatch enemy vs hj2-fort-turret.
(defmethod relocate ((this hj2-fort-turret) (offset int))
  "Move the head's joint-mod with the process heap, then the enemy's relocate."
  (if (nonzero? (-> this gun-tilt-jm))
      (&+! (-> this gun-tilt-jm) offset)
      )
  (the-as hj2-fort-turret ((method-of-type enemy relocate) this offset))
  )

(defmethod init-enemy! ((this hj2-fort-turret))
  "Jak 2's init-enemy!: skeleton, enemy info, never paused (it shoots from afar), the head's tilt
joint-mod, straight ahead, the sweep's sync (the sync lump, else 10 s, back and forth) and its
placement's rotation (init-mat). Side effects: all of the turret's fields."
  (initialize-skeleton this *hj2-fort-turret-sg* (the-as pair 0))
  (setup-enemy! this *hj2-fort-turret-enemy-info*)
  (logclear! (-> this mask) (process-mask actor-pause))
  (logclear! (-> this enemy-flags) (enemy-flag actor-pause-backup))
  (set! (-> this gun-tilt-jm) (new 'process 'joint-mod (joint-mod-mode joint-set*) this 4))
  (set! (-> this gun-twist) 0.0)
  (set! (-> this gun-tilt) 0.0)
  (set! (-> this desired-twist) 0.0)
  (set! (-> this desired-tilt) 0.0)
  (set! (-> this flash-state) #f)
  (set! (-> this can-shoot) #t)
  (set! (-> this last-hit-time) 0)
  (set! (-> this target-timeout) 0)
  (set! (-> this beam-intersect) #f)
  (let ((a1-7 (new 'stack-no-clear 'sync-info-params)))
    (set! (-> a1-7 sync-type) 'sync-linear)
    (set! (-> a1-7 sync-flags) (sync-flags pong))
    (set! (-> a1-7 entity) (-> this entity))
    (set! (-> a1-7 period) (the-as uint 3000))
    (set! (-> a1-7 percent) 0.0)
    (initialize! (-> this sync) a1-7)
    )
  (quaternion->matrix (-> this init-mat) (-> this root quat))
  0
  (none)
  )

;; Electric belt ///////////////////////////////////////////////////////////////////////////////////

;; The lightning of an arc: Jak 2's fort-elec-belt spec, rand-func 2 (the 17 points follow the path
;; the arc sets every frame). The texture is Jak 3's: Jak 2's default lightning texture (page #xc
;; index #x83) is page #x4 index #x3f in Jak 3 (lightning.gc). Also the spec of the short sparks
;; (lightning-tracker) drawn where an arc touches Jak.
(define *hj2-fort-elec-belt-spec* (new 'static 'lightning-spec
                                    :name #f
                                    :flags (lightning-spec-flags lsf2)
                                    :rand-func #x2
                                    :start-color (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                                    :end-color (new 'static 'rgba :a #x80)
                                    :fade-to-color (new 'static 'rgba :r #xbf :b #x8f :a #x5)
                                    :fade-start-factor 0.2
                                    :fade-time 120.0
                                    :texture (new 'static 'texture-id :index #x3f :page #x4)
                                    :reduction 0.72
                                    :num-points 17
                                    :box-size 4997.12
                                    :merge-factor 0.32
                                    :merge-count 2
                                    :radius 7372.8
                                    :duration -1.0
                                    :sound #f
                                    )
        )

;; Jak 2's fort-elec-belt: no model of its own, it launches the arcs (hj2-fort-elec-belt-inst) at
;; the start of its path, one per sync period (4s by default, the sync lump otherwise), each riding
;; the path at 6m/s and gone at its end. At birth it places the arcs already on their way, so the
;; belt is full at once. Lumps (kept by the manifest): path (its two ends), sync.
;;   l-spec: the arcs' lightning; next-spawn-time: when the next arc leaves; path: the rail;
;;   init-quat: the arcs' rotation (the entity's); sync: the launch period; attack-id: the id of
;;   every arc's attack (one hit per touch, 3s invulnerability); path-du: the arcs' speed, in path
;;   fractions per second.
(deftype hj2-fort-elec-belt (process)
  ((l-spec           lightning-spec)
   (next-spawn-time  time-frame)
   (path             path-control)
   (init-quat        quaternion   :inline)
   (sync             sync-linear  :inline)
   (attack-id        uint32)
   (path-du          float)
   )
  (:state-methods
    idle
    )
  (:methods
    (spawn-initial-arcs (_type_) none)
    )
  )


;; One arc: the model (two emitters, joints raya_ 4 and rayb_ 5, Jak 2's order) riding the belt's
;; path, a lightning hanging between its emitters (a 22m radius arc), hurting Jak when it crosses
;; him.
;;   l-spec: its lightning spec; l-bolt: its lightning; points: the arc's 17 points (world);
;;   path-u: where it is on the path (0 to 1); path-du: its speed (fractions per second);
;;   attack-id: the belt's.
(deftype hj2-fort-elec-belt-inst (process-drawable)
  ((l-spec     lightning-spec)
   (l-bolt     lightning-control)
   (points     vector  17 :inline)
   (path-u     float)
   (path-du    float)
   (attack-id  uint32)
   )
  (:state-methods
    idle
    running
    die
    )
  )


;; the art group from build-actor: joint geometry, merc model, Jak 2's idle animation (one frame)
(def-actor hj2-fort-elec-belt
  :bounds (0 0 -19 20)
  )

(defbehavior hj2-fort-elec-belt-inst-advance! hj2-fort-elec-belt-inst ()
  "Puts the arc at path-u along its parent belt's path, then moves path-u on by path-du for this
frame (Jak 2 asks the belt with a 'get-point-norm event; here it reads the belt's path).
Side effects: the root's trans, path-u. Returns nothing."
  (let ((belt (the-as hj2-fort-elec-belt (ppointer->process (-> self parent)))))
    (if belt
        (get-point-at-percent-along-path! (-> belt path) (-> self root trans) (-> self path-u) 'interp)
        )
    )
  (+! (-> self path-u) (* (-> self path-du) (seconds-per-frame)))
  (none)
  )

;; the first frame: the arc's points aren't set yet, so its lightning stays off (mode 0) this frame,
;; then it turns on (mode 1) and runs
(defstate idle (hj2-fort-elec-belt-inst)
  :virtual #t
  :code (behavior ()
    (suspend)
    (change-mode (-> self l-bolt) (lightning-mode lm1))
    (go-virtual running)
    )
  :post (behavior ()
    (hj2-fort-elec-belt-inst-advance!)
    (ja-post)
    )
  )

;; riding the path, the lightning hanging between the emitters; any segment of it touching Jak (or
;; his bots) attacks him (Jak 2's: no damage amount given, 3m up, 3s invulnerability) and draws a
;; spark along that segment. At the end of the path: die.
(defstate running (hj2-fort-elec-belt-inst)
  :virtual #t
  :trans (behavior ()
    (if (>= (-> self path-u) 1.0)
        (go-virtual die)
        )
    )
  :code sleep-code
  :post (behavior ()
    (hj2-fort-elec-belt-inst-advance!)
    ;; the arc: from raya_ to rayb_, on a 22m radius circle whose center is above the middle of
    ;; the emitters (it sags between them), in the vertical plane holding both, 16 equal steps
    (let ((ray-a (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data 4)))
          (ray-b (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data 5)))
          )
      (let* ((side (vector-cross!
                     (new 'stack-no-clear 'vector)
                     (vector-normalize! (vector-! (new 'stack-no-clear 'vector) ray-b ray-a) 1.0)
                     *up-vector*
                     )
                   )
             (radius 90112.0)
             (center (vector-! (new 'stack-no-clear 'vector) ray-b ray-a))
             (half (* 0.5 (vector-length center)))
             )
        (vector-float*! center center 0.5)
        (vector+! center ray-a center)
        (+! (-> center y) (sqrtf (- (square radius) (square half))))
        (let* ((angle (* 2.0 (asin (/ half radius))))
               (step (/ angle 16))
               (spoke (new 'stack-no-clear 'vector))
               )
          (set-vector! spoke 0.0 (- radius) 0.0 0.0)
          (vector-orient-by-quat!
            spoke
            spoke
            (quaternion-vector-angle! (new 'stack-no-clear 'quaternion) side (/ angle -2))
            )
          (dotimes (i 17)
            (let ((point (vector+! (new 'stack-no-clear 'vector) center spoke)))
              (set-point! (-> self l-bolt) i point)
              (vector-copy! (-> self points i) point)
              )
            (vector-orient-by-quat! spoke spoke (quaternion-vector-angle! (new 'stack-no-clear 'quaternion) side step))
            )
          )
        )
      )
    ;; collision: gather what is around the arc (Jak, his bots), then sweep a 1m sphere along each
    ;; of its 16 segments
    (let ((query (new 'stack-no-clear 'collide-query)))
      (let ((spheres (new 'stack-no-clear 'inline-array 'sphere 17)))
        (dotimes (i 17)
          (vector-copy! (-> spheres i) (-> self points i))
          (set! (-> spheres i r) 4096.0)
          )
        (set-from-spheres! (-> query bbox) spheres 17)
        )
      (set! (-> query collide-with) (collide-spec jak bot player-list))
      (set! (-> query ignore-process0) self)
      (set! (-> query ignore-process1) #f)
      (set! (-> query ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
      (set! (-> query action-mask) (collide-action solid))
      (fill-using-bounding-box *collide-cache* query)
      )
    (let ((i 1))
      (while (< i 17)
        (let ((query (new 'stack-no-clear 'collide-query))
              (p0 (-> self points (+ i -1)))
              (p1 (-> self points i))
              )
          (vector-copy! (-> query start-pos) p0)
          (vector-! (-> query move-dist) p1 p0)
          (set! (-> query radius) 4096.0)
          (set! (-> query collide-with) (collide-spec jak bot player-list))
          (set! (-> query ignore-process0) self)
          (set! (-> query ignore-process1) #f)
          (set! (-> query ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
          (set! (-> query action-mask) (collide-action solid semi-solid))
          (when (>= (probe-using-line-sphere *collide-cache* query) 0.0)
            (let ((prim (as-type (-> query best-other-tri collide-ptr) collide-shape-prim-sphere)))
              (when prim
                (process-spawn
                  lightning-tracker
                  :init lightning-tracker-init
                  (-> self l-spec)
                  (the int (* 3.0 (rand-vu-float-range 5.0 11.0)))
                  (the-as symbol #f)
                  (the-as symbol #f)
                  p0
                  p1
                  :name "lightning-tracker"
                  :to *entity-pool*
                  :unk 0
                  )
                (send-event
                  (-> prim cshape process)
                  'attack
                  #f
                  (static-attack-info ((id (-> self attack-id))
                                       (invinc-time (seconds 3))
                                       (vector (vector-reset! (new 'stack-no-clear 'vector)))
                                       (shove-up (meters 3))
                                       )
                                      )
                  )
                )
              )
            )
          )
        (+! i 1)
        )
      )
    (ja-post)
    )
  )

;; at the end of the path: the lightning fades out (mode 3), then the arc is gone
(defstate die (hj2-fort-elec-belt-inst)
  :virtual #t
  :code (behavior ()
    (change-mode (-> self l-bolt) (lightning-mode lm3))
    (suspend)
    (cleanup-for-death self)
    )
  )

;; WARN: Return type mismatch process-drawable vs hj2-fort-elec-belt-inst.
(defmethod relocate ((this hj2-fort-elec-belt-inst) (offset int))
  "Moves the pointer to the lightning-control (in the process heap) with the process. Returns the
arc."
  (if (nonzero? (-> this l-bolt))
      (&+! (-> this l-bolt) offset)
      )
  (the-as hj2-fort-elec-belt-inst ((method-of-type process-drawable relocate) this offset))
  )

;; WARN: Return type mismatch object vs none.
(defbehavior hj2-fort-elec-belt-inst-init-by-other hj2-fort-elec-belt-inst ((quat quaternion) (u float) (du float) (spec lightning-spec) (id uint))
  "Sets up an arc spawned by its belt (process-spawn, child of the belt): rotation quat (the belt
entity's), at u along the path, moving du per second, its lightning (spec, off until its first
frame is over), attack id id. Not paused far away (the belt's arcs stay in step). Side effects: the
arc's root, skeleton, fields. Goes to idle."
  (set! (-> self root) (new 'process 'trsqv))
  (initialize-skeleton self *hj2-fort-elec-belt-sg* (the-as pair 0))
  (quaternion-copy! (-> self root quat) quat)
  (set! (-> self path-u) u)
  (set! (-> self path-du) du)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self l-bolt) (new 'process 'lightning-control spec self 0.0))
  (change-mode (-> self l-bolt) (lightning-mode lm0))
  (set! (-> self l-spec) spec)
  (set! (-> self attack-id) id)
  (ja-no-eval :group! hj2-fort-elec-belt-idle-ja :num! zero)
  (ja-post)
  (go-virtual idle)
  (none)
  )

(defun hj2-fortb-electricity-scale! ((arg0 float))
  "Sets hj2-fortb's first electricity (Jak 2's set-forrescb-electricity-scale! arg0 0): the scale
word of electricity-state 0 (word 1 of its mood state, read by update-mood-hj2-fortb on light
palette 6), to arg0. Does nothing if hj2-fortb isn't loaded. Returns none."
  (let ((lev (level-get *level* 'hj2-fortb)))
    (when lev
      (set! (-> (the-as (pointer float) (-> lev mood-context state)) 1) arg0)
      )
    )
  (none)
  )

;; launching an arc each sync period; keeps the fortress's electricity palette on (Jak 2's)
(defstate idle (hj2-fort-elec-belt)
  :virtual #t
  :trans (behavior ()
    (hj2-fortb-electricity-scale! 1.0)
    (when (>= (current-time) (-> self next-spawn-time))
      (process-spawn
        hj2-fort-elec-belt-inst
        (-> self init-quat)
        0.0
        (-> self path-du)
        (-> self l-spec)
        (-> self attack-id)
        :to self
        )
      (set! (-> self next-spawn-time) (get-timeframe-offset! (-> self sync) 0))
      )
    )
  :code sleep-code
  )

(defmethod spawn-initial-arcs ((this hj2-fort-elec-belt))
  "Jak 2's fort-elec-belt-method-15: spawns the arcs launched before now that are still on the path
(one per sync period, 20 units per tick, 6m/s), at their current place, so the belt is full when it
is born. Side effects: spawns children. Returns none."
  (let* ((len (total-distance (-> this path)))
         (speed 81.92)
         (u (/ (* speed (the float (- (current-time) (get-timeframe-offset! (-> this sync) 0)))) len))
         (du (/ (* speed (the float (-> this sync period))) len))
         )
    (while (>= 1.0 u)
      (if (>= u 0.0)
          (process-spawn
            hj2-fort-elec-belt-inst
            (-> this init-quat)
            u
            (-> this path-du)
            (-> this l-spec)
            (-> this attack-id)
            :to this
            )
          )
      (+! u du)
      )
    )
  (none)
  )

;; WARN: Return type mismatch process vs hj2-fort-elec-belt.
(defmethod relocate ((this hj2-fort-elec-belt) (offset int))
  "Moves the pointer to the path-control (in the process heap) with the process. Returns the belt."
  (if (nonzero? (-> this path))
      (&+! (-> this path) offset)
      )
  (the-as hj2-fort-elec-belt ((method-of-type process relocate) this offset))
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-fort-elec-belt) (arg0 entity-actor))
  "Jak 2's fort-elec-belt setup, from the entity arg0: the arcs' rotation (its quat), its sync (4s
period by default, the sync lump otherwise), its lightning spec, its rail (path lump), the arcs'
speed (6m/s), one attack id, the arcs already on their way, not paused far away. Goes to idle."
  (quaternion-copy! (-> this init-quat) (-> arg0 quat))
  (let ((params (new 'stack-no-clear 'sync-info-params)))
    (set! (-> params sync-type) 'sync-linear)
    (set! (-> params sync-flags) (sync-flags pong))
    (set! (-> params entity) arg0)
    (set! (-> params period) (the-as uint 1200))
    (set! (-> params percent) 0.0)
    (initialize! (-> this sync) params)
    )
  (set! (-> this l-spec) *hj2-fort-elec-belt-spec*)
  (set! (-> this path) (new 'process 'path-control this 'path 0.0 (the-as entity #f) #f))
  (set! (-> this path-du) (/ 24576.0 (total-distance (-> this path))))
  (set! (-> this attack-id) (new-attack-id))
  (spawn-initial-arcs this)
  (set! (-> this next-spawn-time) (get-timeframe-offset! (-> this sync) 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (go (method-of-object this idle))
  (none)
  )
