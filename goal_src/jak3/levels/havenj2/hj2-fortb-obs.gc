;;-*-Lisp-*-
(in-package goal)

;; name: hj2-fortb-obs.gc
;; name in dgo: hj2-fortb-obs
;; dgos: HJJ

;; og:jak2-haven-city Level code for hj2-fortb, the far end of Jak 2's fortress (levels/fortress/
;; fort-turret.gc and levels/fortress/rescue/forrescb-obs.gc there): its laser turrets and its
;; electric belt, a line of lightning arcs riding a rail across the corridor (Jak 2 runs it whatever
;; the story state). Their models are Jak 2's, rebuilt by build-actor (hj2-fort-turret.glb,
;; hj2-fort-elec-belt.glb, made by the level port, scripts/level_port). Not ported: Jak 2's sounds
;; of the turrets and of the belt (not in Jak 3), the turret light flashes (palettes 2 to 5 of the
;; level's mood, kept off by update-mood-hj2-fortb), the laser's shadow (Jak 2's shadow mesh and its
;; laser_shadow joint-mod), the turrets' explosion (every turret of forrescb is invincible), and the
;; fortress's elec-lock-gate: the rescue pressed all five fort-elec-buttons it waits for, so at the
;; end of the game it is shut down for good.

;; Fortress turrets ///////////////////////////////////////////////////////////////////////////////

;; Jak 2's fort-turret: a cannon on a pillar sweeping its red laser 45 degrees each side of where it
;; faces, on its sync (sync lump: period and offset, in seconds; 10 s by default). When the laser
;; touches Jak, it rises and fires 3 guard shots (Jak 3's, GAME) from its 3 barrels, 0.33 s apart
;; with the shoot animation, then waits 1.5 s, while it follows him (45 degrees each side, tilting
;; 45 degrees up or down); once the laser has missed him for 0.5 s, or 2 s after a shot hit him, it
;; goes back to sweeping. It notices Jak 150m away. Invincible, like all of forrescb's (Jak 2's
;; enemy-options 1): Jak's attacks do nothing, and it is solid and rideable.

;; Joints (Jak 2's, kept by build-actor): 3 main (the pillar), 4 headrotate (tilts), 5 secrotate,
;; 6 recoiltrans, 7-9 gunfire1..3 (the barrels' muzzles), 10 laser_shadow, 11 trackgun,
;; 12 lasersight_ (the laser's origin, along its z). Animations: 2 idle, 3 shoot, 4 rise.
;;   gun-tilt-jm: the head's tilt. aim-pos: where the gun aims (world). target-bullseye: where the
;;   laser ends. gun-twist/gun-tilt: the current turn and tilt, desired-twist/desired-tilt: where
;;   they go. flash-state: firing (answered to 'flash-state). can-shoot: off after a 'stop event.
;;   last-hit-time: when a shot last hit Jak. init-mat: its placement's rotation. target-timeout:
;;   when the laser last touched Jak. beam-intersect: what the laser ends on ('target, 'wall,
;;   'nothing; #f: not probed yet, no laser drawn). sync: the sweep's.
(deftype hj2-fort-turret (enemy)
  ((gun-tilt-jm      joint-mod)
   (aim-pos          vector       :inline)
   (target-bullseye  vector       :inline)
   (gun-twist        float)
   (gun-tilt         float)
   (desired-twist    float)
   (desired-tilt     float)
   (flash-state      symbol)
   (can-shoot        symbol)
   (last-hit-time    time-frame)
   (init-mat         matrix       :inline)
   (target-timeout   time-frame)
   (beam-intersect   symbol)
   (sync             sync-linear  :inline)
   )
  (:state-methods
    attack
    sweep
    )
  (:methods
    (aim-at-target (_type_) none)
    (turn-gun (_type_ float float) none)
    (update-laser (_type_) none)
    (fire-shot (_type_ int) none)
    )
  )


;; the turret on its pillar (Jak 2's bounds, around main)
(def-actor hj2-fort-turret
  :art (idle-ja shoot-ja rise-ja)
  :bounds (8 11.25 0 16.5)
  :origin-joint-index 3
  )

;; Jak 2's *fort-turret-enemy-info* in Jak 3's layout (hj2-pal-gun-turret's for the fields Jak 2
;; doesn't have): every anim is the idle (2), notices Jak 150m away, Jak's gun aims at the head
;; (bullseye joint 4), no gem.
(define *hj2-fort-turret-enemy-info*
  (new 'static 'enemy-info
    :use-die-falling #f
    :use-victory #f
    :use-jump-blocked #f
    :debug-draw-neck #f
    :jump-debug-draw #f
    :move-to-ground #f
    :hover-if-no-ground #f
    :idle-anim-script (new 'static 'inline-array idle-control-frame 2
      (new 'static 'idle-control-frame
        :command (idle-control-cmd play)
        :anim #x2
        :param0 1
        :param1 1
        :param2 '((new 'static 'bfloat :data 1.0) (new 'static 'bfloat :data 1.0))
        )
      (new 'static 'idle-control-frame)
      )
    :idle-anim 2
    :notice-anim 2
    :hostile-anim 2
    :hit-anim 2
    :knocked-anim -1
    :knocked-land-anim -1
    :die-anim 2
    :die-falling-anim -1
    :victory-anim -1
    :jump-wind-up-anim -1
    :jump-in-air-anim -1
    :jump-land-anim -1
    :neck-joint -1
    :bullseye-joint 4
    :notice-distance (meters 150)
    :notice-distance-delta (meters 10)
    :proximity-notice-distance (meters 150)
    :default-hit-points 1.0
    :gnd-collide-with (collide-spec backgnd)
    :overlaps-others-collide-with-filter (collide-spec jak bot player-list)
    :movement-gravity (meters -100)
    :friction 0.8
    :attack-shove-back (meters 3)
    :attack-shove-up (meters 2)
    :attack-mode 'generic
    :attack-damage 2
    :recover-gnd-collide-with (collide-spec backgnd crate obstacle hit-by-others-list pusher)
    :knocked-can-land-timeout (seconds 0.1)
    :knocked-recover-timeout (seconds 2)
    :ragdoll-blend-out-time (seconds 0.25)
    :ragdoll-rotate-velocity-mult 1.0
    :jump-height-min (meters 3)
    :jump-height-factor 0.5
    :knocked-seek-ry-clamp 2730.6667
    :knocked-soft-vxz-lo (meters 17.6)
    :knocked-soft-vxz-hi (meters 26.4)
    :knocked-soft-vy-lo (meters 20)
    :knocked-soft-vy-hi (meters 30)
    :knocked-medium-vxz-lo (meters 36)
    :knocked-medium-vxz-hi (meters 48)
    :knocked-medium-vy-lo (meters 33)
    :knocked-medium-vy-hi (meters 37)
    :knocked-hard-vxz-lo (meters 19.2)
    :knocked-hard-vxz-hi (meters 28.8)
    :knocked-hard-vy-lo (meters 44.8)
    :knocked-hard-vy-hi (meters 51.2)
    :knocked-huge-vxz-lo (meters 40.2)
    :knocked-huge-vxz-hi (meters 60.8)
    :knocked-huge-vy-lo (meters 44.8)
    :knocked-huge-vy-hi (meters 53.2)
    :knocked-yellow-vxz-lo (meters 10)
    :knocked-yellow-vxz-hi (meters 12)
    :knocked-yellow-vy-lo (meters 14)
    :knocked-yellow-vy-hi (meters 20)
    :knocked-red-vxz-lo (meters 6)
    :knocked-red-vxz-hi (meters 48)
    :knocked-red-vy-lo (meters 23)
    :knocked-red-vy-hi (meters 37)
    :knocked-blue-vxz-lo (meters 10)
    :knocked-blue-vxz-hi (meters 12)
