;;-*-Lisp-*-
(in-package goal)

;; name: hj2-ruins-obs.gc
;; name in dgo: hj2-ruins-obs
;; dgos: HJR

;; og:jak2-haven-city Level code for hj2-ruins, Jak 2's Dead Town (levels/ruins/ruins-obs.gc there),
;; as it is at the end of the game: the tower has fallen, so its slabs, bridge, floating platforms
;; and flag are gone (Jak 2 only spawns them before, see the level port's games/jak2.py), the beams
;; are left. Their model is Jak 2's, rebuilt by build-actor (hj2-ruins-beam.glb, made by the level
;; port, scripts/level_port). The swinging bars are Jak 3's swingpole.
;; Not ported: the enemies, the walls and pillars the titan suit breaks (broken for good by the end
;; of the game), the push blocks, Jak 2's sounds.

;; Jak 2's beam: a beam that slips down its supports when Jak first comes near (within 25m of the
;; camera), then stays there. No collision, like Jak 2's.
(deftype hj2-ruins-beam (process-drawable)
  ()
  (:state-methods
    idle
    collapse
    )
  )


;; its rest pose and its slip (Jak 2's beam-idle and beam-slide-center)
(def-actor hj2-ruins-beam
  :art (idle-ja slide-ja)
  :bounds (0 2 -1 3)
  )

;; waiting for the camera to come near
(defstate idle (hj2-ruins-beam)
  :virtual #t
  :trans (behavior ()
    (if (< (vector-vector-distance (-> self root trans) (camera-pos)) (meters 25))
        (go-virtual collapse)
        )
    )
  :code sleep-code
  )

;; slipping once, then still
(defstate collapse (hj2-ruins-beam)
  :virtual #t
  :code (behavior ()
    (ja-no-eval :group! hj2-ruins-beam-slide-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (ja-post)
    (sleep-code)
    )
  :post ja-post
  )

(defmethod init-from-entity! ((this hj2-ruins-beam) (arg0 entity-actor))
  "Jak 2's beam setup: placement, skeleton (its rest pose, hj2-ruins-beam-idle)."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-ruins-beam-sg* (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (ja-post)
  (go (method-of-object this idle))
  )
