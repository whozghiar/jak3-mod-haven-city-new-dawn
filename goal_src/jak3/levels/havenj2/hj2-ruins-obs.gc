;;-*-Lisp-*-
(in-package goal)

;; name: hj2-ruins-obs.gc
;; name in dgo: hj2-ruins-obs
;; dgos: HJR

;; og:jak2-haven-city Level code for hj2-ruins, Jak 2's Dead Town (levels/ruins/ruins-obs.gc and
;; ruins-scenes.gc there): the stone slabs that give way under Jak, the bridge, the platforms
;; floating on the water, the beams of the tower and its flag. Their models are Jak 2's, rebuilt by
;; build-actor (hj2-ruins-*.glb, made by custom_assets/jak3/levels/havenj2/gen_havenj2_links.py);
;; their collision is the convex hull of the model. The swinging bars are Jak 3's swingpole (the
;; bars themselves are background). Not ported: the enemies, the walls and pillars the titan suit
;; breaks (broken for good by the end of the game), the push blocks, Jak 2's sounds.

;; Slabs that give way //////////////////////////////////////////////////////////////////////////////

;; Jak 2's ruins-drop-plat and ruins-bridge: slabs (with their pillar) and a bridge that crumble a
;; moment after Jak lands on them. Jak 2 plays their fall from its streamed animations, which Jak 3
;; doesn't have, and leaves them fallen (a subtask of the tower): here a slab shakes, drops out of
;; sight, and is back in its place a few seconds later. touched: when Jak landed on it (0: not yet).
(deftype hj2-ruins-drop-plat (base-plat)
  ((touched     time-frame)
   (fall-speed  float)
   )
  (:state-methods
    idle
    falling
    gone
    )
  (:methods
    (get-skel (_type_) skeleton-group)
    )
  )


;; the three slab models (Jak 2's ruins-drop-plat-a, b and c, a slab on its pillar) and the bridge
(def-actor hj2-ruins-drop-plat-a
  :bounds (2.5 -3 3 5)
  :origin-joint-index 3
  )

(def-actor hj2-ruins-drop-plat-b
  :bounds (3.5 -4 4 7)
  :origin-joint-index 3
  )

(def-actor hj2-ruins-drop-plat-c
  :bounds (4 -4 5 7)
  :origin-joint-index 3
  )

(def-actor hj2-ruins-bridge
  :bounds (0 -1 0 6.5)
  )

(defmethod get-skel ((this hj2-ruins-drop-plat))
  "The model of this slab (hj2-ruins-drop-plat-a, the classes below choose theirs)."
  *hj2-ruins-drop-plat-a-sg*
  )

;; standing: Jak landing on it (touch), hitting or bonking it makes it shake, then fall
(defstate idle (hj2-ruins-drop-plat)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touch 'attack 'bonk)
       (when (zero? (-> self touched))
         (start-bounce! self)
         (set-time! (-> self touched))
         )
       #f
       )
      (else
        (plat-event proc argc message block)
        )
      )
    )
  :trans (behavior ()
    (plat-trans)
    (if (and (nonzero? (-> self touched)) (time-elapsed? (-> self touched) (seconds 0.6)))
        (go-virtual falling)
        )
    )
  :code sleep-code
  :post plat-post
  )

;; falling: no more ground under Jak, the slab drops for a second and a half
(defstate falling (hj2-ruins-drop-plat)
  :virtual #t
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self fall-speed) 0.0)
    (let ((v1-3 (-> self root root-prim)))
      (set! (-> v1-3 prim-core collide-as) (collide-spec))
      (set! (-> v1-3 prim-core collide-with) (collide-spec))
      )
    )
  :code (behavior ()
    (until (time-elapsed? (-> self state-time) (seconds 1.5))
      (+! (-> self fall-speed) (* (meters 30) (seconds-per-frame)))
      (set! (-> self root trans y) (- (-> self root trans y) (* (-> self fall-speed) (seconds-per-frame))))
      (suspend)
      )
    (go-virtual gone)
    )
  :post transform-post
  )

;; fallen: out of sight, back in its place a few seconds later
(defstate gone (hj2-ruins-drop-plat)
  :virtual #t
  :code (behavior ()
    (logior! (-> self draw status) (draw-control-status no-draw))
    (suspend-for (seconds 5)
      )
    (vector-copy! (-> self root trans) (-> self basetrans))
    (let ((v1-7 (-> self root root-prim)))
      (set! (-> v1-7 prim-core collide-as) (-> self root backup-collide-as))
      (set! (-> v1-7 prim-core collide-with) (-> self root backup-collide-with))
      )
    (logclear! (-> self draw status) (draw-control-status no-draw))
    (set! (-> self touched) 0)
    (transform-post)
    (go-virtual idle)
    )
  )

(defmethod init-from-entity! ((this hj2-ruins-drop-plat) (arg0 entity-actor))
  "A slab's setup: a rideable pusher (the hull of its model, main joint), its model (get-skel), the
bounce of Jak 3's platforms."
  (let ((s4-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s4-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s4-0 reaction) cshape-reaction-default)
    (set! (-> s4-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((v1-6 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-6 prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> v1-6 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-6 prim-core action) (collide-action solid rideable))
      (set! (-> v1-6 transform-index) 3)
      (set-vector! (-> v1-6 local-sphere) (meters 4) (meters -4) (meters 4) (meters 8))
      (set! (-> s4-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 root-prim) v1-6)
      )
    (pusher-init s4-0)
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-9 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-9 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-9 prim-core collide-with))
      )
    (set! (-> this root) s4-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this (get-skel this) (the-as pair 0))
  (init-bounce-params! this)
  (vector-copy! (-> this basetrans) (-> this root trans))
  (set! (-> this touched) 0)
  (transform-post)
  (go (method-of-object this idle))
  )

(deftype hj2-ruins-drop-plat-a (hj2-ruins-drop-plat)
  ()
  )


(deftype hj2-ruins-drop-plat-b (hj2-ruins-drop-plat)
  ()
  )


(defmethod get-skel ((this hj2-ruins-drop-plat-b))
  "Jak 2's ruins-drop-plat-b."
  *hj2-ruins-drop-plat-b-sg*
  )

(deftype hj2-ruins-drop-plat-c (hj2-ruins-drop-plat)
  ()
  )


(defmethod get-skel ((this hj2-ruins-drop-plat-c))
  "Jak 2's ruins-drop-plat-c."
  *hj2-ruins-drop-plat-c-sg*
  )

;; Jak 2's ruins-bridge: the plank bridge of the tower, crumbling like the slabs
(deftype hj2-ruins-bridge (hj2-ruins-drop-plat)
  ()
  )


(defmethod get-skel ((this hj2-ruins-bridge))
  "Jak 2's ruins-bridge-1."
  *hj2-ruins-bridge-sg*
  )

;; Floating platforms /////////////////////////////////////////////////////////////////////////////

;; Jak 2's sinking-plat: a platform floating on Dead Town's water, sinking under Jak's weight, held
;; in place by its anchor. Jak 3's rigid-body-platform (rigid-body-plat.o, linked in HJR too), with
;; Jak 2's constants.
(deftype hj2-ruins-sinking-plat (rigid-body-platform)
  ((anchor-point  vector  :inline)
   )
  )


(def-actor hj2-ruins-sinking-plat
  :bounds (0 1 0 4)
  )

(define *hj2-ruins-sinking-plat-constants* (new 'static 'rigid-body-platform-constants
                                             :info (new 'static 'rigid-body-info
                                               :mass 1.48
                                               :inv-mass 0.6756757
                                               :linear-damping 0.8
                                               :angular-damping 1.0
                                               :friction-factor 0.1
                                               :cm-offset-joint (new 'static 'vector :w 1.0)
                                               :inertial-tensor-box (new 'static 'array meters 3 (meters 2) (meters 1) (meters 2))
                                               )
                                             :extra (new 'static 'rigid-body-object-extra-info
                                               :max-time-step 0.02
                                               :gravity (meters 80)
                                               :idle-distance (meters 50)
                                               :attack-force-scale 1.0
                                               )
                                             :name '*hj2-ruins-sinking-plat-constants*
                                             :drag-factor 2.0
                                             :buoyancy-factor 1.5
                                             :max-buoyancy-depth (meters 2)
                                             :player-weight (meters 60)
                                             :player-bonk-factor 0.5
                                             :player-dive-factor 1.0
                                             :player-force-distance (meters 2)
                                             :player-force-clamp (meters 1000000)
                                             :player-force-timeout (seconds 0.1)
                                             :explosion-force (meters 1000)
                                             :control-point-count 5
                                             :platform #t
                                             :sound-name #f
                                             )
        )

(defmethod get-lava-height ((this hj2-ruins-sinking-plat) (arg0 vector))
  "The surface it floats on: Dead Town's water, 1m under 0 (its water-vol regions)."
  -4096.0
  )

(defmethod apply-gravity! ((this hj2-ruins-sinking-plat) (arg0 float))
  "Jak 3's forces (gravity, buoyancy), and the pull towards its anchor point."
  (call-parent-method this arg0)
  (rigid-body-platform-method-59 this (-> this anchor-point))
  0
  (none)
  )

(defmethod init-collision! ((this hj2-ruins-sinking-plat))
  "A rideable pusher: the hull of its model (main joint)."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((s4-0 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s4-0 prim-core collide-as) (collide-spec pusher))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 (meters 1) 0.0 (meters 3.5))
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-15 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-15 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-15 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-rbody-control! ((this hj2-ruins-sinking-plat))
  "Skeleton, rigid body (its constants), anchor point and its 5 control points (a ring of 3m
radius, 1m up), like Jak 2's init-skel-and-rigid-body."
  (initialize-skeleton this *hj2-ruins-sinking-plat-sg* (the-as pair 0))
  (set! (-> this float-height-offset) 4096.0)
  (alloc-rbody-control! this *hj2-ruins-sinking-plat-constants*)
  (vector-copy! (-> this anchor-point) (-> this rbody position))
  (let ((s5-1 (-> this info control-point-count)))
    (dotimes (s4-1 s5-1)
      (let ((s3-0 (-> this control-point-array data s4-1)))
        (let ((f30-0 (* 65536.0 (/ (the float s4-1) (the float s5-1)))))
          (set! (-> s3-0 local-pos x) (* 12288.0 (sin f30-0)))
          (set! (-> s3-0 local-pos y) 4096.0)
          (set! (-> s3-0 local-pos z) (* 12288.0 (cos f30-0)))
          )
        (set! (-> s3-0 local-pos w) 1.0)
        )
      )
    )
  0
  (none)
  )

;; Beams and flag ///////////////////////////////////////////////////////////////////////////////////

;; Jak 2's beam: a beam of the tower that slips down its supports when Jak first comes near (within
;; 25m of the camera), then stays there. No collision, like Jak 2's.
(deftype hj2-ruins-beam (process-drawable)
  ()
  (:state-methods
    idle
    collapse
    )
  )


;; its rest pose and its slip (Jak 2's beam-idle and beam-slide-center)
(def-actor hj2-ruins-beam
  :art (idle-ja slide-ja)
  :bounds (0 2 -1 3)
  )

;; waiting for the camera to come near
(defstate idle (hj2-ruins-beam)
  :virtual #t
  :trans (behavior ()
    (if (< (vector-vector-distance (-> self root trans) (camera-pos)) (meters 25))
        (go-virtual collapse)
        )
    )
  :code sleep-code
  )

;; slipping once, then still
(defstate collapse (hj2-ruins-beam)
  :virtual #t
  :code (behavior ()
    (ja-no-eval :group! hj2-ruins-beam-slide-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (ja-post)
    (sleep-code)
    )
  :post ja-post
  )

(defmethod init-from-entity! ((this hj2-ruins-beam) (arg0 entity-actor))
  "Jak 2's beam setup: placement, skeleton (its rest pose, hj2-ruins-beam-idle)."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-ruins-beam-sg* (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (ja-post)
  (go (method-of-object this idle))
  )

;; Jak 2's flag on the tower (ruins-scenes.gc there), waving
(deftype hj2-ruins-flag (process-drawable)
  ()
  (:state-methods
    idle
    )
  )


(def-actor hj2-ruins-flag
  :bounds (0 2.5 3 4.5)
  )

;; waving: its animation in a loop
(defstate idle (hj2-ruins-flag)
  :virtual #t
  :code (behavior ()
    (until #f
      (ja-no-eval :group! (ja-group) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post ja-post
  )

(defmethod init-from-entity! ((this hj2-ruins-flag) (arg0 entity-actor))
  "Jak 2's flag setup: placement and skeleton."
  (logior! (-> this mask) (process-mask ambient))
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (logclear! (-> this mask) (process-mask actor-pause))
  (initialize-skeleton this *hj2-ruins-flag-sg* (the-as pair 0))
  (go (method-of-object this idle))
  )
