;;-*-Lisp-*-
(in-package goal)

;; name: hj2-vin-game.gc
;; name in dgo: hj2-vin-game
;; dgos: HJV

;; og:jak2-haven-city Level code for hj2-vin, Vin's power station room: Jak 3's Vin game (power-game,
;; levels/city/vinroom/power-game.gc, Jak 3's task city-power-game), offered at the room's console
;; like the Hip Hog's Whack-a-Metal-Head. Jak 2's and Jak 3's Vin rooms are the same place: the game
;; stands where Jak 3 places it (its power-game-1 at the room's center, Jak 2's scene-stage-42 0.13 m
;; away, placed as hj2-power-game by the level port: named_actors).
;;
;; Jak 3's game is played on a board 225 m under the room: the level powergd (POWERGD.DGO, Jak 3's,
;; built by the stock game.gp), a borrow level loaded into slot 0 of the Vin room's borrow heap (Jak
;; 3's task node does (vinroom 0 powergd display)). It holds the board, Daxter's pac-man model and the
;; monsters' art, and the scoreboard's textures. Here hj2-vin is the host: its level-load-info needs a
;; borrow heap (Jak 3's vinroom's, 3000 KB in slot 0), which the level port writes. The game's sounds
;; are in Jak 3's bank POWERGD1, loaded in the extra bank slot the doors' banks use
;; (*hj2-door-sound-bank*, hj2-update-extra-sound-bank), Daxter's lines are Jak 3's own voice lines,
;; the music is Jak 3's waspgame, the camera Jak 3's cam-power-game.
;;
;; Not like Jak 3: no task (Jak 3's game, played once to clear its task, ends when the board is
;; cleared and its cipher caught; then it is replayed for a score, wave after wave, as here: every
;; game is a replay and ends when Daxter dies); no skill rewards (Jak 3 gives one at its bronze,
;; silver and gold scores, closing task nodes); no auto-save; Jak 3's high score table left alone,
;; the session's best kept instead (*hj2-power-game-high-score*); Jak held between waves (Jak 3
;; releases him, invisible, while Daxter plays on); R3 quits a game. Offered only while the war mode
;; is off. Jak 3's power-game.gc is linked as it is, before this file.

;; GAME, jak2-haven-city-war.gc (the integrator's war switch)
(define-extern *mod-jak2-haven-city-war* symbol)

;; The best score of the session (any number of trips to Vin's room: define-perm keeps it when the
;; level reloads), shown in the prompt.
(define-perm *hj2-power-game-high-score* int 0)

;; Jak 3's power-game with this mod's start, end and scoring (the states and methods below). Its
;; fields are Jak 3's.
(deftype hj2-power-game (power-game)
  ()
  )


(defun hj2-power-game-want-board ((this hj2-power-game) (show symbol))
  "Ask for Jak 3's board level, powergd, in slot 0 of the borrow heap of this game's level (show #t:
loaded and shown, as Jak 3's task node asks: (vinroom 0 powergd display)), or let it go (#f: the
loader unloads it). Nothing while the level has no borrow heap (its level-load-info's borrow, written
by the level port). Side effects: the level-load-info's borrow-info, the load-state's wanted levels
(add-borrow-levels). Returns nothing."
  (let ((borrow (-> this level info borrow)))
    (when borrow
      (set! (-> borrow borrow-info 0) (if show
                                          '(powergd display)
                                          #f
                                          )
            )
      (add-borrow-levels *load-state*)
      )
    )
  (none)
  )

(defun hj2-power-game-drop-task-manager ()
  "Deactivate Jak 3's task manager of its Vin game (task node city-power-game-resolution), if one
runs: update-task-masks spawns it whenever powergd is active and the save has that task open, and it
would run Jak 3's mission here (its failure sends Jak to Jak 3's Vin room). Returns nothing."
  (let ((info (-> *game-info* sub-task-list (game-task-node city-power-game-resolution) manager)))
    (when info
      (let ((proc (handle->process (-> info manager))))
        (if proc
            (deactivate proc)
            )
        )
      )
    )
  (none)
  )

(defbehavior hj2-power-game-hold hj2-power-game ()
  "Called every frame from the start of a game to its end by the game's states. Keeps POWERGD1, Jak
3's bank of the game's sounds, among the extra sound banks (it takes the doors' slot,
*hj2-door-sound-bank*, which hj2-update-extra-sound-bank fills first and keeps 15 s after the last
ask); drops Jak 3's task manager (hj2-power-game-drop-task-manager); grabs Jak again when he is let
go (Jak 3's active state releases him when a wave starts over). Returns nothing."
  (set! (car *hj2-door-sound-bank*) 'powergd1)
  (set! *hj2-door-sound-last* (the-as int (hj2-now)))
  (hj2-power-game-drop-task-manager)
  (if (and *target* (not (focus-test? *target* grabbed)))
      (process-grab? *target* #f)
      )
  (none)
  )

;; Where Jak 3's init (power-game's init-from-entity!, inherited) sends the game. Jak 3 waits there
;; for powergd and its task; here: straight to idle.
(defstate hide (hj2-power-game)
  :virtual #t
  :trans #f
  :code (behavior ()
    (go-virtual idle)
    )
  )

;; Between games: Daxter's skeleton hidden (no channel, as Jak 3's hide), the scoreboard's particles
;; killed and powergd let go (after a game), Jak 3's task manager kept away while powergd unloads.
;; Within 10 m of the console (Jak 3's distance), the warp gates' conditions met (hj2-can-travel?: not
;; on the board, not in a vehicle...), the war mode off and the level's borrow heap there: the prompt
;; with the session's best score; triangle starts a game (wait-for-start).
(defstate idle (hj2-power-game)
  :virtual #t
  :trans #f
  :code (behavior ()
    (ja-channel-set! 0)
    (kill-particles (-> self score-part 0))
    (hj2-power-game-want-board self #f)
    (set-time! (-> self state-time))
    (until #f
      (hj2-power-game-drop-task-manager)
      (when (and (time-elapsed? (-> self state-time) (seconds 1))
                 (not *mod-jak2-haven-city-war*)
                 (-> self level info borrow)
                 (hj2-can-travel? (meters 10))
                 )
        (talker-surpress!)
        (when (can-display-query? self "hj2-power-game" -99.0)
          (format (clear *hj2-travel-text*) "Press <PAD_TRIANGLE> to play Vin's game (best: ~D)" *hj2-power-game-high-score*)
          (hj2-print-travel-prompt *hj2-travel-text*)
          (if (cpad-pressed? 0 triangle)
              (go-virtual wait-for-start)
              )
          )
        )
      (suspend)
      )
    #f
    )
  )

;; A new game: Jak grabbed (Jak 3's wait-for-start), then powergd asked for and waited for, with the
;; POWERGD1 bank (up to 3 s, like a door's bank); "Loading" meanwhile. Not loaded after 20 s: Jak let
;; go, back to idle. Then Jak hidden and the game starts (Jak 3's active, a new game).
(defstate wait-for-start (hj2-power-game)
  :virtual #t
  ;; left for anything but the game (the 20 s give-up, or the process killed: the room unloads, a
  ;; warp): Jak isn't left grabbed, and the board is let go
  :exit (behavior ()
    (when (not (and (-> self next-state) (= (-> self next-state name) 'active)))
      (if (and *target* (focus-test? *target* grabbed))
          (process-release? *target*)
          )
      (hj2-power-game-want-board self #f)
      )
    )
  :code (behavior ()
    (set! (-> self difficulty) 0)
    (set! (-> self wave-index) 0)
    (set! (-> self base-score) 0.0)
    (set! (-> *game-info* score) 0.0)
    (while (or (not *target*) (not (process-grab? *target* #f)))
      (suspend)
      )
    (hj2-power-game-want-board self #t)
    (set-time! (-> self state-time))
    (until (and (= (level-status? *level* 'powergd #f) 'active)
                (or (hj2-sound-bank-loaded? 'powergd1) (time-elapsed? (-> self state-time) (seconds 3)))
                )
      (hj2-power-game-hold)
      (hj2-print-travel-prompt "Loading Vin's game...")
      (when (time-elapsed? (-> self state-time) (seconds 20))
        (format 0 "hj2: powergd did not load, Vin's game cancelled~%")
        (if (and *target* (focus-test? *target* grabbed))
            (process-release? *target*)
            )
        (go-virtual idle)
        )
      (suspend)
      )
    (send-event *target* 'draw #f)
    (go-virtual active #t)
    )
  )

;; Jak 3's active state (its enter, exit, events, code and post kept), with the replay's trans:
;; hj2-power-game-hold every frame, the quit hint, R3 quits (lose, no wait); the board cleared starts
;; the next wave (Jak 3's play after its task is done: harder, the score carried over). No task, no
;; cipher, no cheat-mode keys. Daxter's death ends the game (Jak 3's 'fail event: lose).
(defstate active (hj2-power-game)
  :virtual #t
  :trans (behavior ()
    (hj2-power-game-hold)
    (hj2-print-travel-prompt "Press <PAD_PART_STICK> R3 to quit")
    (cond
      ((cpad-pressed? 0 r3)
       (cpad-clear! 0 r3)
       (go-virtual lose #t)
       )
      ((and (>= (-> self score) (-> self point-win)) (not (-> self score-met)))
       (+! (-> self wave-index) 1)
       (+! (-> self difficulty) 1)
       (sound-play "glyph-kill")
       (+! (-> self base-score) (-> self score))
       (go-virtual active #t)
       )
      )
    )
  )

;; The end of a game (Jak 3's exit and post kept). arg0 #f: Daxter died; his line is waited for (2 s
;; at least, as Jak 3) and the score counts for the session's best. #t: quit, at once, not counted.
;; The score is then emptied, so that the exit (Jak 3's active exit) leaves Jak 3's high score table
;; alone (update-high-score! skips a score of 0). No task manager, no auto-save: Daxter goes behind
;; Jak 3's short fade, and idle (the exit puts back Jak, the camera, the music and the settings, and
;; kills the game's objects).
(defstate lose (hj2-power-game)
  :virtual #t
  :code (behavior ((arg0 symbol))
    (when (not arg0)
      (let ((gp-0 (lookup-gui-connection-id *gui-control* (the-as string #f) (gui-channel daxter) (gui-action none)))
            (s5-0 (current-time))
            )
        (while (or (nonzero? (get-status *gui-control* gp-0)) (not (time-elapsed? s5-0 (seconds 2))))
          (hj2-power-game-hold)
          (suspend)
          )
        )
      (let ((total (the int (+ (-> self base-score) (-> self score)))))
        (if (< *hj2-power-game-high-score* total)
            (set! *hj2-power-game-high-score* total)
            )
        )
      )
    (set! (-> self base-score) 0.0)
    (set! (-> self score) 0.0)
    (ja-channel-set! 0)
    (ja-post)
    (set-blackout-frames (seconds 0.2))
    (go-virtual idle)
    )
  )

;; Jak 3's win (the cipher caught, its first game won) is never reached here (no cipher); were it,
;; it ends like a death (lose's code), without Jak 3's task completion and auto-save.
(defstate win (hj2-power-game)
  :virtual #t
  :code (-> (method-of-type hj2-power-game lose) code)
  )

(defmethod update-score-and-give-orbs ((this hj2-power-game))
  "Jak 3's update-score-and-give-orbs (every frame of a game): the score from the dots eaten, the
scoreboard's count (*game-info* score) rising toward it with its sound. Without its rewards (a skill
and a closed task node at Jak 3's bronze, silver and gold scores) nor its misses (no 'done event
in this game). Returns nothing."
  (set! (-> this score) -3.0)
  (dotimes (v1-1 (-> this dots length))
    (if (zero? (-> this dots v1-1))
        (+! (-> this score) 1.0)
        )
    )
  (let ((f30-0 (+ (-> this base-score) (-> this score))))
    (cond
      ((>= (-> *game-info* score) f30-0)
       (set! (-> *game-info* score) f30-0)
       )
      ((time-elapsed? (-> this score-time) (seconds 0.1))
       (sound-play "point-increase")
       (seek! (-> *game-info* score) f30-0 1.0)
       (set-time! (-> this score-time))
       )
      )
    )
  (none)
  )

(defmethod update-score-text ((this hj2-power-game))
  "Jak 3's update-score-text (the dots, and the scoreboard above the board once Jak 3's task is
done), with the scoreboard shown whatever the task's state: every game here is a replay, scored.
Returns nothing."
  (call-parent-method this)
  (if (not (task-node-closed? (game-task-node city-power-game-resolution)))
      (spawn
        (-> this score-part 0)
        (vector+! (new 'stack-no-clear 'vector) (-> this center) (new 'static 'vector :y 16384.0 :w 1.0))
        )
      )
  (none)
  )

(defmethod deactivate ((this hj2-power-game))
  "Jak 3's deactivate (the scoreboard's particles killed, *power-game* cleared), after emptying the
score (a game killed midway, by a continue or a level unload, leaves Jak 3's high score table alone:
the active exit run by the kill skips a score of 0) and letting powergd go (the level-load-info's
borrow-info, GAME data, must not keep this level's quoted list once it unloads). Returns nothing."
  (set! (-> this base-score) 0.0)
  (set! (-> this score) 0.0)
  (let ((borrow (-> this level info borrow)))
    (if borrow
        (set! (-> borrow borrow-info 0) #f)
        )
    )
  (call-parent-method this)
  (none)
  )
