(in-package goal)

;; name: hj2-atoll-part.gc
;; name in dgo: hj2-atoll-part
;; dgos: HJL

;; og:jak2-haven-city GENERATED by scripts/level_port from
;; custom_assets/jak3/ports/jak2-haven-city/port.jsonc, edit the port.
;; Jak 2's particle effects of atoll: 30 parts (ids 3316-3345), 15 groups (ids 1001-1015), 1 sprite
;; texture(s) in its own texture page 1556, translated from Jak 2's levels/atoll/atoll-part.gc.

;; hj2-atoll's texture page 1556: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-atoll.jsonc), as names and sizes (w | h << 16)
(define *hj2-atoll-sprite-names* (new 'static 'boxed-array :type string "water-ring"))

(define *hj2-atoll-sprite-sizes* (new 'static 'boxed-array :type uint32 #x800080))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-atoll (hj2-sprite-page-new 1556 *hj2-atoll-sprite-names* *hj2-atoll-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-drop-level-atoll-drop ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's check-drop-level-atoll-drop (levels/atoll/atoll-part.gc)."
  (let
    ((f30-0 (get-height *ocean* (-> arg2 x-y-z-sx) #t)))
    (when
      (and (!= f30-0 4095996000.0) (< (-> arg2 y) f30-0))
      (let
        ((s3-0 (new 'stack-no-clear 'vector)))
        (sp-kill-particle arg0 arg1)
        (set-vector! s3-0 (-> arg2 x) f30-0 (-> arg2 z) 1.0)
        (launch-particles (-> *part-id-table* 3331) s3-0)
        (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 3343) s3-0)
      )
    )
  )
  (sparticle-motion-blur arg0 arg1 (the-as vector arg2))
  (none)
  )

(defun hj2-check-drop-level-atoll ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 vector))
  (when (< (-> arg2 y) (-> arg1 user-float))
    (let ((s3-0 (new 'stack-no-clear 'vector)))
      (sp-kill-particle arg0 arg1)
      (set-vector! s3-0 (-> arg2 x) (-> arg1 user-float) (-> arg2 z) 1.0)
      (launch-particles (-> *part-id-table* 3331) s3-0)
      )
    )
  (sparticle-motion-blur arg0 arg1 arg2)
  (none)
  )

