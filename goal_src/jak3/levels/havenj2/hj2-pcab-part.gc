;; Jak 2's particle effects of palcab: 48 parts (ids 3268-3315), 36 groups (ids 965-1000), 5 sprite
;; texture(s) in its own texture page 1548, translated from Jak 2's
;; levels/palace/cable/palcab-part.gc, levels/sewer/sew-gunturret.gc.

;; hj2-pcab's texture page 1548: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-pcab.jsonc), as names and sizes (w | h << 16)
(define *hj2-pcab-sprite-names* (new 'static 'boxed-array :type string "palcab-blue-rotaters" "seagull-wing" "flamingstick" "explosion-wave" "bigstarflash"))

(define *hj2-pcab-sprite-sizes* (new 'static 'boxed-array :type uint32 #x200020 #x200040 #x100080 #x400040 #x800080))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-pcab (hj2-sprite-page-new 1548 *hj2-pcab-sprite-names* *hj2-pcab-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-palcab-bird-bob-func ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's palcab-bird-bob-func (levels/palace/cable/palcab-part.gc)."
  (set!
    (-> arg2 y)
    (+
      (-> arg1 key proc root trans y)
      (* -2048.0 (sin (* 218.45334 (the float (mod (current-time) 300)))))
    )
  )
  0
  (none)
  )

(defun hj2-sparticle-palcab-bird-moon ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's sparticle-palcab-bird-moon (levels/palace/cable/palcab-part.gc)."
  (set! (-> arg2 rot) (the float (sar (shl (the int (+ -16384.0 (-> arg1 omega))) 48) 48)))
  0
  (none)
  )

