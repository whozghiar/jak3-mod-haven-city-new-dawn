;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-birth-func-vinroom-sphere ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-3d) (arg3 sparticle-launcher) (arg4 sparticle-launch-state))
  "Jak 2's birth-func-vinroom-sphere (levels/city/vinroom/vinroom-part.gc)."
  (let
    ((v1-1 (-> arg4 sprite key)))
    (when
      (nonzero? v1-1)
      (let
        ((f0-2 (+ (- 24576.0 (-> arg2 x-y-z-sx y)) (-> v1-1 origin trans y))))
        (set! (-> arg1 radius) (sqrtf (- (* (-> arg1 radius) (-> arg1 radius)) (square f0-2))))
      )
    )
  )
  0
  (none)
  )

