(in-package goal)

;; name: hj2-ruins-part.gc
;; name in dgo: hj2-ruins-part
;; dgos: HJR

;; og:jak2-haven-city GENERATED by custom_assets/jak3/levels/havenj2/gen_havenj2_particles.py, edit
;; the script. Jak 2's particle effects of ruins, translated from Jak 2's levels/ruins/ruins-part.gc:
;; 7 parts (ids 2800-2999), 2 groups (ids 840-879), 1 sprite texture(s) in its own texture page.

;; hj2-ruins's texture page 1627: the sprite textures of its particles (their pixels are in
;; its fr3, see sprite_textures in hj2-ruins.jsonc), as names and sizes (w | h << 16)
(define *hj2-ruins-sprite-names* (new 'static 'boxed-array :type string "seagull-wing"))

(define *hj2-ruins-sprite-sizes* (new 'static 'boxed-array :type uint32 #x200040))

;; made while the level loads, handed to the texture system when it is activated (GAME,
;; jak2-haven-city-world.gc)
(hj2-sprite-page-register 'hj2-ruins (hj2-sprite-page-new 1627 *hj2-ruins-sprite-names* *hj2-ruins-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-ruins-bird-bob-func ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's ruins-bird-bob-func (levels/ruins/ruins-part.gc)."
  (set!
    (-> arg2 y)
    (+
      (-> arg1 key proc root trans y)
      (* -2048.0 (sin (* 218.45334 (the float (mod (current-time) 300)))))
    )
  )
  0
  (none)
  )

(defun hj2-sparticle-ruins-bird-moon ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's sparticle-ruins-bird-moon (levels/ruins/ruins-part.gc)."
  (set! (-> arg2 rot) (the float (sar (shl (the int (+ -16384.0 (-> arg1 omega))) 48) 48)))
  0
  (none)
  )

