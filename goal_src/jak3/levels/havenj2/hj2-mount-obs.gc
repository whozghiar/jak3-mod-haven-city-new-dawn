;;-*-Lisp-*-
(in-package goal)

;; name: hj2-mount-obs.gc
;; name in dgo: hj2-mount-obs
;; dgos: HJM

;; og:jak2-haven-city Level code for hj2-mount, Jak 2's mountain (levels/mountain/mountain-obs.gc
;; and mountain-obs2.gc there): the actors on the way from the gardens airlock to Haven Forest, and
;; the temple's platforms. Its warp gates are Jak 3's own. The models here are Jak 2's, rebuilt by
;; build-actor (hj2-*.glb, made by the level port, scripts/level_port), each
;; with an invisible collision mesh: a box around it, or for the platforms the convex hull of the
;; model.

;; Transport platform /////////////////////////////////////////////////////////////////////////////

;; Jak 2's trans-plat (a mtn-plat-return): from the mountain top, it takes Jak down the stream to
;; Haven Forest, and back. It waits at one end of its path; once Jak has stood on it for half a
;; second, it grabs him and rides to the other end. Jak 2 only showed it after the forest scouts
;; mission started, it is always there here.
(deftype hj2-trans-plat (base-plat)
  ((ride-timer  time-frame)
   (ridden?     symbol)
   (path-pos    float)
   (dest-pos    float)
   (path-speed  float)
   )
  (:state-methods
    rising
    waiting
    running
    waiting-for-no-player
    )
  )


(def-actor hj2-trans-plat
  :bounds (0 -2 0 4.8)
  )

;; rises 6m into place at its path position, then waits
(defstate rising (hj2-trans-plat)
  :virtual #t
  :event plat-event
  :code (behavior ()
    (get-point-at-percent-along-path! (-> self path) (-> self basetrans) (-> self path-pos) 'interp)
    (let ((base-y (-> self basetrans y))
          (offset (meters 6))
          )
      (while (< 0.0 offset)
        (set! (-> self basetrans y) (- base-y offset))
        (plat-trans)
        (set! offset (seek-ease offset 0.0 (* (meters 10) (seconds-per-frame)) (meters 0.5) (* (meters 1) (seconds-per-frame))))
        (suspend)
        )
      )
    (go-virtual waiting)
    )
  :post plat-post
  )

;; waits at an end of its path; after half a second with Jak on it, grabs Jak and runs
(defstate waiting (hj2-trans-plat)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('ridden)
       (set! (-> self ridden?) #t)
       )
      (else
        (plat-event proc argc message block)
        )
      )
    )
  :enter (behavior ()
    (set-time! (-> self ride-timer))
    (get-point-at-percent-along-path! (-> self path) (-> self basetrans) (-> self path-pos) 'interp)
    )
  :trans (behavior ()
    ;; 'ridden comes from plat-trans (rider-trans)
    (set! (-> self ridden?) #f)
    (plat-trans)
    (if (not (-> self ridden?))
        (set-time! (-> self ride-timer))
        )
    (when (and (time-elapsed? (-> self ride-timer) (seconds 0.5))
               (-> self ridden?)
               *target*
               (process-grab? *target* #f)
               )
      (set! (-> self dest-pos) (if (= (-> self path-pos) 0.0)
                                   1.0
                                   0.0
                                   )
            )
      (go-virtual running)
      )
    )
  :code sleep-code
  :post plat-post
  )

;; rides to the other end (eased), then waits for Jak to get off
(defstate running (hj2-trans-plat)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('ridden)
       (set! (-> self ridden?) #t)
       )
      (else
        (plat-event proc argc message block)
        )
      )
    )
  :exit (behavior ()
    (if (-> self ridden?)
        (process-release? *target*)
        )
    )
  :trans (behavior ()
    (if (= (-> self path-pos) (-> self dest-pos))
        (go-virtual waiting-for-no-player)
        )
    (plat-trans)
    )
  :code sleep-code
  :post (behavior ()
    (seek! (-> self path-pos) (-> self dest-pos) (* (-> self path-speed) (seconds-per-frame)))
    (get-point-at-percent-along-path!
      (-> self path)
      (-> self basetrans)
      (ease-value-in-out (-> self path-pos) 0.1)
      'interp
      )
    (plat-post)
    )
  )

;; at its destination: waits until Jak has been off it for a second
(defstate waiting-for-no-player (hj2-trans-plat)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('ridden)
       (set-time! (-> self ride-timer))
       )
      (else
        (plat-event proc argc message block)
        )
      )
    )
  :trans (behavior ()
    (plat-trans)
    (if (time-elapsed? (-> self ride-timer) (seconds 1))
        (go-virtual waiting)
        )
    )
  :code sleep-code
  :post plat-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-trans-plat) (arg0 entity-actor))
  "Jak 2's mtn-plat-return and trans-plat setup: a rideable pusher (the collision box of its model,
from its origin, as in Jak 2), its path (a curve) ridden at the entity's speed, starting from the
end closest to Jak, and rising into place."
  (let ((s5-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s4-0 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s4-0 prim-core collide-as) (collide-spec pusher))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (set! (-> s4-0 transform-index) 0)
      (set-vector! (-> s4-0 local-sphere) 0.0 (meters -1.9) 0.0 (meters 4.5))
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-11 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-11 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-11 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-trans-plat-sg* (the-as pair 0))
  (init-bounce-params! this)
  (set! (-> this ridden?) #f)
  (set! (-> this path-pos) 0.0)
  (set! (-> this path) (new 'process 'curve-control this 'path -1000000000.0))
  (if (logtest? (-> this path flags) (path-control-flag not-found))
      (go process-drawable-art-error "error in path")
      )
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (let ((f30-0 (total-distance (-> this path))))
    (set! (-> this path-speed) (/ (res-lump-float arg0 'speed :default 40960.0) f30-0))
    (set! (-> this root pause-adjust-distance) (+ 204800.0 f30-0))
    )
  ;; trans-plat's init-plat!: start at the control point closest to Jak
  (when *target*
    (let ((s4-0 (get-trans *target* 0))
          (f28-0 0.0)
          (f30-1 -1.0)
          (s5-1 (-> this path curve num-cverts))
          )
      (dotimes (s3-0 s5-1)
        (let ((f0-3
                (vector-vector-distance s4-0 (get-point-in-path! (-> this path) (new 'stack-no-clear 'vector) (the float s3-0) 'interp))
                )
              )
          (when (or (= f30-1 -1.0) (< f0-3 f28-0))
            (set! f28-0 f0-3)
            (set! f30-1 (the float s3-0))
            )
          )
        )
      (if (!= f30-1 -1.0)
          (set! (-> this path-pos) (/ f30-1 (+ -1.0 (the float s5-1))))
          )
      )
    )
  (go (method-of-object this rising))
  )

;; Solid props ////////////////////////////////////////////////////////////////////////////////////

;; A model that doesn't move: solid and rideable (the collision box of its model, bound to its main
;; joint), holding the first frame of its animation.
(deftype hj2-mtn-prop (process-drawable)
  ((root  collide-shape :override)
   )
  (:state-methods
    idle
    )
  )


;; holds the first frame of its animation, still
(defstate idle (hj2-mtn-prop)
  :virtual #t
  :code (behavior ()
    (ja :num-func num-func-identity :frame-num 0.0)
    (transform-post)
    (sleep-code)
    )
  )

(defun hj2-mtn-prop-init! ((this hj2-mtn-prop) (arg0 entity-actor) (skel skeleton-group) (sphere vector))
  "Collision (sphere: its bounds, from the main joint), placement and skeleton of a solid prop."
  (let ((s5-0 (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((v1-2 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-2 prim-core collide-as) (collide-spec obstacle))
      (set! (-> v1-2 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-2 prim-core action) (collide-action solid rideable))
      (set! (-> v1-2 transform-index) 3)
      (vector-copy! (-> v1-2 local-sphere) sphere)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-2)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-5 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-5 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-5 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this skel (the-as pair 0))
  (none)
  )

;; Jak 2's mtn-iris-door, shut: Jak 2 opens it once the items are placed in the canyon, after Mar's
;; tomb is found (canyon-insert-items-door). Kept shut like the palace plaza is kept before the
;; tomb (see END_HIDDEN_PROTOTYPES in the level port's games/jak2.py); the canyon behind it
;; isn't ported.
(deftype hj2-iris-door (hj2-mtn-prop)
  ()
  )


(def-actor hj2-iris-door
  :bounds (0 0 0 9.5)
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-iris-door) (arg0 entity-actor))
  "Jak 2's mtn-iris-door setup: a solid prop, shut."
  (hj2-mtn-prop-init! this arg0 *hj2-iris-door-sg* (new 'static 'vector :w (meters 9.5)))
  (go (method-of-object this idle))
  )

;; Jak 2's mtn-plat-elevator, parked at the mountain top: it only goes down to the far iris door,
;; which stays shut.
(deftype hj2-mtn-elevator (hj2-mtn-prop)
  ()
  )


(def-actor hj2-mtn-elevator
  :bounds (0 0 0 8.5)
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-mtn-elevator) (arg0 entity-actor))
  "Jak 2's mtn-plat-elevator setup: a solid prop, parked."
  (hj2-mtn-prop-init! this arg0 *hj2-mtn-elevator-sg* (new 'static 'vector :w (meters 8.5)))
  (go (method-of-object this idle))
  )

;; Jak 2's mtn-plat-gap (a mtn-plat-return, the model of the trans-plat), raised over the temple's
;; gap once its puzzle is solved: here it stays there (the generator puts it at the top of its path).
(deftype hj2-mtn-plat-gap (hj2-mtn-prop)
  ()
  )


;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-mtn-plat-gap) (arg0 entity-actor))
  "Jak 2's mtn-plat-gap setup: a solid prop with the trans-plat's model."
  (hj2-mtn-prop-init! this arg0 *hj2-trans-plat-sg* (new 'static 'vector :y (meters -1.9) :w (meters 4.5)))
  (go (method-of-object this idle))
  )

;; Jak 2's mtn-plat-buried (levels/mountain/mountain-scenes.gc there), out of the rocks.
(deftype hj2-mtn-plat-buried (hj2-mtn-prop)
  ()
  )


(def-actor hj2-mtn-plat-buried
  :bounds (0 -1.9 0 4.5)
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-mtn-plat-buried) (arg0 entity-actor))
  "Jak 2's mtn-plat-buried setup: a solid prop, out of the rocks."
  (hj2-mtn-prop-init! this arg0 *hj2-mtn-plat-buried-sg* (new 'static 'vector :y (meters -1.9) :w (meters 4.5)))
  (go (method-of-object this idle))
  )

;; Moving platforms ////////////////////////////////////////////////////////////////////////////////

;; A base-plat's collision: the convex hull of its model, bound to its main joint, rideable and
;; pushing (sphere: its bounds from the main joint).
(defun hj2-mtn-plat-collision! ((this base-plat) (sphere vector))
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (let ((s4-0 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s4-0 prim-core collide-as) (collide-spec pusher))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (set! (-> s4-0 transform-index) 3)
      (vector-copy! (-> s4-0 local-sphere) sphere)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-12 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-12 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-12 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  (none)
  )

;; Jak 2's mtn-plat-updown: a platform going up and down its path (sync lump).
(deftype hj2-mtn-plat-updown (base-plat)
  ((sync      sync-eased  :inline)
   (path-pos  float)
   )
  (:state-methods
    idle
    active
    )
  )


(def-actor hj2-mtn-plat-updown
  :bounds (0 -1.8 0 4)
  )

;; without a path or a sync period: still
(defstate idle (hj2-mtn-plat-updown)
  :virtual #t
  :code sleep-code
  :post ja-post
  )

;; going up and down its path (sync), carrying Jak
(defstate active (hj2-mtn-plat-updown)
  :virtual #t
  :event plat-event
  :trans (behavior ()
    (set! (-> self path-pos) (get-norm! (-> self sync) 0))
    (get-point-at-percent-along-path! (-> self path) (-> self basetrans) (-> self path-pos) 'interp)
    (plat-trans)
    )
  :code sleep-code
  :post plat-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-mtn-plat-updown) (arg0 entity-actor))
  "Jak 2's mtn-plat-updown setup: a rideable pusher (the hull of its model), its path and its sync
(a 6 second cycle)."
  (hj2-mtn-plat-collision! this (new 'static 'vector :y (meters -1.8) :w (meters 4)))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-mtn-plat-updown-sg* (the-as pair 0))
  (init-bounce-params! this)
  (ja-post)
  (set! (-> this path) (new 'process 'path-control this 'path 0.0 arg0 #f))
  (logior! (-> this path flags) (path-control-flag display draw-line draw-point draw-text))
  (let ((a1-7 (new 'stack-no-clear 'sync-info-params)))
    (set! (-> a1-7 sync-type) 'sync-eased)
    (set! (-> a1-7 sync-flags) (sync-flags pong))
    (set! (-> a1-7 period) (the-as uint 1800))
    (set! (-> a1-7 entity) arg0)
    (set! (-> a1-7 percent) 0.0)
    (set! (-> a1-7 ease-in) 0.15)
    (set! (-> a1-7 ease-out) 0.15)
    (set! (-> a1-7 pause-in) 0.2)
    (set! (-> a1-7 pause-out) 0.0)
    (initialize! (-> this sync) a1-7)
    )
  (if (or (logtest? (-> this path flags) (path-control-flag not-found)) (<= (-> this sync period) 0))
      (go (method-of-object this idle))
      (go (method-of-object this active))
      )
  )

;; Jak 2's mtn-plat-long: a long platform swinging along its animation, one cycle per sync period.
(deftype hj2-mtn-plat-long (base-plat)
  ((sync  sync-linear  :inline)
   )
  (:state-methods
    idle
    )
  )


(def-actor hj2-mtn-plat-long
  :bounds (0 0 0 15.5)
  )

;; swings along its animation, one cycle per sync period, carrying Jak
(defstate idle (hj2-mtn-plat-long)
  :virtual #t
  :event plat-event
  :trans plat-trans
  :code (behavior ()
    (until #f
      (let ((f0-1 (* (get-current-phase-no-mod (-> self sync)) (the float (+ (-> (ja-group) frames num-frames) -1))))
            (a0-1 (-> self skel root-channel 0))
            )
        (set! (-> a0-1 frame-group) (ja-group))
        (set! (-> a0-1 param 0) 1.0)
        (set! (-> a0-1 frame-num) f0-1)
        (joint-control-channel-group! a0-1 (ja-group) num-func-loop!)
        )
      (suspend)
      )
    #f
    )
  :post plat-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-mtn-plat-long) (arg0 entity-actor))
  "Jak 2's mtn-plat-long setup: a rideable pusher (the hull of its model) and its sync (a 4 second
cycle)."
  (hj2-mtn-plat-collision! this (new 'static 'vector :w (meters 15.5)))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-mtn-plat-long-sg* (the-as pair 0))
  (init-bounce-params! this)
  (update-transforms (-> this root))
  (let ((a1-5 (new 'stack-no-clear 'sync-info-params)))
    (set! (-> a1-5 sync-type) 'sync-linear)
    (set! (-> a1-5 sync-flags) (sync-flags pong))
    (set! (-> a1-5 entity) arg0)
    (set! (-> a1-5 period) (the-as uint 1200))
    (set! (-> a1-5 percent) 0.0)
    (initialize! (-> this sync) a1-5)
    )
  (go (method-of-object this idle))
  )

;; Jak 2's mtn-plat-shoot: a platform moving along its path, flipping over for a few seconds (delay)
;; when shot.
(deftype hj2-mtn-plat-shoot (plat)
  ((incoming-attack-id  uint32)
   (angle-flip          float)
   (angle-flip-vel      float)
   (axe-flip            vector  :inline)
   (state-flip          uint32)
   (time-flip           float)
   (dest-angle          float)
   )
  )


(def-actor hj2-mtn-plat-shoot
  :bounds (0 -2.5 0 5.1)
  )

(defmethod get-art-group ((this hj2-mtn-plat-shoot))
  "Its model: Jak 2's mtn-plat-shoot."
  (the-as art-group *hj2-mtn-plat-shoot-sg*)
  )

(defmethod init-collision! ((this hj2-mtn-plat-shoot))
  "A rideable pusher: the hull of its model."
  (hj2-mtn-plat-collision! this (new 'static 'vector :y (meters -2.5) :w (meters 5.1)))
  (none)
  )

(defmethod base-plat-method-34 ((this hj2-mtn-plat-shoot))
  "Jak 2's init-plat!: the flip axis and how long the platform stays flipped."
  (logclear! (-> this mask) (process-mask actor-pause))
  (logior! (-> this mask) (process-mask enemy))
  (set-vector! (-> this axe-flip) 1.0 0.0 0.0 1.0)
  (set! (-> this angle-flip) 180.0)
  (set! (-> this dest-angle) 180.0)
  (set! (-> this time-flip) (the float (the int (* 300.0 (res-lump-float (-> this entity) 'delay :default 4.0)))))
  (none)
  )

;; Jak 3's plat moving along its path, with Jak 2's flip: a projectile flips it over for its delay
(defstate plat-path-active (hj2-mtn-plat-shoot)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('bonk)
       (start-bounce! self)
       )
      (('attack)
       (when (zero? (-> self state-flip))
         (let ((attack (the-as attack-info (-> block param 1))))
           (when (!= (-> attack id) (-> self incoming-attack-id))
             (set! (-> self incoming-attack-id) (-> attack id))
             (let ((attacker (as-type proc process-drawable)))
               (when attacker
                 (let ((cshape (as-type (-> (the-as process-drawable attacker) root) collide-shape)))
                   (when (and cshape (logtest? (-> (the-as collide-shape cshape) root-prim prim-core collide-as)
                                               (collide-spec projectile)
                                               )
                              )
                     (set! (-> self state-flip) (the-as uint 1))
                     (vector-! (-> self axe-flip) (-> (the-as collide-shape cshape) trans) (-> self root trans))
                     (set! (-> self axe-flip y) 0.0)
                     (vector-normalize! (-> self axe-flip) 1.0)
                     (vector-rotate90-around-y! (-> self axe-flip) (-> self axe-flip))
                     (set! (-> self angle-flip-vel) -10.0)
                     (set-time! (-> self state-time))
                     )
                   )
                 )
               )
             )
           )
         )
       #f
       )
      )
    )
  :enter (behavior ()
    (let ((func (-> (method-of-type plat plat-path-active) enter)))
      (if func
          (func)
          )
      )
    (set! (-> self dest-angle) 180.0)
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (when (time-elapsed? (-> self state-time) (the int (-> self time-flip)))
      (set! (-> self state-flip) (the-as uint 0))
      0
      )
    (set! (-> self dest-angle) (if (zero? (-> self state-flip))
                                   180.0
                                   0.0
                                   )
          )
    (+! (-> self angle-flip-vel) (* -0.5 (seconds-per-frame) (- (-> self angle-flip) (-> self dest-angle))))
    (+! (-> self angle-flip-vel) (* -6.0 (seconds-per-frame) (-> self angle-flip-vel)))
    (+! (-> self angle-flip) (-> self angle-flip-vel))
    (quaternion-vector-angle! (-> self root quat) (-> self axe-flip) (* 182.04445 (-> self angle-flip)))
    (quaternion-normalize! (-> self root quat))
    (let ((func (-> (method-of-type plat plat-path-active) trans)))
      (if func
          (func)
          )
      )
    )
  :post (behavior ()
    (let ((func (-> (method-of-type plat plat-path-active) post)))
      (if func
          ((the-as (function none) func))
          )
      )
    )
  )

;; Windmills ///////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's pal-windmill (levels/palace/cable/palcab-obs.gc there): the windmills of the backdrop,
;; their blades turning in their animation.
(deftype hj2-pal-windmill (process-drawable)
  ()
  (:state-methods
    idle
    )
  )


(def-actor hj2-pal-windmill
  :bounds (0 0 0 62)
  )

;; plays its animation (the blades turning) in a loop
(defstate idle (hj2-pal-windmill)
  :virtual #t
  :code (behavior ()
    (until #f
      (ja-no-eval :group! (ja-group) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    #f
    )
  :post ja-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-pal-windmill) (arg0 entity-actor))
  "Jak 2's pal-windmill setup: placement and skeleton."
  (logior! (-> this mask) (process-mask ambient))
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (logclear! (-> this mask) (process-mask actor-pause))
  (initialize-skeleton this *hj2-pal-windmill-sg* (the-as pair 0))
  (go (method-of-object this idle))
  )
