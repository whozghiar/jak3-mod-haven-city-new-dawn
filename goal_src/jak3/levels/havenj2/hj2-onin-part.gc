;; dgos: HKI

;; og:jak2-haven-city GENERATED by scripts/level_port from
;; custom_assets/jak3/ports/jak2-haven-city/port.jsonc, edit the port.
;; Jak 2's particle effects of onintent: 50 parts (ids 3905-3954), 10 groups (ids 1165-1174), 4
;; sprite texture(s) in its own texture page 1652, translated from Jak 2's
;; levels/city/onintent/onintent-part.gc.

;; hj2-onin's texture page 1652: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-onin.jsonc), as names and sizes (w | h << 16)
(define *hj2-onin-sprite-names* (new 'static 'boxed-array :type string "onin-magic-bigpuff" "onin-spider-02" "onin-spider-01" "onin-spider-03"))

(define *hj2-onin-sprite-sizes* (new 'static 'boxed-array :type uint32 #x400040 #x200020 #x200020 #x200020))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-onin (hj2-sprite-page-new 1652 *hj2-onin-sprite-names* *hj2-onin-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-bubble-surface-onintent ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's check-bubble-surface-onintent (levels/city/onintent/onintent-part.gc)."
  (if (< (-> arg1 user-float) (-> arg2 y)) (sp-kill-particle arg0 arg1))
  )

(defun hj2-check-onintent-bugs ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's check-onintent-bugs (levels/city/onintent/onintent-part.gc)."
  (let
    ((a2-1 (-> arg1 key)) (v1-0 (new 'stack-no-clear 'vector)))
    (vector-! v1-0 (the-as vector (-> arg2 x-y-z-sx)) (-> a2-1 origin trans))
    (when
      (or (< 30720.0 (fabs (-> v1-0 x))) (< 45056.0 (fabs (-> v1-0 z))))
      (sp-kill-particle arg0 arg1)
      (return #f)
    )
  )
  (let
    ((s3-0 (the-as sprite-vec-data-2d (-> arg1 user-float))))
    (if
      (nonzero? s3-0)
      (set!
        (-> s3-0 x-y-z-sx w)
        (the-as
          float
          (the int (lerp-scale 150.0 10.0 (* 300.0 (vector-length (-> arg1 vel-sxvel))) 0.0 4096.0))
        )
      )
    )
  )
  (sparticle-turn-to-vel arg0 arg1 (the-as sprite-vec-data-3d arg2))
  (sparticle-texture-animate arg0 arg1 (the-as vector arg2))
  (none)
  )

