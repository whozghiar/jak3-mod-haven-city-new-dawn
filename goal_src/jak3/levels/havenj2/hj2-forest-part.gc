;;-*-Lisp-*-
(in-package goal)

;; name: hj2-forest-part.gc
;; name in dgo: hj2-forest-part
;; dgos: HJF

;; og:jak2-haven-city GENERATED by scripts/level_port from
;; custom_assets/jak3/ports/jak2-haven-city/port.jsonc, edit the port.
;; Jak 2's particle effects of forest: 53 parts (ids 2600-2652), 17 groups (ids 800-816), 8 sprite
;; texture(s) in its own texture page 1594, translated from Jak 2's levels/forest/forest-part.gc.

;; hj2-forest's texture page 1594: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-forest.jsonc), as names and sizes (w | h << 16)
(define *hj2-forest-sprite-names* (new 'static 'boxed-array :type string "butterfly-1" "butterfly-2" "harddot" "cattail" "firefly" "waterfall-drops" "water-ring" "rainbow"))

(define *hj2-forest-sprite-sizes* (new 'static 'boxed-array :type uint32 #x400040 #x400040 #x400040 #x200020 #x200020 #x400040 #x800080 #x400040))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-forest (hj2-sprite-page-new 1594 *hj2-forest-sprite-names* *hj2-forest-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-drop-level-forest ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 vector))
  (when (< (-> arg2 y) (-> arg1 user-float))
    (let ((s3-0 (new 'stack-no-clear 'vector)))
      (sp-kill-particle arg0 arg1)
      (set-vector! s3-0 (-> arg2 x) (-> arg1 user-float) (-> arg2 z) 1.0)
      (launch-particles (-> *part-id-table* 2634) s3-0)
      (launch-particles (-> *part-id-table* 2635) s3-0)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 2636) s3-0)
      )
    )
  (sparticle-motion-blur arg0 arg1 arg2)
  (none)
  )

