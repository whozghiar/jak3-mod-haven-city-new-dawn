;; Art groups ////////////////////////////////////////////////////////////////////////////////////////

;; The models, rebuilt by build-actor from Jak 2's rips (the level port's "models": hj2-whack-cabinet
;; and its extras). Their animations are in the order of their "anims" there.

;; Jak 2's hip-whack-a-metal: the cabinet. Joints (node = joint + 1): main 3, the 8 holes mole to
;; mole7 4 to 11, the scoreboards misses 12 and points 13. Bounds: Jak 2's skel-hip-whack-a-metal's.
(def-actor hj2-whack-cabinet
  :bounds (0 -1 1 3.8)
  :origin-joint-index 3
  )

;; Jak 2's hip-mole: a metal head (its normal primitives), rising, bobbing and sinking. Joints: main
;; 3, head 4. Bounds: Jak 2's skel-hip-mole's.
(def-actor hj2-hip-mole
  :art (idle-ja up-ja loop-ja down-ja)
  :bounds (0 1 0 1.5)
  :origin-joint-index 3
  )

;; The gold metal head: the same rip's gold primitives (Jak 2 shows them with setup-masks; a
;; build-actor model has no masks, so it is a model of its own), the same animations.
(def-actor hj2-hip-mole-gold
  :art (idle-ja up-ja loop-ja down-ja)
  :bounds (0 1 0 1.5)
  :origin-joint-index 3
  )

;; Jak 2's daxter-highres with its daxter-mole animations, played on the cabinet (their root is the
;; cabinet's origin). Bounds: Jak 2's skel-sidekick-highres's (around node 6, the chest).
(def-actor hj2-whack-daxter
  :art (mole-idle-ja
        mole-whack0-ja
        mole-whack1-ja
        mole-whack2-ja
        mole-whack3-ja
        mole-whack4-ja
        mole-whack5-ja
        mole-whack6-ja
        mole-whack7-ja
        mole-idle-crazy-ja
        mole-idle-tired-ja
        mole-idle-angry-ja
        mole-shock-ja
        mole-idle-shock-ja
        mole-idle-shock-end-ja
        )
  :bounds (0 0 0 3)
  :origin-joint-index 6
  )

;; Jak 2's big-bopper: Daxter's hammer, with the same animations as his (by name: clone-anim-once).
(def-actor hj2-whack-bopper
  :art (mole-idle-ja
        mole-whack0-ja
        mole-whack1-ja
        mole-whack2-ja
        mole-whack3-ja
        mole-whack4-ja
        mole-whack5-ja
        mole-whack6-ja
        mole-whack7-ja
        mole-idle-crazy-ja
        mole-idle-tired-ja
        mole-idle-angry-ja
        mole-shock-ja
        mole-idle-shock-ja
        mole-idle-shock-end-ja
        )
  :bounds (0 0 0 3)
  :origin-joint-index 3
  )

;; Jak 2's frames are at 30 per second, build-actor's at 60: Jak 2's frame numbers (its ja-aframe
;; values, artist base 0) times this.
(defconstant HJ2_WHACK_FRAMES 2.0)

;; Jak 2's lightning-hip-mole-deadly (its lightning-spec 21): the sparks around a red metal head and
;; around a shocked Daxter, with the texture of Jak 3's lightning (Jak 2's page #xc index #x83 is
;; page #x4 index #x3f in Jak 3, as in hj2-vin-obs.gc).
(define *hj2-hip-mole-lightning* (new 'static 'lightning-spec
                                   :name #f
                                   :flags (lightning-spec-flags lsf0)
                                   :start-color (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                                   :end-color (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                                   :fade-to-color (new 'static 'rgba :r #xbf :b #x8f :a #x5)
                                   :fade-start-factor 0.2
                                   :texture (new 'static 'texture-id :index #x3f :page #x4)
                                   :reduction 0.5
                                   :num-points 32
                                   :box-size 2048.0
                                   :merge-factor 0.5
                                   :merge-count 2
                                   :radius 409.6
                                   :duration 30.0
                                   :sound (static-sound-spec "shock" :group 0)
                                   )
        )

;; Metal heads ///////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's hip-mole: one metal head of a hole of the cabinet, a child of the game (hj2-whack-a-metal).
;;   cabinet:  the cabinet (hj2-whack-cabinet), whose hole joint it follows
;;   index:    its hole, 0 to 7
;;   mode:     the wave mode it rose for (hj2-hip-mole-event): 10 red, 11 gold, else normal
;;   sound-id: its bouncing sound while up
;;   abort?:   set by 'abort (Daxter shocked): it sinks without counting a miss
;;   gold?:    the gold twin (hj2-hip-mole-gold model), hidden while down
(deftype hj2-hip-mole (process-drawable)
  ((cabinet   handle)
   (index     int32)
   (mode      uint8)
   (sound-id  sound-id)
   (abort?    symbol)
   (gold?     symbol)
   )
  (:state-methods
    idle
    (active time-frame uint)
    )
  )


(defbehavior hj2-hip-mole-anim hj2-hip-mole ((idx int))
  "The metal head's animation idx (0 idle, 1 up, 2 loop, 3 down) in its own art group: the normal
and the gold models have the same animations in the same order. Returns the art-joint-anim."
  (the-as art-joint-anim (-> self draw art-group data (+ idx 2)))
  )

(defbehavior hj2-hip-mole-post hj2-hip-mole ()
  "Jak 2's hip-mole idle post: stands on its hole joint of the cabinet (node 4 + index), turned like
the cabinet, then the animation post. Returns nothing."
  (let ((cab (the-as process-drawable (handle->process (-> self cabinet)))))
    (when cab
      (vector<-cspace! (-> self root trans) (-> cab node-list data (+ (-> self index) 4)))
      (quaternion-copy! (-> self root quat) (-> cab root quat))
      )
    )
  (ja-post)
  (none)
  )

;; down in its hole (the first frame of its rising animation), waiting for 'active (its time up and
;; its mode); the gold one hidden
(defstate idle (hj2-hip-mole)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('active)
       (go-virtual active (the-as time-frame (-> block param 0)) (-> block param 1))
       )
      )
    )
  :code (behavior ()
    (if (-> self gold?)
        (logior! (-> self draw status) (draw-control-status no-draw))
        )
    (set-vector! (-> self draw color-mult) 1.0 1.0 1.0 1.0)
    (ja-channel-push! 1 (seconds 0.05))
    (ja :group! (hj2-hip-mole-anim 1) :num! min)
    (sleep-code)
    )
  :post hj2-hip-mole-post
  )

;; up for arg0 (Jak 2's hip-mole active): rises, bobs until its time is up, sinks; a sink unhit is a
;; miss ('done to the game) but for a red one. 'touch (Daxter's hammer) answers 'die (red: Daxter is
;; shocked), 'gold, or a hit (anything else); 'abort sinks it without a miss.
(defstate active (hj2-hip-mole)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touch)
       (case (-> self mode)
         ((10)
          (sound-play "whack-wrong")
          'die
          )
         ((11)
          (sound-play "whack-gold")
          (go-virtual idle)
          'gold
          )
         (else
           (sound-play "whack-hit")
           (go-virtual idle)
           )
         )
       )
      (('abort)
       (set! (-> self abort?) #t)
       #t
       )
      )
    )
  :enter (behavior ((arg0 time-frame) (arg1 uint))
    (set! (-> self mode) arg1)
    (if (= (-> self mode) 10)
        (set-vector! (-> self draw color-mult) 1.0 0.0 0.0 1.0)
        )
    (logclear! (-> self draw status) (draw-control-status no-draw))
    (sound-play "whack-up")
    (set! (-> self sound-id) (sound-play "whack-bounce"))
    (set! (-> self abort?) #f)
    )
  :exit (behavior ()
    (sound-stop (-> self sound-id))
    )
  :trans (behavior ()
    ;; a red one sparks around its head (node 4)
    (when (and (= (-> self mode) 10) (rand-vu-percent? 0.4))
      (let ((gp-0 (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data 4)))
            (s5-0 (vector<-cspace! (new 'stack-no-clear 'vector) (-> self node-list data 4)))
            )
        (+! (-> gp-0 x) (rand-vu-float-range -1638.4 819.2))
        (+! (-> s5-0 x) (rand-vu-float-range -1638.4 819.2))
        (+! (-> gp-0 y) (rand-vu-float-range -1228.8 1228.8))
        (+! (-> s5-0 y) (rand-vu-float-range -1228.8 1228.8))
        (+! (-> gp-0 z) (rand-vu-float-range -1638.4 819.2))
        (+! (-> s5-0 z) (rand-vu-float-range -1638.4 819.2))
        (process-spawn
          lightning-tracker
          :init lightning-tracker-init
          *hj2-hip-mole-lightning*
          0
          (the-as symbol #f)
          (the-as process-drawable #f)
          gp-0
          s5-0
          :name "lightning-tracker"
          :to *entity-pool*
          )
        )
      )
    )
  :code (behavior ((arg0 time-frame) (arg1 uint))
    (ja-no-eval :group! (hj2-hip-mole-anim 1) :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (ja-channel-push! 1 (seconds 0.05))
    (let ((s5-0 (current-time)))
      (while (and (not (time-elapsed? s5-0 arg0)) (not (-> self abort?)))
        (ja :group! (hj2-hip-mole-anim 2) :num! (loop!))
        (suspend)
        )
      )
    (ja-channel-push! 1 (seconds 0.05))
    (sound-play "whack-down")
    (ja-no-eval :group! (hj2-hip-mole-anim 3) :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (if (and (not (-> self abort?)) (!= (-> self mode) 10))
        (send-event (ppointer->process (-> self parent)) 'done)
        )
    (go-virtual idle)
    )
  :post hj2-hip-mole-post
  )

(defbehavior hj2-hip-mole-init hj2-hip-mole ((cabinet handle) (index int) (gold? symbol))
  "Jak 2's hip-mole-init. cabinet: the cabinet's handle; index: its hole (0 to 7); gold?: the gold
twin (its own model). Sets the root and the skeleton, goes to idle."
  (set! (-> self index) index)
  (set! (-> self cabinet) cabinet)
  (set! (-> self abort?) #f)
  (set! (-> self gold?) gold?)
  (set! (-> self root) (new 'process 'trsqv))
  (initialize-skeleton self (if gold? *hj2-hip-mole-gold-sg* *hj2-hip-mole-sg*) (the-as pair 0))
  (go-virtual idle)
  (none)
  )

;; Daxter's hammer /////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's big-bopper manipy ('clone-anim): Daxter's hammer, a child of the game, playing Daxter's
;; animation of the same name every frame.
(deftype hj2-whack-bopper (process-drawable)
  ()
  (:state-methods
    idle
    )
  )


;; copies Daxter's animation channels (hj2-whack-daxter-mole-* -> hj2-whack-bopper-mole-*), his
;; place and his turn every frame
(defstate idle (hj2-whack-bopper)
  :virtual #t
  :code sleep-code
  :post (behavior ()
    (clone-anim-once (ppointer->handle (-> self parent)) #t "hj2-whack-bopper-")
    )
  )

(defbehavior hj2-whack-bopper-init hj2-whack-bopper ()
  "The hammer's root and skeleton, then idle (Daxter's animation from its first frame on)."
  (set! (-> self root) (new 'process 'trsqv))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (initialize-skeleton self *hj2-whack-bopper-sg* (the-as pair 0))
  (go-virtual idle)
  (none)
  )

;; The game /////////////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's whack-a-metal: the game, Daxter on the cabinet (his model and animations), a child of the
;; cabinet, alive from the start of a game to its end.
;;   cabinet:          the cabinet (hj2-whack-cabinet): its holes and scoreboards
;;   camera-name:      the cabinet's fixed camera (its camera-name lump: Jak 2's camera-230)
;;   bopper:           Daxter's hammer (hj2-whack-bopper)
;;   mole, gold:       the 8 metal heads and their gold twins (hj2-hip-mole)
;;   score-part:       the scoreboards' particles: misses (0), points (1)
;;   wave, event:      where the game is in *hj2-mole-data*
;;   event-time, event-length: when the current event began, how long it lasts (0: not started)
;;   score:            the score; *game-info* score (read by the scoreboard's particles) counts up
;;                     to it
;;   score-time:       when *game-info* score last counted up
;;   dizzy?:           Daxter hit a red one: shocked, no input until he recovers
;;   miss-count:       misses (20: the game is over)
;;   air-attack-count: swings since Daxter last stood idle (10 or more: his tired idle)
;;   slot-buffer:      the buttons pressed during a swing, played next (-1: none)
;;   speech-time:      when Tess last spoke
;;   speech-count:     1 once she said a line about 1300 points
;;   speech-last:      the last line said of each kind (hj2-whack-pick-line)
;;   speech-id:        her line playing
(deftype hj2-whack-a-metal (process-drawable)
  ((cabinet           handle)
   (camera-name       string)
   (bopper            (pointer process))
   (mole              (pointer hj2-hip-mole)    8)
   (gold              (pointer hj2-hip-mole)    8)
   (score-part        sparticle-launch-control  2)
   (wave              int32)
   (event             int32)
   (event-time        time-frame)
   (event-length      time-frame)
   (score             float)
   (score-time        time-frame)
   (dizzy?            symbol)
   (miss-count        int32)
   (air-attack-count  int32)
   (slot-buffer       int32                     4)
   (speech-time       time-frame)
   (speech-count      int32)
   (speech-last       int32                     4)
   (speech-id         sound-id)
   )
  (:state-methods
    wait-for-start
    (active symbol)
    (attack int)
    lose
    win
    )
  )


(defmethod deactivate ((this hj2-whack-a-metal))
  "Jak 2's whack-a-metal deactivate: frees the scoreboards' particles, then the process."
  (dotimes (s5-0 2)
    (if (nonzero? (-> this score-part s5-0))
        (kill-particles (-> this score-part s5-0))
        )
    )
  (call-parent-method this)
  (none)
  )

(defmethod relocate ((this hj2-whack-a-metal) (offset int))
  "Jak 2's whack-a-metal relocate: moves the scoreboards' launch controls with the process heap."
  (dotimes (v1-0 2)
    (if (nonzero? (-> this score-part v1-0))
        (&+! (-> this score-part v1-0) offset)
        )
    )
  (call-parent-method this offset)
  )

(defun hj2-whack-pick-line ((this hj2-whack-a-metal) (kind int) (count int))
  "Jak 2's whack-a-metal-method-29: which of count lines of a kind (0 to 3) Tess says next, the next
or the one after the last one said (speech-last, updated). Returns its index."
  (let ((v0-1 (mod (+ (-> this speech-last kind) (rand-vu-int-range 1 2)) count)))
    (set! (-> this speech-last kind) v0-1)
    v0-1
    )
  )

(defun hj2-whack-say ((this hj2-whack-a-metal) (lines (array string)) (idx int) (force? symbol))
  "Tess says line idx of lines (Jak 2's talker-spawn-func of her speech), on the Daxter voice
channel, unless her previous line still plays (force?: it is stopped first). Returns the line's
sound id (0 when nothing was said)."
  (when (nonzero? (get-status *gui-control* (-> this speech-id)))
    (if (not force?)
        (return (new 'static 'sound-id))
        )
    (set-action!
      *gui-control*
      (gui-action stop)
      (-> this speech-id)
      (gui-channel none)
      (gui-action none)
      (the-as string #f)
      (the-as (function gui-connection symbol) #f)
      (the-as process #f)
      )
    )
  (set! (-> this speech-id)
        (add-process *gui-control* this (gui-channel daxter) (gui-action play) (-> lines idx) -99.0 0)
        )
  (-> this speech-id)
  )

(defun hj2-whack-read-input ((this hj2-whack-a-metal))
  "Jak 2's whack-a-metal-method-26: the hole of the button pressed this frame (up 0, right 1, down 2,
left 3, triangle 4, circle 5, x 6, square 7; -1: none or Daxter can't swing), the buttons then
cleared. A press is queued in slot-buffer; the first one queued comes first. Returns the hole."
  (if (or (-> this dizzy?) (>= (-> this miss-count) 20))
      (return -1)
      )
  (let* ((pressed (logior (logior (-> *cpad-list* cpads 0 button0-rel 0) (-> *cpad-list* cpads 0 button0-rel 1))
                          (-> *cpad-list* cpads 0 button0-rel 2)
                          )
                  )
         (v0-0 (cond
                 ((logtest? pressed (pad-buttons up))
                  0
                  )
                 ((logtest? pressed (pad-buttons right))
                  1
                  )
                 ((logtest? pressed (pad-buttons down))
                  2
                  )
                 ((logtest? pressed (pad-buttons left))
                  3
                  )
                 ((logtest? pressed (pad-buttons triangle))
                  4
                  )
                 ((logtest? pressed (pad-buttons circle))
                  5
                  )
                 ((logtest? pressed (pad-buttons x))
                  6
                  )
                 ((logtest? pressed (pad-buttons square))
                  7
                  )
                 (else
                   -1
                   )
                 )
               )
         )
    (logclear! (-> *cpad-list* cpads 0 button0-abs 0) (pad-buttons up right down left triangle circle x square))
    (logclear! (-> *cpad-list* cpads 0 button0-rel 0) (pad-buttons up right down left triangle circle x square))
    (dotimes (v1-57 4)
      (when (< (-> this slot-buffer v1-57) 0)
        (set! (-> this slot-buffer v1-57) v0-0)
        (goto cfg-30)
        )
      )
    (label cfg-30)
    (if (>= (-> this slot-buffer 0) 0)
        (return (-> this slot-buffer 0))
        )
    v0-0
    )
  )

(defun hj2-whack-up-mole ((this hj2-whack-a-metal) (slot int))
  "The metal head up at a hole (in its active state): the normal or the gold one, #f when both are
down. Returns the hj2-hip-mole or #f."
  (let ((normal (ppointer->process (-> this mole slot)))
        (gold (ppointer->process (-> this gold slot)))
        )
    (cond
      ((and normal (-> normal next-state) (= (-> normal next-state name) 'active))
       (the-as hj2-hip-mole normal)
       )
      ((and gold (-> gold next-state) (= (-> gold next-state name) 'active))
       (the-as hj2-hip-mole gold)
       )
      (else
        (the-as hj2-hip-mole #f)
        )
      )
    )
  )

(defun hj2-whack-update-score ((this hj2-whack-a-metal))
  "Jak 2's whack-a-metal-method-28: *game-info* score counts up to the score (2 points every 0.1 s,
with a tick), and the scoreboards are drawn on the cabinet's misses (node 12) and points (node 13)
joints: the score's digits, and a mark per miss left (Jak 2's part 3336 moved to each of its 20
places). Returns nothing."
  (cond
    ((>= (-> *game-info* score) (-> this score))
     (set! (-> *game-info* score) (-> this score))
     )
    ((time-elapsed? (-> this score-time) (seconds 0.1))
     (sound-play "whack-score")
     (seek! (-> *game-info* score) (-> this score) 2.0)
     (set-time! (-> this score-time))
     )
    )
  (let ((s5-1 (the-as process-drawable (handle->process (-> this cabinet)))))
    (when s5-1
      (spawn-from-mat (-> this score-part 1) (-> s5-1 node-list data 13 bone transform))
      (spawn-from-mat (-> this score-part 0) (-> s5-1 node-list data 12 bone transform))
      (let ((part (-> *part-id-table* *hj2-whack-miss-mark-part-id*)))
        (dotimes (s4-1 (- 20 (-> this miss-count)))
          (set! (-> part init-specs 2 initial-valuef) (+ -1228.8 (* 614.4 (the float (mod s4-1 5)))))
          (set! (-> part init-specs 2 random-rangef) 0.0)
          (set! (-> part init-specs 3 initial-valuef) (- 921.6 (* 614.4 (the float (/ s4-1 5)))))
          (set! (-> part init-specs 3 random-rangef) 0.0)
          (launch-particles
            :system *sp-particle-system-3d*
            part
            (-> s5-1 node-list data 12 bone transform)
            :origin-is-matrix #t
            )
          )
        )
      )
    )
  (none)
  )

(defun hj2-whack-run-events ((this hj2-whack-a-metal))
  "Jak 2's whack-a-metal-method-27, every frame of a game: runs the current event of the wave (a
pause, or a metal head sent up a hole: its own, or a free one at random), steps to the next event
when it is done (the next wave after the last one, the last wave repeating), lets Tess cheer every
15 s (once about 1300 points), and draws the scoreboards. Returns nothing."
  (let ((s4-0 (-> *hj2-mole-data* (-> this wave) (-> this event)))
        (s5-0 #t)
        )
    (when (zero? (-> this event-length))
      (set! (-> this event-length)
            (the-as time-frame
                    (rand-vu-int-range (the-as int (-> s4-0 min-time)) (the-as int (+ (-> s4-0 min-time) (-> s4-0 max-time))))
                    )
            )
      (set-time! (-> this event-time))
      )
    (let ((v1-8 (-> s4-0 mode)))
      (cond
        ((= v1-8 8)
         (set! s5-0 (time-elapsed? (-> this event-time) (-> this event-length)))
         )
        ((< v1-8 12)
         ;; modes 0 to 7: that hole (another one at random if it's busy); 9 to 11: a random one
         (let ((slot (if (< v1-8 8) (the-as int v1-8) (rand-vu-int-range 0 7)))
               (tries 0)
               )
           (while (and (hj2-whack-up-mole this slot) (< tries 101))
             (set! slot (rand-vu-int-range 0 7))
             (+! tries 1)
             )
           (if (< tries 101)
               (send-event
                 (ppointer->process (if (= v1-8 11)
                                        (-> this gold slot)
                                        (-> this mole slot)
                                        )
                                    )
                 'active
                 (-> this event-length)
                 (-> s4-0 mode)
                 )
               )
           )
         )
        )
      )
    (when s5-0
      (set! (-> this event-length) 0)
      (+! (-> this event) 1)
      (when (>= (-> this event) (-> *hj2-mole-data* (-> this wave) length))
        (set! (-> this event) 0)
        (+! (-> this wave) 1)
        (if (>= (-> this wave) (-> *hj2-mole-data* length))
            (set! (-> this wave) (+ (-> *hj2-mole-data* length) -1))
            )
        )
      )
    )
  (when (and (time-elapsed? (-> this speech-time) (seconds 15)) (!= (-> this speech-count) 1))
    (when (nonzero? (if (>= (-> this score) 1300.0)
                        (begin
                          (set! (-> this speech-count) 1)
                          (hj2-whack-say this *hj2-whack-close-sounds* (hj2-whack-pick-line this 0 3) #f)
                          )
                        (hj2-whack-say this *hj2-whack-cheer-sounds* (hj2-whack-pick-line this 1 20) #f)
                        )
                    )
      (set-time! (-> this speech-time))
      )
    )
  (hj2-whack-update-score this)
  (none)
  )

;; waiting to grab Jak (Jak 2's wait-for-start): then Jak is hidden and the game starts
(defstate wait-for-start (hj2-whack-a-metal)
  :virtual #t
  :code (behavior ()
    (while (or (not *target*) (not (process-grab? *target* #f)))
      (suspend)
      )
    (send-event *target* 'draw #f)
    (go-virtual active #t)
    )
  )

(defbehavior hj2-whack-game-over? hj2-whack-a-metal ()
  "At 20 misses: the game ends, won (Jak 2's win state) when its score beats the session's best
(*hj2-whack-high-score*, updated), else lost. Returns #f while the game goes on."
  (when (>= (-> self miss-count) 20)
    (cond
      ((< *hj2-whack-high-score* (the int (-> self score)))
       (set! *hj2-whack-high-score* (the int (-> self score)))
       (go-virtual win)
       )
      (else
        (go-virtual lose)
        )
      )
    )
  #f
  )

;; Daxter waits for a button, idle (tired after 10 swings or more, angry after a shock); a press
;; swings (attack). arg0: a new game (Jak 2's enter: score reset, start sound, the danger3 music,
;; the cabinet's camera, the hammer, no airlock opening). 'done: a metal head sank unhit (a miss).
;; Leaving the game (any state but active, attack, win, lose) puts everything back.
(defstate active (hj2-whack-a-metal)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('done)
       (let ((v0-0 (+ (-> self miss-count) 1)))
         (set! (-> self miss-count) v0-0)
         v0-0
         )
       )
      )
    )
  :enter (behavior ((arg0 symbol))
    (when arg0
      (set! (-> *game-info* score) 0.0)
      (sound-play "whack-start")
      (set-setting! 'music 'j2dange3 0.0 0)
      (if (-> self camera-name)
          (set-setting! 'entity-name (-> self camera-name) 0.0 0)
          )
      (set! (-> self bopper) (process-spawn hj2-whack-bopper :init hj2-whack-bopper-init :name "hj2-whack-bopper" :to self))
      (set-setting! 'airlock #f 0.0 0)
      (set-time! (-> self speech-time))
      )
    )
  :exit (behavior ()
    (when (not (and (-> self next-state) (let ((v1-3 (-> self next-state name)))
                                           (or (= v1-3 'active) (= v1-3 'attack) (= v1-3 'win) (= v1-3 'lose))
                                           )
                    )
               )
      (remove-setting! 'music)
      (remove-setting! 'entity-name)
      (if (and *target* (focus-test? *target* grabbed))
          (process-release? *target*)
          )
      (send-event *target* 'draw #t)
      (let ((v1-32 (-> self bopper)))
        (if v1-32
            (deactivate (-> v1-32 0))
            )
        )
      (remove-setting! 'airlock)
      )
    )
  :trans (behavior ()
    (hj2-whack-game-over?)
    (let ((a0-10 (hj2-whack-read-input self)))
      (if (>= a0-10 0)
          (go-virtual attack a0-10)
          )
      )
    (logclear!
      (-> *cpad-list* cpads 0 button0-abs 0)
      (pad-buttons up right down left l1 r1 triangle circle x square)
      )
    (logclear!
      (-> *cpad-list* cpads 0 button0-rel 0)
      (pad-buttons up right down left l1 r1 triangle circle x square)
      )
    )
  :code (behavior ((arg0 symbol))
    (let ((gp-0 (if (>= (-> self air-attack-count) 10)
                    hj2-whack-daxter-mole-idle-tired-ja
                    hj2-whack-daxter-mole-idle-ja
                    )
                )
          )
      (set! (-> self air-attack-count) 0)
      (when (-> self dizzy?)
        ;; shocked: sparks over his body, then dizzy (stars over his head, node 9), then angry
        (sound-play "whack-dizzy")
        (ja-channel-push! 1 (seconds 0.1))
        (ja-no-eval :group! hj2-whack-daxter-mole-shock-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (when (rand-vu-percent? 0.2)
            (let ((v1-26 (process-spawn
                           lightning-tracker
                           :init lightning-tracker-init
                           *hj2-hip-mole-lightning*
                           0
                           (the-as symbol lightning-probe-callback)
                           self
                           (vector<-cspace!
                             (new 'stack-no-clear 'vector)
                             (-> self node-list data (rand-vu-int-range 3 (+ (-> self node-list length) -1)))
                             )
                           (vector<-cspace!
                             (new 'stack-no-clear 'vector)
                             (-> self node-list data (rand-vu-int-range 3 (+ (-> self node-list length) -1)))
                             )
                           :name "lightning-tracker"
                           :to self
                           )
                         )
                  )
              (if v1-26
                  (set! (-> (the-as lightning-tracker (-> v1-26 0)) user-time 0) 0)
                  )
              )
            )
          ;; the wave waits while he is shocked
          (+! (-> self event-time) (- (current-time) (-> self clock old-frame-counter)))
          (ja-blend-eval)
          (suspend)
          (ja :num! (seek!))
          )
        (part-tracker-spawn
          part-tracker
          :to *entity-pool*
          :group (-> *part-group-id-table* (-> *hj2-mole-dizzy-group-ids* 0))
          :target self
          :mat-joint 9
          )
        (ja-no-eval :group! hj2-whack-daxter-mole-idle-shock-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (+! (-> self event-time) (- (current-time) (-> self clock old-frame-counter)))
          (suspend)
          (ja :num! (seek!))
          )
        (set! (-> self dizzy?) #f)
        (dotimes (v1-85 4)
          (set! (-> self slot-buffer v1-85) -1)
          )
        (ja-no-eval :group! hj2-whack-daxter-mole-idle-shock-end-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (+! (-> self event-time) (- (current-time) (-> self clock old-frame-counter)))
          (suspend)
          (ja :num! (seek!))
          )
        (set! gp-0 hj2-whack-daxter-mole-idle-angry-ja)
        )
      (ja-channel-push! 1 (seconds 0.2))
      (ja :group! gp-0 :num! (identity (* 8.0 HJ2_WHACK_FRAMES)))
      (until #f
        (ja :group! gp-0 :num! (loop!))
        (ja-blend-eval)
        (suspend)
        )
      )
    #f
    )
  :post (behavior ()
    (hj2-whack-run-events self)
    (ja-post)
    )
  )

(defbehavior hj2-whack-strike hj2-whack-a-metal ((arg0 int))
  "The hammer lands on hole arg0 (Jak 2's lambda in its attack state): the metal head there is
touched. Red: Daxter is shocked (2 misses, every head sinks, Tess teases him, back to active);
none up: a miss puff; gold: 50 points; normal: 10 points (Tess comments now and then). The
particles face the player (Jak 2's matrix). Returns nothing."
  (let ((gp-0 (matrix-rotate-y! (new 'stack-no-clear 'matrix) -26396.445)))
    (let ((a1-2 (matrix-rotate-x! (new 'stack-no-clear 'matrix) 3640.889)))
      (matrix*! gp-0 a1-2 gp-0)
      )
    (vector<-cspace! (-> gp-0 trans) (-> (the-as process-drawable (handle->process (-> self cabinet))) node-list data (+ arg0 4)))
    (let ((mole (hj2-whack-up-mole self arg0)))
      (case (if mole
                (send-event mole 'touch)
                #f
                )
        (('die)
         (part-tracker-spawn
           part-tracker
           :to *entity-pool*
           :group (-> *part-group-id-table* (-> *hj2-whack-shock-group-ids* 0))
           :mat-joint gp-0
           )
         (dotimes (v1-15 4)
           (set! (-> self slot-buffer v1-15) -1)
           )
         (set! (-> self dizzy?) #t)
         (+! (-> self miss-count) 2)
         (hj2-whack-say self *hj2-whack-wrong-sounds* (hj2-whack-pick-line self 2 12) #f)
         (dotimes (gp-13 8)
           (send-event (ppointer->process (-> self mole gp-13)) 'abort)
           (send-event (ppointer->process (-> self gold gp-13)) 'abort)
           )
         (go-virtual active #f)
         )
        ((#f)
         (sound-play "whack-miss")
         (part-tracker-spawn
           part-tracker
           :to *entity-pool*
           :group (-> *part-group-id-table* (-> *hj2-whack-miss-group-ids* 0))
           :mat-joint gp-0
           )
         )
        (('gold)
         (part-tracker-spawn
           part-tracker
           :to *entity-pool*
           :group (-> *part-group-id-table* (-> *hj2-whack-hit-group-ids* 0))
           :mat-joint gp-0
           )
         (+! (-> self score) 50.0)
         )
        (else
          (when (time-elapsed? (-> self speech-time) (seconds 12))
            (hj2-whack-say self *hj2-whack-hit-sounds* (hj2-whack-pick-line self 3 3) #f)
            (set-time! (-> self speech-time))
            )
          (part-tracker-spawn
            part-tracker
            :to *entity-pool*
            :group (-> *part-group-id-table* (-> *hj2-whack-hit-group-ids* 0))
            :mat-joint gp-0
            )
          (+! (-> self score) 10.0)
          )
        )
      )
    )
  (none)
  )

;; a swing at hole arg0 (Jak 2's attack): the swing of that hole (whack0 to whack7) up to its
;; frame 10, where the hammer lands (hj2-whack-strike); a press from its frame 12 on swings again
(defstate attack (hj2-whack-a-metal)
  :virtual #t
  :event (-> (method-of-type hj2-whack-a-metal active) event)
  :exit (-> (method-of-type hj2-whack-a-metal active) exit)
  :code (behavior ((arg0 int))
    (sound-play "whack-swish")
    (set-time! (-> self state-time))
    (dotimes (v1-3 3)
      (set! (-> self slot-buffer v1-3) (-> self slot-buffer (+ v1-3 1)))
      )
    (set! (-> self slot-buffer 3) -1)
    (+! (-> self air-attack-count) 1)
    (let ((s5-1 (case arg0
                  ((0) hj2-whack-daxter-mole-whack0-ja)
                  ((1) hj2-whack-daxter-mole-whack2-ja)
                  ((2) hj2-whack-daxter-mole-whack3-ja)
                  ((3) hj2-whack-daxter-mole-whack1-ja)
                  ((4) hj2-whack-daxter-mole-whack4-ja)
                  ((5) hj2-whack-daxter-mole-whack6-ja)
                  ((6) hj2-whack-daxter-mole-whack7-ja)
                  (else hj2-whack-daxter-mole-whack5-ja)
                  )
                )
          ;; from the start, or from frame 6 when he was in the middle of another swing
          (f30-0 (cond
                   ((ja-group? hj2-whack-daxter-mole-idle-ja)
                    0.0
                    )
                   ((>= (ja-frame-num 0) (* 22.0 HJ2_WHACK_FRAMES))
                    0.0
                    )
                   (else
                     (* 6.0 HJ2_WHACK_FRAMES)
                     )
                   )
                 )
          )
      (ja-channel-push! 1 (seconds 0.1))
      (ja-no-eval :group! s5-1 :num! (seek! (* 10.0 HJ2_WHACK_FRAMES)) :frame-num f30-0)
      )
    (until (ja-done? 0)
      (ja-blend-eval)
      (hj2-whack-read-input self)
      (suspend)
      (ja :num! (seek! (* 10.0 HJ2_WHACK_FRAMES)))
      )
    (hj2-whack-strike arg0)
    (ja-no-eval :num! (seek!))
    (while (not (ja-done? 0))
      (let ((gp-1 (hj2-whack-read-input self)))
        (if (and (>= gp-1 0) (>= (ja-frame-num 0) (* 12.0 HJ2_WHACK_FRAMES)))
            (go-virtual attack gp-1)
            )
        )
      (suspend)
      (ja-eval)
      )
    (go-virtual active #f)
    )
  :post (-> (method-of-type hj2-whack-a-metal active) post)
  )

(defbehavior hj2-whack-end hj2-whack-a-metal ((anim art-element) (lines (array string)))
  "The end of a game (Jak 2's lose and win code): Daxter's idle anim, Tess's line (one of lines at
random), at least 2 s; then Daxter goes and a short fade hides the camera's return. Returns nothing
(the game's process then ends, its exit putting everything back)."
  (when (not (ja-group? anim))
    (ja-channel-push! 1 (seconds 0.1))
    (ja :group! anim)
    )
  (let ((gp-1 (hj2-whack-say self lines (rand-vu-int-count (-> lines length)) #t))
        (s5-8 (current-time))
        )
    (while (or (nonzero? (get-status *gui-control* gp-1)) (not (time-elapsed? s5-8 (seconds 2))))
      (suspend)
      (ja :num! (loop!))
      )
    )
  (ja-channel-set! 0)
  (ja-post)
  (set-blackout-frames (seconds 0.2))
  (none)
  )

;; 20 misses, the session's best not beaten: Daxter tired, Tess's losing line (Jak 2's lose)
(defstate lose (hj2-whack-a-metal)
  :virtual #t
  :exit (-> (method-of-type hj2-whack-a-metal active) exit)
  :code (behavior ()
    (hj2-whack-end hj2-whack-daxter-mole-idle-tired-ja *hj2-whack-lose-sounds*)
    )
  :post (behavior ()
    (hj2-whack-update-score self)
    (ja-post)
    )
  )

;; 20 misses and the session's best beaten: Daxter happy, Tess's winning line (Jak 2's win, reached
;; there at 1500 points the first time)
(defstate win (hj2-whack-a-metal)
  :virtual #t
  :exit (-> (method-of-type hj2-whack-a-metal active) exit)
  :code (behavior ()
    (hj2-whack-end hj2-whack-daxter-mole-idle-crazy-ja *hj2-whack-win-sounds*)
    )
  :post (-> (method-of-type hj2-whack-a-metal lose) post)
  )

(defbehavior hj2-whack-a-metal-init hj2-whack-a-metal ((cab process-drawable) (camera-name string))
  "Jak 2's whack-a-metal-init: Daxter at the cabinet's place (cab), the 8 metal heads and their
gold twins, the scoreboards' particles. camera-name: the cabinet's camera. Goes to wait-for-start."
  ;; Jak 2's (og:preserve-this): its states suspend inside called behaviors (hj2-whack-end)
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) (-> cab root trans))
  (quaternion-copy! (-> self root quat) (-> cab root quat))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (initialize-skeleton self *hj2-whack-daxter-sg* (the-as pair 0))
  (set! (-> self cabinet) (process->handle cab))
  (set! (-> self camera-name) camera-name)
  (set! (-> self speech-id) (new 'static 'sound-id))
  (dotimes (gp-1 8)
    (set! (-> self mole gp-1) (process-spawn hj2-hip-mole :init hj2-hip-mole-init (-> self cabinet) gp-1 #f :name "hj2-hip-mole" :to self))
    (set! (-> self gold gp-1) (process-spawn hj2-hip-mole :init hj2-hip-mole-init (-> self cabinet) gp-1 #t :name "hj2-hip-mole" :to self))
    )
  (set! (-> self dizzy?) #f)
  (dotimes (v1-20 4)
    (set! (-> self slot-buffer v1-20) -1)
    )
  (set! (-> self score-part 0) (create-launch-control (-> *part-group-id-table* (-> *hj2-whack-misses-group-ids* 0)) self))
  (set! (-> self score-part 1) (create-launch-control (-> *part-group-id-table* (-> *hj2-whack-points-group-ids* 0)) self))
  (dotimes (v1-31 4)
    (set! (-> self speech-last v1-31) 0)
    )
  (go-virtual wait-for-start)
  (none)
  )

;; The cabinet //////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's hip-whack-a-metal (a process-taskable there): the cabinet, still and solid (hj2-still-prop,
;; GAME), offering a game when Jak stands near it.
;;   camera-name: its camera-name lump (Jak 2's camera-230, the fixed camera of the game)
;;   game:        the game playing (hj2-whack-a-metal)
(deftype hj2-whack-cabinet (hj2-still-prop)
  ((camera-name  string)
   (game         handle)
   )
  (:state-methods
    play
    )
  )


;; still (its one-frame idle); within 4 m of Jak, the prompt and the session's best score; triangle
;; plays (the warp gates' conditions, hj2-can-travel?: not on the board, not in a vehicle...)
(defstate idle (hj2-whack-cabinet)
  :virtual #t
  :code (behavior ()
    (ja :num-func num-func-identity :frame-num 0.0)
    (transform-post)
    (set-time! (-> self state-time))
    (until #f
      (when (and (time-elapsed? (-> self state-time) (seconds 1)) (hj2-can-travel? (meters 4)))
        (talker-surpress!)
        (when (can-display-query? self "hj2-whack-a-metal" -99.0)
          (format (clear *hj2-travel-text*) "Press <PAD_TRIANGLE> to play Whack-a-Metal-Head (best: ~D)" *hj2-whack-high-score*)
          (hj2-print-travel-prompt *hj2-travel-text*)
          (if (cpad-pressed? 0 triangle)
              (go-virtual play)
              )
          )
        )
      (suspend)
      )
    #f
    )
  )

;; a game (Jak 2's play-game): the game's process runs until the game is over, then idle again
(defstate play (hj2-whack-cabinet)
  :virtual #t
  :code (behavior ()
    (set! (-> self game)
          (ppointer->handle
            ;; a 32 KB heap: Daxter's 62 joints (Jak 2 gave the game 16 KB and a small stack)
            (process-spawn hj2-whack-a-metal :init hj2-whack-a-metal-init self (-> self camera-name) :name "hj2-whack-a-metal" :stack-size #x8000 :to self)
            )
          )
    (while (handle->process (-> self game))
      (suspend)
      )
    (go-virtual idle)
    )
  )

(defmethod init-from-entity! ((this hj2-whack-cabinet) (arg0 entity-actor))
  "The cabinet: collision, placement and skeleton (hj2-still-prop-init!), its camera (camera-name
lump), then idle. Returns nothing."
  (hj2-still-prop-init! this arg0 *hj2-whack-cabinet-sg*)
  (set! (-> this camera-name) (res-lump-struct arg0 'camera-name string))
  (set! (-> this game) (the-as handle #f))
  (go (method-of-object this idle))
  (none)
  )
