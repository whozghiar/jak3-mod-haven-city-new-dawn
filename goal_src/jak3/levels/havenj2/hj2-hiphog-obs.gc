;;-*-Lisp-*-
(in-package goal)

;; name: hj2-hiphog-obs.gc
;; name in dgo: hj2-hiphog-obs
;; dgos: HJH

;; og:jak2-haven-city Level code for hj2-hiphog, the Hip Hog saloon: Jak 2's arcade game
;; Whack-a-Metal-Head (levels/hiphog/whack.gc and hiphog-scenes.gc there). Jak presses triangle at
;; the cabinet, hides, and Daxter stands on the cabinet with his hammer: the d-pad and the four
;; face buttons hit the 8 holes, metal heads pop out of them in Jak 2's waves (*hj2-mole-data*),
;; a red one shocks Daxter (dizzy, 2 misses), a gold one is worth 50, a normal one 10, and one that
;; goes down unhit is a miss. The game ends at 20 misses. The cabinet's scoreboards show the score
;; and the misses left (Jak 2's particles, hj2-hiphog-part.gc), Tess comments (Jak 2's voice lines,
;; packed by the level port: "voices"), the music is Jak 2's danger3 (j2dange3).
;;
;; The models are Jak 2's, rebuilt by build-actor (made by the level port, "models"): the cabinet
;; (hip-whack-a-metal), the metal heads and their gold twin (hip-mole), Daxter (daxter-highres with
;; his daxter-mole animations: Jak 2 keeps them in LWHACK, the level it loads for the game) and his
;; hammer (big-bopper). The fixed camera is Jak 2's camera-230 (lwhack, merged into hj2-hiphog).
;;
;; Not like Jak 2: no task (Jak 2's first game is won at 1500 points, then the cabinet can be
;; replayed, as here: a game only ends at 20 misses); the session's best score is kept
;; (*hj2-whack-high-score*), and a game that beats it ends with Tess's winning lines and Daxter's
;; happy idle (Jak 2's win state), else with her losing lines (its lose state). No Tess model (Jak
;; 2 places her next to the cabinet while the game runs), no subtitles, no goal HUD (hud-goal, only
;; shown before Jak 2's task is done), no blend shapes or eye animation on Daxter's face (build-actor
;; has none).

;; hj2-hiphog-part.gc (generated by the level port: hj2-hiphog's "extra_groups" and "extra_parts")
(define-extern *hj2-whack-misses-group-ids* (array int32))

(define-extern *hj2-whack-points-group-ids* (array int32))

(define-extern *hj2-whack-miss-group-ids* (array int32))

(define-extern *hj2-whack-hit-group-ids* (array int32))

(define-extern *hj2-whack-shock-group-ids* (array int32))

(define-extern *hj2-mole-dizzy-group-ids* (array int32))

(define-extern *hj2-whack-miss-mark-part-id* int)

;; jak2-haven-city-levels.gc (GAME, generated by the level port: the port's sound "voices"): Tess's
;; whack-a-metal lines (Jak 2's talker speeches 395 to 448)
(define-extern *hj2-whack-cheer-sounds* (array string))

(define-extern *hj2-whack-close-sounds* (array string))

(define-extern *hj2-whack-hit-sounds* (array string))

(define-extern *hj2-whack-wrong-sounds* (array string))

(define-extern *hj2-whack-win-sounds* (array string))

(define-extern *hj2-whack-lose-sounds* (array string))

;; The best score of the session (any number of trips to the Hip Hog: define-perm keeps it when the
;; level reloads), shown in the cabinet's prompt.
(define-perm *hj2-whack-high-score* int 0)

;; Waves /////////////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's hip-mole-event: one step of a wave.
;;   min-time, max-time: how long it lasts (frames at 300/s: min-time plus a random part up to
;;                       max-time); for a metal head, how long it stays up
;;   mode:               0 to 7: a metal head pops out of that hole; 8: a pause; 9: out of a free
;;                       hole picked at random; 10: a red one (shocks Daxter); 11: a gold one
(deftype hj2-hip-mole-event (structure)
  ((min-time  uint16  :offset   0)
   (max-time  uint16  :offset   2)
   (mode      uint8   :offset   4)
   )
  )


;; Jak 2's *mole-data*: the 7 waves of the game, each played in order; the last one repeats.
(define *hj2-mole-data* (the-as (array (array hj2-hip-mole-event))
                      (new 'static 'boxed-array :type array
                        (new 'static 'boxed-array :type hj2-hip-mole-event
                          (new 'static 'hj2-hip-mole-event :min-time #x258 :mode #x8)
                          (new 'static 'hj2-hip-mole-event :min-time #x2ee :mode #x9)
                          (new 'static 'hj2-hip-mole-event :min-time #x2ee :mode #x8)
                          (new 'static 'hj2-hip-mole-event :min-time #x2ee :mode #x9)
                          (new 'static 'hj2-hip-mole-event :min-time #x2ee :mode #x8)
