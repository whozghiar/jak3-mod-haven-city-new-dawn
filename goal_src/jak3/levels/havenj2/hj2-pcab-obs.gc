;;-*-Lisp-*-
(in-package goal)

;; name: hj2-pcab-obs.gc
;; name in dgo: hj2-pcab-obs
;; dgos: HJQ

;; og:jak2-haven-city Level code for hj2-pcab, Jak 2's palace cable (levels/palace/cable/
;; palcab-obs.gc, levels/palace/pal-obs.gc and levels/sewer/sew-gunturret.gc there): the nuts turning
;; on the cable, the plats that drop under Jak, the electrified fans, the rotating gun and the gun
;; turrets that shoot at Jak. Their models are Jak 2's, rebuilt by build-actor (hj2-*.glb, made by
;; the level port, scripts/level_port), their particles Jak 2's (hj2-pcab-part.gc, generated). The
;; flip steps and windmills, also placed by levels loaded with hj2-pcab, are in GAME
;; (hj2-common-obs.gc). Not ported: Jak 2's sounds of these objects (not in Jak 3).

;; Cable nuts ////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's pal-cable-nut: a big hex nut on the cable, turning around it (its local z axis) by sixth
;; turns. Each sixth of its sync period (sync lump: period and offset, in seconds; 12 s by default),
;; it turns 60 degrees over the first 30% (hold-percentage), holds, then wiggles over the last 20%
;; (from wiggle-percentage on). Jak rides it.
(deftype hj2-pal-cable-nut (process-drawable)
  ((root               collide-shape  :override)
   (sync               sync-linear    :inline)
   (init-quat          quaternion     :inline)
   (hold-percentage    float)
   (wiggle-percentage  float)
   )
  (:state-methods
    idle
    )
  )


;; the art group from build-actor: joint geometry, merc model, and Jak 2's idle animation (never
;; played: held at frame 0, like in Jak 2)
(def-actor hj2-pal-cable-nut
  :bounds (0 0 0 13)
  )

(defun hj2-pal-cable-nut-turn! ((this hj2-pal-cable-nut))
  "Sets the nut's rotation (root quat: init-quat turned around its local z) for the current phase of
its sync, as Jak 2's idle code does. The angles wrap to 16 bits like Jak 2's (sar/shl).
  this: the nut. Returns nothing; side effect: writes (-> this root quat)."
  (let* ((f1-0 (* 6.0 (get-current-phase-no-mod (-> this sync))))
         (step (the float (the int f1-0)))
         (frac (- f1-0 step))
         )
    (cond
      ((< (-> this hold-percentage) frac)
       ;; turned: held at the next sixth, wiggling (about 1 degree) near the end of the step. Jak 2
       ;; computes a wiggle fade-in but drops it (decompiled dead expression): not kept either.
       (let ((wiggle (if (< (-> this wiggle-percentage) frac)
                         (* 182.04445 (sin (the float (sar (shl (the int (* 524288.0 frac)) 48) 48))))
                         0.0
                         )
                     )
             )
         (quaternion-rotate-local-z!
           (-> this root quat)
           (-> this init-quat)
           (the float (sar (shl (the int (+ 10922.667 wiggle (the float (sar (shl (the int (* 10922.667 step)) 48) 48)))) 48) 48))
           )
         )
       )
      (else
        ;; turning from this sixth to the next one
        (quaternion-rotate-local-z!
          (-> this root quat)
          (-> this init-quat)
          (the float (sar (shl (the int (* 10922.667 (+ step (/ frac (-> this hold-percentage))))) 48) 48))
          )
        )
      )
    )
  (none)
  )

;; turns with its sync forever, carrying Jak (rider-trans / rider-post)
(defstate idle (hj2-pal-cable-nut)
  :virtual #t
  :trans rider-trans
  :code (behavior ()
    (until #f
      (hj2-pal-cable-nut-turn! self)
      (suspend)
      )
    #f
    )
  :post rider-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-pal-cable-nut) (arg0 entity-actor))
  "Jak 2's pal-cable-nut setup: a rideable pusher (the hull of its model, bound to its main joint,
transform index 3, as in Jak 2), its sync (12 s by default, the sync lump otherwise), not paused
when far (the nuts stay in step), and its rotation for the current phase.
  this: the nut; arg0: its entity. Goes to idle."
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((v1-2 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-2 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-2 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-2 prim-core action) (collide-action solid rideable))
      (set! (-> v1-2 transform-index) 3)
      (set-vector! (-> v1-2 local-sphere) 0.0 0.0 0.0 (meters 13))
      (set! (-> s4-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 root-prim) v1-2)
      )
    (pusher-init s4-0)
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-7 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-7 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-7 prim-core collide-with))
      )
    (set! (-> this root) s4-0)
    )
  (set! (-> this root rider-max-momentum) 8192.0)
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-pal-cable-nut-sg* (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (let ((a1-4 (new 'stack-no-clear 'sync-info-params)))
    (set! (-> a1-4 sync-type) 'sync-linear)
    (set! (-> a1-4 sync-flags) (sync-flags pong))
    (set! (-> a1-4 entity) arg0)
    (set! (-> a1-4 period) (the-as uint 3600))
    (set! (-> a1-4 percent) 0.0)
    (initialize! (-> this sync) a1-4)
    )
  (set! (-> this hold-percentage) 0.3)
  (set! (-> this wiggle-percentage) 0.8)
  (quaternion-copy! (-> this init-quat) (-> this root quat))
  (hj2-pal-cable-nut-turn! this)
  (transform-post)
  (go (method-of-object this idle))
  )

;; Falling platforms ///////////////////////////////////////////////////////////////////////////////

;; Jak 2's pal-falling-plat: a hinged plat on the cable. Once Jak stands on it, it shakes, then
;; swings down (Jak falls off) and back up (its idle animation), and is ready again.
(deftype hj2-pal-falling-plat (process-drawable)
  ((root  collide-shape  :override)
   )
  (:state-methods
    idle
    fall
    )
  )


;; the art group from build-actor: joint geometry, merc model, and Jak 2's animations: idle (flat
;; at frame 0, the drop and the way back up over the whole animation) and shake
(def-actor hj2-pal-falling-plat
  :art (idle-ja shake-ja)
  :bounds (0 0 0 5.8)
  )

;; flat and rideable; Jak standing on it ('ridden, from rider-trans) makes it fall
(defstate idle (hj2-pal-falling-plat)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('ridden)
       (go-virtual fall)
       )
      )
    )
  :enter (behavior ()
    (logior! (-> self root root-prim prim-core action) (collide-action rideable))
    )
  :trans rider-trans
  :code (behavior ()
    (ja-no-eval :group! hj2-pal-falling-plat-idle-ja :num! zero)
    (transform-post)
    (sleep-code)
    )
  :post rider-post
  )

;; shakes, stops carrying Jak, swings down and back up, then idle. While Jak touches the sphere under
;; it (prim id 8) past the bottom of the swing, the swing waits (Jak 2's frame 18 of 38), so the plat
;; doesn't come back up through him.
(defstate fall (hj2-pal-falling-plat)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touch)
       (when (and (ja-group? hj2-pal-falling-plat-idle-ja)
                  ((method-of-type touching-shapes-entry prims-touching?)
                   (the-as touching-shapes-entry (-> block param 0))
                   (-> self root)
                   (the-as uint 8)
                   )
                  )
         ;; Jak 2's frame 18 (of 0-38), as a fraction: build-actor samples the animation at 60 fps
         (let ((hold-frame (* 0.47368 (the float (+ (-> (ja-group) frames num-frames) -1)))))
           (when (< hold-frame (ja-frame-num 0))
             (let ((v1-9 (-> self skel root-channel 0)))
               (set! (-> v1-9 num-func) num-func-identity)
               (set! (-> v1-9 frame-num) hold-frame)
               )
             )
           )
         )
       )
      )
    )
  :trans rider-trans
  :code (behavior ()
    (ja-no-eval :group! hj2-pal-falling-plat-shake-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (logclear! (-> self root root-prim prim-core action) (collide-action rideable))
    (ja-no-eval :group! hj2-pal-falling-plat-idle-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (go-virtual idle)
    )
  :post rider-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-pal-falling-plat) (arg0 entity-actor))
  "Jak 2's pal-falling-plat setup: a rideable pusher group (its sphere around the plat, from the main
joint, transform index 3) holding the plat (the hull of the plat joint's part, transform index 4,
as in Jak 2) and the touch sphere under it (prim id 8, no action).
  this: the plat; arg0: its entity. Goes to idle."
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s3-0 (new 'process 'collide-shape-prim-group s4-0 (the-as uint 2) 0)))
      (set! (-> s4-0 total-prims) (the-as uint 3))
      (set! (-> s3-0 prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> s3-0 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> s3-0 prim-core action) (collide-action solid rideable))
      (set! (-> s3-0 transform-index) 3)
      (set-vector! (-> s3-0 local-sphere) 0.0 0.0 11059.2 20480.0)
      (set! (-> s4-0 root-prim) s3-0)
      )
    (pusher-init s4-0)
    (let ((v1-11 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-11 prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> v1-11 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-11 prim-core action) (collide-action solid rideable))
      (set! (-> v1-11 transform-index) 4)
      (set-vector! (-> v1-11 local-sphere) 0.0 0.0 8192.0 19660.8)
      )
    (let ((v1-13 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 8))))
      (set! (-> v1-13 prim-core collide-as) (collide-spec obstacle))
      (set! (-> v1-13 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-13 prim-core action) (collide-action))
      (set-vector! (-> v1-13 local-sphere) -16384.0 -4096.0 0.0 16384.0)
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-16 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-16 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-16 prim-core collide-with))
      )
    (set! (-> this root) s4-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-pal-falling-plat-sg* (the-as pair 0))
  (go (method-of-object this idle))
  )


;; Electric fans ///////////////////////////////////////////////////////////////////////////////////

;; One lightning ring around a fan pole: its lightning, the ring's radius, its distance from the
;; fan's center along the pole, and the tilt of its plane (an angle around the fan's z axis).
(deftype hj2-pal-fan-ring (structure)
  ((lightning       lightning-control)
   (radius          float)
   (dist            float)
   (local-z-rotate  float)
   )
  :allow-misaligned
  )


;; One of the fan's 3 electrified poles: its 6 rings (smallest near the hub) and its angle around
;; the fan's z axis.
(deftype hj2-pal-fan-pole (structure)
  ((rings     hj2-pal-fan-ring  6 :inline)
   (z-rotate  float)
   )
  :allow-misaligned
  )


;; Jak 2's pal-electric-fan: a wheel threaded on a palace cable (its z axis along the cable), turning
;; around it (rotspeed, degrees per second), its hub ring (4 to 6m out, around the cable) solid and
;; rideable, its 3 poles circled by lightning rings (Jak 3's lightning, the texture of
;; Jak 3's elec-gate rings) and hurting Jak (3 attack spheres per pole, Jak 2's attack). After a hit
;; the fan stops colliding for Jak's invulnerability time.
;;   poles: the poles' rings; no-collision-timer: when Jak was hit (0: colliding);
;;   rotate-speed: rotspeed; attack-id: the id of its attacks (one hit per touch)
(deftype hj2-pal-electric-fan (process-drawable)
  ((root                collide-shape :override)
   (poles               hj2-pal-fan-pole  3 :inline)
   (no-collision-timer  time-frame)
   (rotate-speed        float)
   (attack-id           uint32)
   )
  (:state-methods
    idle
    )
  )


(def-actor hj2-pal-electric-fan
  :bounds (0 0 0 16)
  )

;; Jak 2 gave the fan a 24KB process heap (its 18 lightnings alone are about 18KB, past the 16KB an
;; entity gets by default). Jak 3's entity-actor birth! takes the heap size from the entity-info its
;; entity-info-lookup caches in method slot 13 of the type (process-tree's entity-info-slot): set it
;; here, every time the level code links (the type outlives the level heap holding this entity-info,
;; like its methods: it is only read when an actor of this type is born, so with HJQ loaded).
;; The 3 fans' 54 rings also take 54 of the 64 connections of Jak 3's *lightning-engine* (Jak 2 had
;; 128): a lightning that finds the engine full is not drawn (no crash).
(define *hj2-pal-electric-fan-entity-info*
  (new 'static 'entity-info :ptype 'hj2-pal-electric-fan :pool '*16k-dead-pool* :heap-size #x6000)
  )

(set! (-> hj2-pal-electric-fan method-table 13) (the-as function *hj2-pal-electric-fan-entity-info*))

;; The lightning of a ring: Jak 2's spec, with the texture of Jak 3's ring lightning (Jak 2's
;; default lightning texture, page #xc index #x83, is page #x4 index #x3f in Jak 3: lightning.gc).
;; rand-func 3: the 16 points follow the path the fan sets every frame (set-point!).
(define *hj2-pal-fan-ring-spec* (new 'static 'lightning-spec
                                  :name #f
                                  :flags (lightning-spec-flags lsf2)
                                  :rand-func #x3
                                  :start-color (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                                  :end-color (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                                  :fade-to-color (new 'static 'rgba :r #xbf :b #x8f :a #x5)
                                  :fade-start-factor 0.2
                                  :fade-time 120.0
                                  :texture (new 'static 'texture-id :index #x3f :page #x4)
                                  :reduction 0.42
                                  :num-points 16
                                  :box-size 8192.0
                                  :merge-factor 0.5
                                  :merge-count 2
                                  :radius 3276.8
                                  :duration -1.0
                                  :sound #f
                                  )
        )

;; Turning forever.
;;   event 'touch: a pole's attack sphere (prim id 1) touching a focusable attacks it (Jak 2's
;;     attack: default damage, shoved 3m back along the fan's axis, away from where it faces, and
;;     9m up), then the fan stops colliding (no-collision-timer).
;;   trans: collides again once Jak's invulnerability is over; carries its riders.
;;   post: turns (rotate-speed), moves the 16 points of each ring around its pole, pulls its riders.
(defstate idle (hj2-pal-electric-fan)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('touch)
       (let ((focus (the-as process-focusable (as-type proc process-focusable))))
         (when (and focus ((method-of-type touching-shapes-entry prims-touching?)
                           (the-as touching-shapes-entry (-> block param 0))
                           (-> self root)
                           (the-as uint 1)
                           )
                    )
           (let ((dir (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> self root quat))))
             (if (< 0.0 (vector-dot dir (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> focus root quat))))
                 (vector-float*! dir dir -1.0)
                 )
             (when (send-event
                     focus
                     'attack
                     (-> block param 0)
                     (static-attack-info ((id (-> self attack-id))
                                          (vector dir)
                                          (shove-back (meters 3))
                                          (shove-up (meters 9))
                                          (control (if (focus-test? focus board)
                                                       1.0
                                                       0.0
                                                       )
                                                   )
                                          )
                                         )
                     )
               (set-time! (-> self no-collision-timer))
               (let ((prim (-> self root root-prim)))
                 (set! (-> prim prim-core collide-as) (collide-spec))
                 (set! (-> prim prim-core collide-with) (collide-spec))
                 )
               )
             )
           )
         )
       )
      )
    )
  :trans (behavior ()
    (when (and (nonzero? (-> self no-collision-timer))
               (time-elapsed? (-> self no-collision-timer) (-> *TARGET-bank* hit-invulnerable-timeout))
               )
      (let ((prim (-> self root root-prim)))
        (set! (-> prim prim-core collide-as) (-> self root backup-collide-as))
        (set! (-> prim prim-core collide-with) (-> self root backup-collide-with))
        )
      (set! (-> self no-collision-timer) 0)
      )
    (rider-trans)
    )
  :code sleep-code
  :post (behavior ()
    (let ((step (* (-> self rotate-speed) (seconds-per-frame)))
          (squash (new 'stack-no-clear 'vector))
          )
      ;; the rings are flattened along the fan's axis (Jak 2's scale, in world space)
      (set-vector! squash 1.0 1.0 0.4 1.0)
      (quaternion-rotate-local-z! (-> self root quat) (-> self root quat) step)
      (dotimes (i 3)
        (let ((pole (-> self poles i)))
          (dotimes (j 6)
            (let ((ring (-> pole rings j))
                  (center (new 'stack-no-clear 'vector))
                  (spoke (new 'stack-no-clear 'vector))
                  (point (new 'stack-no-clear 'vector))
                  (q (quaternion-rotate-local-z!
                       (new 'stack-no-clear 'quaternion)
                       (-> self root quat)
                       (+ (-> pole z-rotate) (/ step 5))
                       )
                     )
                  )
              ;; the ring's center: on the pole, dist from the hub
              (set-vector! center 0.0 (-> ring dist) 0.0 1.0)
              (vector-orient-by-quat! center center q)
              (vector+! center center (-> self root trans))
              ;; 16 points around the pole (24 degrees apart, the last one closing the ring)
              (set-vector! spoke (-> ring radius) 0.0 0.0 0.0)
              (quaternion-rotate-local-z! q q (-> ring local-z-rotate))
              (dotimes (k 16)
                (vector-orient-by-quat! point spoke q)
                (vector*! point point squash)
                (set-point! (-> ring lightning) k (vector+! point center point))
                (quaternion-rotate-local-y! q q 4369.067)
                )
              )
            )
          )
        )
      )
    (rider-post)
    )
  )

(defmethod relocate ((this hj2-pal-electric-fan) (offset int))
  "Moves the pointers to the rings' lightning-controls (in the process heap) with the process.
Returns the fan."
  (dotimes (i 3)
    (dotimes (j 6)
      (let ((ring (-> this poles i rings j)))
        (if (nonzero? (-> ring lightning))
            (&+! (-> ring lightning) offset)
            )
        )
      )
    )
  (call-parent-method this offset)
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-pal-electric-fan) (arg0 entity-actor))
  "Jak 2's pal-electric-fan setup, from the entity arg0: a rideable pusher (its hub: the collide mesh
of its model, a 6m disc of 5 boxes made by the level port, bound to the main joint) with 3 attack
spheres per pole (prim id 1, at 10, 12 and 14m, radius 1, 1.5 and 2m), its turn speed (rotspeed,
default 80 degrees per second), its attack id and its 18 lightning rings. Not paused with the actors
(actor-pause cleared): it keeps turning. Goes to idle."
  (let ((cshape (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((group (new 'process 'collide-shape-prim-group cshape (the-as uint 10) 0)))
      (set! (-> cshape total-prims) (the-as uint 11))
      (set! (-> group prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> group prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> group prim-core action) (collide-action solid rideable))
      (set! (-> group transform-index) 3)
      (set-vector! (-> group local-sphere) 0.0 0.0 0.0 (meters 16))
      (set! (-> cshape root-prim) group)
      )
    (pusher-init cshape)
    ;; the group's children are allocated right after it, in this order: the hub, then the spheres
    (let ((mesh (new 'process 'collide-shape-prim-mesh cshape (the-as uint 0) (the-as uint 0))))
      (set! (-> mesh prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> mesh prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> mesh prim-core action) (collide-action solid rideable))
      (set! (-> mesh transform-index) 3)
      (set-vector! (-> mesh local-sphere) 0.0 0.0 0.0 (meters 9))
      )
    (let ((dir (new 'stack-no-clear 'vector)))
      (dotimes (i 3)
        (vector-rotate-z! dir *y-vector* (* 21845.334 (the float i)))
        (vector-normalize! dir 1.0)
        (dotimes (k 3)
          (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 1))))
            (set! (-> sphere prim-core collide-as) (collide-spec obstacle pusher))
            (set! (-> sphere prim-core collide-with) (collide-spec jak bot player-list))
            (set! (-> sphere transform-index) 3)
            (vector-float*! (-> sphere local-sphere) dir (+ (meters 10) (* (meters 2) (the float k))))
            (set! (-> sphere local-sphere w) (+ (meters 1) (* (meters 0.5) (the float k))))
            )
          )
        )
      )
    (set! (-> cshape nav-radius) (* 0.75 (-> cshape root-prim local-sphere w)))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> this root) cshape)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-pal-electric-fan-sg* (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this rotate-speed) (res-lump-float arg0 'rotspeed :default 14563.556))
  (set! (-> this attack-id) (new-attack-id))
  (set! (-> this no-collision-timer) 0)
  ;; the rings: 6 per pole, from 10.7 to 14m out, growing from 0.8 to 1.9m, tilted 6 to 10 degrees
  ;; one way then the other. Jak 2 spreads the poles' rings a little off 120 degrees, ahead of the
  ;; turn.
  (dotimes (i 3)
    (let ((pole (-> this poles i)))
      (set! (-> pole z-rotate) (* (if (< 0.0 (-> this rotate-speed)) 21954.56 21736.107) (the float i)))
      (dotimes (j 6)
        (let ((ring (-> pole rings j))
              (n (the float (+ j 1)))
              )
          (set! (-> ring lightning) (new 'process 'lightning-control *hj2-pal-fan-ring-spec* this 0.0))
          (set! (-> ring dist) (+ (meters 10) (* 2730.6667 n)))
          (set! (-> ring radius) (+ 3276.8 (* 4505.6 (/ (* n n n) 216.0))))
          (set! (-> ring local-z-rotate) (* 182.04445 (rand-vu-float-range 6.0 10.0)))
          (if (= (logand j 1) 1)
              (set! (-> ring local-z-rotate) (- (-> ring local-z-rotate)))
              )
          )
        )
      )
    )
  (transform-post)
  (go (method-of-object this idle))
  )


;; Rotating gun ///////////////////////////////////////////////////////////////////////////////////

;; Jak 2's pal-rot-gun-shot: the rotating gun's bullet. Jak 3's guard-shot (GAME,
;; engine/common-obs/guard-projectile.gc) with Jak 2's changes: a longer range (154m/s for up to
;; 1.427s), a trail that doesn't fade, a long beam left where it lands, and a collision that only
;; hits Jak and his bots (it flies through the background, like Jak 2's). Jak 2's particles 606-609
;; are Jak 3's 850-853, the same guard-shot particles. Sounds: guard-shot's (Jak 2's rot-gun-fire
;; and pal-rot-gun-sho aren't in Jak 3).
(deftype hj2-pal-rot-gun-shot (guard-shot)
  ()
  )


(defmethod projectile-method-25 ((this hj2-pal-rot-gun-shot))
  "Draws the flying shot each frame (Jak 2's spawn-impact-particles): guard-shot's beam (part 850)
from the tail to the head, shown for 5 ticks without fading, two glows 80% along it (851, 852) and
sparks at the head (853, one or two of them, scaled by the beam length). Changes the parts' init
specs for the launch and restores them. Returns none."
  (let* ((head (-> this root trans))
         (tail (-> this tail-pos))
         (dir (vector-! (new 'stack-no-clear 'vector) head tail))
         (len (vector-length dir))
         )
    (let ((glow-pos (vector+*! (new 'stack-no-clear 'vector) tail dir 0.8))
          (beam (-> *part-id-table* 850))
          )
      (let ((old-len (-> beam init-specs 4 initial-valuef))
            (old-timer (-> beam init-specs 11 initial-valuef))
            (old-fade (-> beam init-specs 10 initial-valuef))
            )
        ;; spec 4: scale-y (beam length), 11: timer (ticks, int bits), 10: fade-a
        (set! (-> beam init-specs 4 initial-valuef) len)
        (set! (-> beam init-specs 11 initial-valuef) (the-as float #x5))
        (set! (-> beam init-specs 10 initial-valuef) 0.0)
        (draw-beam beam tail dir #f)
        (set! (-> beam init-specs 4 initial-valuef) old-len)
        (set! (-> beam init-specs 11 initial-valuef) old-timer)
        (set! (-> beam init-specs 10 initial-valuef) old-fade)
        )
      (vector-normalize! dir 1.0)
      (launch-particles (-> *part-id-table* 851) glow-pos)
      (launch-particles (-> *part-id-table* 852) glow-pos)
      )
    (let ((mat (new 'stack-no-clear 'matrix))
          (k (/ len (meters 9)))
          (sparks (-> *part-id-table* 853))
          )
      (let ((old-sx (-> sparks init-specs 3 initial-valuef))
            (old-sy (-> sparks init-specs 4 initial-valuef))
            (old-num (-> sparks init-specs 1 initial-valuef))
            (old-num-rand (-> sparks init-specs 1 random-rangef))
            )
        (forward-up->inv-matrix mat dir *up-vector*)
        (vector-copy! (-> mat trans) head)
        ;; spec 3/4: scale-x/y, 1: num
        (set! (-> sparks init-specs 3 initial-valuef) (* k old-sx))
        (set! (-> sparks init-specs 4 initial-valuef) (* k old-sy))
        (set! (-> sparks init-specs 1 initial-valuef) 1.0)
        (set! (-> sparks init-specs 1 random-rangef) 1.0)
        (launch-particles sparks mat :origin-is-matrix #t)
        (set! (-> sparks init-specs 3 initial-valuef) old-sx)
        (set! (-> sparks init-specs 4 initial-valuef) old-sy)
        (set! (-> sparks init-specs 1 initial-valuef) old-num)
        (set! (-> sparks init-specs 1 random-rangef) old-num-rand)
        )
      )
    )
  0
  (none)
  )

(defmethod projectile-method-26 ((this hj2-pal-rot-gun-shot))
  "Where the shot lands (Jak 2's spawn-shell-particles): guard-shot's beam (part 850) over its last
stretch, shown for 40 ticks and fading faster, then guard-shot's hit sparks (its own
projectile-method-26). Changes part 850's init specs for the launch and restores them. Returns
none."
  (let ((beam (-> *part-id-table* 850))
        (dir (vector-! (new 'stack-no-clear 'vector) (-> this root trans) (-> this tail-pos)))
        )
    (let ((old-len (-> beam init-specs 4 initial-valuef))
          (old-timer (-> beam init-specs 11 initial-valuef))
          (old-fade (-> beam init-specs 10 initial-valuef))
          )
      (set! (-> beam init-specs 4 initial-valuef) (vector-length dir))
      (set! (-> beam init-specs 11 initial-valuef) (the-as float #x28))
      (set! (-> beam init-specs 10 initial-valuef) -3.2)
      (draw-beam beam (-> this tail-pos) dir #f)
      (set! (-> beam init-specs 4 initial-valuef) old-len)
      (set! (-> beam init-specs 11 initial-valuef) old-timer)
      (set! (-> beam init-specs 10 initial-valuef) old-fade)
      )
    )
  (call-parent-method this)
  (none)
  )

;; out of time: the shot lands where it is (Jak 2's), leaving its beam and sparks
(defstate dissipate (hj2-pal-rot-gun-shot)
  :virtual #t
  :enter (behavior ()
    (go-virtual impact)
    )
  )

(defmethod setup-collision! ((this hj2-pal-rot-gun-shot))
  "Jak 2's pal-rot-gun-shot collision: one 0.3m sphere that only hits Jak and his bots (no
background: the shots fly through the cable's platforms), solid, with guard-shot's ignored surfaces.
Sets the shot's root. Returns none."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction)
          (the-as (function control-info collide-query vector vector collide-status) cshape-reaction-just-move)
          )
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrate-using) (penetrate enemy-yellow-shot))
    (let ((v1-6 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-6 prim-core collide-as) (collide-spec projectile))
      (set! (-> v1-6 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-6 prim-core action) (collide-action solid))
      (set-vector! (-> v1-6 local-sphere) 0.0 0.0 0.0 1228.8)
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) v1-6)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-9 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-9 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-9 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 1))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  (set! (-> this root pat-ignore-mask)
        (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noproj #x1 :noendlessfall #x1 :board #x1)
        )
  0
  (none)
  )

(defmethod init-proj-settings! ((this hj2-pal-rot-gun-shot))
  "Jak 2's pal-rot-gun-shot settings: guard-shot's move and attack, a straight flight (no homing,
no gravity: no update-velocity), 154m/s at most, gone after 1.427s. Returns none."
  (set! (-> this hit-actor?) #f)
  (vector-copy! (-> this tail-pos) (-> this root trans))
  (set! (-> this attack-mode) 'guard-shot)
  (set! (-> this move) guard-shot-move)
  (set! (-> this max-speed) 630784.0)
  (set! (-> this timeout) (seconds 1.427))
  (none)
  )

;; Jak 2's pal-rot-gun: the twin-barrelled gun spinning over the cable. Region 429 (a script of
;; Jak 2's, kept by the manifest) sends it 'trigger when Jak gets near it and 'untrigger when he
;; leaves: it spins up to a quarter turn per second about its axis, firing a shot every 0.05s from
;; one barrel then the other, and spins down once Jak is gone. Its shots flash the cable's turret
;; light palette (hj2-pcab-turret-flash!). No sounds: Jak 2's rot-gun and rot-gun-shot loops aren't
;; in Jak 3 (its shots keep guard-shot's).
(deftype hj2-pal-rot-gun (process-drawable)
  ((spin-rate        float)       ;; current spin about its z axis (angle units per second)
   (spin-rate-final  float)       ;; full spin, a quarter turn per second (16384.0)
   (fire-timer       time-frame)  ;; time of the last shot (a shot every 0.05s while spinning)
   (gun-index        int32)       ;; barrel firing next: 0 = gun_a_top (node 4), 1 = gun_b_bottom (node 6)
   )
  (:state-methods
    idle
    spin
    spin-down
    )
  (:methods
    (fire-shot (_type_ vector vector) none)
    )
  )


;; the art group from build-actor: joints align, prejoint, main, gun_a_top (4), gun_a_bottom,
;; gun_b_bottom (6), gun_b_top, Jak 2's order; merc model in hj2-pcab's fr3; hj2-pal-rot-gun-idle
(def-actor hj2-pal-rot-gun
  :bounds (0 0 0 12)
  )

(defun hj2-pcab-turret-flash! ((arg0 float))
  "Sets the cable's turret flash (Jak 2's set-palcab-turret-flash!) to arg0 (0 to 1.2): a float in
word 2 of hj2-pcab's mood state (byte 8, Jak 2's palcab-states turret-value; its light is at byte 0,
its electricity at 12), that update-mood-hj2-pcab shows on light palette 6 and fades. Does nothing
if hj2-pcab isn't loaded. Returns none."
  (let ((lev (level-get *level* 'hj2-pcab)))
    (when lev
      (set! (-> (the-as (pointer float) (-> lev mood-context state)) 2) arg0)
      )
    )
  (none)
  )

;; still, waiting for region 429's 'trigger to spin up
(defstate idle (hj2-pal-rot-gun)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('trigger)
       (go-virtual spin)
       )
      )
    )
  :code sleep-code
  )

;; spinning and firing, until region 429's 'untrigger
(defstate spin (hj2-pal-rot-gun)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('untrigger)
       (go-virtual spin-down)
       )
      )
    )
  :enter (behavior ()
    (set-time! (-> self fire-timer))
    (set! (-> self gun-index) 0)
    )
  :code sleep-code
  :post (behavior ()
    ;; speeds up by 20 degrees/s each second, turning about its own z axis
    (seek! (-> self spin-rate) (-> self spin-rate-final) (* 3640.889 (seconds-per-frame)))
    (quaternion-rotate-z! (-> self root quat) (-> self root quat) (* (-> self spin-rate) (seconds-per-frame)))
    (let ((flash 1.0))
      ;; every 0.05s: a shot from barrel joint 4 (gun_a_top) or 6 (gun_b_bottom), along its z axis
      ;; tilted 2.5 degrees about x, at 140m/s
      (when (time-elapsed? (-> self fire-timer) (seconds 0.05))
        (let ((pos (new 'stack-no-clear 'vector))
              (vel (new 'stack-no-clear 'vector))
              (barrel (-> self node-list data (+ (* (-> self gun-index) 2) 4)))
              )
          (vector<-cspace! pos barrel)
          (vector-normalize-copy! vel (-> barrel bone transform fvec) 1.0)
          (vector-rotate-x! vel vel -455.1111)
          (vector-normalize! vel 573440.0)
          (fire-shot self pos vel)
          )
        (set! (-> self gun-index) (- 1 (-> self gun-index)))
        (set-time! (-> self fire-timer))
        (set! flash 1.2)
        )
      ;; the flash is brightest when the barrels point up or down (z angle near 0 or 180 degrees)
      (let ((c (fabs (cos (the float (sar (shl (the int (quaternion-z-angle (-> self root quat))) 48) 48))))))
        (hj2-pcab-turret-flash! (* flash c c c))
        )
      )
    (ja-post)
    )
  )

;; slowing down to a stop, then still; a 'trigger spins it up again
(defstate spin-down (hj2-pal-rot-gun)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('trigger)
       (go-virtual spin)
       )
      )
    )
  :trans (behavior ()
    (if (>= 0.0 (-> self spin-rate))
        (go-virtual idle)
        )
    )
  :code sleep-code
  :post (behavior ()
    (seek! (-> self spin-rate) 0.0 (* 3640.889 (seconds-per-frame)))
    (quaternion-rotate-z! (-> self root quat) (-> self root quat) (* (-> self spin-rate) (seconds-per-frame)))
    (ja-post)
    )
  )

(defmethod fire-shot ((this hj2-pal-rot-gun) (pos vector) (vel vector))
  "Fires one hj2-pal-rot-gun-shot from pos at velocity vel (Jak 2's pal-rot-gun-method-23): a new
attack id, the gun ignored by its own shots and notified of their hits. Spawns the shot as a child
of the gun. Returns none."
  (let ((params (new 'stack-no-clear 'projectile-init-by-other-params)))
    (set! (-> params ent) (-> this entity))
    (set! (-> params charge) 1.0)
    (set! (-> params options) (projectile-options))
    (vector-copy! (-> params pos) pos)
    (vector-copy! (-> params vel) vel)
    (set! (-> params notify-handle) (process->handle this))
    (set! (-> params owner-handle) (the-as handle #f))
    (set! (-> params target-handle) (the-as handle #f))
    (set! (-> params target-pos quad) (the-as uint128 0))
    (set! (-> params ignore-handle) (process->handle this))
    (let* ((gi *game-info*)
           (id (+ (-> gi attack-id) 1))
           )
      (set! (-> gi attack-id) id)
      (set! (-> params attack-id) id)
      )
    (set! (-> params timeout) (seconds 4))
    (spawn-projectile hj2-pal-rot-gun-shot params this *default-dead-pool*)
    )
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-pal-rot-gun) (arg0 entity-actor))
  "Jak 2's pal-rot-gun setup: placement (turned 2 degrees about x and a quarter turn about z, like
Jak 2's), skeleton at the first frame of its animation (initialize-skeleton sets frame 0 of the
skeleton group's hj2-pal-rot-gun-idle), not paused far away, still. arg0: its entity (no lumps
read). Side effects: allocates the root and skeleton, goes to idle (does not return)."
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-pal-rot-gun-sg* (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (let ((q (-> this root quat)))
    (quaternion-rotate-local-x! q q 364.0889)
    (quaternion-rotate-local-z! q q 16384.0)
    )
  (set! (-> this spin-rate) 0.0)
  (set! (-> this spin-rate-final) 16384.0)
  (ja-post)
  (go (method-of-object this idle))
  )


;; Pal gun turrets /////////////////////////////////////////////////////////////////////////////

;; Jak 2's pal-gun-turret (levels/sewer/sew-gunturret.gc there: a sew-gunturret with palcab's
;; model): a cannon on the pillar tops that turns towards Jak (30 degrees each side of where it
;; faces), locks on for 0.75 s, fires a 0.125 s burst of guard shots (one every 0.05 s) from its
;; muzzle, smokes for 0.5 s, and starts again; it waits 2 s after a shot hits Jak. Its distance
;; lump: Jak must be in front of it, closer than that (along its facing), for it to turn hostile
;; (0: always). One hit destroys it: its pieces fly apart (joint-exploder with its explode model)
;; and it stays destroyed (Jak 3's enemy marks its entity dead). Models: Jak 2's, rebuilt by
;; build-actor (hj2-pal-gun-turret.glb with its idle and shoot animations,
;; hj2-pal-gun-turret-explode.glb, made by the level port). Particles: Jak 2's sew-gunturret
;; groups (hit, smoke, casing), translated into hj2-pcab-part.gc. Sounds: Jak 2's lock-on, burst
;; and explosion sounds aren't in Jak 3; the guard shots play their own (guard-shot-fire), the
;; explosion is Jak 3's "explosion", the lock-on and burst are silent. Not ported: the
;; communicator line Jak 2 plays when one blows up.

;; the group ids of the turret's particles (hj2-pcab-part.gc, generated: "extra_groups")
(define-extern *hj2-pal-gun-turret-hit-group-ids* (array int32))
(define-extern *hj2-pal-gun-turret-smoke-group-ids* (array int32))
(define-extern *hj2-pal-gun-turret-casing-group-ids* (array int32))

;; Joints (Jak 2's, kept by build-actor): 3 main, 4 barrel (tilts), 5 gun (the muzzle), 6 track
;; (the pivot the tilt is measured from), 7-14 hole_0..hole_7 (the drum's 8 holes: casings and
;; smoke). Animations: 2 idle, 3 shoot.
;; gun-tilt-jm: the barrel's tilt. aim-pos: where the gun aims (world). gun-twist/gun-tilt: the
;; current turn and tilt, desired-twist/desired-tilt: where they go. los-clear: nothing between
;; the muzzle and Jak. flash-state: firing (answered to 'flash-state). can-shoot: off after a
;; 'stop event. last-hit-time: when a shot last hit Jak. init-mat: its placement's rotation.
;; activate-distance: the distance lump.
(deftype hj2-pal-gun-turret (enemy)
  ((gun-tilt-jm        joint-mod)
   (aim-pos            vector                    :inline)
   (gun-twist          float)
   (gun-tilt           float)
   (desired-twist      float)
   (desired-tilt       float)
   (los-clear          symbol)
   (smoke-part         sparticle-launch-control)
   (casing-part        sparticle-launch-control)
   (flash-state        symbol)
   (can-shoot          symbol)
   (last-hit-time      time-frame)
   (init-mat           matrix                    :inline)
   (activate-distance  float)
   )
  (:methods
    (track-target (_type_ symbol) none)
    (check-los (_type_) none)
    (reset-aim (_type_) none)
    (fire-shot (_type_) none)
    )
  )


;; the cannon (its model's bounds) and its pieces (Jak 2's explode bounds)
(def-actor hj2-pal-gun-turret
  :art (idle-ja shoot-ja)
  :bounds (0 2.25 1 4.75)
  )

(def-actor hj2-pal-gun-turret-explode
  :bounds (0 0 0 15)
  )

;; the pieces the explosion throws: every joint of the explode model past main (Jak 2's)
(define *hj2-pal-gun-turret-exploder-params*
  (new 'static 'joint-exploder-static-params
    :joints (new 'static 'boxed-array :type joint-exploder-static-joint-params
      (new 'static 'joint-exploder-static-joint-params :joint-index 4 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 5 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 6 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 7 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 8 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 9 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 10 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 11 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 12 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 13 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 14 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 15 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 16 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 17 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 18 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 19 :parent-joint-index -1)
      (new 'static 'joint-exploder-static-joint-params :joint-index 20 :parent-joint-index -1)
      )
    :collide-spec (collide-spec backgnd)
    )
  )

;; Jak 2's *pal-gun-turret-enemy-info* in Jak 3's layout (Jak 3's fac-gunturret for the fields
;; Jak 2 doesn't have): every anim is the idle (2), notices Jak 150m away, 1 hit point, Jak's gun
;; aims at the barrel (bullseye joint 4), no gem.
(define *hj2-pal-gun-turret-enemy-info*
  (new 'static 'enemy-info
    :use-die-falling #f
    :use-victory #f
    :use-jump-blocked #f
    :debug-draw-neck #f
    :jump-debug-draw #f
    :move-to-ground #f
    :hover-if-no-ground #f
    :idle-anim-script (new 'static 'inline-array idle-control-frame 2
      (new 'static 'idle-control-frame
        :command (idle-control-cmd play)
        :anim #x2
        :param0 2
        :param1 2
        :param2 '((new 'static 'bfloat :data 1.0) (new 'static 'bfloat :data 1.0))
        )
      (new 'static 'idle-control-frame)
      )
    :idle-anim 2
    :notice-anim 2
    :hostile-anim 2
    :hit-anim 2
    :knocked-anim -1
    :knocked-land-anim -1
    :die-anim 2
    :die-falling-anim -1
    :victory-anim -1
    :jump-wind-up-anim -1
    :jump-in-air-anim -1
    :jump-land-anim -1
    :neck-joint -1
    :bullseye-joint 4
    :notice-distance (meters 150)
    :notice-distance-delta (meters 10)
    :proximity-notice-distance (meters 150)
    :default-hit-points 1.0
    :gnd-collide-with (collide-spec backgnd)
    :overlaps-others-collide-with-filter (collide-spec jak bot player-list)
    :movement-gravity (meters -100)
    :friction 0.8
    :attack-shove-back (meters 3)
    :attack-shove-up (meters 2)
    :attack-mode 'generic
    :attack-damage 2
    :recover-gnd-collide-with (collide-spec backgnd crate obstacle hit-by-others-list pusher)
    :knocked-can-land-timeout (seconds 0.1)
    :knocked-recover-timeout (seconds 2)
    :ragdoll-blend-out-time (seconds 0.25)
    :ragdoll-rotate-velocity-mult 1.0
    :jump-height-min (meters 3)
    :jump-height-factor 0.5
    :knocked-seek-ry-clamp 2730.6667
    :knocked-soft-vxz-lo (meters 17.6)
    :knocked-soft-vxz-hi (meters 26.4)
    :knocked-soft-vy-lo (meters 20)
    :knocked-soft-vy-hi (meters 30)
    :knocked-medium-vxz-lo (meters 36)
    :knocked-medium-vxz-hi (meters 48)
    :knocked-medium-vy-lo (meters 33)
    :knocked-medium-vy-hi (meters 37)
    :knocked-hard-vxz-lo (meters 19.2)
    :knocked-hard-vxz-hi (meters 28.8)
    :knocked-hard-vy-lo (meters 44.8)
    :knocked-hard-vy-hi (meters 51.2)
    :knocked-huge-vxz-lo (meters 40.2)
    :knocked-huge-vxz-hi (meters 60.8)
    :knocked-huge-vy-lo (meters 44.8)
    :knocked-huge-vy-hi (meters 53.2)
    :knocked-yellow-vxz-lo (meters 10)
    :knocked-yellow-vxz-hi (meters 12)
    :knocked-yellow-vy-lo (meters 14)
    :knocked-yellow-vy-hi (meters 20)
    :knocked-red-vxz-lo (meters 6)
    :knocked-red-vxz-hi (meters 48)
    :knocked-red-vy-lo (meters 23)
    :knocked-red-vy-hi (meters 37)
    :knocked-blue-vxz-lo (meters 10)
    :knocked-blue-vxz-hi (meters 12)
    :knocked-blue-vy-lo (meters 6)
    :knocked-blue-vy-hi (meters 20)
    :ragdoll-info #f
    :shadow-size (meters 1)
    :shadow-max-y (meters 1)
    :shadow-min-y (meters -1)
    :shadow-locus-dist (meters 150)
    :gem-joint -1
    :gem-offset (new 'static 'sphere :r 163840.0)
    :knocked-off #t
    )
  )

(set! (-> *hj2-pal-gun-turret-enemy-info* fact-defaults) *fact-info-enemy-defaults*)


(defmethod reset-aim ((this hj2-pal-gun-turret))
  "Aim straight ahead: aim-pos 40m in front of the turret's placement (Jak 2's
set-aim-at-default!). Side effect: aim-pos."
  (vector+float*! (-> this aim-pos) (-> this root trans) (-> this init-mat fvec) 163840.0)
  0
  (none)
  )

(defmethod track-target ((this hj2-pal-gun-turret) (at-target? symbol))
  "Turn and tilt the gun one frame towards Jak (at-target? #t and the line of sight clear) or
straight ahead (Jak 2's aim-turret!): the turn is clamped to 30 degrees each side, the tilt to
0..30 degrees down and only with a distance lump; each moves at most 2 degrees a frame. aim-pos
becomes where the barrel points now, at Jak's distance (the shots lag behind him). Side effects:
aim-pos, desired/current twist and tilt, the root's rotation, the barrel's joint-mod."
  (if (and at-target? (-> this los-clear))
      (let ((a0-2 (the-as process-focusable (handle->process (-> this focus handle)))))
        (if a0-2
            (vector-copy! (-> this aim-pos) (get-trans a0-2 3))
            )
        )
      (reset-aim this)
      )
  (let ((s4-0 (new 'stack-no-clear 'vector))
        (s5-0 (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 6)))
        )
    ;; twist: the aim's side angle in the placement's horizontal plane, clamped to +/- 30 degrees
    ;; (behind the turret: the clamp on its side)
    (vector-! s4-0 (-> this aim-pos) (-> this root trans))
    (vector-flatten! s4-0 s4-0 (-> this init-mat uvec))
    (vector-normalize! s4-0 1.0)
    (set! (-> this desired-twist) (fmin 5461.3335 (fmax -5461.3335 (asin (vector-dot (-> this init-mat rvec) s4-0)))))
    (if (>= 0.0 (vector-dot (-> this init-mat fvec) s4-0))
        (set! (-> this desired-twist) (if (< (-> this desired-twist) 0.0)
                                          -5461.3335
                                          5461.3335
                                          )
              )
        )
    ;; tilt: the aim's angle below the track joint, 0 to 30 degrees down
    (cond
      ((and (!= (-> this activate-distance) 0.0) (< (fabs (-> this desired-twist)) 5461.3335))
       (let ((s3-0 (vector-normalize-copy!
                     (new 'stack-no-clear 'vector)
                     (-> this node-list data 6 bone transform uvec)
                     1.0
                     )
                   )
             )
         (vector-! s4-0 (-> this aim-pos) s5-0)
         (vector-normalize! s4-0 1.0)
         (set! (-> this desired-tilt) (fmin 5461.3335 (fmax 0.0 (- (asin (vector-dot s3-0 s4-0))))))
         )
       )
      (else
        (set! (-> this desired-tilt) 0.0)
        )
      )
    ;; aim-pos: along the barrel, as far as the aim was from the track joint, from the muzzle
    (vector-normalize-copy!
      (-> this aim-pos)
      (-> this node-list data 4 bone transform fvec)
      (vector-vector-distance s5-0 (-> this aim-pos))
      )
    )
  (vector+! (-> this aim-pos) (-> this aim-pos) (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 5)))
  (let ((s5-1 (new 'stack-no-clear 'matrix)))
    (+! (-> this gun-twist)
        (fmax -364.0889 (fmin 364.0889 (* 0.3 (- (-> this desired-twist) (-> this gun-twist)))))
        )
    (matrix-rotate-y! s5-1 (-> this gun-twist))
    (matrix*! s5-1 s5-1 (-> this init-mat))
    (matrix->quaternion (-> this root quat) s5-1)
    )
  (+! (-> this gun-tilt) (fmax -364.0889 (fmin 364.0889 (* 0.3 (- (-> this desired-tilt) (-> this gun-tilt))))))
  (quaternion-axis-angle! (-> this gun-tilt-jm quat) 1.0 0.0 0.0 (-> this gun-tilt))
  0
  (none)
  )

(defmethod check-los ((this hj2-pal-gun-turret))
  "Jak 2's update-collision!: aim-pos on Jak, and when Jak is off the gun's axis (more than 2
degrees), probe a line from the muzzle to him: los-clear #t when nothing solid is in the way.
Side effects: aim-pos, los-clear."
  (let ((a0-2 (the-as process-focusable (handle->process (-> this focus handle)))))
    (if a0-2
        (vector-copy! (-> this aim-pos) (get-trans a0-2 3))
        )
    )
  (let* ((s4-0 (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 5)))
         (s5-1 (vector-! (new 'stack-no-clear 'vector) (-> this aim-pos) s4-0))
         )
    (when (< (vector-dot (vector-normalize-copy! (new 'stack-no-clear 'vector) s5-1 1.0) (-> this init-mat fvec))
             (cos 364.0889)
             )
      (let ((a1-5 (new 'stack-no-clear 'collide-query)))
        (vector-copy! (-> a1-5 start-pos) s4-0)
        (vector-copy! (-> a1-5 move-dist) s5-1)
        (let ((v1-12 a1-5))
          (set! (-> v1-12 radius) 409.6)
          (set! (-> v1-12 collide-with)
                (collide-spec backgnd crate obstacle hit-by-player-list hit-by-others-list pusher)
                )
          (set! (-> v1-12 ignore-process0) this)
          (set! (-> v1-12 ignore-process1) #f)
          (set! (-> v1-12 ignore-pat)
                (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1)
                )
          (set! (-> v1-12 action-mask) (collide-action solid))
          )
        (set! (-> this los-clear) (< (fill-and-probe-using-line-sphere *collide-cache* a1-5) 0.0))
        )
      )
    )
  0
  (none)
  )

(defmethod fire-shot ((this hj2-pal-gun-turret))
  "Fire one guard shot (Jak 3's guard-shot, GAME) from the muzzle towards aim-pos at 120 m/s,
spread at random (less the farther the aim), Jak 3's default damage (2); throw a casing out of
each of the drum's 8 holes and flash the cable's turret lights (Jak 2's fire-turret!). Side
effects: spawns the projectile (child of the turret, notifies it when it hits), flash-state #t,
casing particles, hj2-pcab-turret-flash!."
  (let ((s4-0 (vector<-cspace! (new 'stack-no-clear 'vector) (-> this node-list data 5)))
        (s5-0 (new 'stack-no-clear 'projectile-init-by-other-params))
        )
    (let* ((s3-1 (vector-! (new 'stack-no-clear 'vector) (-> this aim-pos) s4-0))
           (f30-1 (fmin 16384.0 (/ 2013265900.0 (vector-length s3-1))))
           (s2-0 (new 'stack-no-clear 'vector))
           )
      (set! (-> s5-0 ent) (-> this entity))
      (set! (-> s5-0 charge) 1.0)
      (set! (-> s5-0 options) (projectile-options))
      (vector-copy! (-> s5-0 pos) s4-0)
      (set! (-> s5-0 notify-handle) (process->handle this))
      (set! (-> s5-0 owner-handle) (the-as handle #f))
      (set! (-> s5-0 target-handle) (the-as handle #f))
      (set! (-> s5-0 target-pos quad) (the-as uint128 0))
      (set! (-> s5-0 ignore-handle) (process->handle this))
      (let* ((v1-12 *game-info*)
             (a0-12 (+ (-> v1-12 attack-id) 1))
             )
        (set! (-> v1-12 attack-id) a0-12)
        (set! (-> s5-0 attack-id) a0-12)
        )
      (set! (-> s5-0 timeout) (seconds 4))
      (vector-normalize-copy! (-> s5-0 vel) s3-1 491520.0)
      ;; the spread: two random pushes across the shot's direction
      (set-vector! s2-0 (-> s3-1 z) (-> s3-1 y) (- (-> s3-1 x)) 1.0)
      (vector-normalize! s2-0 (rand-vu-float-range (- f30-1) f30-1))
      (vector+! (-> s5-0 vel) (-> s5-0 vel) s2-0)
      (vector-cross! s2-0 s2-0 (-> s5-0 vel))
      (vector-normalize! s2-0 (rand-vu-float-range (- f30-1) f30-1))
      (vector+! (-> s5-0 vel) (-> s5-0 vel) s2-0)
      )
    (spawn-projectile guard-shot s5-0 this *default-dead-pool*)
    )
  (set! (-> this flash-state) #t)
  (dotimes (i 8)
    (spawn-from-cspace (-> this casing-part) (-> this node-list data (+ i 7)))
    )
  (hj2-pcab-turret-flash! 1.0)
  (none)
  )

;; hostile (Jak 2's): wait 2 s after a hit on Jak, lock on for 0.75 s, a 0.125 s burst (a shot
;; every 0.05 s while it can shoot), back to the idle anim and smoke 0.5 s, again. Goes to stare
;; once Jak is no longer its hostile focus.
(defstate hostile (hj2-pal-gun-turret)
  :virtual #t
  :exit (behavior ()
    (let ((t9-0 (-> (method-of-type enemy hostile) exit)))
      (if t9-0
          (t9-0)
          )
      )
    (ja :group! hj2-pal-gun-turret-idle-ja)
    (set! (-> self flash-state) #f)
    )
  :trans (behavior ()
    (if (and (logtest? (-> self enemy-flags) (enemy-flag victory)) (-> self enemy-info use-victory))
        (go-virtual victory)
        )
    (when (time-elapsed? (-> self state-time) (-> self reaction-time))
      (if (>= 2 (the-as int (-> self focus aware)))
          (go-stare self)
          )
      )
    (set! (-> self root penetrated-by) (get-penetrated-by self))
    )
  :code (behavior ()
    (reset-aim self)
    (until #f
      (until (time-elapsed? (-> self last-hit-time) (seconds 2))
        (suspend)
        )
      (check-los self)
      (suspend-for (seconds 0.75)
        (track-target self #t)
        )
      (ja :group! hj2-pal-gun-turret-shoot-ja)
      (let ((last-shot (the-as time-frame 0)))
        (suspend-for (seconds 0.125)
          (cond
            ((not (-> self can-shoot))
             )
            ((time-elapsed? last-shot (seconds 0.05))
             (fire-shot self)
             (set! last-shot (current-time))
             )
            (else
              (set! (-> self flash-state) #f)
              )
            )
          (ja :num! (loop!))
          )
        )
      (set! (-> self flash-state) #f)
      (ja-channel-push! 1 (seconds 0.2))
      (ja :group! hj2-pal-gun-turret-idle-ja)
      (suspend-for (seconds 0.5)
        (dotimes (i 8)
          (spawn-from-cspace (-> self smoke-part) (-> self node-list data (+ i 7)))
          )
        )
      )
    #f
    )
  )

;; stare (Jak 2's): the enemy's, the gun going back to straight ahead (with a distance lump)
(defstate stare (hj2-pal-gun-turret)
  :virtual #t
  :trans (behavior ()
    (let ((t9-0 (-> (method-of-type enemy stare) trans)))
      (if t9-0
          (t9-0)
          )
      )
    (if (!= (-> self activate-distance) 0.0)
        (track-target self #f)
        )
    )
  )

(defmethod event-handler ((this hj2-pal-gun-turret) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  "Jak 2's events: a shot's 'notify of a hit on Jak (last-hit-time: the turret waits 2 s),
'start/'stop (can-shoot), 'bonk (shoves Jak back off it), 'flash-state (returns it); the others
are the enemy's. arg0: the sender, arg1: the parameter count, arg2: the message, arg3: the
parameters. Returns the event's answer. Side effects: last-hit-time, can-shoot, events to arg0."
  (if (and (= arg2 'notify) (< 1 arg1) (= (-> arg3 param 0) 'attack) (= (-> arg3 param 1) *target*))
      (set-time! (-> this last-hit-time))
      )
  (case arg2
    (('start)
     (set! (-> this can-shoot) #t)
     #t
     )
    (('stop)
     (set! (-> this can-shoot) #f)
     #f
     )
    (('bonk)
     (send-event arg0 'target-mech-get-off (seconds 0.3))
     (send-event arg0 'shove #f (static-attack-info :mask (vehicle-impulse-factor) ((id (new-attack-id))
                                                                                    (damage 2.0)
                                                                                    (vehicle-damage-factor 1.0)
                                                                                    (vehicle-impulse-factor 1.0)
                                                                                    (shove-back (meters 2))
                                                                                    (shove-up (meters 0.5))
                                                                                    )
                                                    )
                 )
     #f
     )
    (('flash-state)
     (-> this flash-state)
     )
    (else
      ((method-of-type enemy event-handler) this arg0 arg1 arg2 arg3)
      )
    )
  )

;; die (Jak 2's): no more collision, its pieces fly apart, the camera shakes, the hit particles
;; burn 2 s over it, then the enemy's death-end (its entity is marked dead: it stays destroyed)
(defstate die (hj2-pal-gun-turret)
  :virtual #t
  :enter (behavior ()
    (on-dying self)
    (let ((v1-3 (-> self root root-prim)))
      (set! (-> v1-3 prim-core collide-as) (collide-spec))
      (set! (-> v1-3 prim-core collide-with) (collide-spec))
      )
    0
    (set! (-> self hit-points) 0.0)
    )
  :code (behavior ()
    (let ((gp-0 (new 'stack 'joint-exploder-tuning (the-as uint 0))))
      (process-spawn
        joint-exploder
        *hj2-pal-gun-turret-explode-sg*
        2
        gp-0
        *hj2-pal-gun-turret-exploder-params*
        :name "joint-exploder"
        :to self
        )
      )
    (activate! *camera-smush-control* 819.2 37 210 1.0 0.995 (-> self clock))
    (sound-play "explosion")
    (suspend)
    (cleanup-for-death self)
    (ja-channel-set! 0)
    (let ((gp-1 (new 'stack-no-clear 'vector)))
      (vector-copy! gp-1 (-> self root trans))
      (+! (-> gp-1 y) 10240.0)
      (suspend-for (seconds 2)
        (spawn (-> self part) gp-1)
        )
      )
    (suspend-for (seconds 1)
      )
    (send-event self 'death-end)
    (while (-> self child)
      (suspend)
      )
    )
  :post (behavior ()
    (enemy-common-post self)
    )
  )

(defmethod init-enemy-collision! ((this hj2-pal-gun-turret))
  "Jak 2's collision (sew-gunturret's): a group on main holding a sphere around the body (main)
and one around the barrel (gun joint), solid, not standable; Jak 3's melee attacks hurt it.
Side effect: sets the root."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate
                                    generic-attack
                                    lunge
                                    flop
                                    punch
                                    spin
                                    roll
                                    uppercut
                                    bonk
                                    tube
                                    vehicle
                                    flut-attack
                                    board
                                    mech-punch
                                    dark-punch
                                    dark-smack
                                    flut
                                    )
          )
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 2) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 3))
      (set! (-> s4-0 prim-core collide-as) (collide-spec enemy))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid no-standon))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 9216.0 4096.0 18432.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-13 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-13 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-13 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-13 prim-core action) (collide-action solid no-standon))
      (set! (-> v1-13 transform-index) 3)
      (set-vector! (-> v1-13 local-sphere) 0.0 6144.0 0.0 11264.0)
      )
    (let ((v1-15 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-15 prim-core collide-as) (collide-spec enemy))
      (set! (-> v1-15 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-15 prim-core action) (collide-action solid no-standon))
      (set! (-> v1-15 transform-index) 5)
      (set-vector! (-> v1-15 local-sphere) 0.0 0.0 -5120.0 4096.0)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-18 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-18 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-18 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod can-become-hostile-to? ((this hj2-pal-gun-turret) (arg0 process-focusable) (arg1 vector))
  "Jak 2's in-aggro-range?: always with no distance lump, else when arg0 (the focus candidate, Jak)
is in front of the turret's placement, closer than the distance along its facing. arg1 (the
enemy's probe position) is unused, as in Jak 2. Returns #t or #f. No side effects."
  (if (= (-> this activate-distance) 0.0)
      #t
      (let ((f0-1 (vector-dot
                    (vector-! (new 'stack-no-clear 'vector) (get-trans arg0 3) (-> this root trans))
                    (-> this init-mat fvec)
                    )
                  )
            )
        (and (< 0.0 f0-1) (< f0-1 (-> this activate-distance)))
        )
      )
  )

(defmethod deactivate ((this hj2-pal-gun-turret))
  "Free the smoke and casing particles, then the enemy's deactivate."
  (if (nonzero? (-> this smoke-part))
      (kill-particles (-> this smoke-part))
      )
  (if (nonzero? (-> this casing-part))
      (kill-particles (-> this casing-part))
      )
  ((method-of-type enemy deactivate) this)
  (none)
  )

(defmethod coin-flip? ((this hj2-pal-gun-turret))
  "Never drawn mirrored (Jak 2's): returns #f."
  #f
  )

;; WARN: Return type mismatch enemy vs hj2-pal-gun-turret.
(defmethod relocate ((this hj2-pal-gun-turret) (offset int))
  "Move the joint-mod and the two launch controls with the process heap, then the enemy's."
  (if (nonzero? (-> this gun-tilt-jm))
      (&+! (-> this gun-tilt-jm) offset)
      )
  (if (nonzero? (-> this smoke-part))
      (&+! (-> this smoke-part) offset)
      )
  (if (nonzero? (-> this casing-part))
      (&+! (-> this casing-part) offset)
      )
  (the-as hj2-pal-gun-turret ((method-of-type enemy relocate) this offset))
  )

(defmethod init-enemy! ((this hj2-pal-gun-turret))
  "Jak 2's init-enemy!: skeleton, enemy info, never paused (it shoots from afar), its particles
(hit for the explosion, smoke, casings), the barrel's tilt joint-mod, straight ahead, its
placement's rotation (init-mat) and the distance lump. Side effects: all of the turret's fields."
  (initialize-skeleton this *hj2-pal-gun-turret-sg* (the-as pair 0))
  (setup-enemy! this *hj2-pal-gun-turret-enemy-info*)
  (logclear! (-> this mask) (process-mask actor-pause))
  (logclear! (-> this enemy-flags) (enemy-flag actor-pause-backup))
  (set! (-> this part)
        (create-launch-control (-> *part-group-id-table* (-> *hj2-pal-gun-turret-hit-group-ids* 0)) this)
        )
  (set! (-> this smoke-part)
        (create-launch-control (-> *part-group-id-table* (-> *hj2-pal-gun-turret-smoke-group-ids* 0)) this)
        )
  (set! (-> this casing-part)
        (create-launch-control (-> *part-group-id-table* (-> *hj2-pal-gun-turret-casing-group-ids* 0)) this)
        )
  (set! (-> this gun-tilt-jm) (new 'process 'joint-mod (joint-mod-mode joint-set*) this 4))
  (set! (-> this los-clear) #f)
  (set! (-> this gun-twist) 0.0)
  (set! (-> this gun-tilt) 0.0)
  (set! (-> this desired-twist) 0.0)
  (set! (-> this desired-tilt) 0.0)
  (set! (-> this flash-state) #f)
  (set! (-> this can-shoot) #t)
  (set! (-> this last-hit-time) 0)
  (quaternion->matrix (-> this init-mat) (-> this root quat))
  (set! (-> this activate-distance) (res-lump-float (-> this entity) 'distance))
  0
  (none)
  )
