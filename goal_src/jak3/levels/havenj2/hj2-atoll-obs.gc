(defun hj2-gun-buoy-zone? ((pos vector))
  "Is pos (world) inside the gun buoy's zone, seen from above (y is ignored)? Each polygon of
*hj2-gun-buoy-zone* is convex: pos is inside one when it is on the same side of all its edges (a
repeated corner makes a null edge, ignored). Returns #t or #f. No side effects."
  (let ((x (/ (-> pos x) 4096.0))
        (z (/ (-> pos z) 4096.0))
        (zone *hj2-gun-buoy-zone*)
        )
    (dotimes (i (/ (-> zone length) 8))
      (let ((base (* i 8))
            (left 0)
            (right 0)
            )
        (dotimes (j 4)
          (let* ((a (+ base (* j 2)))
                 (b (+ base (* (logand (+ j 1) 3) 2)))
                 (cross (- (* (- (-> zone b) (-> zone a)) (- z (-> zone (+ a 1))))
                           (* (- (-> zone (+ b 1)) (-> zone (+ a 1))) (- x (-> zone a)))
                           )
                        )
                 )
            (cond
              ((< 0.0 cross)
               (+! left 1)
               )
              ((< cross 0.0)
               (+! right 1)
               )
              )
            )
          )
        (if (or (zero? left) (zero? right))
            (return #t)
            )
        )
      )
    )
  #f
  )

;; Jak 2's gun-buoy-shot: a guard shot (Jak 3's guard-shot, GAME: its beam, glows and hit sparks)
;; that turns towards Jak every frame (aimed 2m above his feet), 180m/s, gone after 2.78s, and kills
;; Jak (Jak 2's 'explode attack, 1024 damage). Jak 2's flies through the background (it only collides
;; with Jak and his bots): here it stops at walls and the ground, Jak behind cover is safe. Sound: Jak 2's buoy-shot as it fires (no hit sound, as in Jak 2).
(deftype hj2-gun-buoy-shot (guard-shot)
  ()
  )


(defmethod play-impact-sound ((this hj2-gun-buoy-shot) (arg0 projectile-options))
  "Jak 2's gun-buoy-shot sound: buoy-shot (ATOLL3/ATOLL4) when it is fired (no options), nothing on
impact. Returns none."
  (if (zero? arg0)
      (sound-play "buoy-shot")
      )
  0
  (none)
  )


(defun hj2-gun-buoy-shot-move ((arg0 hj2-gun-buoy-shot))
  "The shot's move (Jak 2's gun-buoy-shot-move): its velocity turned towards Jak (2m above his
feet), its speed kept, then guard-shot's move (sweep, tail, impact). Side effects: the shot's
transv, trans, tail-pos; may go to impact. Returns none."
  (let ((tgt *target*)
        (vel (-> arg0 root transv))
        )
    (when tgt
      (let ((speed (vector-length vel))
            (aim (vector-copy! (new 'stack-no-clear 'vector) (get-trans tgt 0)))
            )
        (+! (-> aim y) 8192.0)
        (vector-! vel aim (-> arg0 root trans))
        (vector-normalize! vel speed)
        )
      )
    )
  (guard-shot-move arg0)
  (none)
  )

(defmethod setup-collision! ((this hj2-gun-buoy-shot))
  "Jak 2's gun-buoy-shot collision: a 0.6m group holding a 0.2m solid deadly sphere and a 0.6m
deadly sphere, colliding with Jak, his bots and the background (Jak 2's goes through it),
guard-shot's ignored surfaces. Sets the shot's root. Returns none."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction)
          (the-as (function control-info collide-query vector vector collide-status) cshape-reaction-just-move)
          )
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrate-using) (penetrate enemy-yellow-shot))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 2) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 3))
      (set! (-> s4-0 prim-core collide-as) (collide-spec projectile))
      (set! (-> s4-0 prim-core collide-with) (collide-spec backgnd jak bot player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 0.0 2457.6)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-13 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-13 prim-core collide-as) (collide-spec projectile))
      (set! (-> v1-13 prim-core collide-with) (collide-spec backgnd jak bot player-list))
      (set! (-> v1-13 prim-core action) (collide-action solid deadly))
      (set-vector! (-> v1-13 local-sphere) 0.0 0.0 0.0 819.2)
      )
    (let ((v1-15 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-15 prim-core collide-as) (collide-spec projectile))
      (set! (-> v1-15 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-15 prim-core action) (collide-action deadly))
      (set-vector! (-> v1-15 local-sphere) 0.0 0.0 0.0 2457.6)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-18 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-18 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-18 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 1))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  (set! (-> this root pat-ignore-mask)
        (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noproj #x1 :noendlessfall #x1 :board #x1)
        )
  0
  (none)
  )

(defmethod init-proj-settings! ((this hj2-gun-buoy-shot))
  "Jak 2's gun-buoy-shot settings: homing move (hj2-gun-buoy-shot-move, no update-velocity), 180m/s,
2.78s, Jak 2's 'explode attack of 1024 damage. Returns none."
  (set! (-> this hit-actor?) #f)
  (vector-copy! (-> this tail-pos) (-> this root trans))
  (set! (-> this attack-mode) 'explode)
  (set! (-> this max-speed) 737280.0)
  (set! (-> this move) hj2-gun-buoy-shot-move)
  (set! (-> this timeout) (seconds 2.78))
  (set! (-> this damage) 1024.0)
  (none)
  )

;; The buoy.
;;   start-pos: where it waits (its placement); offset: where it stays, from Jak (20m, turning with
;;   his facing); aim-dir: where its guns point (unit); gun-jm: the guns' tilt (joint gunrotate, 6);
;;   offset-y-angular: the offset's last turn (smoothing); elev-angle: the aim's tilt; y-offset: how
;;   deep it is under its floating height (0 surfaced, -20m sunk); y-speed: how fast it surfaces;
;;   warned?: it has already warned Jak once (next warnings are 0.1 s); kill?: a region told it to
;;   kill Jak (no warning, fires until Jak dies); warning-id: the buoy-alarm loop's sound id;
;;   hit-points: what Jak's attacks leave it (12); incoming-attack-id: the last attack taken (one
;;   hit per attack).
(deftype hj2-gun-buoy (process-drawable)
  ((root              collide-shape  :override)
   (start-pos         vector         :inline)
   (offset            vector         :inline)
   (aim-dir           vector         :inline)
   (gun-jm            joint-mod)
   (offset-y-angular  float)
   (elev-angle        float)
   (y-offset          float)
   (y-speed           float)
   (warned?           symbol)
   (kill?             symbol)
   (warning-id        sound-id)
   (hit-points        int32)
   (incoming-attack-id uint32)
   )
  (:state-methods
    dormant
    ambush
    open-guns
    warning
    attack
    stare-down
    exit-ambush
    explode
    )
  (:methods
    (fire-pair (_type_) none)
    )
  )


;; the art group from build-actor: joints align, prejoint, main, door_L, door_R, gunrotate (6),
;; gunbase_L, gunmid_L (8), gunbase_R, gunmid_R (10), Jak 2's order; Jak 2's idle (shut), open and
;; close animations
(def-actor hj2-gun-buoy
  :art (idle-ja open-ja close-ja)
  :bounds (0 1.3 -0.4 3)
  )

;; the 4 directions tried around Jak for where the buoy surfaces: ahead, left, right, behind
(define *hj2-gun-buoy-surface-turns* (new 'static 'boxed-array :type float 0.0 16384.0 -16384.0 32768.0))

(defbehavior hj2-gun-buoy-jak-in-zone? hj2-gun-buoy ()
  "Is Jak swimming in the buoy's zone (Jak 2's in-aggro-range?: on or under water, inside its nav
mesh)? Returns #t or #f. No side effects."
  (let ((tgt *target*))
    (the-as symbol (and tgt
                        (not (focus-test? tgt dead teleporting))
                        (focus-test? tgt on-water under-water)
                        (hj2-gun-buoy-zone? (get-trans tgt 0))
                        )
            )
    )
  )

(defbehavior hj2-gun-buoy-show! hj2-gun-buoy ((show? symbol))
  "Shows the buoy and makes it solid (show? #t), or hides it with no collision (#f). Side effects:
draw status, collision. Returns nothing."
  (let ((prim (-> self root root-prim)))
    (cond
      (show?
        (logclear! (-> self draw status) (draw-control-status no-draw))
        (set! (-> prim prim-core collide-as) (-> self root backup-collide-as))
        (set! (-> prim prim-core collide-with) (-> self root backup-collide-with))
        )
      (else
        (logior! (-> self draw status) (draw-control-status no-draw))
        (set! (-> prim prim-core collide-as) (collide-spec))
        (set! (-> prim prim-core collide-with) (collide-spec))
        )
      )
    )
  (none)
  )

(defbehavior hj2-gun-buoy-fade! hj2-gun-buoy ()
  "While it surfaces or sinks: its size, its tint and its ambient sound's volume follow its depth
(Jak 2's: full size, color and volume at the surface, nothing 20m down, greenish under water). Side
effects: root scale, draw color-mult, the ambient sound's volume. Returns nothing."
  (let* ((f (fmax 0.0 (- 1.0 (fabs (/ (-> self y-offset) (meters 20))))))
         (under (new 'stack-no-clear 'vector))
         )
    (set-vector! (-> self root scale) f f f 1.0)
    (set-vector! under 0.3 0.4 0.0 1.0)
    (vector-lerp! (-> self draw color-mult) under *identity-vector* (* f f))
    (update-vol! (-> self sound) f)
    )
  (none)
  )

(defbehavior hj2-gun-buoy-chase-post hj2-gun-buoy ()
  "Post of the surfaced states (Jak 2's gun-buoy-chase-post, common-post and nav-enemy-method-142,
without nav): the offset turns with Jak's facing; the buoy moves towards Jak plus the offset while
that point is in its zone (straight, at most 28m/s, faster when Jak is fast or the offset is off);
its guns aim at Jak; it bobs at its floating height (0.8m under its placement, the sea's level
there) plus y-offset; its ambient sound follows it (Jak 2's common-post). Side effects: offset,
aim-dir, elev-angle, root trans and quat, gun-jm, the ambient sound. The state's post then runs
transform-post (joints, collision). Returns nothing."
  (let ((tgt *target*))
    (when tgt
      (let ((jak (get-trans tgt 0)))
        ;; the offset follows Jak's facing, smoothed
        (let* ((face (vector-z-quaternion! (new 'stack-no-clear 'vector) (get-quat tgt 2)))
               (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> self offset) 1.0))
               (turn (+ (* 0.15 (-> self offset-y-angular))
                        (* 0.8 (seconds-per-frame) (deg-diff (vector-y-angle dir) (vector-y-angle face)))
                        )
                     )
               )
          (vector-rotate-y! dir dir turn)
          (set! (-> dir y) 0.0)
          (vector-normalize! dir (meters 20))
          (vector-copy! (-> self offset) dir)
          (set! (-> self offset-y-angular) turn)
          )
        ;; the move, in the horizontal plane
        (let ((goal (vector+! (new 'stack-no-clear 'vector) jak (-> self offset))))
          (when (hj2-gun-buoy-zone? goal)
            (let* ((delta (vector-! (new 'stack-no-clear 'vector) goal (-> self root trans)))
                   (v (get-transv tgt))
                   (speed (fmin (meters 28)
                                (fmax (* 1.1 (sqrtf (+ (* (-> v x) (-> v x)) (* (-> v z) (-> v z)))))
                                      (fabs (- (vector-vector-xz-distance jak (-> self root trans)) (meters 20)))
                                      )
                                )
                          )
                   )
              (set! (-> delta y) 0.0)
              (let ((len (vector-length delta))
                    (step (* speed (seconds-per-frame)))
                    )
                (if (< step len)
                    (vector-normalize! delta step)
                    )
                )
              (vector+! (-> self root trans) (-> self root trans) delta)
              )
            )
          )
        ;; the aim: from 1m above the buoy to Jak's middle, never straight up or down
        (let ((from (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans)))
              (to-jak (new 'stack-no-clear 'vector))
              (aim (-> self aim-dir))
              )
          (+! (-> from y) 4096.0)
          (vector-! to-jak (get-trans tgt 3) from)
          (vector-normalize! to-jak 1.0)
          (vector-lerp! aim aim to-jak 0.99)
          (when (< 0.95 (fabs (vector-dot aim *y-vector*)))
            (set! (-> aim y) (* 0.95 (-> aim y)))
            )
          (vector-normalize! aim 1.0)
          )
        )
      )
    )
  ;; facing the aim; the guns tilt up to 4 degrees, past that the body tilts a fifth of the rest
  (forward-up-nopitch->quaternion (-> self root quat) (-> self aim-dir) *y-vector*)
  (seek! (-> self elev-angle) (- (vector-x-angle (-> self aim-dir))) (* 10922.667 (seconds-per-frame)))
  (let* ((elev (-> self elev-angle))
         (gun (fmax -728.1778 (fmin 728.1778 elev)))
         (rest (- elev gun))
         (q (new 'stack-no-clear 'quaternion))
         )
    (quaternion-vector-angle! q *x-vector* (/ rest 5))
    (quaternion-normalize! (quaternion*! (-> self root quat) (-> self root quat) q))
    (quaternion-vector-angle! (-> self gun-jm quat) *x-vector* (+ gun (* 0.8 rest)))
    )
  ;; floating: 0.8m under its placement's height, bobbing 0.3m every 4.83 s (1449 ticks)
  (set! (-> self root trans y)
        (+ (-> self start-pos y)
           -3276.8
           (* 1228.8 (cos (* 65536.0 (/ (the float (mod (current-time) 1449)) 1449.0))))
           (-> self y-offset)
           )
        )
  (update-trans! (-> self sound) (-> self root trans))
  (update! (-> self sound))
  (none)
  )

(defbehavior hj2-gun-buoy-hit hj2-gun-buoy ((proc process) (message symbol) (block event-message-block))
  "The buoy's 'attack event while it is up (every state but dormant and explode), like the city
turrets' (hj2-cty-guard-turret-event-handler): once per attack id, 10 hit points for a strong hit
(a punch, a kick, a red or dark shot, an explosion), else the attack's damage; below 0 it blows up.
proc: the sender, message: the event, block: its parameters. Returns #t for an attack taken, else
#f. Side effects: hit-points, incoming-attack-id, the explode state."
  (when (= message 'attack)
    (let ((pen (get-penetrate-using-from-attack-event (the-as process-drawable proc) block))
          (info (the-as attack-info (-> block param 1)))
          )
      (when (!= (-> info id) (-> self incoming-attack-id))
        (set! (-> self incoming-attack-id) (-> info id))
        (cond
          ((logtest? (penetrate
                       flop
                       punch
                       spin
                       uppercut
                       dark-punch
                       dark-bomb
                       dark-smack
                       explode
                       jak-red-shot
                       jak-dark-shot
                       )
                     pen
                     )
           (+! (-> self hit-points) -10)
           )
          ((logtest? (attack-mask damage) (-> info mask))
           (set! (-> self hit-points) (- (-> self hit-points) (the int (-> info damage))))
           )
          (else
            (set! (-> self hit-points) (- (-> self hit-points) (penetrate-using->damage pen)))
            )
          )
        (if (< (-> self hit-points) 0)
            (go-virtual explode)
            )
        #t
        )
      )
    )
  )

;; blown up: the explosion (Jak 3's guards' particles, Jak 2's vehicle-explode sound from CTYWIDE1,
;; which the station loads), then gone: hidden, without collision, its sounds stopped, until the
;; station loads again
(defstate explode (hj2-gun-buoy)
  :virtual #t
  :enter (behavior ()
    (sound-play "vehicle-explode")
    (vector-copy!
      (-> *launch-matrix* trans)
      (vector+*! (new 'stack-no-clear 'vector) (-> self root trans) *up-vector* 8192.0)
      )
    (part-tracker-spawn part-tracker :to *entity-pool* :group group-kg-explosion)
    (logior! (-> self draw status) (draw-control-status no-draw))
    (let ((prim (-> self root root-prim)))
      (set! (-> prim prim-core collide-as) (collide-spec))
      (set! (-> prim prim-core collide-with) (collide-spec))
      )
    (stop! (-> self sound))
    )
  :code sleep-code
  )

;; waiting under water, hidden; surfaces when Jak swims into its zone, or at once on 'kill-player
(defstate dormant (hj2-gun-buoy)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('kill-player)
       (set! (-> self kill?) #t)
       (go-virtual ambush)
       )
      )
    )
  :enter (behavior ()
    (vector-copy! (-> self root trans) (-> self start-pos))
    (set! (-> self warned?) #f)
    (set! (-> self kill?) #f)
    (hj2-gun-buoy-show! #f)
    (transform-post)
    )
  :trans (behavior ()
    (if (hj2-gun-buoy-jak-in-zone?)
        (go-virtual ambush)
        )
    )
  :code sleep-code
  )

;; Jak 2's ambush: appears 20m ahead of Jak (or beside or behind him if that is out of its zone, or
;; under him), 20m down (9m on the board), and rises to the surface, growing; then opens its guns
(defstate ambush (hj2-gun-buoy)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (hj2-gun-buoy-hit proc message block)
    )
  :enter (behavior ()
    (let ((tgt *target*))
      (cond
        (tgt
          (let ((jak (get-trans tgt 0))
                (board? (focus-test? tgt board))
                (dir (vector-z-quaternion! (new 'stack-no-clear 'vector) (get-quat tgt 2)))
                (spot (new 'stack-no-clear 'vector))
                (found? #f)
                )
            (set! (-> dir y) 0.0)
            (vector-normalize! dir (meters 20))
            (dotimes (i 4)
              (when (not found?)
                (vector-rotate-y! (-> self offset) dir (-> *hj2-gun-buoy-surface-turns* i))
                (vector+! spot jak (-> self offset))
                (set! found? (hj2-gun-buoy-zone? spot))
                )
              )
            (if (not found?)
                (vector-copy! spot jak)
                )
            (set! (-> self root trans x) (-> spot x))
            (set! (-> self root trans z) (-> spot z))
            (set! (-> self y-offset) (if board?
                                         -36864.0
                                         -81920.0
                                         )
                  )
            (set! (-> self y-speed) (if board?
                                        196608.0
                                        65536.0
                                        )
                  )
            (set! (-> self offset-y-angular) 0.0)
            (vector-normalize-copy! (-> self aim-dir) (-> self offset) -1.0)
            )
          (hj2-gun-buoy-show! #t)
          (hj2-gun-buoy-fade!)
          )
        (else
          (go-virtual dormant)
          )
        )
      )
    )
  :trans (behavior ()
    (when (< (fabs (-> self y-offset)) 409.6)
      (set! (-> self y-offset) 0.0)
      (go-virtual open-guns)
      )
    )
  :code sleep-code
  :post (behavior ()
    (set! (-> self y-offset)
          (seek-ease (-> self y-offset) 0.0 (* (-> self y-speed) (seconds-per-frame)) 12288.0 (* 40.96 (seconds-per-frame)))
          )
    (hj2-gun-buoy-fade!)
    (hj2-gun-buoy-chase-post)
    (transform-post)
    )
  )

;; opening its guns (faster on the board); then fires (told to kill, or Jak already warned), warns
;; Jak (still in its zone) or stares at him (gone). Jak moving faster than 25m/s: fires at once.
(defstate open-guns (hj2-gun-buoy)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (hj2-gun-buoy-hit proc message block)
    )
  :trans (behavior ()
    (if (and *target* (< 102400.0 (vector-length (get-transv *target*))))
        (go-virtual attack)
        )
    )
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.075))
    (let ((rate (rand-vu-float-range 0.8 1.2)))
      (if (and *target* (focus-test? *target* board))
          (set! rate (* 2.0 rate))
          )
      (ja-no-eval :group! hj2-gun-buoy-open-ja :num! (seek! max rate) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek! max rate))
        )
      )
    (cond
      ((-> self kill?)
       (go-virtual attack)
       )
      ((not (hj2-gun-buoy-jak-in-zone?))
       (go-virtual stare-down)
       )
      ((-> self warned?)
       (go-virtual attack)
       )
      (else
        (go-virtual warning)
        )
      )
    )
  :post (behavior ()
    (hj2-gun-buoy-chase-post)
    (transform-post)
    )
  )

;; guns out, waiting for Jak to turn back: 4 s (0.5 s on the board, 0.1 s once warned), then fires
;; if he is still in its zone; stares once he has left. 'kill-player: fires at once. Jak 2's
;; buoy-alarm loops meanwhile (warning-id), stopped on exit.
(defstate warning (hj2-gun-buoy)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('kill-player)
       (set! (-> self kill?) #t)
       (go-virtual attack)
       )
      (('attack)
       (hj2-gun-buoy-hit proc message block)
       )
      )
    )
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self warning-id) (sound-play "buoy-alarm"))
    )
  :exit (behavior ()
    (sound-stop (-> self warning-id))
    (set! (-> self warning-id) (new 'static 'sound-id))
    )
  :trans (behavior ()
    (cond
      ((not (hj2-gun-buoy-jak-in-zone?))
       (go-virtual stare-down)
       )
      ((time-elapsed? (-> self state-time) (cond
                                             ((-> self warned?)
                                              (seconds 0.1)
                                              )
                                             ((focus-test? *target* board)
                                              (seconds 0.5)
                                              )
                                             (else
                                               (seconds 4)
                                               )
                                             )
                      )
       (set! (-> self warned?) #t)
       (go-virtual attack)
       )
      )
    )
  :code sleep-code
  :post (behavior ()
    (sound-play "buoy-alarm" :id (-> self warning-id))
    (hj2-gun-buoy-chase-post)
    (transform-post)
    )
  )

;; firing: 4 pairs of shots, 0.75 s apart, again while Jak stays in its zone (or always, told to
;; kill); stares once Jak has left or is dead
(defstate attack (hj2-gun-buoy)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (hj2-gun-buoy-hit proc message block)
    )
  :trans (behavior ()
    (if (or (not *target*) (focus-test? *target* dead))
        (go-virtual stare-down)
        )
    )
  :code (behavior ()
    (until #f
      (dotimes (i 4)
        (fire-pair self)
        (suspend-for (seconds 0.75)
          )
        )
      (if (not (or (-> self kill?) (hj2-gun-buoy-jak-in-zone?)))
          (go-virtual stare-down)
          )
      )
    #f
    )
  :post (behavior ()
    (hj2-gun-buoy-chase-post)
    (transform-post)
    )
  )

;; closes its guns (Jak 2's buoy-guns-in sound), then watches for 6 s: Jak back in its zone opens
;; them again, else it sinks
(defstate stare-down (hj2-gun-buoy)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (hj2-gun-buoy-hit proc message block)
    )
  :enter (behavior ()
    (set-time! (-> self state-time))
    )
  :trans (behavior ()
    (cond
      ((hj2-gun-buoy-jak-in-zone?)
       (go-virtual open-guns)
       )
      ((time-elapsed? (-> self state-time) (seconds 6))
       (go-virtual exit-ambush)
       )
      )
    )
  :code (behavior ()
    (sound-play "buoy-guns-in")
    (ja-channel-push! 1 (seconds 0.075))
    (let ((rate (rand-vu-float-range 0.8 1.2)))
      (ja-no-eval :group! hj2-gun-buoy-close-ja :num! (seek! max rate) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek! max rate))
        )
      )
    (sleep-code)
    )
  :post (behavior ()
    (hj2-gun-buoy-chase-post)
    (transform-post)
    )
  )

;; sinking 20m (12m/s), shrinking, then back to its spot, hidden
(defstate exit-ambush (hj2-gun-buoy)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (hj2-gun-buoy-hit proc message block)
    )
  :trans (behavior ()
    (if (< (-> self y-offset) -81510.4)
        (go-virtual dormant)
        )
    )
  :code sleep-code
  :post (behavior ()
    (seek! (-> self y-offset) -81920.0 (* 49152.0 (seconds-per-frame)))
    (hj2-gun-buoy-fade!)
    (hj2-gun-buoy-chase-post)
    (transform-post)
    )
  )

(defmethod fire-pair ((this hj2-gun-buoy))
  "Fires two hj2-gun-buoy-shots (Jak 2's gun-buoy-method-183), from the guns' ends (joints
gunmid_L 8 and gunmid_R 10) towards Jak (2m above his feet) at 180m/s, each with a new attack id,
the buoy ignored by them. Does nothing without Jak. Side effects: spawns the shots (children of the
buoy). Returns none."
  (let ((tgt *target*))
    (when tgt
      (let ((aim (vector-copy! (new 'stack-no-clear 'vector) (get-trans tgt 0)))
            (params (new 'stack-no-clear 'projectile-init-by-other-params))
            )
        (+! (-> aim y) 8192.0)
        (set! (-> params ent) (-> this entity))
        (set! (-> params charge) 1.0)
        (set! (-> params options) (projectile-options))
        (set! (-> params notify-handle) (the-as handle #f))
        (set! (-> params owner-handle) (the-as handle #f))
        (set! (-> params target-handle) (the-as handle #f))
        (set! (-> params target-pos quad) (the-as uint128 0))
        (set! (-> params ignore-handle) (process->handle this))
        (set! (-> params timeout) (seconds 4))
        (dotimes (i 2)
          (set! (-> params attack-id) (new-attack-id))
          (vector<-cspace! (-> params pos) (-> this node-list data (+ 8 (* i 2))))
          (vector-! (-> params vel) aim (-> params pos))
          (vector-normalize! (-> params vel) 737280.0)
          (spawn-projectile hj2-gun-buoy-shot params this *default-dead-pool*)
          )
        )
      )
    )
  (none)
  )

;; WARN: Return type mismatch process-drawable vs hj2-gun-buoy.
(defmethod relocate ((this hj2-gun-buoy) (offset int))
  "Moves the pointer to the guns' joint-mod (in the process heap) with the process. Returns the
buoy."
  (if (nonzero? (-> this gun-jm))
      (&+! (-> this gun-jm) offset)
      )
  (the-as hj2-gun-buoy ((method-of-type process-drawable relocate) this offset))
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-gun-buoy) (arg0 entity-actor))
  "Jak 2's gun-buoy setup, from the entity arg0 (no lumps read): a solid sphere that can't be stood
on (Jak 2's: 3m around its body, in a 3.4m group), placement, skeleton (shut), the guns' tilt
joint-mod, aiming ahead, sunk, Jak 2's gun-buoy-steady ambient sound (80m falloff, silent until it
surfaces), 12 hit points. Not paused far away: it watches Jak anywhere in the station. Goes to
dormant."
  (let ((cshape (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((group (new 'process 'collide-shape-prim-group cshape (the-as uint 1) 0)))
      (set! (-> cshape total-prims) (the-as uint 2))
      (set! (-> group prim-core collide-as) (collide-spec obstacle))
      (set! (-> group prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> group prim-core action) (collide-action solid no-standon))
      (set! (-> group transform-index) 3)
      (set-vector! (-> group local-sphere) 0.0 5324.8 -1638.4 13926.4)
      (set! (-> cshape root-prim) group)
      )
    (let ((sphere (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> sphere prim-core collide-as) (collide-spec obstacle))
      (set! (-> sphere prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> sphere prim-core action) (collide-action solid no-standon))
      (set! (-> sphere transform-index) 3)
      (set-vector! (-> sphere local-sphere) 0.0 5324.8 -1638.4 12288.0)
      )
    (set! (-> cshape nav-radius) 24576.0)
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> this root) cshape)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-gun-buoy-sg* (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (vector-copy! (-> this start-pos) (-> this root trans))
  (set! (-> this gun-jm) (new 'process 'joint-mod (joint-mod-mode joint-set*) this 6))
  (vector-z-quaternion! (-> this aim-dir) (-> this root quat))
  (vector-reset! (-> this offset))
  (set! (-> this offset-y-angular) 0.0)
  (set! (-> this elev-angle) 0.0)
  (set! (-> this y-offset) -81920.0)
  (set! (-> this warned?) #f)
  (set! (-> this kill?) #f)
  (set! (-> this warning-id) (new 'static 'sound-id))
  (set! (-> this hit-points) 12)
  (set! (-> this incoming-attack-id) (the-as uint 0))
  (set! (-> this sound)
        (new 'process 'ambient-sound (static-sound-spec "gun-buoy-steady" :group 0 :fo-max 80) (-> this root trans) 0.0)
        )
  (update-vol! (-> this sound) 0.0)
  (ja-post)
  (go (method-of-object this dormant))
  )
