;; og:jak2-haven-city GENERATED by scripts/level_port from
;; custom_assets/jak3/ports/jak2-haven-city/port.jsonc, edit the port.
;; Jak 2's particle effects of palroof: 16 parts (ids 3252-3267), 6 groups (ids 959-964), 1 sprite
;; texture(s) in its own texture page 1545, translated from Jak 2's
;; levels/palace/roof/palroof-part.gc.

;; hj2-proof's texture page 1545: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-proof.jsonc), as names and sizes (w | h << 16)
(define *hj2-proof-sprite-names* (new 'static 'boxed-array :type string "water-ring"))

(define *hj2-proof-sprite-sizes* (new 'static 'boxed-array :type uint32 #x800080))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-proof (hj2-sprite-page-new 1545 *hj2-proof-sprite-names* *hj2-proof-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-drop-level-palroof ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 vector))
  (when (< (-> arg2 y) (-> arg1 user-float))
    (let ((s3-0 (new 'stack-no-clear 'vector)))
      (sp-kill-particle arg0 arg1)
      (set-vector! s3-0 (-> arg2 x) (-> arg1 user-float) (-> arg2 z) 1.0)
      (launch-particles (-> *part-id-table* 3253) s3-0)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 3254) s3-0)
      )
    )
  (sparticle-motion-blur arg0 arg1 arg2)
  (none)
  )

