;; og:jak2-haven-city GENERATED by scripts/level_port from
;; custom_assets/jak3/ports/jak2-haven-city/port.jsonc, edit the port.
;; Jak 2's particle effects of dig3a, dig3b: 24 parts (ids 3433-3456), 5 groups (ids 1043-1047), 1
;; sprite texture(s) in its own texture page 1609, translated from Jak 2's levels/dig/dig-part.gc.

;; hj2-dig's texture page 1609: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-dig.jsonc), as names and sizes (w | h << 16)
(define *hj2-dig-sprite-names* (new 'static 'boxed-array :type string "lava-ball"))

(define *hj2-dig-sprite-sizes* (new 'static 'boxed-array :type uint32 #x200020))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-dig (hj2-sprite-page-new 1609 *hj2-dig-sprite-names* *hj2-dig-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-drop-level-dig-lava-bloops ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's check-drop-level-dig-lava-bloops (levels/dig/dig-part.gc)."
  (let
    ((origin-y (-> arg1 key origin trans y)))
    (when
      (< (-> arg2 y) origin-y)
      (let
        ((gp-0 (new 'stack-no-clear 'vector)))
        (sp-kill-particle arg0 arg1)
        (set-vector! gp-0 (-> arg2 x) origin-y (-> arg2 z) 1.0)
        (launch-particles (-> *part-id-table* 3447) gp-0)
        (launch-particles (-> *part-id-table* 3438) gp-0)
      )
    )
  )
  (none)
  )

