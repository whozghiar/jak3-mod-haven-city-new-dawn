;;-*-Lisp-*-
(in-package goal)

;; name: hj2-mount-part.gc
;; name in dgo: hj2-mount-part
;; dgos: HJM

;; og:jak2-haven-city GENERATED by scripts/level_port from
;; custom_assets/jak3/ports/jak2-haven-city/port.jsonc, edit the port.
;; Jak 2's particle effects of mountain: 77 parts (ids 3346-3422), 24 groups (ids 1016-1039), 3
;; sprite texture(s) in its own texture page 1558, translated from Jak 2's
;; levels/mountain/mountain-part.gc.

;; hj2-mount's texture page 1558: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-mount.jsonc), as names and sizes (w | h << 16)
(define *hj2-mount-sprite-names* (new 'static 'boxed-array :type string "waterfall-drops" "water-ring" "rainbow"))

(define *hj2-mount-sprite-sizes* (new 'static 'boxed-array :type uint32 #x400040 #x800080 #x400040))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-mount (hj2-sprite-page-new 1558 *hj2-mount-sprite-names* *hj2-mount-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-drop-level-mountain ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 vector))
  (when (< (-> arg2 y) (-> arg1 user-float))
    (let ((s3-0 (new 'stack-no-clear 'vector)))
      (sp-kill-particle arg0 arg1)
      (set-vector! s3-0 (-> arg2 x) (-> arg1 user-float) (-> arg2 z) 1.0)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 3366) s3-0)
      )
    )
  (sparticle-motion-blur arg0 arg1 arg2)
  (none)
  )

