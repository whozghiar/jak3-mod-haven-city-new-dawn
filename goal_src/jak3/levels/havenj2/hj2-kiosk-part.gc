;; hj2-kiosk's texture page 1637: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-kiosk.jsonc), as names and sizes (w | h << 16)
(define *hj2-kiosk-sprite-names* (new 'static 'boxed-array :type string "kiosk-neon-off" "kiosk-neon-on"))

(define *hj2-kiosk-sprite-sizes* (new 'static 'boxed-array :type uint32 #x1000200 #x800100))

;; made while the level loads, handed to the texture system when it is activated
(hj2-sprite-page-register 'hj2-kiosk (hj2-sprite-page-new 1637 *hj2-kiosk-sprite-names* *hj2-kiosk-sprite-sizes*))

;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-drop-level-kiosk-fire-sparks ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 vector))
  "Jak 2's check-drop-level-kiosk-fire-sparks (levels/city/kiosk/kiosk-part.gc)."
  (sparticle-motion-blur arg0 arg1 arg2)
  (when
    (< (-> arg2 y) (-> arg1 user-float))
    (let
      ((gp-0 (new 'stack-no-clear 'vector)))
      (sp-kill-particle arg0 arg1)
      (set-vector! gp-0 (-> arg2 x) (-> arg1 user-float) (-> arg2 z) 1.0)
      (launch-particles (-> *part-id-table* 3899) gp-0)
      (launch-particles (-> *part-id-table* 3900) gp-0)
    )
  )
  (none)
  )

