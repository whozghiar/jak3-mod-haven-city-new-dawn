  (set! (-> this kind) 2)
  (call-parent-method this arg0)
  )

(deftype hj2-farm-small-cabbage (hj2-farm-crop)
  ()
  )


(defmethod init-from-entity! ((this hj2-farm-small-cabbage) (arg0 entity-actor))
  "Jak 2's farm-small-cabbage."
  (set! (-> this kind) 3)
  (call-parent-method this arg0)
