;;-*-Lisp-*-
(in-package goal)

;; name: hj2-onin-obs.gc
;; name in dgo: hj2-onin-obs
;; dgos: HKI

;; og:jak2-haven-city Level code for hj2-onin, Onin's tent: Jak 2's bubble game (levels/city/
;; onintent/onin-game.gc there, started by onin-npc's play-game, levels/common/scene-actor.gc).
;; Onin sits behind her pot, Pecker perched by her. Jak presses triangle in front of her, hides,
;; the camera turns to the pot (Jak 2's camera-235, onin-npc's camera-name lump) and Onin throws
;; bubbles out of the pot in Jak 2's waves (*hj2-onin-game-data*): each bubble shows a triangle, a
;; circle, an x or a square, and the button of its shape pops the oldest bubble of that shape. A
;; pop is worth 1 point, doubled for each pop of the same shape in a row (up to 16); a button with
;; no bubble of its shape up and a bubble that lands are misses. The game ends at 20 misses, won
;; at 1000 points or more. Jak 3's HUD widgets show the score, the goal and the misses (Jak 2's
;; hud-big-score, hud-goal and hud-miss, the same classes in Jak 3), Pecker comments (Jak 2's
;; voice lines, packed by the level port: "voices"), the music is Jak 2's danger3 (j2dange3). The
;; bubbles are particles only (Jak 2's onin-game.gc groups, translated into hj2-onin-part.gc).
;;
;; Onin and Pecker are Jak 2's models (onin-highres, pecker-highres), rebuilt by build-actor (the
;; level port's "models"), with their idle-sleep and idle-game animations; their place comes from
;; Jak 2's onin-npc actor (the level port's "ported_etypes"), their offset from it from their main
;; joint's animation (Onin 4.4 m behind it, Pecker 3.9 m).
;;
;; Not like Jak 2: no task (Jak 2's first game is won at 400 points, the task city-play-onin-game,
;; then the game can be replayed with *onin-game-data* 1: every game here is such a replay, won
;; at 1000 points once the 20 misses are reached); no reward (Jak 2 gives a skill once); the
;; session's best score is kept (*hj2-onin-high-score*) and shown at the prompt. R3 quits a game
;; (not in Jak 2; a hint at the bottom of the screen, no Pecker line, the best score untouched).
;; The prompt is only offered while the war mode is off (*mod-jak2-haven-city-war*). No
;; subtitles, no blend shapes or eye animation (build-actor has none), no Jak 2 *cheat-mode*
;; shortcuts, no Pecker wakeup animation (his idle-sleep loops), no Pecker collision.

;; jak2-haven-city-war.gc (GAME): the war mode's switch
(define-extern *mod-jak2-haven-city-war* symbol)

;; hj2-onin-part.gc (generated by the level port: hj2-onin's "extra_groups" and "extra_parts"): the
;; groups of a bubble (bubble: its look, launched every frame; birth, pop, land: one-shots) by shape
(define-extern *hj2-onin-bubble-triangle-ids* (array int32))

(define-extern *hj2-onin-bubble-circle-ids* (array int32))

(define-extern *hj2-onin-bubble-x-ids* (array int32))

(define-extern *hj2-onin-bubble-square-ids* (array int32))

(define-extern *hj2-onin-birth-triangle-ids* (array int32))

(define-extern *hj2-onin-birth-circle-ids* (array int32))

(define-extern *hj2-onin-birth-x-ids* (array int32))

(define-extern *hj2-onin-birth-square-ids* (array int32))

(define-extern *hj2-onin-pop-triangle-ids* (array int32))

(define-extern *hj2-onin-pop-circle-ids* (array int32))

(define-extern *hj2-onin-pop-x-ids* (array int32))

(define-extern *hj2-onin-pop-square-ids* (array int32))

(define-extern *hj2-onin-land-triangle-ids* (array int32))

(define-extern *hj2-onin-land-circle-ids* (array int32))

(define-extern *hj2-onin-land-x-ids* (array int32))

(define-extern *hj2-onin-land-square-ids* (array int32))

;; the pot's sparks (Jak 2's part 3429, group-onin-heatpot) and the tiki's drips (part 3437,
;; group-onin-tiki), turned off during a game as Jak 2 does
(define-extern *hj2-onin-heatpot-spark-part-id* int)

(define-extern *hj2-onin-tiki-drip-part-id* int)

;; jak2-haven-city-levels.gc (GAME, generated by the level port: the port's sound "voices"):
;; Pecker's lines (Jak 2's talker speeches 141 to 169)
(define-extern *hj2-onin-start-sounds* (array string))

(define-extern *hj2-onin-good-wave-sounds* (array string))

(define-extern *hj2-onin-bad-wave-sounds* (array string))

(define-extern *hj2-onin-wrong-sounds* (array string))

(define-extern *hj2-onin-splat-sounds* (array string))

(define-extern *hj2-onin-win-sounds* (array string))

(define-extern *hj2-onin-lose-sounds* (array string))

;; The best score of the session (any number of visits to the tent: define-perm keeps it when the
;; level reloads), shown in Onin's prompt.
(define-perm *hj2-onin-high-score* int 0)

;; Waves /////////////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's onin-game-event: one wave of the game (times in frames at 300/s).
;;   min-count, max-count:  how many bubbles each throw sends (a random count between them)
;;   min-event, max-event:  the time between two throws (random between them)
;;   wave-delay:            the pause after the wave, once its last bubble is gone
;;   min-wave, max-wave:    how long the wave throws (random between them)
;;   gravity:               the bubbles' gravity (their height is random, 1 to 1.8 m)
;; Row 0 is the game's header: max-count is the score to win, min-event / 300 the misses allowed.
;; A row with min-count 0 ends the table: the game goes back to wave max-count.
(deftype hj2-onin-game-event (structure)
  ((min-count   uint16)
   (max-count   uint16)
   (min-event   uint16)
   (max-event   uint16)
   (wave-delay  uint16)
   (min-wave    uint16)
   (max-wave    uint16)
   (gravity     meters)
   )
  :pack-me
  )


;; Jak 2's *onin-game-data* 1: the waves of a replay (the game once its task is done): 1000 points
;; to win, 20 misses, waves 1 to 19, then waves 12 to 19 again.
(define *hj2-onin-game-data* (new 'static 'inline-array hj2-onin-game-event 21
                               (new 'static 'hj2-onin-game-event :min-count #x1 :max-count #x3e8 :min-event #x1770 :max-event #x12c :wave-delay #x12c :min-wave #xbb8 :max-wave #xbb8 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x1 :max-count #x1 :min-event #x12c :max-event #x1c2 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -3))
                               (new 'static 'hj2-onin-game-event :min-count #x3 :max-count #x5 :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x1 :max-count #x1 :min-event #x4b :max-event #x96 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x4 :max-count #x6 :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x2 :max-count #x2 :min-event #xe1 :max-event #x12c :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x5 :max-count #x7 :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x2 :max-count #x2 :min-event #x96 :max-event #xe1 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x6 :max-count #x8 :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x3 :max-count #x3 :min-event #x12c :max-event #x177 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x1 :max-count #x5 :min-event #x12c :max-event #x1c2 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x3 :max-count #x3 :min-event #xe1 :max-event #x12c :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x7 :max-count #x9 :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x4 :max-count #x4 :min-event #x177 :max-event #x1c2 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x8 :max-count #xa :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x4 :max-count #x4 :min-event #x12c :max-event #x177 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #x9 :max-count #xb :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x2 :max-count #x2 :min-event #x78 :max-event #x96 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :min-count #xa :max-count #xc :min-event #x258 :max-event #x384 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -1))
                               (new 'static 'hj2-onin-game-event :min-count #x2 :max-count #x2 :min-event #x4b :max-event #x96 :wave-delay #x12c :min-wave #x1194 :max-wave #x1194 :gravity (meters -2))
                               (new 'static 'hj2-onin-game-event :max-count #xc :min-event #x12c :max-event #x12c :wave-delay #x12c :min-wave #xbb8 :max-wave #xbb8 :gravity (meters -2))
                               )
        )

;; Art groups ////////////////////////////////////////////////////////////////////////////////////////

;; The models, rebuilt by build-actor from Jak 2's rips (the level port's "models": hj2-onin-npc
;; and its extra). Their animations are in the order of their "anims" there. Joints (node = joint
;; + 1): main 3. Bounds and origin joint: Jak 2's skel-onin-highres and skel-pecker-highres.

;; Jak 2's onin-highres: Onin, asleep (idle-sleep, Jak 2's art 4) or throwing bubbles (idle-game,
;; art 6, during a game).
(def-actor hj2-onin-npc
  :art (idle-sleep-ja idle-game-ja)
  :bounds (0 0 0 5)
  :origin-joint-index 3
  )

;; Jak 2's pecker-highres: Pecker, the same two loops.
(def-actor hj2-onin-pecker
  :art (idle-sleep-ja idle-game-ja)
  :bounds (0 0 0 5)
  :origin-joint-index 3
  )

;; Bubbles ///////////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's onin-game-bubble: one bubble, a child of the game (hj2-onin-game), drawn by particles
;; only: born over the pot (idle), thrown up and falling (fall).
;;   bubble-type:       its shape and button: 0 triangle, 1 circle, 2 x, 3 square
;;   bubble-start-time: when it was thrown (the oldest bubble of a shape pops first)
;;   gravity:           its wave's gravity
;;   dead?:             landed (a miss) or killed: it can't pop any more
;;   angle:             its sideways speed (world x, units per second)
;;   height:            how high it rises above the pot
(deftype hj2-onin-bubble (process-drawable)
  ((bubble-type        int32)
   (bubble-start-time  time-frame)
   (gravity            meters)
   (dead?              symbol)
   (angle              float)
   (height             float)
   )
  (:state-methods
    idle
    fall
    )
  )


(defun hj2-onin-bubble-group ((kind int) (shape int))
  "The particle group of a bubble (Jak 2's onin-game.gc groups, by the level port's extra_groups
arrays). kind: 0 the bubble itself (its launch control), 1 its birth, 2 its pop, 3 its landing.
shape: its bubble-type (0 triangle, 1 circle, 2 x, 3 square). Returns the sparticle-launch-group."
  (let ((ids (case kind
               ((1)
                (case shape
                  ((0) *hj2-onin-birth-triangle-ids*)
                  ((1) *hj2-onin-birth-circle-ids*)
                  ((2) *hj2-onin-birth-x-ids*)
                  (else *hj2-onin-birth-square-ids*)
                  )
                )
               ((2)
                (case shape
                  ((0) *hj2-onin-pop-triangle-ids*)
                  ((1) *hj2-onin-pop-circle-ids*)
                  ((2) *hj2-onin-pop-x-ids*)
                  (else *hj2-onin-pop-square-ids*)
                  )
                )
               ((3)
                (case shape
                  ((0) *hj2-onin-land-triangle-ids*)
                  ((1) *hj2-onin-land-circle-ids*)
                  ((2) *hj2-onin-land-x-ids*)
                  (else *hj2-onin-land-square-ids*)
                  )
                )
               (else
                 (case shape
                   ((0) *hj2-onin-bubble-triangle-ids*)
                   ((1) *hj2-onin-bubble-circle-ids*)
                   ((2) *hj2-onin-bubble-x-ids*)
                   (else *hj2-onin-bubble-square-ids*)
                   )
                 )
               )
             )
        )
    (-> *part-group-id-table* (-> ids 0))
    )
  )

(defbehavior hj2-onin-bubble-burst hj2-onin-bubble ((kind int))
  "A one-shot group of this bubble's shape where it is (Jak 2's part-tracker on *launch-matrix*).
kind: 1 birth, 2 pop, 3 landing (hj2-onin-bubble-group). Returns nothing."
  (set! (-> *launch-matrix* trans quad) (-> self root trans quad))
  (part-tracker-spawn part-tracker :to *entity-pool* :group (hj2-onin-bubble-group kind (-> self bubble-type)))
  (none)
  )

;; over the pot, its birth burst, 0.25 s, then thrown (fall). 'die ends it; 'attack #t (the end of
;; the game) too, 'attack #f (a button) does nothing yet: no pop, no point (the sender sees #f).
(defstate idle (hj2-onin-bubble)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('die)
       (go empty-state)
       )
      (('attack)
       (if (-> block param 0)
           (go empty-state)
           )
       )
      )
    )
  :code (behavior ()
    (hj2-onin-bubble-burst 1)
    (suspend-for (seconds 0.25))
    (go-virtual fall)
    )
  )

;; thrown up to its height, drifting sideways and toward the camera, then falling back: below the
;; pot's rim it lands (a splat burst, 'done to the game: a miss) and sinks into the pot. 'attack
;; pops it (a pop burst; returns #t to the game: a point) unless it landed; 'die ends it.
(defstate fall (hj2-onin-bubble)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       (when (not (-> self dead?))
         (sound-play "onin-pop")
         (hj2-onin-bubble-burst 2)
         (go empty-state)
         #t
         )
       )
      (('die)
       (set! (-> self dead?) #t)
       (go empty-state)
       )
      )
    )
  :enter (behavior ()
    ;; Jak 2's: the speed that reaches height under gravity (sqrtf takes the absolute value: gravity
    ;; is negative), plus one frame of gravity at 120 frames per second
    (set-vector!
      (-> self root transv)
      (-> self angle)
      (- (sqrtf (* 2.0 (-> self gravity) (-> self height))) (* 0.008333334 (- (-> self gravity))))
      819.2
      1.0
      )
    )
  :code (behavior ()
    ;; Jak 2's absolute heights (the mod keeps Jak 2's coordinates): the pot's rim 8.8 m, the
    ;; landing 8.74 m, gone below 7.8 m
    (while (and (not (and (< (-> self root transv y) 0.0) (< (-> self root trans y) 36044.8))) (not (-> self dead?)))
      (suspend)
      )
    (set! (-> self root trans y) 35799.04)
    (set! (-> self dead?) #t)
    (hj2-onin-bubble-burst 3)
    (send-event (ppointer->process (-> self parent)) 'done)
    (while (not (and (< (-> self root transv y) 0.0) (< (-> self root trans y) 31948.8)))
      (suspend)
      )
    )
  :post (behavior ()
    (+! (-> self root transv y) (* (-> self gravity) (seconds-per-frame)))
    (set! (-> self root transv x) (* 0.999 (-> self root transv x)))
    (vector-v+! (-> self root trans) (-> self root trans) (-> self root transv))
    (spawn (-> self part) (-> self root trans))
    )
  )

(defbehavior hj2-onin-bubble-init hj2-onin-bubble ((pos vector) (shape int) (gravity meters) (angle float) (height float))
  "Jak 2's onin-game-bubble-init: a bubble at pos (the pot), of a shape (0 triangle, 1 circle, 2 x, 3
square), its wave's gravity, its sideways speed (angle) and its height. Plays the throw sound, keeps
running out of view (no actor-pause), its look's launch control; its event hook is idle's, so an
event sent before its state is installed (the next frame) is handled. Goes to idle."
  (sound-play "onin-launch")
  (set-time! (-> self bubble-start-time))
  (set! (-> self bubble-type) shape)
  (set! (-> self gravity) gravity)
  (set! (-> self angle) angle)
  (set! (-> self height) height)
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self dead?) #f)
  (set! (-> self part) (create-launch-control (hj2-onin-bubble-group 0 shape) self))
  (set! (-> self event-hook) (-> (method-of-type hj2-onin-bubble idle) event))
  (go-virtual idle)
  (none)
  )

;; The game /////////////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's onin-game: the game, a child of Onin (hj2-onin-npc), alive from the start of a game to
;; its end. It draws nothing itself (Jak 2's draws no model either): its bubbles are its children.
;;   origin:            where the bubbles are thrown from (the pot)
;;   camera-name:       Onin's camera (her camera-name lump: Jak 2's camera-235)
;;   wave:              where the game is in *hj2-onin-game-data* (0: the header, before wave 1)
;;   wave-time, wave-length: when the wave began, how long it throws
;;   wave-delay-time:   when the pause after the wave began (0: not yet)
;;   event-time, event-length: when the last throw was, the time to the next one (0: at once)
;;   hud-score, hud-goal, hud-miss: Jak 3's HUD widgets (Jak 2's)
;;   score:             the score; *game-info* score (the HUD's) counts up to it
;;   score-time:        when *game-info* score last counted up
;;   miss-max, miss-count: the misses allowed (20), the misses so far
;;   point-win:         the score that wins (1000)
;;   game-start-time:   when the game began (the first wave waits 2 s)
;;   last-type:         the shape of the last pop (-1: a miss broke the run)
;;   current-bonus:     the points of the last pop (doubled by a pop of the same shape, up to 16)
;;   last-angle:        the last bubble's sideways speed (the next one differs by 0.2 m/s or more)
;;   wave-start-miss:   the misses when the wave began (Pecker's comment on the wave)
;;   speech-id:         Pecker's line playing
(deftype hj2-onin-game (process)
  ((origin           vector       :inline)
   (camera-name      string)
   (wave             int32)
   (wave-time        time-frame)
   (wave-delay-time  time-frame)
   (wave-length      time-frame)
   (event-time       time-frame)
   (event-length     time-frame)
   (hud-score        handle)
   (hud-goal         handle)
   (hud-miss         handle)
   (score            float)
   (score-time       time-frame)
   (miss-max         int32)
   (miss-count       int32)
   (point-win        float)
   (game-start-time  time-frame)
   (last-type        int32)
   (current-bonus    float)
   (last-angle       float)
   (wave-start-miss  int32)
   (speech-id        sound-id)
   )
  (:state-methods
    wait-for-start
    (active symbol)
    lose
    win
    quit
    )
  )


(defun hj2-onin-say ((this hj2-onin-game) (lines (array string)) (force? symbol))
  "Pecker says one of lines at random (Jak 2's talker-spawn-func of his speech), on the Daxter voice
channel, unless his previous line still plays (force?: it is stopped first). Returns the line's
sound id (0 when nothing was said)."
  (when (nonzero? (get-status *gui-control* (-> this speech-id)))
    (if (not force?)
        (return (new 'static 'sound-id))
        )
    (set-action!
      *gui-control*
      (gui-action stop)
      (-> this speech-id)
      (gui-channel none)
      (gui-action none)
      (the-as string #f)
      (the-as (function gui-connection symbol) #f)
      (the-as process #f)
      )
    )
  (set! (-> this speech-id)
        (add-process
          *gui-control*
          this
          (gui-channel daxter)
          (gui-action play)
          (-> lines (rand-vu-int-count (-> lines length)))
          -99.0
          0
          )
        )
  (-> this speech-id)
  )

(defun hj2-onin-set-part-num ((id int) (num float) (range float))
  "Sets how many particles part id launches (its spt-num init spec: num plus a random part up to
range), as Jak 2's onin-game does to the pot's sparks and the tiki's drips. Nothing when the part
isn't defined. Returns nothing."
  (let ((part (-> *part-id-table* id)))
    (when (nonzero? part)
      (let ((spec (get-field-spec-by-id part (sp-field-id spt-num))))
        (when spec
          (set! (-> spec initial-valuef) num)
          (set! (-> spec random-rangef) range)
          )
        )
      )
    )
  (none)
  )

(defun hj2-onin-update-score ((this hj2-onin-game))
  "Jak 2's onin-game-method-26: *game-info* score (the HUD's) counts up to the score, a point every
0.1 s with a tick, and *game-info* miss (the HUD's) is the misses. Returns nothing."
  (cond
    ((>= (-> *game-info* score) (-> this score))
     (set! (-> *game-info* score) (-> this score))
     )
    ((time-elapsed? (-> this score-time) (seconds 0.1))
     (sound-play "onin-score")
     (seek! (-> *game-info* score) (-> this score) 1.0)
     (set-time! (-> this score-time))
     )
    )
  (set! (-> *game-info* miss) (the float (-> this miss-count)))
  (none)
  )

(defun hj2-onin-bubbles-up? ((this hj2-onin-game))
  "Is a bubble of the game still alive (one of its children, landed or not)?"
  (let ((p (-> this child)))
    (while p
      (if (type? (ppointer->process p) hj2-onin-bubble)
          (return #t)
          )
      (set! p (-> p 0 brother))
      )
    )
  #f
  )

(defun hj2-onin-run-waves ((this hj2-onin-game))
  "Jak 2's onin-game-method-25, every frame of a game (2 s after its start): once a wave's time is
up and its bubbles are gone, the pause after it, then the next wave (Pecker comments on the one
over: more than 4 misses, or 1 at most); while a wave throws, a throw of bubbles every event time
(their count, shape, height and sideways speed at random). Then the score (hj2-onin-update-score).
Returns nothing."
  (when (time-elapsed? (-> this game-start-time) (seconds 2))
    (let ((wave (-> *hj2-onin-game-data* (-> this wave)))
          (throw? #t)
          )
      (when (time-elapsed? (-> this wave-time) (-> this wave-length))
        (cond
          ((hj2-onin-bubbles-up? this)
           (set! throw? #f)
           )
          (else
            (if (zero? (-> this wave-delay-time))
                (set-time! (-> this wave-delay-time))
                )
            (cond
              ((not (time-elapsed? (-> this wave-delay-time) (the-as time-frame (-> wave wave-delay))))
               (set! throw? #f)
               )
              (else
                ;; the next wave (the row ending the table sends the game back to wave max-count)
                (set! (-> this event-length) 0)
                (+! (-> this wave) 1)
                (set! wave (-> *hj2-onin-game-data* (-> this wave)))
                (when (zero? (-> wave min-count))
                  (set! (-> this wave) (the-as int (-> wave max-count)))
                  (set! wave (-> *hj2-onin-game-data* (-> this wave)))
                  )
                (set-time! (-> this wave-time))
                (set! (-> this wave-length)
                      (the-as time-frame (rand-vu-int-range (the-as int (-> wave min-wave)) (the-as int (-> wave max-wave))))
                      )
                (set! (-> this wave-delay-time) 0)
                (when (< 1 (-> this wave))
                  (let ((missed (- (-> this miss-count) (-> this wave-start-miss))))
                    (cond
                      ((< 4 missed)
                       (hj2-onin-say this *hj2-onin-bad-wave-sounds* #f)
                       )
                      ((>= 1 missed)
                       (hj2-onin-say this *hj2-onin-good-wave-sounds* #f)
                       )
                      )
                    )
                  )
                (set! (-> this wave-start-miss) (-> this miss-count))
                )
              )
            )
          )
        )
      (when (and throw? (time-elapsed? (-> this event-time) (-> this event-length)))
        (set-time! (-> this event-time))
        ;; the count drawn once (dotimes evaluates its count at every turn)
        (let ((n (rand-vu-int-range (the-as int (-> wave min-count)) (the-as int (-> wave max-count)))))
          (dotimes (i n)
            ;; a sideways speed 0.2 m/s or more away from the last bubble's
            (let ((angle (-> this last-angle)))
              (while (< (fabs (- (-> this last-angle) angle)) 819.2)
                (set! angle (rand-vu-float-range -1720.32 1720.32))
                )
              (set! (-> this last-angle) angle)
              )
            (process-spawn
              hj2-onin-bubble
              :init hj2-onin-bubble-init
              (-> this origin)
              (rand-vu-int-range 0 3)
              (-> wave gravity)
              (-> this last-angle)
              (rand-vu-float-range 4096.0 7372.8)
              :name "hj2-onin-bubble"
              :to this
              )
            )
          )
        (set! (-> this event-length)
              (the-as time-frame (rand-vu-int-range (the-as int (-> wave min-event)) (the-as int (-> wave max-event))))
              )
        )
      )
    )
  (hj2-onin-update-score this)
  (none)
  )

(defun hj2-onin-press ((this hj2-onin-game) (shape int))
  "Jak 2's onin-game-method-27: the button of a shape (0 triangle, 1 circle, 2 x, 3 square) pops the
oldest bubble of that shape: a point, doubled for each pop of the same shape in a row (up to 16).
A bubble just born or landed doesn't pop (no point, no miss). No bubble of that shape: a miss
(Pecker teases Jak). Returns nothing."
  (let ((oldest (the-as hj2-onin-bubble #f)))
    (let ((p (-> this child)))
      (while p
        (let ((b (as-type (ppointer->process p) hj2-onin-bubble)))
          (when (and b
                     (= (-> b bubble-type) shape)
                     (or (not oldest) (< (-> b bubble-start-time) (-> oldest bubble-start-time)))
                     )
            (set! oldest b)
            )
          )
        (set! p (-> p 0 brother))
        )
      )
    (cond
      (oldest
        (when (send-event oldest 'attack #f)
          (cond
            ((= shape (-> this last-type))
             (+! (-> this current-bonus) (-> this current-bonus))
             (if (>= (-> this current-bonus) 16.0)
                 (set! (-> this current-bonus) 16.0)
                 )
             )
            (else
              (set! (-> this current-bonus) 1.0)
              )
            )
          (set! (-> this last-type) shape)
          (+! (-> this score) (-> this current-bonus))
          )
        )
      (else
        (sound-play "onin-wrong")
        (set! (-> this last-type) -1)
        (+! (-> this miss-count) 1)
        (hj2-onin-say this *hj2-onin-wrong-sounds* #f)
        )
      )
    )
  (none)
  )

(defbehavior hj2-onin-quit? hj2-onin-game ()
  "Not in Jak 2, every frame of a game (active trans): the hint at the bottom of the screen (where
Onin's prompt is), and a new R3 press (cleared so Jak does not see it once released) quits the game
(the quit state). Returns #f while the game goes on."
  (hj2-print-travel-prompt "Press <PAD_PART_STICK> R3 to quit")
  (when (cpad-pressed? 0 r3)
    (cpad-clear! 0 r3)
    (go-virtual quit)
    )
  #f
  )

;; waiting to grab Jak (Jak 2's wait-for-start), then the game starts
(defstate wait-for-start (hj2-onin-game)
  :virtual #t
  :code (behavior ()
    (while (or (not *target*) (not (process-grab? *target* #f)))
      (suspend)
      )
    (go-virtual active #t)
    )
  )

;; the game (Jak 2's active): the buttons pop bubbles (hj2-onin-press), the waves throw them
;; (hj2-onin-run-waves), 'done is a bubble that landed (a miss). At 20 misses: won at 1000 points or
;; more, else lost. arg0: a new game (Jak 2's enter: the danger3 music, Onin's camera, no airlock
;; opening, no minimap, no gun, calm, no gem count, the HUD, Jak hidden, the pot's sparks and the
;; tiki's drips off). Leaving the game (any state but active, win, lose, quit) puts everything back.
;; R3 quits (hj2-onin-quit?).
(defstate active (hj2-onin-game)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('done)
       (sound-play "onin-splat")
       (set! (-> self last-type) -1)
       (+! (-> self miss-count) 1)
       (hj2-onin-say self *hj2-onin-splat-sounds* #f)
       )
      )
    )
  :enter (behavior ((arg0 symbol))
    (when arg0
      (set-setting! 'music 'j2dange3 0.0 0)
      (if (-> self camera-name)
          (set-setting! 'entity-name (-> self camera-name) 0.0 0)
          )
      (set-setting! 'airlock #f 0.0 0)
      (set-setting! 'minimap 'clear 0.0 (minimap-flag minimap))
      (set! (-> self hud-score)
            (ppointer->handle (process-spawn hud-big-score :init hud-init-by-other :name "hud-big-score" :to self))
            )
      (set! (-> self hud-goal)
            (ppointer->handle (process-spawn hud-goal :init hud-init-by-other :name "hud-goal" :to self))
            )
      (set! (-> self hud-miss)
            (ppointer->handle (process-spawn hud-miss :init hud-init-by-other :name "hud-miss" :to self))
            )
      (set-time! (-> self game-start-time))
      (send-event *target* 'draw #f)
      (set-setting! 'gun #f 0.0 0)
      (set-setting! 'calm #t 0.0 0)
      (set-setting! 'gem #f 0.0 0)
      (hj2-onin-set-part-num *hj2-onin-heatpot-spark-part-id* 0.0 0.0)
      (hj2-onin-set-part-num *hj2-onin-tiki-drip-part-id* 0.0 0.0)
      )
    )
  :exit (behavior ()
    (when (not (and (-> self next-state) (let ((v1-3 (-> self next-state name)))
                                           (or (= v1-3 'active) (= v1-3 'win) (= v1-3 'lose) (= v1-3 'quit))
                                           )
                    )
               )
      (let ((p (-> self child)))
        (while p
          (if (type? (ppointer->process p) hj2-onin-bubble)
              (send-event (ppointer->process p) 'die)
              )
          (set! p (-> p 0 brother))
          )
        )
      (remove-setting! 'music)
      (send-event (handle->process (-> self hud-score)) 'hide-and-die)
      (send-event (handle->process (-> self hud-miss)) 'hide-and-die)
      (send-event (handle->process (-> self hud-goal)) 'hide-and-die)
      (remove-setting! 'entity-name)
      (if (and *target* (focus-test? *target* grabbed))
          (process-release? *target*)
          )
      (remove-setting! 'airlock)
      (remove-setting! 'minimap)
      (remove-setting! 'gun)
      (remove-setting! 'calm)
      (remove-setting! 'gem)
      (persist-with-delay *setting-control* 'gun (seconds 0.5) 'gun #f 0.0 0)
      (send-event *target* 'draw #t)
      (hj2-onin-set-part-num *hj2-onin-heatpot-spark-part-id* 0.0 1.0)
      (hj2-onin-set-part-num *hj2-onin-tiki-drip-part-id* 1.0 0.0)
      (logclear!
        (-> *cpad-list* cpads 0 button0-abs 0)
        (pad-buttons up right down left l1 r1 triangle circle x square)
        )
      (logclear!
        (-> *cpad-list* cpads 0 button0-rel 0)
        (pad-buttons up right down left l1 r1 triangle circle x square)
        )
      )
    )
  :trans (behavior ()
    (cond
      ((>= (-> self miss-count) (-> self miss-max))
       (if (>= (-> self score) (-> self point-win))
           (go-virtual win)
           (go-virtual lose)
           )
       )
      ((cpad-pressed? 0 triangle)
       (hj2-onin-press self 0)
       )
      ((cpad-pressed? 0 circle)
       (hj2-onin-press self 1)
       )
      ((cpad-pressed? 0 x)
       (hj2-onin-press self 2)
       )
      ((cpad-pressed? 0 square)
       (hj2-onin-press self 3)
       )
      )
    (hj2-onin-quit?)
    (logclear!
      (-> *cpad-list* cpads 0 button0-abs 0)
      (pad-buttons up right down left l1 r1 triangle circle x square)
      )
    (logclear!
      (-> *cpad-list* cpads 0 button0-rel 0)
      (pad-buttons up right down left l1 r1 triangle circle x square)
      )
    )
  :code (behavior ((arg0 symbol))
    (suspend-for (seconds 1))
    (hj2-onin-say self *hj2-onin-start-sounds* #f)
    (sleep-code)
    )
  :post (behavior ()
    (hj2-onin-run-waves self)
    )
  )

(defbehavior hj2-onin-end hj2-onin-game ((lines (array string)) (wait time-frame))
  "The end of a finished game (Jak 2's lose and win code, as when replayed): every bubble left pops,
the session's best score is updated, Pecker says one of lines once his line playing is over, then
after wait more a short fade hides the camera's return. Returns nothing (the game's process then
ends, the active state's exit putting everything back)."
  (let ((p (-> self child)))
    (while p
      (if (type? (ppointer->process p) hj2-onin-bubble)
          (send-event (ppointer->process p) 'attack #t)
          )
      (set! p (-> p 0 brother))
      )
    )
  (if (< *hj2-onin-high-score* (the int (-> self score)))
      (set! *hj2-onin-high-score* (the int (-> self score)))
      )
  (while (nonzero? (get-status *gui-control* (-> self speech-id)))
    (suspend)
    )
  (let ((id (hj2-onin-say self lines #t)))
    (while (nonzero? (get-status *gui-control* id))
      (suspend)
      )
    )
  (suspend-for wait)
  (set-blackout-frames (seconds 0.1))
  (none)
  )

;; 20 misses under 1000 points (Jak 2's lose): Pecker's losing line
(defstate lose (hj2-onin-game)
  :virtual #t
  :exit (-> (method-of-type hj2-onin-game active) exit)
  :code (behavior ()
    (hj2-onin-end *hj2-onin-lose-sounds* (seconds 0))
    )
  :post (behavior ()
    (hj2-onin-update-score self)
    )
  )

;; 20 misses at 1000 points or more (Jak 2's win, there at 400 points the first time): Pecker's
;; winning line, 2 s more
(defstate win (hj2-onin-game)
  :virtual #t
  :exit (-> (method-of-type hj2-onin-game active) exit)
  :code (behavior ()
    (hj2-onin-end *hj2-onin-win-sounds* (seconds 2))
    )
  :post (-> (method-of-type hj2-onin-game lose) post)
  )

;; not in Jak 2: R3 during a game (hj2-onin-quit?). No reaction (Pecker's line playing is cut,
;; none said), the session's best score untouched (an unfinished game); a short fade hides the
;; camera's return. The code then ends with the process, whose exit (active's) puts everything
;; back; the bubbles (children) die with it.
(defstate quit (hj2-onin-game)
  :virtual #t
  :exit (-> (method-of-type hj2-onin-game active) exit)
  :code (behavior ()
    (if (nonzero? (get-status *gui-control* (-> self speech-id)))
        (set-action!
          *gui-control*
          (gui-action stop)
          (-> self speech-id)
          (gui-channel none)
          (gui-action none)
          (the-as string #f)
          (the-as (function gui-connection symbol) #f)
          (the-as process #f)
          )
        )
    (set-blackout-frames (seconds 0.2))
    )
  )

(defbehavior hj2-onin-game-init hj2-onin-game ((camera-name string))
  "Jak 2's onin-game-init, as replayed: a short fade, the pot as the bubbles' origin (Jak 2's
absolute place: the mod keeps Jak 2's coordinates), Onin's camera (camera-name), the rules of
*hj2-onin-game-data*'s header (1000 points to win, 20 misses), the HUD's values reset. Keeps running
out of view (no actor-pause). Goes to wait-for-start."
  (set-blackout-frames (seconds 0.1))
  ;; Jak 2's (og:preserve-this): its states suspend inside called behaviors (hj2-onin-end)
  (stack-size-set! (-> self main-thread) 512)
  (logclear! (-> self mask) (process-mask actor-pause))
  (set-vector! (-> self origin) 2918698.5 36044.8 3025589.5 1.0)
  (set! (-> self camera-name) camera-name)
  (set! (-> self hud-score) (the-as handle #f))
  (set! (-> self hud-goal) (the-as handle #f))
  (set! (-> self hud-miss) (the-as handle #f))
  (set! (-> self last-type) -1)
  (set! (-> self speech-id) (new 'static 'sound-id))
  (set! (-> self miss-max) (the int (* 0.0033333334 (the float (-> *hj2-onin-game-data* 0 min-event)))))
  (set! (-> self point-win) (the float (-> *hj2-onin-game-data* 0 max-count)))
  (set! (-> *game-info* score) 0.0)
  (set! (-> *game-info* goal) (-> self point-win))
  (set! (-> *game-info* miss) 0.0)
  (set! (-> *game-info* miss-max) (the float (-> self miss-max)))
  (go-virtual wait-for-start)
  (none)
  )

;; Onin and Pecker ///////////////////////////////////////////////////////////////////////////////////

;; Jak 2's onin-npc (a process-taskable there), placed from its actor (camera-name lump): Onin,
;; solid (Jak 2's three 1 m spheres on her main joint), Pecker her child, offering a game when Jak
;; stands in front of her.
;;   camera-name: her camera-name lump (Jak 2's camera-235, the fixed camera of the game)
;;   game:        the game playing (hj2-onin-game)
(deftype hj2-onin-npc (process-drawable)
  ((root         collide-shape  :override)
   (camera-name  string)
   (game         handle)
   )
  (:state-methods
    idle
    play
    )
  )


;; Jak 2's pecker-npc: Pecker, a child of Onin (same place: his offset is in his animation),
;; playing his idle-game loop while her game runs, else his idle-sleep loop.
(deftype hj2-onin-pecker (process-drawable)
  ()
  (:state-methods
    idle
    )
  )


(defun hj2-onin-playing? ((onin hj2-onin-npc))
  "Is a game of Onin's running (her game's process alive)?"
  (if (handle->process (-> onin game))
      #t
      #f
      )
  )

(defbehavior hj2-onin-npc-anim process-drawable ((sleep-anim art-element) (game-anim art-element) (game? symbol))
  "One frame of Onin's or Pecker's animation (Jak 2's onin-npc and pecker-npc get-art-elem): their
idle-sleep loop, or their idle-game loop while a game runs (game?). A change blends the new loop in
over 0.2 s from its first frame. Returns nothing."
  (let ((anim (if game? game-anim sleep-anim)))
    (when (not (ja-group? anim))
      (ja-channel-push! 1 (seconds 0.2))
      (ja :group! anim :num! min)
      )
    (ja :num! (loop!))
    (ja-blend-eval)
    )
  (none)
  )

;; his loops, by Onin's game (hj2-onin-npc-anim)
(defstate idle (hj2-onin-pecker)
  :virtual #t
  :code (behavior ()
    (until #f
      (hj2-onin-npc-anim
        hj2-onin-pecker-idle-sleep-ja
        hj2-onin-pecker-idle-game-ja
        (hj2-onin-playing? (the-as hj2-onin-npc (ppointer->process (-> self parent))))
        )
      (suspend)
      )
    #f
    )
  :post ja-post
  )

(defbehavior hj2-onin-pecker-init hj2-onin-pecker ((onin hj2-onin-npc))
  "Pecker at Onin's place and turn (onin), his skeleton. Goes to idle."
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) (-> onin root trans))
  (quaternion-copy! (-> self root quat) (-> onin root quat))
  (set-vector! (-> self root scale) 1.0 1.0 1.0 1.0)
  (initialize-skeleton self *hj2-onin-pecker-sg* (the-as pair 0))
  (go-virtual idle)
  (none)
  )

;; Onin's 85 joints are past the 16KB an entity gets by default (the whack-a-metal's 62-joint Daxter
;; needed 32KB). Jak 3's entity-actor birth! takes the heap size from the entity-info its
;; entity-info-lookup caches in method slot 13 of the type (as hj2-mtnx-obs.gc and hj2-pcab-obs.gc
;; do), set here every time the level code links.
(define *hj2-onin-npc-entity-info*
  (new 'static 'entity-info :ptype 'hj2-onin-npc :pool '*16k-dead-pool* :heap-size #x8000)
  )

(set! (-> hj2-onin-npc method-table 13) (the-as function *hj2-onin-npc-entity-info*))

;; asleep (her idle-sleep loop); in front of her (4 m from her actor's place, where Jak 2's scenes
;; stand Jak), out of the war mode, the prompt and the session's best score; triangle plays (the
;; warp gates' conditions, hj2-can-travel?: not on the board, not in a vehicle...)
(defstate idle (hj2-onin-npc)
  :virtual #t
  :code (behavior ()
    (set-time! (-> self state-time))
    (until #f
      (hj2-onin-npc-anim hj2-onin-npc-idle-sleep-ja hj2-onin-npc-idle-game-ja #f)
      (when (and (not *mod-jak2-haven-city-war*)
                 (time-elapsed? (-> self state-time) (seconds 1))
                 (hj2-can-travel? (meters 4))
                 )
        (talker-surpress!)
        (when (can-display-query? self "hj2-onin-game" -99.0)
          (format (clear *hj2-travel-text*) "Press <PAD_TRIANGLE> to play Onin's game (best: ~D)" *hj2-onin-high-score*)
          (hj2-print-travel-prompt *hj2-travel-text*)
          (when (cpad-pressed? 0 triangle)
            ;; the press must not reach the game, where triangle pops a bubble (or is a miss)
            (cpad-clear! 0 triangle)
            (go-virtual play)
            )
          )
        )
      (suspend)
      )
    #f
    )
  :post transform-post
  )

;; a game (Jak 2's play-game): Onin throws bubbles (her idle-game loop) while the game's process
;; runs, then idle again
(defstate play (hj2-onin-npc)
  :virtual #t
  :code (behavior ()
    (set! (-> self game)
          (ppointer->handle
            (process-spawn hj2-onin-game :init hj2-onin-game-init (-> self camera-name) :name "hj2-onin-game" :to self)
            )
          )
    (while (handle->process (-> self game))
      (hj2-onin-npc-anim hj2-onin-npc-idle-sleep-ja hj2-onin-npc-idle-game-ja #t)
      (suspend)
      )
    (set! (-> self game) (the-as handle #f))
    (go-virtual idle)
    )
  :post transform-post
  )

(defmethod init-from-entity! ((this hj2-onin-npc) (arg0 entity-actor))
  "Onin: Jak 2's process-taskable collision (three 1 m spheres stacked on her main joint, node 3),
placement and skeleton, her camera (camera-name lump), Pecker (her child, a 32KB heap for his 74
joints), then idle. Returns nothing."
  (let ((s5-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 3) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 4))
      (set! (-> s4-0 prim-core collide-as) (collide-spec civilian))
      (set! (-> s4-0 prim-core action) (collide-action solid no-standon))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 -1024.0 0.0 7372.8)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (let ((v1-7 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-7 prim-core collide-as) (collide-spec civilian))
      (set! (-> v1-7 prim-core action) (collide-action solid))
      (set! (-> v1-7 transform-index) 3)
      (set-vector! (-> v1-7 local-sphere) 0.0 -4096.0 0.0 4096.0)
      )
    (let ((v1-9 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-9 prim-core collide-as) (collide-spec civilian))
      (set! (-> v1-9 prim-core action) (collide-action solid))
      (set! (-> v1-9 transform-index) 3)
      (set-vector! (-> v1-9 local-sphere) 0.0 -1024.0 0.0 4096.0)
      )
    (let ((v1-11 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
      (set! (-> v1-11 prim-core collide-as) (collide-spec civilian))
      (set! (-> v1-11 prim-core action) (collide-action solid no-standon))
      (set! (-> v1-11 transform-index) 3)
      (set-vector! (-> v1-11 local-sphere) 0.0 2048.0 0.0 4096.0)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-14 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-14 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-14 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-onin-npc-sg* (the-as pair 0))
  (set! (-> this camera-name) (res-lump-struct arg0 'camera-name string))
  (set! (-> this game) (the-as handle #f))
  (process-spawn hj2-onin-pecker :init hj2-onin-pecker-init this :name "hj2-onin-pecker" :stack-size #x8000 :to this)
  (go (method-of-object this idle))
  (none)
  )
