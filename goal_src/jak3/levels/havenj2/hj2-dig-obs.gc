;; Stomp blocks ////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's dig-stomp-block (dig3-obs.gc there): one of the 4 blocks in a row of the stomp block
;; puzzle (6m cubes, top at the origin), spawned by its controller. Diving onto one (Jak's flop)
;; sinks it 3m; a block sinking blocks the others' stomps (the flag). Once two neighbors are more than
;; 5m apart, the controller breaks the row: every block becomes a rigid body (Jak 3's
;; rigid-body-object, like the lava platforms' rigid-body-platform) thrown in a random direction.
;;   desty: the height the sinking block goes down to; flag: a block is sinking (no stomps).
;; Silent: Jak 2's stomp-block sound isn't in Jak 3.
(deftype hj2-dig-stomp-block (rigid-body-object)
  ((desty  float)
   (flag   symbol)
   )
  (:state-methods
    waiting
    hit
    )
  )


(def-actor hj2-dig-stomp-block
  :bounds (0 -3 0 5.5)
  )

;; Jak 2's *dig-stomp-block-constants*
(define *hj2-dig-stomp-block-constants* (new 'static 'rigid-body-object-constants
                                          :info (new 'static 'rigid-body-info
                                            :mass 1.0
                                            :inv-mass 1.0
                                            :linear-damping 0.99
                                            :angular-damping 0.9
                                            :bounce-factor 0.5
                                            :friction-factor 0.1
                                            :cm-offset-joint (new 'static 'vector :w 1.0)
                                            :inertial-tensor-box (new 'static 'array meters 3 (meters 1) (meters 3) (meters 1))
                                            )
                                          :extra (new 'static 'rigid-body-object-extra-info
                                            :max-time-step 0.02
                                            :gravity (meters 80)
                                            :idle-distance (meters 200)
                                            :attack-force-scale 1.0
                                            )
                                          :name '*hj2-dig-stomp-block-constants*
                                          )
        )

;; Standing in its row.
;;   event 'set-flag/'clear-flag (from the controller): another block sinks / stopped sinking;
;;     'attack: Jak's flop sinks it 3m (hit) unless a block is sinking, and tells the controller;
;;     'broken: the row is broken, falls (active).
(defstate waiting (hj2-dig-stomp-block)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('set-flag)
       (set! (-> self flag) #t)
       #t
       )
      (('clear-flag)
       (set! (-> self flag) #f)
       #f
       )
      (('attack)
       (case (-> (the-as attack-info (-> block param 1)) mode)
         (('flop)
          (when (not (-> self flag))
            (set! (-> self desty) (+ (meters -3) (-> self root trans y)))
            (send-event (ppointer->process (-> self parent)) 'set-flag)
            (go-virtual hit)
            'solid
            )
          )
         )
       )
      (('broken)
       (go-virtual active)
       )
      )
    )
  :code sleep-code
  :post ja-post
  )

;; Sinks to desty (smoothly, 6m/s at most), then tells the controller and waits again.
;;   event 'broken: falls (active).
(defstate hit (hj2-dig-stomp-block)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('broken)
       (go-virtual active)
       )
      )
    )
  :code (behavior ()
    (while (< (-> self desty) (-> self root trans y))
      (set! (-> self root trans y)
            (seek-with-smooth (-> self root trans y) (-> self desty) (* (meters 6) (seconds-per-frame)) 0.25 1.0)
            )
      (suspend)
      )
    (set! (-> self flag) #f)
    (send-event (ppointer->process (-> self parent)) 'clear-flag)
    (go-virtual waiting)
    )
  :post transform-post
  )

;; Jak 3's rigid-body-object active state (physics, Jak's touches, idle when Jak is 200m away), and on
;; entering it Jak 2's throw: physics on from where it stands, a random push (up to 10m/s sideways,
;; downwards) and spin.
(defstate active (hj2-dig-stomp-block)
  :virtual #t
  :enter (behavior ()
    (apply-momentum! self)
    (let ((s5-0 (new 'stack-no-clear 'vector))
          (gp-0 (new 'stack-no-clear 'vector))
          )
      (set! (-> s5-0 x) (rand-vu-float-range (meters -10) (meters 10)))
      (set! (-> s5-0 y) (rand-vu-float-range (meters -10) 0.0))
      (set! (-> s5-0 z) (rand-vu-float-range (meters -10) (meters 10)))
      (set! (-> s5-0 w) 0.0)
      (vector-float*! (-> self rbody lin-momentum) s5-0 (-> self info info mass))
      (set! (-> gp-0 x) (rand-vu-float-range -10000.0 10000.0))
      (set! (-> gp-0 y) (rand-vu-float-range -10000.0 10000.0))
      (set! (-> gp-0 z) (rand-vu-float-range -10000.0 10000.0))
      (set! (-> gp-0 w) 0.0)
      (vector-float*! (-> self rbody ang-momentum) gp-0 (-> self info info mass))
      )
    )
  )

(defmethod rbody-post ((this hj2-dig-stomp-block))
  "Jak 2's post of a falling block: fills the collide cache along its motion (what the rigid body
collides with), lifts the endless-fall floors in it 100m (Jak 2's, so the blocks don't sink into
the pit's floor), then Jak 3's rigid body step (rbody-post: physics, transform, joints, collision).
Returns nothing."
  (let ((a1-0 (new 'stack-no-clear 'collide-query)))
    (vector-copy! (-> a1-0 start-pos) (-> this rbody position))
    (vector-float*! (-> a1-0 move-dist) (-> this rbody lin-velocity) (seconds-per-frame))
    (let ((v1-3 a1-0))
      (set! (-> v1-3 radius) (+ 4096.0 (-> this root root-prim local-sphere w)))
      (set! (-> v1-3 collide-with) (-> this root root-prim prim-core collide-with))
      (set! (-> v1-3 ignore-process0) this)
      (set! (-> v1-3 ignore-process1) #f)
      (set! (-> v1-3 ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
      (set! (-> v1-3 action-mask) (collide-action solid))
      )
    (fill-using-line-sphere *collide-cache* a1-0)
    )
  (let* ((a0-15 *collide-cache*)
         (v1-6 (the-as object (-> a0-15 tris)))
         )
    (countdown (a0-16 (-> a0-15 num-tris))
      (when (= (-> (the-as collide-cache-tri v1-6) pat event) (pat-event endlessfall))
        (+! (-> (the-as collide-cache-tri v1-6) vertex 0 y) 409600.0)
        (+! (-> (the-as collide-cache-tri v1-6) vertex 1 y) 409600.0)
        (+! (-> (the-as collide-cache-tri v1-6) vertex 2 y) 409600.0)
        )
      (set! v1-6 (-> (the-as (inline-array collide-cache-tri) v1-6) 1))
      )
    )
  (call-parent-method this)
  (none)
  )

(defmethod init-collision! ((this hj2-dig-stomp-block))
  "Jak 2's collision of a stomp block: 8 spheres (1.5m, the cube's corners, for the background when
it falls) and the solid hull of its model (collide mesh 0, main joint) for Jak, in a group around
the cube. Touches come back as 'touched (Jak 3's rigid body events). Returns nothing."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 9) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 10))
      (set! (-> s4-0 prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> s4-0 prim-core collide-with)
            (collide-spec backgnd jak obstacle hit-by-others-list player-list pusher)
            )
      (set! (-> s4-0 prim-core action) (collide-action solid))
      (set-vector! (-> s4-0 local-sphere) 0.0 (meters -3) 0.0 (meters 5.5))
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    ;; the corners: x and z at +-1.5m, y at -1.5 and -4.5m
    (dotimes (i 8)
      (let ((v1-14 (new 'process 'collide-shape-prim-sphere s5-0 (the-as uint 0))))
        (set! (-> v1-14 prim-core collide-as) (collide-spec obstacle))
        (set! (-> v1-14 prim-core collide-with) (collide-spec backgnd obstacle hit-by-others-list))
        (set! (-> v1-14 prim-core action) (collide-action solid))
        (set! (-> v1-14 transform-index) 0)
        (set-vector!
          (-> v1-14 local-sphere)
          (if (logtest? i 2) 6144.0 -6144.0)
          (if (logtest? i 4) -18432.0 -6144.0)
          (if (logtest? i 1) 6144.0 -6144.0)
          6144.0
          )
        )
      )
    (let ((v1-30 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-30 prim-core collide-as) (collide-spec pusher))
      (set! (-> v1-30 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-30 prim-core action) (collide-action solid))
      (set! (-> v1-30 transform-index) 3)
      (set-vector! (-> v1-30 local-sphere) 0.0 (meters -3) 0.0 (meters 5.5))
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-33 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-33 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-33 prim-core collide-with))
      )
    (set! (-> s5-0 max-iteration-count) (the-as uint 2))
    (set! (-> s5-0 event-self) 'touched)
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-rbody-control! ((this hj2-dig-stomp-block))
  "Skeleton, rigid body (Jak 2's constants) colliding with the background, runs when far away, no
flag. Returns nothing."
  (initialize-skeleton this *hj2-dig-stomp-block-sg* (the-as pair 0))
  (alloc-rbody-control! this *hj2-dig-stomp-block-constants*)
  (logclear! (-> this mask) (process-mask actor-pause))
  (logior! (-> this rbody flags) (rigid-body-flag enable-collision))
  (set! (-> this flag) #f)
  0
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defbehavior hj2-dig-stomp-block-init-by-other hj2-dig-stomp-block ((arg0 vector))
  "Init of a stomp block (spawned by its controller): a platform at arg0, turned half a turn (Jak
2's), collision and rigid body, then waiting."
  (logior! (-> self mask) (process-mask platform))
  (init-collision! self)
  (vector-copy! (-> self root trans) arg0)
  (set-vector! (-> self root quat) 0.0 1.0 0.0 0.0)
  (init-rbody-control! self)
  (transform-post)
  (go-virtual waiting)
  (none)
  )

;; Jak 2's dig-stomp-block-controller: the row of 4 stomp blocks (no model of its own).
;;   stomp-blocks: its blocks; played-fall?: the row broke (Jak 2's blocks-fall sound, not in Jak 3)
(deftype hj2-dig-stomp-block-controller (process-drawable)
  ((stomp-blocks  (pointer hj2-dig-stomp-block)  4)
   (played-fall?  symbol)
   )
  (:state-methods
    idle
    )
  )


;; the blocks' x offsets from the controller: 9, 3, -3 and -9m
(define *hj2-dig-stomp-block-table* (new 'static 'vector :x 36864.0 :y 12288.0 :z -12288.0 :w -36864.0))

;; Runs the row.
;;   enter: joins the pusher pool (its blocks push Jak) and spawns the 4 blocks along x.
;;   event 'set-flag/'clear-flag (from a block): passed on to every block.
;;   post: two neighbors more than 5m apart break the row: 'broken to every block (each frame).
(defstate idle (hj2-dig-stomp-block-controller)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('set-flag)
       (dotimes (gp-0 4)
         (if (-> self stomp-blocks gp-0)
             (send-event (ppointer->process (-> self stomp-blocks gp-0)) 'set-flag)
             )
         )
       #f
       )
      (('clear-flag)
       (dotimes (gp-1 4)
         (if (-> self stomp-blocks gp-1)
             (send-event (ppointer->process (-> self stomp-blocks gp-1)) 'clear-flag)
             )
         )
       #f
       )
      )
    )
  :enter (behavior ()
    (change-parent self *pusher-pool*)
    (let ((gp-0 (new 'stack-no-clear 'vector)))
      (dotimes (s5-0 4)
        (vector-copy! gp-0 (-> self root trans))
        (+! (-> gp-0 x) (-> *hj2-dig-stomp-block-table* data s5-0))
        (set! (-> self stomp-blocks s5-0) (process-spawn hj2-dig-stomp-block gp-0 :to self))
        )
      )
    )
  :code sleep-code
  :post (behavior ()
    (let ((v1-3 #f))
      (dotimes (a0-5 3)
        (let ((a1-2 (-> self stomp-blocks a0-5))
              (a2-3 (-> self stomp-blocks (+ a0-5 1)))
              )
          (when (and a1-2 a2-3)
            (if (< (meters 5) (fabs (- (-> a1-2 0 root trans y) (-> a2-3 0 root trans y))))
                (set! v1-3 #t)
                )
            )
          )
        )
      (when v1-3
        (set! (-> self played-fall?) #t)
        (dotimes (gp-1 4)
          (if (-> self stomp-blocks gp-1)
              (send-event (ppointer->process (-> self stomp-blocks gp-1)) 'broken)
              )
          )
        )
      )
    )
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-dig-stomp-block-controller) (arg0 entity-actor))
  "Jak 2's dig-stomp-block-controller setup: placement only (a trsqv), then idle, which spawns the
blocks."
  (set! (-> this played-fall?) #f)
  (set! (-> this root) (new 'process 'trsqv))
  (process-drawable-from-entity! this arg0)
  (go (method-of-object this idle))
  (none)
  )
