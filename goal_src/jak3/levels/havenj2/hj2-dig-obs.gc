;;-*-Lisp-*-
(in-package goal)

;; name: hj2-dig-obs.gc
;; name in dgo: hj2-dig-obs
;; dgos: HJT

;; og:jak2-haven-city Level code for hj2-dig, Jak 2's dig (levels/dig/dig-obs.gc and dig3-obs.gc
;; there): its platforms and props. Their models are Jak 2's, rebuilt by build-actor (hj2-*.glb,
;; made by the level port, scripts/level_port); their collision is the convex
;; hull of the model (or of a joint's part of it), bound to that joint like Jak 2's mesh. The story
;; state is the end of the game: the log is raised and its buttons are down. Not ported: the enemies,
;; the spiky spheres rolled out of their doors, and Jak 2's sounds of these objects
;; (not in Jak 3). The lava platforms are Jak 3's rigid-body-platform (rigid-body-plat.o, linked
;; before this file in HJT: Jak 3 only has it in the volcano's DGO).

;; Spikey steps ////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's dig-spikey-step: a step turning a full turn around its length every few seconds
;; (cycle-speed: period and offset, in seconds), after a shudder.
(deftype hj2-dig-spikey-step (process-drawable)
  ((root           collide-shape :override)
   (smush          smush-control  :inline)
   (init-quat      quaternion     :inline)
   (shudder-angle  float)
   (rot-angle      float)
   (cycle-time     float)
   (cycle-offset   float)
   )
  (:state-methods
    idle
    )
  )


(def-actor hj2-dig-spikey-step
  :bounds (0 0 6 9)
  )

;; waits its offset, then every cycle: a shudder and a full turn around its length, carrying Jak
(defstate idle (hj2-dig-spikey-step)
  :virtual #t
  :trans rider-trans
  :code (behavior ()
    (suspend-for (the int (-> self cycle-offset))
      )
    (until #f
      (suspend-for (the int (-> self cycle-time))
        )
      (activate! (-> self smush) -1.0 60 225 1.0 1.0 (-> self clock))
      (suspend-for (seconds 0.75)
        (set! (-> self shudder-angle) (* 364.0889 (update! (-> self smush))))
        )
      (set! (-> self shudder-angle) 0.0)
      (set-zero! (-> self smush))
      (suspend-for (seconds 0.25)
        )
      (let ((f30-1 65536.0))
        (suspend-for (seconds 1)
          (set! (-> self rot-angle)
                (the float (sar (shl (the int (+ (-> self rot-angle) (* f30-1 (seconds-per-frame)))) 48) 48))
                )
          )
        )
      (let ((v1-42 #x10000))
        (if (< (-> self rot-angle) 0.0)
            (set! (-> self rot-angle)
                  (the float (sar (shl (* v1-42 (/ (- (the int (-> self rot-angle)) (/ v1-42 2)) v1-42)) 48) 48))
                  )
            (set! (-> self rot-angle)
                  (the float (sar (shl (* v1-42 (/ (+ (the int (-> self rot-angle)) (/ v1-42 2)) v1-42)) 48) 48))
                  )
            )
        )
      )
    #f
    )
  :post (behavior ()
    (let ((a2-1 (quaternion-vector-angle!
                  (new 'stack-no-clear 'quaternion)
                  *z-vector*
                  (+ (-> self rot-angle) (-> self shudder-angle))
                  )
                )
          )
      (quaternion*! (-> self root quat) (-> self init-quat) a2-1)
      )
    (rider-post)
    )
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-dig-spikey-step) (arg0 entity-actor))
  "Jak 2's dig-spikey-step setup: a rideable pusher (the hull of its model) and its timing
(cycle-speed)."
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((s3-0 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s3-0 prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> s3-0 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> s3-0 prim-core action) (collide-action solid rideable))
      (set! (-> s3-0 transform-index) 3)
      (set-vector! (-> s3-0 local-sphere) 0.0 0.0 (meters 6) (meters 9))
      (set! (-> s4-0 total-prims) (the-as uint 1))
      (set! (-> s4-0 root-prim) s3-0)
      )
    (pusher-init s4-0)
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-12 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-12 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-12 prim-core collide-with))
      )
    (set! (-> this root) s4-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-dig-spikey-step-sg* (the-as pair 0))
  (quaternion-copy! (-> this init-quat) (-> this root quat))
  (let ((f28-0 4.0)
        (f30-0 0.0)
        )
    (let* ((sv-16 (new 'static 'res-tag))
           (v1-20 (res-lump-data arg0 'cycle-speed (pointer float) :tag-ptr (& sv-16)))
           )
      (when v1-20
        (set! f28-0 (-> v1-20 0))
        (set! f30-0 (-> v1-20 1))
        )
      )
    (set! (-> this cycle-time) (the float (max 0 (+ (the int (* 300.0 f28-0)) -525))))
    (set! (-> this cycle-offset) (the float (the int (* 300.0 f30-0))))
    )
  (transform-post)
  (go (method-of-object this idle))
  )

;; Wheel steps /////////////////////////////////////////////////////////////////////////////////////

;; Jak 2's dig-wheel-step: a wheel turning (rotspeed) with two steps on its side that stay level.
;; Its collision: the steps (bound to their joints, platform_a and platform_b) and the wheel.
(deftype hj2-dig-wheel-step (process-drawable)
  ((root        collide-shape :override)
   (anim-speed  float)
   )
  (:state-methods
    idle
    )
  )


(def-actor hj2-dig-wheel-step
  :bounds (2 0 0 14)
  )

;; plays its animation (a full turn) in a loop at its speed, carrying Jak
(defstate idle (hj2-dig-wheel-step)
  :virtual #t
  :trans rider-trans
  :code (behavior ()
    (until #f
      (ja-no-eval :group! (ja-group) :num! (seek! max (-> self anim-speed)) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek! max (-> self anim-speed)))
        )
      )
    #f
    )
  :post rider-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-dig-wheel-step) (arg0 entity-actor))
  "Jak 2's dig-wheel-step setup: the two steps (bound to their joints, transform indices 4 and 5)
and the wheel (3) as rideable pushers, and its turning speed."
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s3-0 (new 'process 'collide-shape-prim-group s4-0 (the-as uint 3) 0)))
      (set! (-> s4-0 total-prims) (the-as uint 4))
      (set! (-> s3-0 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> s3-0 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> s3-0 prim-core action) (collide-action solid rideable))
      (set! (-> s3-0 transform-index) 3)
      (set-vector! (-> s3-0 local-sphere) (meters 2) 0.0 0.0 (meters 14))
      (set! (-> s4-0 root-prim) s3-0)
      )
    (pusher-init s4-0)
    (let ((v1-11 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-11 prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> v1-11 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-11 prim-core action) (collide-action solid rideable))
      (set! (-> v1-11 transform-index) 4)
      (set-vector! (-> v1-11 local-sphere) (meters 6) 0.0 0.0 (meters 6))
      )
    (let ((v1-13 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 1) (the-as uint 0))))
      (set! (-> v1-13 prim-core collide-as) (collide-spec obstacle pusher))
      (set! (-> v1-13 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-13 prim-core action) (collide-action solid rideable))
      (set! (-> v1-13 transform-index) 5)
      (set-vector! (-> v1-13 local-sphere) (meters 6) 0.0 0.0 (meters 6))
      )
    (let ((v1-15 (new 'process 'collide-shape-prim-mesh s4-0 (the-as uint 2) (the-as uint 0))))
      (set! (-> v1-15 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-15 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-15 prim-core action) (collide-action solid rideable))
      (set! (-> v1-15 transform-index) 3)
      (set-vector! (-> v1-15 local-sphere) 0.0 0.0 0.0 (meters 10.5))
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-18 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-18 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-18 prim-core collide-with))
      )
    (set! (-> this root) s4-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-dig-wheel-step-sg* (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  ;; rotspeed in angle per second: the animation is a full turn
  (set! (-> this anim-speed) (/ (res-lump-float arg0 'rotspeed :default 8192.0) (meters 16)))
  (go (method-of-object this idle))
  )

;; Lava platforms //////////////////////////////////////////////////////////////////////////////////

;; Jak 2's dig-sinking-plat: a slab floating on the lava, sinking under Jak's weight. Jak 2 moves
;; some along a path; the dig's have none, so they float where they are, held there (Jak 3's
;; platform anchor, which Jak 2's path replaces) if Jak pushes them away.
(deftype hj2-dig-sinking-plat (rigid-body-platform)
  ((anchor-point    vector  :inline)
   (surface-height  float)
   )
  )


(def-actor hj2-dig-sinking-plat
  :bounds (0 -2 0 5.25)
  )

(define *hj2-dig-sinking-plat-constants* (new 'static 'rigid-body-platform-constants
                                           :info (new 'static 'rigid-body-info
                                             :mass 4.0
                                             :inv-mass 0.25
                                             :linear-damping 0.9
                                             :angular-damping 0.48
                                             :friction-factor 0.1
                                             :cm-offset-joint (new 'static 'vector :y -8192.0 :w 1.0)
                                             :inertial-tensor-box (new 'static 'array meters 3 (meters 6) (meters 4) (meters 6))
                                             )
                                           :extra (new 'static 'rigid-body-object-extra-info
                                             :max-time-step 0.02
                                             :gravity (meters 80)
                                             :idle-distance (meters 200)
                                             :attack-force-scale 2.0
                                             )
                                           :name '*hj2-dig-sinking-plat-constants*
                                           :drag-factor 2.0
                                           :buoyancy-factor 1.2
                                           :max-buoyancy-depth (meters 2)
                                           :player-weight (meters 80)
                                           :player-bonk-factor 0.5
                                           :player-dive-factor 1.0
                                           :player-force-distance (meters 30)
                                           :player-force-clamp (meters 1000000)
                                           :player-force-timeout (seconds 0.1)
                                           :explosion-force (meters 1000)
                                           :control-point-count 5
                                           :platform #t
                                           :sound-name #f
                                           )
        )

(defmethod get-lava-height ((this hj2-dig-sinking-plat) (arg0 vector))
  "The lava's surface: 1m under where it was placed."
  (-> this surface-height)
  )

(defmethod apply-gravity! ((this hj2-dig-sinking-plat) (arg0 float))
  "Jak 3's forces (gravity, buoyancy), and the pull towards its anchor point."
  (call-parent-method this arg0)
  (rigid-body-platform-method-59 this (-> this anchor-point))
  0
  (none)
  )

(defmethod init-collision! ((this hj2-dig-sinking-plat))
  "A rideable pusher: the hull of its model (joint 3)."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (set! (-> s5-0 penetrated-by) (penetrate))
    (let ((s4-0 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s4-0 prim-core collide-as) (collide-spec pusher))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak hit-by-others-list player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 (meters -2) 0.0 (meters 5.25))
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-16 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-16 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-16 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-rbody-control! ((this hj2-dig-sinking-plat))
  "Skeleton, rigid body (its constants), anchor point, lava height and its 5 control points (a
ring of 4m radius, 2m under its center)."
  (initialize-skeleton this *hj2-dig-sinking-plat-sg* (the-as pair 0))
  (set! (-> this float-height-offset) 0.0)
  (alloc-rbody-control! this *hj2-dig-sinking-plat-constants*)
  (vector-copy! (-> this anchor-point) (-> this rbody position))
  (set! (-> this surface-height) (+ -4096.0 (-> this root trans y)))
  (let ((s5-1 (-> this info control-point-count)))
    (dotimes (s4-1 s5-1)
      (let ((s3-0 (-> this control-point-array data s4-1)))
        (let ((f30-0 (* 65536.0 (/ (the float s4-1) (the float s5-1)))))
          (set! (-> s3-0 local-pos x) (* 16384.0 (sin f30-0)))
          (set! (-> s3-0 local-pos y) -8192.0)
          (set! (-> s3-0 local-pos z) (* 16384.0 (cos f30-0)))
          )
        (set! (-> s3-0 local-pos w) 1.0)
        )
      )
    )
  0
  (none)
  )

;; Jak 2's dig-tipping-rock: a long rock floating on the lava, tipping under Jak's weight, held in
;; place by its anchor.
(deftype hj2-dig-tipping-rock (rigid-body-platform)
  ((anchor-point    vector  :inline)
   (surface-height  float)
   )
  )


(def-actor hj2-dig-tipping-rock
  :bounds (0 0 0 14.5)
  :origin-joint-index 3
  )

(define *hj2-dig-tipping-rock-constants* (new 'static 'rigid-body-platform-constants
                                           :info (new 'static 'rigid-body-info
                                             :mass 4.0
                                             :inv-mass 0.25
                                             :linear-damping 0.9
                                             :angular-damping 0.48
                                             :friction-factor 0.1
                                             :cm-offset-joint (new 'static 'vector :z -24576.0 :w 1.0)
                                             :inertial-tensor-box (new 'static 'array meters 3 (meters 4) (meters 3) (meters 21))
                                             )
                                           :extra (new 'static 'rigid-body-object-extra-info
                                             :max-time-step 0.02
                                             :gravity (meters 80)
                                             :idle-distance (meters 50)
                                             :attack-force-scale 1.0
                                             )
                                           :name '*hj2-dig-tipping-rock-constants*
                                           :drag-factor 2.0
                                           :buoyancy-factor 1.2
                                           :max-buoyancy-depth (meters 2)
                                           :player-weight (meters 80)
                                           :player-bonk-factor 0.5
                                           :player-dive-factor 1.0
                                           :player-force-distance (meters 30)
                                           :player-force-clamp (meters 1000000)
                                           :player-force-timeout (seconds 0.1)
                                           :explosion-force (meters 1000)
                                           :control-point-count 4
                                           :platform #t
                                           :sound-name #f
                                           )
        )

(defmethod get-lava-height ((this hj2-dig-tipping-rock) (arg0 vector))
  "The lava's surface: 1.5m above where it was placed."
  (-> this surface-height)
  )

(defmethod apply-gravity! ((this hj2-dig-tipping-rock) (arg0 float))
  "Jak 3's forces (gravity, buoyancy), and the pull towards its anchor point."
  (call-parent-method this arg0)
  (rigid-body-platform-method-59 this (-> this anchor-point))
  0
  (none)
  )

(defmethod init-collision! ((this hj2-dig-tipping-rock))
  "A rideable pusher: the hull of its model (joint 3)."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((s4-0 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> s4-0 prim-core collide-as) (collide-spec pusher))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 0.0 (meters 1) (meters 14.5))
      (set! (-> s5-0 total-prims) (the-as uint 1))
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-16 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-16 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-16 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  0
  (none)
  )

(defmethod init-rbody-control! ((this hj2-dig-tipping-rock))
  "Skeleton (tipped 14 degrees, like Jak 2's), rigid body, anchor point, its 4 control points and
the lava height."
  (initialize-skeleton this *hj2-dig-tipping-rock-sg* (the-as pair 0))
  ;; Jak 2 starts it tipped (14 degrees)
  (quaternion-rotate-local-x! (-> this root quat) (-> this root quat) -2555.2202)
  (set! (-> this float-height-offset) 0.0)
  (alloc-rbody-control! this *hj2-dig-tipping-rock-constants*)
  (vector-copy! (-> this anchor-point) (-> this rbody position))
  (let ((v1-8 (-> this control-point-array)))
    (set-vector! (-> v1-8 data 0 local-pos) 0.0 0.0 -8192.0 1.0)
    (set-vector! (-> v1-8 data 1 local-pos) 0.0 8192.0 -40960.0 1.0)
    (set-vector! (-> v1-8 data 2 local-pos) 40960.0 4096.0 -24576.0 1.0)
    (set-vector! (-> v1-8 data 3 local-pos) -40960.0 4096.0 -24576.0 1.0)
    )
  (set! (-> this surface-height) (+ 6144.0 (-> this root trans y)))
  0
  (none)
  )

;; Balloon lurkers /////////////////////////////////////////////////////////////////////////////////

;; Jak 2's dig-balloon-lurker: a lurker pedaling a balloon along its path and back (sync), bobbing,
;; a trapeze hanging under it (hj2-dig-trapeze) for Jak to swing from. options 1: it also turns 70
;; degrees along the way, and swings the trapeze half a swing apart. While Jak hangs from the bar,
;; the camera looks at the balloon from aside (Jak 2's).
(deftype hj2-dig-balloon-lurker (process-drawable)
  ((root              collide-shape  :override)
   (init-quat         quaternion     :inline)
   (sync              sync-eased     :inline)
   (swing-sync        sync-linear    :inline)
   (smush             smush-control  :inline)
   (pov-cam-offset    vector         :inline)
   (options           int32)
   (bouncing          symbol)
   (bounce-scale      meters)
   (bob-counter       float)
   (forward-backward  symbol)
   (grabbed           symbol)
   (trapeze-grabbed   symbol)
   (pedal-anim-frame  float)
   (pedal-anim-speed  float)
   )
  (:state-methods
    idle
    )
  )


;; The trapeze under a balloon lurker (its child): its swing (the lurker's swing-sync), a swingpole
;; on its bar, and the swing with Jak on it blended in (swing-type).
(deftype hj2-dig-trapeze (process-drawable)
  ((parent-ptr        (pointer hj2-dig-balloon-lurker)  :overlay-at parent)
   (swing-type        float)
   (swing-pole        (pointer swingpole))
   (swing-anim-frame  float)
   )
  (:state-methods
    idle
    )
  )


(def-actor hj2-dig-balloon-lurker
  :bounds (0 8 0 16)
  )

;; the trapeze's swing, Jak off the bar and on it (blended by swing-type)
(def-actor hj2-dig-trapeze
  :art (idle-ja jak-on-ja)
  :bounds (0 0 0 20)
  )

;; WARN: Return type mismatch object vs none.
(defbehavior hj2-dig-trapeze-init-by-other hj2-dig-trapeze ((arg0 entity-actor))
  "Init of the trapeze (spawned by its balloon lurker, with its entity): skeleton and the bar's
swingpole."
  (set! (-> self root) (new 'process 'trsqv))
  (process-drawable-from-entity! self arg0)
  (initialize-skeleton self *hj2-dig-trapeze-sg* (the-as pair 0))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self swing-type) 0.0)
  ;; the bar: the trapeze_end joint (index 10, 11 in the node list)
  (set! (-> self swing-pole) (process-spawn swingpole :init swingpole-init 11 :to self))
  (set! (-> self swing-anim-frame) 0.0)
  (go-virtual idle)
  )

;; follows the lurker, swings with its swing-sync, and tells it when Jak hangs from the bar
(defstate idle (hj2-dig-trapeze)
  :virtual #t
  :code (behavior ()
    (ja-channel-push! 2 0)
    (ja :group! hj2-dig-trapeze-idle-ja :num! min)
    (ja :chan 1 :group! hj2-dig-trapeze-jak-on-ja :num! min)
    (until #f
      (ja :num-func num-func-identity :frame-num (-> self swing-anim-frame))
      (let ((a0-4 (-> self skel root-channel 1)))
        (let ((f0-4 (* 0.6 (-> self swing-type))))
          (set! (-> a0-4 frame-interp 1) f0-4)
          (set! (-> a0-4 frame-interp 0) f0-4)
          )
        (set! (-> a0-4 param 0) 0.0)
        (joint-control-channel-group-eval! a0-4 (the-as art-joint-anim #f) num-func-chan)
        )
      (let* ((f30-0 (the float (ja-num-frames 0)))
             (f0-10 (+ (* 1.5 f30-0 (get-norm! (-> self parent-ptr 0 swing-sync) 0))
                       (if (= (-> self parent-ptr 0 options) 1)
                           (/ f30-0 2)
                           0.0
                           )
                       )
                    )
             )
        (set! (-> self swing-anim-frame) (- f0-10 (* (the float (the int (/ f0-10 f30-0))) f30-0)))
        )
      (vector-copy! (-> self root trans) (-> self parent-ptr 0 root trans))
      (quaternion-copy! (-> self root quat) (-> self parent-ptr 0 root quat))
      (set! (-> self parent-ptr 0 trapeze-grabbed)
            (the-as symbol (and (-> self swing-pole 0 next-state) (= (-> self swing-pole 0 next-state name) 'active)))
            )
      (seek!
        (-> self swing-type)
        (if (-> self parent-ptr 0 trapeze-grabbed)
            1.0
            0.0
            )
        (/ (-> self clock time-adjust-ratio) 50)
        )
      (suspend)
      )
    #f
    )
  :post ja-post
  )

;; pedals along its path and back (sync), bobbing; bounces and sets the side camera while Jak
;; hangs from the trapeze
(defstate idle (hj2-dig-balloon-lurker)
  :virtual #t
  :code (behavior ()
    (until #f
      (let ((f30-0 (get-norm! (-> self sync) 0)))
        (cond
          ((-> self forward-backward)
           (if (< 0.9 f30-0)
               (set! (-> self forward-backward) #f)
               )
           )
          (else
            (if (< f30-0 0.1)
                (set! (-> self forward-backward) #t)
                )
            )
          )
        (seek!
          (-> self pedal-anim-speed)
          (if (-> self forward-backward)
              -0.5
              0.5
              )
          (/ (-> self clock time-adjust-ratio) 100)
          )
        (ja :num-func num-func-identity :frame-num (-> self pedal-anim-frame))
        (+! (-> self pedal-anim-frame) (* (-> self pedal-anim-speed) (-> self clock time-adjust-ratio)))
        (cond
          ((>= (-> self pedal-anim-frame) (the float (ja-num-frames 0)))
           (set! (-> self pedal-anim-frame) (- (-> self pedal-anim-frame) (the float (ja-num-frames 0))))
           )
          ((< (-> self pedal-anim-frame) 0.0)
           (+! (-> self pedal-anim-frame) (the float (ja-num-frames 0)))
           )
          )
        (cond
          ((-> self trapeze-grabbed)
           (when (not (-> self grabbed))
             (set-setting! 'mode-name 'cam-pov-track 0.0 0)
             (let ((v1-33 (process->ppointer self)))
               (set-setting! 'pov-handle v1-33 3.0 (-> v1-33 0 pid))
               )
             (set! (-> self pov-cam-offset z)
                   (if (< 0.0 (vector-dot (-> self node-list data 0 bone transform fvec) (-> (camera-matrix) fvec)))
                       -81920.0
                       81920.0
                       )
                   )
             (set-setting! 'pov-offset 'abs (-> self pov-cam-offset) 0)
             (set! (-> self grabbed) #t)
             )
           (when (not (-> self bouncing))
             (activate! (-> self smush) -1.0 210 600 1.0 1.0 (-> self clock))
             (set! (-> self bouncing) #t)
             (cond
               ((< (-> self bob-counter) 90.0)
                (set! (-> self bob-counter) (- 180.0 (-> self bob-counter)))
                )
               ((< 270.0 (-> self bob-counter))
                (set! (-> self bob-counter) (- 540.0 (-> self bob-counter)))
                )
               )
             )
           (seek! (-> self bob-counter) 270.0 (* 3.0 (-> self clock time-adjust-ratio)))
           )
          (else
            (when (-> self grabbed)
              (remove-setting! 'pov-handle)
              (remove-setting! 'mode-name)
              (remove-setting! 'pov-offset)
              (set! (-> self grabbed) #f)
              )
            (+! (-> self bob-counter) (* 3.0 (-> self clock time-adjust-ratio)))
            (if (< 360.0 (-> self bob-counter))
                (+! (-> self bob-counter) -360.0)
                )
            (if (= (-> self smush amp) 0.0)
                (set! (-> self bouncing) #f)
                )
            )
          )
        (get-point-at-percent-along-path! (-> self path) (-> self root trans) f30-0 'interp)
        (+! (-> self root trans y) (+ (* 2048.0 (sin (* 182.04445 (the float (the int (-> self bob-counter))))))
                                      (* (-> self bounce-scale) (update! (-> self smush)))
                                      )
            )
        (when (= (-> self options) 1)
          (let ((a2-12 (quaternion-vector-angle! (new 'stack-no-clear 'quaternion) *y-vector* (* 182.04445 (* 70.0 f30-0)))))
            (quaternion*! (-> self root quat) (-> self init-quat) a2-12)
            )
          )
        )
      (suspend)
      )
    #f
    )
  :post transform-post
  )

;; WARN: Return type mismatch object vs none.
(defmethod init-from-entity! ((this hj2-dig-balloon-lurker) (arg0 entity-actor))
  "Jak 2's dig-balloon-lurker setup: solid (the balloon and its two ends, spheres), its trapeze, its
path, options and syncs (12 seconds)."
  (let ((s4-0 (new 'process 'collide-shape this (collide-list-enum hit-by-player))))
    (let ((s3-0 (new 'process 'collide-shape-prim-group s4-0 (the-as uint 3) 0)))
      (set! (-> s4-0 total-prims) (the-as uint 4))
      (set! (-> s3-0 prim-core collide-as) (collide-spec crate))
      (set! (-> s3-0 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> s3-0 prim-core action) (collide-action solid))
      (set! (-> s3-0 transform-index) 0)
      (set-vector! (-> s3-0 local-sphere) 0.0 (meters 15) 0.0 (meters 15))
      (set! (-> s4-0 root-prim) s3-0)
      )
    ;; the balloon and its two ends, around the "all" joint (13m up)
    (let ((v1-8 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> v1-8 prim-core collide-as) (collide-spec crate))
      (set! (-> v1-8 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-8 prim-core action) (collide-action solid))
      (set! (-> v1-8 transform-index) 3)
      (set-vector! (-> v1-8 local-sphere) 0.0 (meters 1) 0.0 (meters 7))
      )
    (let ((v1-10 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> v1-10 prim-core collide-as) (collide-spec crate))
      (set! (-> v1-10 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-10 prim-core action) (collide-action solid))
      (set! (-> v1-10 transform-index) 3)
      (set-vector! (-> v1-10 local-sphere) 0.0 (meters 1) (meters 9) (meters 4))
      )
    (let ((v1-12 (new 'process 'collide-shape-prim-sphere s4-0 (the-as uint 0))))
      (set! (-> v1-12 prim-core collide-as) (collide-spec crate))
      (set! (-> v1-12 prim-core collide-with) (collide-spec jak player-list))
      (set! (-> v1-12 prim-core action) (collide-action solid))
      (set! (-> v1-12 transform-index) 3)
      (set-vector! (-> v1-12 local-sphere) 0.0 (meters 1) (meters -9) (meters 5))
      )
    (set! (-> s4-0 nav-radius) (* 0.75 (-> s4-0 root-prim local-sphere w)))
    (let ((v1-15 (-> s4-0 root-prim)))
      (set! (-> s4-0 backup-collide-as) (-> v1-15 prim-core collide-as))
      (set! (-> s4-0 backup-collide-with) (-> v1-15 prim-core collide-with))
      )
    (set! (-> this root) s4-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this *hj2-dig-balloon-lurker-sg* (the-as pair 0))
  (process-spawn hj2-dig-trapeze arg0 :to this)
  (quaternion-copy! (-> this init-quat) (-> this root quat))
  (logclear! (-> this mask) (process-mask actor-pause))
  (set! (-> this options) (res-lump-value arg0 'options int :time -1000000000.0))
  (set! (-> this path) (new 'process 'curve-control this 'path -1000000000.0))
  (set! (-> this bouncing) #f)
  (set! (-> this bounce-scale) 1228.8)
  (set! (-> this bob-counter) (if (= (-> this options) 1)
                                  145.0
                                  0.0
                                  )
        )
  (set! (-> this forward-backward) #f)
  (set! (-> this grabbed) #f)
  (set! (-> this trapeze-grabbed) #f)
  (set! (-> this pedal-anim-frame) 0.0)
  (set! (-> this pedal-anim-speed) 0.5)
  (set-vector! (-> this pov-cam-offset) 0.0 -20480.0 0.0 1.0)
  (let ((a1-23 (new 'stack-no-clear 'sync-info-params)))
    (set! (-> a1-23 sync-type) 'sync-eased)
    (set! (-> a1-23 sync-flags) (sync-flags pong))
    (set! (-> a1-23 period) (the-as uint 3600))
    (set! (-> a1-23 entity) arg0)
    (set! (-> a1-23 percent) 0.0)
    (set! (-> a1-23 ease-in) 0.15)
    (set! (-> a1-23 ease-out) 0.15)
    (set! (-> a1-23 pause-in) 0.0)
    (set! (-> a1-23 pause-out) 0.0)
    (initialize! (-> this sync) a1-23)
    )
  (let ((a1-24 (new 'stack-no-clear 'sync-info-params)))
    (set! (-> a1-24 sync-type) 'sync-linear)
    (set! (-> a1-24 sync-flags) (sync-flags pong))
    (set! (-> a1-24 entity) arg0)
    (set! (-> a1-24 period) (the-as uint 3600))
    (set! (-> a1-24 percent) 0.0)
    (initialize! (-> this swing-sync) a1-24)
    )
  (go (method-of-object this idle))
  )

