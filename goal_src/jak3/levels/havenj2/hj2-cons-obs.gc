;;-*-Lisp-*-
(in-package goal)

;; name: hj2-cons-obs.gc
;; name in dgo: hj2-cons-obs
;; dgos: HJC

;; og:jak2-haven-city Level code for hj2-cons, Jak 2's construction site (levels/consite/consite-obs.gc
;; there): the silo doors and the bomb elevator, still like at the end of the game. Their models are
;; Jak 2's, rebuilt by build-actor (hj2-cons-*.glb, made by the level
;; port, scripts/level_port); their collision is the convex hull of the
;; parts Jak 2's collide meshes cover (each door leaf on its joint, the elevator's platform). Not
;; ported: the Baron's fight (its breaking scaffolds, the bomb), Jak 2's sounds.

;; A still model: solid (its collide meshes, one per joint given), holding its first frame.
(deftype hj2-cons-prop (process-drawable)
  ((root  collide-shape :override)
   )
  (:state-methods
    idle
    )
  )


;; still
(defstate idle (hj2-cons-prop)
  :virtual #t
  :code (behavior ()
    (transform-post)
    (sleep-code)
    )
  )

(defun hj2-cons-prop-init! ((this hj2-cons-prop) (arg0 entity-actor) (skel skeleton-group) (joints (array int32)) (sphere vector))
  "A still prop's setup: one collide mesh per joint of joints (their transform indices, in the order
of the model's collide meshes), a group around them all (sphere, from the origin), placement and
skeleton."
  (let ((s5-0 (new 'process 'collide-shape this (collide-list-enum usually-hit-by-player))))
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint (-> joints length)) 0)))
      (set! (-> s5-0 total-prims) (the-as uint (+ (-> joints length) 1)))
      (set! (-> s4-0 prim-core collide-as) (collide-spec obstacle))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (vector-copy! (-> s4-0 local-sphere) sphere)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (dotimes (i (-> joints length))
      (let ((v1-9 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint i) (the-as uint 0))))
        (set! (-> v1-9 prim-core collide-as) (collide-spec obstacle))
        (set! (-> v1-9 prim-core collide-with) (collide-spec jak bot player-list))
        (set! (-> v1-9 prim-core action) (collide-action solid rideable))
        (set! (-> v1-9 transform-index) (-> joints i))
        (vector-copy! (-> v1-9 local-sphere) sphere)
        )
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-12 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-12 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-12 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  (process-drawable-from-entity! this arg0)
  (initialize-skeleton this skel (the-as pair 0))
  (logclear! (-> this mask) (process-mask actor-pause))
  (none)
  )

;; Jak 2's consite-silo-doors: the two leaves over the bomb's silo, each solid on its joint (top_left,
;; top_right: transform indices 4 and 5)
(deftype hj2-cons-silo-doors (hj2-cons-prop)
  ()
  )


(def-actor hj2-cons-silo-doors
  :bounds (0 1 0 18)
  )

(defmethod init-from-entity! ((this hj2-cons-silo-doors) (arg0 entity-actor))
  "Jak 2's consite-silo-doors setup."
  (hj2-cons-prop-init!
    this
    arg0
    *hj2-cons-silo-doors-sg*
    (new 'static 'boxed-array :type int32 4 5)
    (new 'static 'vector :y (meters 1) :w (meters 18))
    )
  (go (method-of-object this idle))
  )

;; Jak 2's consite-bomb-elevator: a 20m platform on a long screw, in the silo; solid at its platform
;; (its main joint), with its hinges (a model of their own, hj2-cons-bomb-hinges, on a child process
;; like Jak 2's consite-bomb-elevator-hinges)
(deftype hj2-cons-bomb-elevator (hj2-cons-prop)
  ()
  )


(def-actor hj2-cons-bomb-elevator
  :bounds (0 -27 0 38)
  )

(def-actor hj2-cons-bomb-hinges
  :bounds (0 10.4 0 2)
  )

;; the hinges, where the elevator stands
(deftype hj2-cons-bomb-hinges (process-drawable)
  ()
  (:state-methods
    idle
    )
  )


;; still
(defstate idle (hj2-cons-bomb-hinges)
  :virtual #t
  :code sleep-code
  )

(defbehavior hj2-cons-bomb-hinges-init-by-other hj2-cons-bomb-hinges ((from trsqv))
  "Init of the elevator's hinges (process-spawn from the elevator): at the elevator's place."
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) (-> from trans))
  (quaternion-copy! (-> self root quat) (-> from quat))
  (vector-copy! (-> self root scale) (-> from scale))
  (initialize-skeleton self *hj2-cons-bomb-hinges-sg* (the-as pair 0))
  (logclear! (-> self mask) (process-mask actor-pause))
  (ja-post)
  (go-virtual idle)
  )

(defmethod init-from-entity! ((this hj2-cons-bomb-elevator) (arg0 entity-actor))
  "Jak 2's consite-bomb-elevator setup, and its hinges."
  (hj2-cons-prop-init!
    this
    arg0
    *hj2-cons-bomb-elevator-sg*
    (new 'static 'boxed-array :type int32 3)
    (new 'static 'vector :w (meters 15))
    )
  (process-spawn hj2-cons-bomb-hinges (-> this root) :name "hj2-cons-bomb-hinges" :to this)
  (go (method-of-object this idle))
  )
