;;-*-Lisp-*-
(in-package goal)

;; name: hj2-fexa-obs.gc
;; name in dgo: hj2-fexa-obs
;; dgos: HKF

;; og:jak2-haven-city Level code for hj2-fexa, Jak 2's way out of the fortress (levels/fortress/
;; exit/forexita-obs.gc there): its scissor lifts. Their model is Jak 2's, rebuilt by build-actor
;; (hj2-fort-lift-plat.glb, made by the level port, scripts/level_port). Not
;; ported: the guards, the claw (never placed), the lifts' glow. Sound: Jak 2's fort-lift-plat loop,
;; from its FOREXIT1 bank ('j2forex1), which hj2-fexa loads.

;; Jak 2's fort-lift-plat: a scissor lift, Jak 3's plat. The ones with a sync period ride their path
;; (plat-path-active), their deck raised (the first frame of hj2-fort-lift-plat-scale). The one with
;; the user18 option stays at its initial-spline-pos on the path and raises and lowers its deck in
;; its animation, one cycle per sync period (plat-anim-active). Like Jak 2's, they don't bounce.
;; Jak 2's fort-lift-plat sound loops while it moves (plat's sound-id), restarted every sync period
;; and stopped at the top of the deck's cycle or at the end of the path.
;;   sound-time: when the loop restarts next; last-val: the deck's frame or the path position of the
;;   previous frame (to see it cross the stop point).
(deftype hj2-fort-lift-plat (plat)
  ((sound-time  time-frame)
   (last-val    float)
   )
  (:state-methods
    plat-anim-active
    )
  )


(def-actor hj2-fort-lift-plat
  :art (idle-ja scale-ja)
  :bounds (0 -2 -8 15)
  )

(defmethod get-art-group ((this hj2-fort-lift-plat))
  "Its model: Jak 2's fort-lift-plat."
  (the-as art-group *hj2-fort-lift-plat-sg*)
  )

(defmethod init-collision! ((this hj2-fort-lift-plat))
  "Jak 2's collision: its deck rideable (on the joint platscale), its arms and its base solid, each
on its joint (the hulls made by the generator, in this order: deck, arms, base)."
  (let ((s5-0 (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> s5-0 dynam) (copy *standard-dynamics* 'process))
    (set! (-> s5-0 reaction) cshape-reaction-default)
    (set! (-> s5-0 no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((s4-0 (new 'process 'collide-shape-prim-group s5-0 (the-as uint 3) 0)))
      (set! (-> s5-0 total-prims) (the-as uint 4))
      (set! (-> s4-0 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> s4-0 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> s4-0 prim-core action) (collide-action solid rideable))
      (set! (-> s4-0 transform-index) 3)
      (set-vector! (-> s4-0 local-sphere) 0.0 -16384.0 -49152.0 98304.0)
      (set! (-> s5-0 root-prim) s4-0)
      )
    (pusher-init s5-0)
    (let ((v1-15 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 0) (the-as uint 0))))
      (set! (-> v1-15 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-15 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-15 prim-core action) (collide-action solid rideable))
      (set! (-> v1-15 transform-index) 7)
      (set-vector! (-> v1-15 local-sphere) 0.0 0.0 0.0 49152.0)
      )
    (let ((v1-17 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 1) (the-as uint 0))))
      (set! (-> v1-17 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-17 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-17 prim-core action) (collide-action solid))
      (set! (-> v1-17 transform-index) 4)
      (set-vector! (-> v1-17 local-sphere) 0.0 8192.0 -12288.0 49152.0)
      )
    (let ((v1-19 (new 'process 'collide-shape-prim-mesh s5-0 (the-as uint 2) (the-as uint 0))))
      (set! (-> v1-19 prim-core collide-as) (collide-spec obstacle camera-blocker pusher))
      (set! (-> v1-19 prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> v1-19 prim-core action) (collide-action solid))
      (set! (-> v1-19 transform-index) 3)
      (set-vector! (-> v1-19 local-sphere) 0.0 -25600.0 -19456.0 40960.0)
      )
    (set! (-> s5-0 nav-radius) (* 0.75 (-> s5-0 root-prim local-sphere w)))
    (let ((v1-26 (-> s5-0 root-prim)))
      (set! (-> s5-0 backup-collide-as) (-> v1-26 prim-core collide-as))
      (set! (-> s5-0 backup-collide-with) (-> v1-26 prim-core collide-with))
      )
    (set! (-> this root) s5-0)
    )
  (none)
  )

(defmethod deactivate ((this hj2-fort-lift-plat))
  "Stops the lift's loop sound (Jak 2's fort-lift-plat deactivate), then the parent's deactivate.
Returns nothing."
  (sound-stop (-> this sound-id))
  (call-parent-method this)
  (none)
  )

(defbehavior hj2-fort-lift-plat-sound-post hj2-fort-lift-plat ()
  "Post of the moving lifts (Jak 2's): restarts the fort-lift-plat loop every sync period, keeps it
going (at the lift), then plat-post. Side effects: sound-time, the sound. Returns nothing."
  (when (< (-> self sound-time) (current-time))
    (sound-stop (-> self sound-id))
    (set! (-> self sound-time) (get-timeframe-offset! (-> self sync) 0))
    )
  (sound-play "fort-lift-plat" :id (-> self sound-id) :position (-> self root trans))
  (plat-post)
  (none)
  )

(defmethod go-initial-state ((this hj2-fort-lift-plat))
  "Jak 2's plat-path-sync: with the user18 option, the lift stays at its initial-spline-pos
(plat-anim-active); else Jak 3's plat's (along its path when it has a sync period)."
  (cond
    ((and (not (logtest? (-> this path flags) (path-control-flag not-found)))
          (logtest? (actor-option user18) (-> this fact options))
          )
     (set! (-> this path-pos) (res-lump-float (-> this entity) 'initial-spline-pos))
     (get-point-at-percent-along-path! (-> this path) (-> this root trans) (-> this path-pos) 'interp)
     (go (method-of-object this plat-anim-active))
     )
    (else
      (call-parent-method this)
      )
    )
  )

;; standing still, no bounce
(defstate plat-idle (hj2-fort-lift-plat)
  :virtual #t
  :event #f
  )

;; riding its path with its deck raised, no bounce; Jak 2's loop sound (hj2-fort-lift-plat-sound-post),
;; stopped at the end of the path (in place of Jak 3's plat's eco-plat-hover)
(defstate plat-path-active (hj2-fort-lift-plat)
  :virtual #t
  :event #f
  :enter (behavior ()
    (set! (-> self last-val) 0.0)
    (set! (-> self sound-time) (get-timeframe-offset! (-> self sync) 0))
    )
  :trans (behavior ()
    (set! (-> self path-pos) (get-norm! (-> self sync) 0))
    (get-point-at-percent-along-path! (-> self path) (-> self basetrans) (-> self path-pos) 'interp)
    (if (and (>= (-> self path-pos) 0.9999) (< (-> self last-val) 0.9999))
        (sound-stop (-> self sound-id))
        )
    (set! (-> self last-val) (-> self path-pos))
    (plat-trans)
    )
  :code (behavior ()
    (ja-no-eval :group! hj2-fort-lift-plat-scale-ja :num-func num-func-identity :frame-num 0.0)
    (sleep-code)
    )
  :post hj2-fort-lift-plat-sound-post
  )

;; at its place on the path, raising and lowering its deck, one cycle per sync period; Jak 2's loop
;; sound (hj2-fort-lift-plat-sound-post), stopped as the deck passes the middle of its cycle
(defstate plat-anim-active (hj2-fort-lift-plat)
  :virtual #t
  :event #f
  :enter (behavior ()
    (get-point-at-percent-along-path! (-> self path) (-> self basetrans) (-> self path-pos) 'interp)
    (set! (-> self last-val) 0.0)
    (set! (-> self sound-time) (get-timeframe-offset! (-> self sync) 0))
    )
  :trans plat-trans
  :code (behavior ()
    (until #f
      (let ((f30-0 (* (get-current-phase-no-mod (-> self sync)) (the float (+ (-> (ja-group) frames num-frames) -1)))))
        (ja-no-eval :group! (ja-group) :num! (loop!) :frame-num f30-0)
        (let ((f0-3 (* 0.5 (the float (+ (-> (ja-group) frames num-frames) -1)))))
          (if (and (>= f30-0 f0-3) (< (-> self last-val) f0-3))
              (sound-stop (-> self sound-id))
              )
          )
        (set! (-> self last-val) f30-0)
        )
      (suspend)
      )
    #f
    )
  :post hj2-fort-lift-plat-sound-post
  )
