;; hj2-fexb's texture page 1613: the sprite textures of its particles (their pixels are in its
;; fr3, see sprite_textures in hj2-fexb.jsonc), as names and sizes (w | h << 16)
(define *hj2-fexb-sprite-names* (new 'static 'boxed-array :type string "water-ring"))

(define *hj2-fexb-sprite-sizes* (new 'static 'boxed-array :type uint32 #x800080))

