;; callbacks ///////////////////////////////////////////////////////////////////////////////////////

(defun hj2-check-drop-level-forexitb-drop-water-userdata ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 sprite-vec-data-2d))
  "Jak 2's check-drop-level-forexitb-drop-water-userdata (levels/fortress/exit/forexitb-part.gc)."
  (when
    (< (-> arg2 y) (-> arg1 user-float))
    (let
      ((s3-0 (new 'stack-no-clear 'vector)))
      (sp-kill-particle arg0 arg1)
      (set-vector! s3-0 (-> arg2 x) (-> arg1 user-float) (-> arg2 z) 1.0)
      (launch-particles (-> *part-id-table* 3858) s3-0)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 3859) s3-0)
      (launch-particles (-> *part-id-table* 3860) s3-0)
    )
  )
  (sparticle-motion-blur arg0 arg1 (the-as vector arg2))
  (none)
  )

(defun hj2-check-drop-level-forexitb ((arg0 sparticle-system) (arg1 sparticle-cpuinfo) (arg2 vector))
  (when (< (-> arg2 y) (-> arg1 user-float))
    (let ((s3-0 (new 'stack-no-clear 'vector)))
      (sp-kill-particle arg0 arg1)
      (set-vector! s3-0 (-> arg2 x) (-> arg1 user-float) (-> arg2 z) 1.0)
      (launch-particles (-> *part-id-table* 3858) s3-0)
      (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 3863) s3-0)
      )
    )
  (sparticle-motion-blur arg0 arg1 arg2)
  (none)
  )

